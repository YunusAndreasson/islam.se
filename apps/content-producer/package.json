{
	"name": "@islam-se/content-producer",
	"version": "0.1.0",
	"type": "module",
	"description": "CLI for content production orchestration",
	"main": "dist/index.js",
	"bin": {
		"produce": "./dist/index.js"
	},
	"scripts": {
		"build": "rm -rf dist && tsc",
		"dev": "tsc --watch",
		"produce": "node --no-warnings dist/index.js"
	},
	"dependencies": {
		"@clack/prompts": "^1.8.1",
		"@islam-se/orchestrator": "workspace:*",
		"@islam-se/quotes": "workspace:*",
		"commander": "^15.0.0",
		"diff": "^9.0.0",
		"dotenv": "^18.0.4",
		"yaml": "^2.9.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/node": "^26.6.3",
		"typescript": "^7.0.2"
	}
}
