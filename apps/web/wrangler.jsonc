{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "islam-se",
	"pages_build_output_dir": "dist",
	// Matches what the dashboard already had. Bumping it would change runtime
	// semantics for the markdown middleware that is already live.
	"compatibility_date": "2026-02-15",

	// ⚠️ Once this file exists it is the source of truth for the project's bindings, so
	// anything the dashboard used to hold has to be declared HERE or it stops being
	// applied on the next deploy. Deliberately no "vars" block: the site needs no
	// plaintext runtime variable, and the two values /api/rattelse does need are
	// encrypted secrets that must never sit in the repo —
	//
	//   TURNSTILE_SECRET  the private half of the sitekey in src/lib/rattelse.ts
	//   IP_SALT           per-project salt for the stored ip_hash
	//
	// Set both under Pages → islam-se → Settings → Variables and secrets (or
	// `wrangler pages secret put <NAME> --project-name islam-se`). Locally they come
	// from .dev.vars — see .dev.vars.example. The route now 500s with
	// "server_misconfigured" rather than silently degrading if either is absent.

	"d1_databases": [
		{
			"binding": "RATTELSER",
			"database_name": "islam-se-rattelser",
			"database_id": "e1c0c473-1167-4986-ac36-4136d4b86493",
			"migrations_dir": "migrations"
		}
	],

	// Pages Functions cannot hold a send_email binding, so the notification mail
	// goes out through a Worker that can. Deploy workers/rattelse-mailer before
	// any Pages deploy that references it.
	"services": [
		{
			"binding": "MAILER",
			"service": "islam-se-rattelse-mailer"
		}
	]
}
