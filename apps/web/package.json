{
	"name": "@islam-se/web",
	"type": "module",
	"version": "0.0.1",
	"private": true,
	"description": "The islam.se website: Astro on Cloudflare Pages",
	"license": "MIT",
	"homepage": "https://islam.se",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/YunusAndreasson/islamse.git",
		"directory": "apps/web"
	},
	"scripts": {
		"deps:check": "bash scripts/update-deps.sh --check",
		"deps:update": "bash scripts/update-deps.sh --apply",
		"dev": "astro dev",
		"dev:bg": "astro dev --background",
		"dev:status": "astro dev status",
		"dev:logs": "astro dev logs",
		"dev:stop": "astro dev stop",
		"build": "pnpm library-figures && astro build && tsx scripts/generate-markdown.ts",
		"build:profile": "pnpm library-figures && astro build --timings && tsx scripts/generate-markdown.ts",
		"preview": "astro preview",
		"check": "astro check",
		"bench": "node scripts/bench/bench.mjs",
		"pdf": "tsx scripts/generate-pdf.ts",
		"library-figures": "tsx scripts/build-library-figures.ts",
		"rattelser": "tsx scripts/rattelser.ts",
		"sync-verses": "tsx scripts/sync-verses.ts",
		"ai-barometern": "tsx scripts/ai-barometern.ts",
		"build:fast": "BONETIDER_SAMPLE=12 astro build && tsx scripts/generate-markdown.ts",
		"epub": "tsx scripts/generate-epub.ts",
		"books": "pnpm run pdf && pnpm run epub",
		"test": "vitest run --project web",
		"lint": "biome check .",
		"knip": "knip --directory ../.. --workspace apps/web",
		"check:edge": "wrangler pages functions build functions --outdir node_modules/.cache/pages-check && wrangler deploy --dry-run --config workers/rattelse-mailer/wrangler.jsonc --outdir node_modules/.cache/mailer-check"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.3.5",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@lucide/astro": "^1.67.0",
		"adhan": "^4.4.6",
		"astro": "^7.4.5",
		"maplibre-gl": "^6.16.0",
		"qrcode-generator": "^2.0.4",
		"rehype-stringify": "^10.0.1",
		"remark-rehype": "^11.1.2",
		"remark-smartypants": "^3.0.3",
		"satori": "^0.63.2",
		"sharp": "^0.35.5"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"fontkitten": "1.0.3",
		"node-html-markdown": "^2.0.0",
		"playwright": "^1.65.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"unified": "^11.0.5"
	}
}
