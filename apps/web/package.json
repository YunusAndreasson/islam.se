{
	"name": "@islam-se/web",
	"type": "module",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"deps:check": "bash scripts/update-deps.sh --check",
		"deps:update": "bash scripts/update-deps.sh",
		"dev": "astro dev",
		"dev:bg": "astro dev --background",
		"dev:status": "astro dev status",
		"dev:logs": "astro dev logs",
		"dev:stop": "astro dev stop",
		"build": "pnpm library-figures && astro build && tsx scripts/generate-markdown.ts",
		"build:profile": "pnpm library-figures && astro build --timings && tsx scripts/generate-markdown.ts",
		"preview": "astro preview",
		"check": "astro check",
		"bench": "node scripts/bench/bench.mjs",
		"pdf": "tsx scripts/generate-pdf.ts",
		"library-figures": "tsx scripts/build-library-figures.ts",
		"rattelser": "tsx scripts/rattelser.ts",
		"sync-verses": "tsx scripts/sync-verses.ts",
		"ai-barometern": "tsx scripts/ai-barometern.ts",
		"build:fast": "BONETIDER_SAMPLE=12 astro build && tsx scripts/generate-markdown.ts",
		"epub": "tsx scripts/generate-epub.ts",
		"books": "pnpm run pdf && pnpm run epub"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.3.4",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@lucide/astro": "^1.61.0",
		"adhan": "^4.4.6",
		"astro": "^7.4.2",
		"maplibre-gl": "^6.15.0",
		"qrcode-generator": "^2.0.4",
		"rehype-stringify": "^10.0.1",
		"remark-rehype": "^11.1.2",
		"remark-smartypants": "^3.0.3",
		"satori": "^0.63.2",
		"sharp": "^0.35.5"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"fontkitten": "1.0.3",
		"node-html-markdown": "^2.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"unified": "^11.0.5"
	}
}
