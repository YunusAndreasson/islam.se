---
import type { HTMLAttributes } from "astro/types";
import type { Article } from "../lib/articles";
import { leadSentences } from "../lib/format";
import { inlineMarkdown } from "../lib/articles";
import { CARD_WIDTHS } from "../lib/hero";
import ArticleMeta from "./ArticleMeta.astro";
import EssayImage from "./EssayImage.astro";

type Props = HTMLAttributes<"li"> & {
	article: Article;
	variant?: "row" | "card";
	showReadFlag?: boolean;
	showMinutesAttr?: boolean;
	/** `sizes` for the card picture. The caller owns the grid, so it owns the painted
	 *  width — a `sizes` that under-states it makes the browser fetch a file too small
	 *  for a 2× screen and the picture goes soft. The default matches the auto-fill
	 *  .essay-cards track in layout.css. (A row with a thumbnail down its right edge
	 *  was retired 2026-10-16: nothing had asked for one since the front page dropped
	 *  side thumbnails.) */
	cardSizes?: string;
};

const {
	article,
	variant = "row",
	showReadFlag = false,
	showMinutesAttr = false,
	cardSizes = "(max-width: 600px) 100vw, 20rem",
	class: className,
	...attrs
} = Astro.props;

const isCard = variant === "card";
---

<li
	{...attrs}
	class:list={["archive-item", isCard && "essay-card", className]}
	data-slug={article.slug}
	data-minutes={showMinutesAttr ? article.readingTime : undefined}
>
	<a href={`/${article.slug}/`} data-astro-prefetch="viewport">
		{isCard && article.heroImage && (
			<div class="essay-card-media media-frame">
				<EssayImage article={article} widths={CARD_WIDTHS} sizes={cardSizes} />
			</div>
		)}
		<span class:list={["archive-title", isCard && "essay-card-title"]}>{article.title}</span>
		{!isCard && (
			<ArticleMeta class="label archive-meta" publishedAt={article.publishedAt} readingTime={article.readingTime} showReadFlag={showReadFlag} />
		)}
		{/* The deck's opening sentence in a row as on a card (DESIGN.md, »Decks in lists«).
		    Rows stand two abreast on /essaer/ and the ämne pages, and the full decks ran
		    them three to five lines each, side by side at uneven heights. */}
		{article.description && (
			<p class:list={["archive-description", isCard && "essay-card-desc"]} set:html={inlineMarkdown(leadSentences(article.description, 170))} />
		)}
		{isCard && (
			<ArticleMeta class="label archive-meta" publishedAt={article.publishedAt} readingTime={article.readingTime} showReadFlag={showReadFlag} />
		)}
	</a>
</li>

{/* Card styling is GLOBAL, in styles/layout.css (`.essay-cards` / `.essay-card*`),
    so the Frågor & svar fördjupning band renders the identical card. */}
