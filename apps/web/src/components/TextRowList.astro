---
import type { HTMLAttributes } from "astro/types";
import type { Article } from "../lib/articles";
import AudioPlayer from "./AudioPlayer.astro";
import EssayImage from "./EssayImage.astro";

type TextRowImage = {
	src?: ImageMetadata;
	article?: Article;
	widths: number[];
	sizes: string;
};

type TextRowAudio = {
	src: string;
	title: string;
	artwork?: string;
	/** Overrides the button's word. A row passes its duration — see AudioPlayer. */
	label?: string;
};

type TextRowItem = {
	href: string;
	title: string;
	description?: string;
	/** A quiet third line under the description — counts, dates, provenance. Reference
	 *  rows carry no thumbnail, so this is what tells a reader how substantial the page is. */
	meta?: string;
	image?: TextRowImage | null;
	/** Gives the row a play control. It renders as a SIBLING of the row link, never
	 *  inside it: a <button> nested in an <a> is invalid markup, and the click would
	 *  navigate instead of playing. The row keeps exactly one link and gains exactly
	 *  one button, which is also what a screen reader wants to find there. */
	audio?: TextRowAudio;
	attrs?: HTMLAttributes<"li">;
};

type Props = HTMLAttributes<"ul"> & {
	items: readonly TextRowItem[];
	variant?: "media" | "question";
	titleElement?: "h2" | "span";
};

const {
	class: className,
	items,
	variant = "media",
	titleElement = variant === "media" ? "h2" : "span",
	...attrs
} = Astro.props;

const Title = titleElement;
---

<ul {...attrs} class:list={["text-row-list", `text-row-list--${variant}`, className]}>
	{items.map((item) => (
		<li {...item.attrs} class:list={[item.audio && "text-row-playable"]}>
			<a href={item.href} data-astro-prefetch="viewport">
				{item.image && (
					<span class="text-row-thumb media-frame">
						<EssayImage
							{...(item.image.src === undefined ? {} : { src: item.image.src })}
							{...(item.image.article === undefined ? {} : { article: item.image.article })}
							alt=""
							widths={item.image.widths}
							sizes={item.image.sizes}
							loading="lazy"
						/>
					</span>
				)}
				<span class="text-row-text">
					<Title class="text-row-title cap-trim-start">{item.title}</Title>
					{item.description && <span class="text-row-desc">{item.description}</span>}
					{item.meta && <span class="text-row-meta label">{item.meta}</span>}
				</span>
			</a>
			{item.audio && (
				<span class="text-row-action">
					<AudioPlayer
						src={item.audio.src}
						title={item.audio.title}
						{...(item.audio.artwork === undefined ? {} : { artwork: item.audio.artwork })}
						{...(item.audio.label === undefined ? {} : { label: item.audio.label })}
					/>
				</span>
			)}
		</li>
	))}
</ul>

<style>
	.text-row-list {
		margin: var(--text-row-list-margin, 0);
		padding: 0;
	}

	.text-row-list a {
		text-decoration: none;
		color: inherit;
	}

	/* Apparatus, not editorial. This component renders /fordjupning/, /svar/ and the
	   podcast index — the reference half of the site, where the heading voice is
	   Source Sans. It is a list of entries, not of essays. */
	.text-row-title {
		display: block;
		margin: 0;
		font-family: var(--font-heading);
		color: var(--color-accent);
	}

	.text-row-desc {
		display: block;
		font-family: var(--font-body);
		line-height: 1.55;
		color: var(--color-muted);
		max-width: var(--content-width);
		text-wrap: pretty;
	}

	.text-row-meta {
		display: block;
		margin-top: var(--text-row-meta-margin, 0.35rem);
		color: var(--color-muted);
		font-variant-numeric: lining-nums tabular-nums;
	}

	.text-row-list a:hover .text-row-title,
	.text-row-list a:focus-visible .text-row-title {
		text-decoration: underline;
		text-underline-offset: var(--underline-offset);
	}

	/* Row spacing is a margin, so a caller that lays the rows out as a grid must be able
	   to zero it and use row-gap instead — this rule is scoped to the component and
	   outranks anything the page can write, including :global(). */
	.text-row-list--media li + li {
		margin-top: var(--text-row-row-gap, var(--space-unit));
		padding-top: var(--text-row-media-separator-padding, 0);
		border-top: var(--text-row-media-separator, 0);
	}

	/* Thumb beside text by default. A caller that wants the picture stacked above the
	   text sets `--text-row-columns: 1fr` — the thumb then becomes the first grid row. */
	.text-row-list--media a {
		display: grid;
		grid-template-columns: var(--text-row-columns, var(--text-row-thumb-width, 120px) 1fr);
		gap: var(--text-row-thumb-gap, var(--space-unit));
		align-items: start;
	}

	.text-row-list--media a:not(:has(.text-row-thumb)) {
		grid-template-columns: 1fr;
	}

	/* A playable row carries a control that CANNOT live inside its link — a <button>
	   nested in an <a> is invalid and would navigate instead of playing. So the <li>
	   becomes a grid and the button is placed in it as the link's sibling.

	   The track definition is deliberately the same expression the link uses inside
	   itself. The link spans both columns and keeps its own picture|text grid; the
	   control is placed in column TWO of the outer grid, which lands it exactly on the
	   title's left edge rather than the picture's. Two grids, one measure, so the row
	   reads as a single column of text with a picture beside it and the action at the
	   foot of what it acts on.

	   It was a circle pinned to the row's right edge first. On a 64rem canvas that put
	   the button some six hundred pixels from the title it belonged to, across a gap
	   the deck's own measure had already emptied — an isolated control floating in
	   whitespace, which is what a podcast app does because a phone is 390px wide and
	   this is not a phone. */
	.text-row-list--media li.text-row-playable {
		display: grid;
		grid-template-columns: var(--text-row-columns, var(--text-row-thumb-width, 120px) 1fr);
		column-gap: var(--text-row-thumb-gap, var(--space-unit));
		/* The control is seated in a list; it does not carry the essay page's air. */
		--audio-trigger-margin: 0;
	}

	.text-row-list--media li.text-row-playable > a {
		grid-column: 1 / -1;
	}

	.text-row-list--media .text-row-action {
		display: block;
		grid-column: 2;
		margin-top: var(--space-half);
	}

	/* 3:2, everywhere, no knob. The podcast index briefly cut its art 1:1 on the
	   argument that an episode list is square wherever a reader has met one before.
	   It is — in a music app, where the square IS the album. These episodes are the
	   site's own essays read aloud and the picture is the essay's hero, composed 3:2;
	   squaring it cropped the photograph to look like a record sleeve it is not, and
	   made this the one list on the site with its own crop. */
	/* The picture is centred against the row; the TEXT stays top-aligned. This is the
	   composition `.archive-item--thumb` already uses on the front page, and it is there
	   for the reason it is needed here: when a row is a good deal taller than its
	   picture — an episode row runs a title, a four-line deck, a meta line and a control
	   — a top-aligned crop sits in the upper-left corner with a hand's width of nothing
	   under it, and reads as dropped onto the page rather than set into it. Centred, the
	   picture has type on both sides of its midline and the row balances.

	   A no-op for /fordjupning/ and /svar/, where the picture is the taller item and
	   there is no slack to distribute — which is why it is stated once, here, rather
	   than scoped to the rows that happen to need it today. */
	.text-row-list--media .text-row-thumb {
		align-self: center;
	}

	.text-row-list--media .text-row-thumb :global(img) {
		aspect-ratio: 3 / 2;
		width: 100%;
	}

	/* ⚠️ The weight must be stated. Without it the title inherits from whatever
	   `titleElement` the caller picked for document-outline reasons — an h2 lands on
	   620 from the global heading rule, a span falls to 400. Same class, same rank,
	   two different looks. 620 matches .archive-title, the site's list-title weight. */
	.text-row-list--media .text-row-title {
		font-size: var(--text-row-title-size, var(--step-1-sans));
		font-weight: 620;
	}

	.text-row-list--media .text-row-desc {
		margin-top: var(--text-row-desc-margin, var(--space-half));
		font-size: var(--text-row-desc-size, var(--step--1));
	}

	.text-row-list--question li {
		border-bottom: var(--text-row-question-separator, 1px solid var(--color-divider));
	}

	/* A caller whose rows are a single line tightens the padding — at --space-unit a
	   one-line row is mostly air. Floor is the 24px WCAG 2.5.8 target. */
	.text-row-list--question a {
		display: block;
		padding: var(--text-row-question-padding, var(--space-unit)) 0;
	}

	.text-row-list--question .text-row-title {
		font-weight: 600;
		font-size: var(--step--1);
		max-width: var(--content-width);
	}

	.text-row-list--question .text-row-desc {
		margin-top: 0.25rem;
		font-size: var(--step--2);
	}

	@media (width <= 34rem) {
		.text-row-list--media a {
			grid-template-columns: 1fr;
		}

		.text-row-list--media .text-row-thumb {
			display: none;
		}

		/* A playable row loses its picture here too, and that WAS tried the other way:
		   keeping the art at chip size on a phone. It measured badly — an 88px picture
		   beside a deck squeezed to a 275px measure runs the deck to ten lines, so the
		   row became a tall narrow column of type with a stamp in the corner. Either
		   the deck gets clamped or the art goes; the art goes, because the deck is the
		   episode's own words and this list is only ten rows long. (If the art should
		   come back here, it needs a clamp on the deck to come with it.)

		   The outer grid still collapses: the control takes the whole measure under the
		   row rather than staying indented past a column that is no longer there. */
		.text-row-list--media li.text-row-playable {
			grid-template-columns: 1fr;
		}

		.text-row-list--media .text-row-action {
			grid-column: 1;
		}
	}
</style>
