---
import type { HTMLAttributes } from "astro/types";
import type { Article } from "../lib/articles";
import EssayImage from "./EssayImage.astro";

type TextRowImage = {
	src?: ImageMetadata;
	article?: Article;
	widths: number[];
	sizes: string;
};

type TextRowItem = {
	href: string;
	title: string;
	description?: string;
	/** A quiet third line under the description — counts, dates, provenance. Reference
	 *  rows carry no thumbnail, so this is what tells a reader how substantial the page is. */
	meta?: string;
	image?: TextRowImage | null;
	attrs?: HTMLAttributes<"li">;
};

type Props = HTMLAttributes<"ul"> & {
	items: readonly TextRowItem[];
	variant?: "media" | "question";
	titleElement?: "h2" | "span";
};

const {
	class: className,
	items,
	variant = "media",
	titleElement = variant === "media" ? "h2" : "span",
	...attrs
} = Astro.props;

const Title = titleElement;
---

<ul {...attrs} class:list={["text-row-list", `text-row-list--${variant}`, className]}>
	{items.map((item) => (
		<li {...item.attrs}>
			<a href={item.href} data-astro-prefetch="viewport">
				{item.image && (
					<span class="text-row-thumb media-frame">
						<EssayImage
							{...(item.image.src === undefined ? {} : { src: item.image.src })}
							{...(item.image.article === undefined ? {} : { article: item.image.article })}
							alt=""
							widths={item.image.widths}
							sizes={item.image.sizes}
							loading="lazy"
						/>
					</span>
				)}
				<span class="text-row-text">
					<Title class="text-row-title cap-trim-start">{item.title}</Title>
					{item.description && <span class="text-row-desc">{item.description}</span>}
					{item.meta && <span class="text-row-meta label">{item.meta}</span>}
				</span>
			</a>
		</li>
	))}
</ul>

<style>
	.text-row-list {
		margin: var(--text-row-list-margin, 0);
		padding: 0;
	}

	.text-row-list a {
		text-decoration: none;
		color: inherit;
	}

	/* Apparatus, not editorial. This component is used on exactly two surfaces —
	   /fordjupning/ and /svar/ — which are the reference half of the site, where
	   the heading voice is Source Sans. It is a list of encyclopedia entries, not
	   of essays. */
	.text-row-title {
		display: block;
		margin: 0;
		font-family: var(--font-heading);
		color: var(--color-accent);
	}

	.text-row-desc {
		display: block;
		font-family: var(--font-body);
		line-height: 1.55;
		color: var(--color-muted);
		max-width: var(--content-width);
		text-wrap: pretty;
	}

	.text-row-meta {
		display: block;
		margin-top: 0.35rem;
		color: var(--color-muted);
		font-variant-numeric: lining-nums tabular-nums;
	}

	.text-row-list a:hover .text-row-title,
	.text-row-list a:focus-visible .text-row-title {
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	/* Row spacing is a margin, so a caller that lays the rows out as a grid must be able
	   to zero it and use row-gap instead — this rule is scoped to the component and
	   outranks anything the page can write, including :global(). */
	.text-row-list--media li + li {
		margin-top: var(--text-row-row-gap, var(--space-unit));
		padding-top: var(--text-row-media-separator-padding, 0);
		border-top: var(--text-row-media-separator, 0);
	}

	/* Thumb beside text by default. A caller that wants the picture stacked above the
	   text sets `--text-row-columns: 1fr` — the thumb then becomes the first grid row. */
	.text-row-list--media a {
		display: grid;
		grid-template-columns: var(--text-row-columns, var(--text-row-thumb-width, 120px) 1fr);
		gap: var(--text-row-thumb-gap, var(--space-unit));
		align-items: start;
	}

	.text-row-list--media a:not(:has(.text-row-thumb)) {
		grid-template-columns: 1fr;
	}

	.text-row-list--media .text-row-thumb :global(img) {
		aspect-ratio: 3 / 2;
		width: 100%;
	}

	/* ⚠️ The weight must be stated. Without it the title inherits from whatever
	   `titleElement` the caller picked for document-outline reasons — an h2 lands on
	   620 from the global heading rule, a span falls to 400. Same class, same rank,
	   two different looks. 620 matches .archive-title, the site's list-title weight. */
	.text-row-list--media .text-row-title {
		font-size: var(--text-row-title-size, var(--step-1-sans));
		font-weight: 620;
	}

	.text-row-list--media .text-row-desc {
		margin-top: var(--text-row-desc-margin, var(--space-half));
		font-size: var(--text-row-desc-size, var(--step--1));
	}

	.text-row-list--question li {
		border-bottom: var(--text-row-question-separator, 1px solid var(--color-divider));
	}

	/* A caller whose rows are a single line tightens the padding — at --space-unit a
	   one-line row is mostly air. Floor is the 24px WCAG 2.5.8 target. */
	.text-row-list--question a {
		display: block;
		padding: var(--text-row-question-padding, var(--space-unit)) 0;
	}

	.text-row-list--question .text-row-title {
		font-weight: 600;
		font-size: var(--step--1);
		max-width: var(--content-width);
	}

	.text-row-list--question .text-row-desc {
		margin-top: 0.25rem;
		font-size: var(--step--2);
	}

	@media (width <= 34rem) {
		.text-row-list--media a {
			grid-template-columns: 1fr;
		}

		.text-row-list--media .text-row-thumb {
			display: none;
		}
	}
</style>
