---
import Base from "../layouts/Base.astro";
import ArticleHeader from "./ArticleHeader.astro";

interface Props {
	title: string;
	description?: string;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	noindex?: boolean;
}

const { title, description, jsonLd, noindex = false } = Astro.props;
---

<Base title={title} description={description} jsonLd={jsonLd} noindex={noindex}>
	<main id="main" class="content-column">
		<ArticleHeader title={title.replace(/ — islam\.se$/, "")}>
			<slot name="header" />
		</ArticleHeader>
		<slot />
	</main>
</Base>
