---
import { Pause, Play } from "@lucide/astro";

interface Props {
	src: string;
	title?: string;
	artwork?: string;
	/** What the button says beside the glyph. The essay page's control stands alone
	 *  above the article and says the verb. An episode row says the COST — "16 min" —
	 *  because the row's title and deck have already said what it is, and the one
	 *  thing a listener still weighs before pressing play is how long it takes. Same
	 *  `.audio-trigger` hook and data attributes either way, so FloatingPlayer's
	 *  `syncTriggers()` mirrors playing state onto both without knowing the
	 *  difference. */
	label?: string;
}

const { src, title, artwork, label = "Lyssna" } = Astro.props;
---

<button
	class="audio-trigger pill"
	type="button"
	data-audio-src={src}
	data-audio-title={title}
	data-audio-artwork={artwork}
	aria-label={`Lyssna på ${title || 'essän'}`}
>
	<Play class="audio-trigger-icon-play" size={14} fill="currentColor" stroke-width={0} />
	<Pause class="audio-trigger-icon-pause" size={14} fill="currentColor" stroke-width={0} />
	{label}
</button>

<style>
	/* THE PILL IS `.pill` (layout.css) — the same one Apple Podcasts, Spotify
	   and RSS are drawn as, three rows above this button on /podcast/. It used to be
	   redrawn here, and the copy had drifted: 0.4rem/0.875rem padding against 0.5/1.125,
	   0.06em tracking against 0.05, 0.4em icon gap against 0.45. Nobody could see it
	   because the two pills had never appeared on the same screen before this page put
	   them there. Now they are one shape.

	   What stays below is only what is genuinely this control's own: the two UA button
	   properties `.pill` has no reason to carry (it is written for an <a>),
	   the playing state, and the glyph swap. */
	.audio-trigger {
		background: transparent;
		cursor: pointer;
		/* Page rhythm, not the control's own: the essay page needs air under a button
		   that stands alone above an article, a row seated in a list needs none. A
		   custom property because it INHERITS — the one kind of declaration that
		   crosses an Astro scope boundary, so a caller can actually set it. */
		margin-bottom: var(--audio-trigger-margin, var(--space-unit));
	}

	/* The one place a play button outranks a link pill: while it is playing it is the
	   page's live object, and it says so. */
	.audio-trigger[data-playing] {
		border-color: var(--color-accent);
		color: var(--color-text);
	}

	/* ⚠️ `:global()` on the icon half, and it is load-bearing. These are Lucide <svg>
	   components, not markup this file writes, so a plain descendant selector compiles
	   to `.audio-trigger-icon-pause[data-astro-cid-…]` and reaches nothing. The
	   `.audio-trigger` half stays scoped, so this is still only ever our own buttons.

	   The pause glyph used to be hidden with an inline `style="display:none"` instead
	   of this rule — and an inline style outranks a stylesheet, so the rule below that
	   was meant to reveal it never could. A playing button showed NO glyph at all: play
	   hidden by the rule, pause hidden by the attribute. */
	.audio-trigger :global(.audio-trigger-icon-pause) {
		display: none;
	}

	.audio-trigger[data-playing] :global(.audio-trigger-icon-play) {
		display: none;
	}

	.audio-trigger[data-playing] :global(.audio-trigger-icon-pause) {
		display: inline;
	}
</style>

<script>
	// Every Lyssna button, delegated once on the document: the buttons come and go with the
	// pages and the listener stays, and on a cold visit they work before the window's load
	// (the router's first page-load waits for every image).
	document.addEventListener("click", (event) => {
		const btn = (event.target as Element | null)?.closest<HTMLButtonElement>(".audio-trigger");
		if (!btn) return;
		document.dispatchEvent(new CustomEvent("floating-player:play", {
			detail: {
				src: btn.dataset.audioSrc,
				title: btn.dataset.audioTitle,
				artwork: btn.dataset.audioArtwork,
			},
		}));
	});
</script>
