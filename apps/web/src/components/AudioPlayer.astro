---
import { Pause, Play } from "@lucide/astro";

interface Props {
	src: string;
	title?: string;
	artwork?: string;
}

const { src, title, artwork } = Astro.props;
---

<button
	class="audio-trigger"
	type="button"
	data-audio-src={src}
	data-audio-title={title}
	data-audio-artwork={artwork}
	aria-label={`Lyssna på ${title || 'essän'}`}
>
	<Play class="audio-trigger-icon-play" size={14} fill="currentColor" stroke-width={0} />
	<Pause class="audio-trigger-icon-pause" size={14} fill="currentColor" stroke-width={0} style="display:none" />
	Lyssna
</button>

<style>
	.audio-trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		padding: 0.4rem 0.875rem;
		border: 1px solid var(--color-divider);
		border-radius: 1.25rem;
		background: transparent;
		color: var(--color-accent);
		cursor: pointer;
		font-family: var(--font-heading);
		font-size: var(--step--3);
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		font-feature-settings: "case";
		transition: border-color 0.15s;
		margin-bottom: var(--space-unit);
	}

	.audio-trigger:hover {
		border-color: var(--color-accent);
	}

	.audio-trigger[data-playing] {
		border-color: var(--color-accent);
	}

	.audio-trigger[data-playing] .audio-trigger-icon-play {
		display: none;
	}

	.audio-trigger[data-playing] .audio-trigger-icon-pause {
		display: inline;
	}
</style>

<script>
	document.addEventListener("astro:page-load", () => {
		for (const btn of document.querySelectorAll<HTMLButtonElement>(".audio-trigger")) {
			btn.addEventListener("click", () => {
				document.dispatchEvent(new CustomEvent("floating-player:play", {
					detail: {
						src: btn.dataset.audioSrc,
						title: btn.dataset.audioTitle,
						artwork: btn.dataset.audioArtwork,
					}
				}));
			});
		}
	});
</script>
