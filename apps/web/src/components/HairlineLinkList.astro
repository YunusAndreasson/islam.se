---
import type { HTMLAttributes } from "astro/types";

type HairlineLinkItem = {
	label: string;
	href: string;
};

type Props = HTMLAttributes<"ul"> & {
	items: readonly HairlineLinkItem[];
};

const { class: className, items, ...attrs } = Astro.props;
---

<ul {...attrs} class:list={["hairline-link-list", className]}>
	{items.map((item) => (
		<li><a href={item.href}>{item.label}</a></li>
	))}
</ul>
