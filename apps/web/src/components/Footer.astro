---
import { gregorianToHijri, stockholmNoon } from "../lib/markesdagar";
import { currentNavHref, FOOTER_GROUPS, FOOTER_LINKS } from "../lib/navigation";
import MarkDot from "./MarkDot.astro";

interface Props {
	/** Section to mark current when the URL alone cannot express it — an essay lives at
	 *  the root, so only this tells the footer it belongs under Essäer. */
	activeHref?: string;
}

const { activeHref } = Astro.props;
const year = new Date().getFullYear();
const path = Astro.url.pathname;
const currentHref = currentNavHref(path, FOOTER_LINKS.map((link) => link.href), activeHref);
const here = (href: string) => href === currentHref;

// A colophon date, not a feature version — the site has no release train, so a semver
// triplet would just be three arbitrary-looking digits. The Hijri build date reads the
// same shape (X.Y.Z) but every digit means something: which Hijri year, month and day
// this was deployed. Zero-padded so the stamp holds a fixed width across every build —
// "1447.02.06", never a jittery "1447.2.6". Anchored to noon of the Swedish day, since
// gregorianToHijri reads its instant in UTC and a build between 00:00 and 02:00 Swedish
// time would otherwise stamp the day before.
const buildHijri = gregorianToHijri(stockholmNoon(new Date()));
const pad2 = (n: number) => String(n).padStart(2, "0");
const buildStamp = `${buildHijri.y}.${pad2(buildHijri.m)}.${pad2(buildHijri.d)}`;
---

<footer class="site-footer">
	<nav class="site-footer-nav" aria-label="Sidfotsnavigering">
		{FOOTER_GROUPS.map((group) => (
			<section class="footer-group">
				<h2 class="label">{group.heading}</h2>
				<ul>{group.links.map((l) => <li><a href={l.href} aria-current={here(l.href) ? "page" : undefined}>{l.label}</a></li>)}</ul>
			</section>
		))}
	</nav>

	<div class="site-footer-colophon">
		<p class="label site-footer-meta">
			<span class="site-footer-place">Sverige, {year}</span>
			<span class="nav-dot site-footer-place-dot" aria-hidden="true">&middot;</span>
			<a href="https://islam.se">islam.se</a>
			<span class="nav-dot" aria-hidden="true">&middot;</span>
			<a href="mailto:support@islam.se">support@islam.se</a>
			<span class="nav-dot" aria-hidden="true">&middot;</span>
			<a href="/rss.xml">RSS</a>
		</p>
	</div>

	{/* The page closes on the mark itself — the full stop of islam.se, set alone so the
	    footer tapers from the link row to a single point. Decorative: the colophon above
	    already links home, and a second link here would only split the target. */}
	<MarkDot class="site-footer-mark" />

	{/* A colophon date beneath the printer's device, not a UI element — deliberately
	    quieter than the meta line above it. It says WHICH date it is: bare, »1448.04.13«
	    read as today's date, and sat a day or more behind the front page's horizon,
	    which shows the real one — two islamic dates on one page, disagreeing. */}
	<p class="site-footer-build" title={`Uppdaterad ${buildStamp} i den islamiska kalendern`}>
		uppdaterad {buildStamp}
	</p>
</footer>
