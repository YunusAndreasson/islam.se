---
/**
 * The one door out of the prayer-times surface and into the site's actual
 * subject matter.
 *
 * /bonetider/ is by far the largest thing islam.se publishes — the hub, the
 * method page and 2 118 locality pages — and it carries the highest-intent
 * traffic on the site: someone searching "bönetider malmö" is looking for a
 * prayer time, which means they are already interested in the prayer. Until now
 * every exit from those pages led to more prayer times (nearby localities, the
 * method page, the full index) and nothing in the editorial corpus linked in
 * either. A reader could use the site for years and never learn it explains
 * anything.
 *
 * Deliberately three links and no prose. This sits on a utility page whose job
 * is a table of times; an invitation is welcome, a pitch is not.
 *
 * Slugs are real and load-bearing — there is no `vad-ar-bonen` page. The prayer
 * answer is `sa-ber-man-steg-for-steg` ("Hur ber man i islam? Bönen steg för
 * steg"). If one of these is ever renamed, the redirect map in astro.config.ts
 * is the place that keeps this honest.
 */

import HairlineLinkList from "../HairlineLinkList.astro";
import TitledSection from "../TitledSection.astro";

const prayerLinks = [
	{ label: "Så ber man steg för steg", href: "/svar/sa-ber-man-steg-for-steg/" },
	{ label: "Islams fem pelare", href: "/svar/islams-fem-pelare/" },
	{ label: "Vad är islam?", href: "/vad-ar-islam/" },
];
---

<TitledSection class="om-bonen" id="om-bonen-head" title="Om bönen">
	<HairlineLinkList
		class="om-bonen-links"
		style="--hairline-link-list-margin: var(--space-half) 0 0"
		items={prayerLinks}
	/>
</TitledSection>
