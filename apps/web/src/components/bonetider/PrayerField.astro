---
import {
	computePrayerTimes,
	dateForStockholmDay,
	stockholmDateParts,
	formatTime,
	nextPrayerKeyAt,
	PRAYER_LABELS,
	PRAYER_ORDER,
	PRAYER_SWEDISH_NAMES,
} from "../../lib/bonetider/prayer-times";
import { DEFAULT_SETTINGS } from "../../lib/bonetider/settings";
import { PRAYER_COLORS } from "../../lib/bonetider/solar/palette";

interface Props {
	location: { name: string; latitude: number; longitude: number };
	variant?: "home" | "full";
	/** City pages pin the location; home/hub may be overridden by the visitor's choice. */
	fixed?: boolean;
	/** Names the place and day the times belong to. The hub needs it — its H1 is national
	 *  but the times below it are one town's, which is unreadable in HTML without this. */
	caption?: boolean;
	/** Prioritize the schedule over the explanatory map on the national hub. */
	scheduleFirst?: boolean;
	/** City pages lead with the map: it is the page's whole argument — these times come
	 *  from the sun's real position over this spot, not from a table — and the app's
	 *  signature screen. The stage is rendered AFTER the list so the six times stay
	 *  first in the source on the template that carries the site's search traffic;
	 *  grid-template-areas paints it above them. */
	mapFirst?: boolean;
}

const { location, variant = "home", fixed = false, caption = false, scheduleFirst = false, mapFirst = false } = Astro.props;

// Build-time "today" with default settings — the no-JS / no-flash baseline. The client
// recomputes live against the real now and the visitor's saved settings.
const now = new Date();
const todayIso = now.toLocaleDateString("sv-SE", { timeZone: "Europe/Stockholm" });
const todayLabel = new Intl.DateTimeFormat("sv-SE", {
	timeZone: "Europe/Stockholm",
	weekday: "long",
	day: "numeric",
	month: "long",
}).format(now);
const times = computePrayerTimes(location, now, DEFAULT_SETTINGS);
const rows = PRAYER_ORDER.map((key) => ({
	key,
	label: PRAYER_LABELS[key],
	sv: PRAYER_SWEDISH_NAMES[key],
	time: formatTime(times[key]),
	// Same source as the canvas isolines and the year chart's strokes, themed by
	// light-dark() rather than duplicated per scheme.
	line: `light-dark(${PRAYER_COLORS[key].light}, ${PRAYER_COLORS[key].dark})`,
}));
const todayNext = nextPrayerKeyAt(times, now.getTime());
const nextKey = todayNext ?? "fajr";
const { year, month, day } = stockholmDateParts(now);
const nextTime = todayNext ? times[todayNext] : computePrayerTimes(location, dateForStockholmDay(year, month, day + 1), DEFAULT_SETTINGS).fajr;
---

<div
	class="bonetider-field"
	class:list={[`bf-${variant}`, { "bf-schedule-first": scheduleFirst, "bf-map-first": mapFirst }]}
	data-name={location.name}
	data-lat={location.latitude}
	data-lon={location.longitude}
	data-variant={variant}
	data-fixed={fixed ? "1" : "0"}
>
	{!mapFirst && <div class="bf-stage">
		<canvas class="bf-canvas" aria-hidden="true"></canvas>
		{variant === "home" && (
			<div class="bf-overlay">
				<p class="bf-next">
					<span class="bf-next-prayer">
						<span class="bf-next-name">{PRAYER_LABELS[nextKey]}</span>
						<span class="bf-next-sub">{PRAYER_SWEDISH_NAMES[nextKey]}</span>
					</span>
					<span class="bf-countdown">{formatTime(times[nextKey])}</span>
				</p>
				<p class="bf-place">{location.name}</p>
			</div>
		)}
	</div>}

	{
		caption && (
			<p class="bf-caption">
				Visar <span class="bf-place">{location.name}</span> ·{" "}
				<time class="bf-caption-date" datetime={todayIso}>
					{todayLabel}
				</time>
			</p>
		)
	}

	<ul class="bf-times" aria-label={`Bönetider för ${location.name} i dag`}>
		{rows.map((r) => (
			<li
				class="bf-t"
				id={variant === "full" ? `bt-${r.key}` : undefined}
				data-prayer={r.key}
				class:list={{ "is-next": r.key === nextKey }}
				style={`--prayer-line: ${r.line}`}
			>
				<span class="bf-t-name">{r.label}{scheduleFirst && <span class="bf-next-label">Nästa bön</span>}</span>
				<span class="bf-t-sv">{r.sv}</span>
				<span class="bf-t-time">{r.time}</span>
			</li>
		))}
	</ul>

	{/* The map-first stage. Rendered here, last, so the times precede it in the source;
	    .bf-map-first paints it above them. The dock carries the one fact the list cannot
	    show — how long is left — which is why it repeats the next prayer at all. */}
	{mapFirst && (
		<div class="bf-stage">
			<canvas class="bf-canvas" aria-hidden="true"></canvas>
			<div class="bf-overlay">
				<p class="bf-next">
					<span class="bf-next-prayer">
						<span class="bf-next-lead">Nästa bön</span>
						<span class="bf-next-name">{PRAYER_LABELS[nextKey]}</span>
						<span class="bf-next-sub">{PRAYER_SWEDISH_NAMES[nextKey]}</span>
					</span>
					<span class="bf-next-when">
						<span class="bf-next-time">{formatTime(nextTime)}</span>
						<span class="bf-countdown"></span>
					</span>
				</p>
			</div>
		</div>
	)}
	{mapFirst && (
		<p class="bf-legend"><slot name="legend" /></p>
	)}
</div>

<style>
	/* The field: a living map of Sweden (the sun-driven CANVAS) beside today's schedule
	   (editorial CHROME). Two columns on wide viewports, stacked on narrow — same
	   canvas/chrome split as the app. */
	.bonetider-field {
		display: grid;
		gap: clamp(1.25rem, 4vw, 2.5rem);
		grid-template-columns: 1fr;
	}

	.bf-home {
		--bf-stage-w: 19rem;
	}
	.bf-full {
		--bf-stage-w: 24rem;
	}

	@media (width >= 640px) {
		.bonetider-field {
			grid-template-columns: minmax(0, var(--bf-stage-w)) 1fr;
			align-items: center;
		}

		/* Side by side, the map and the schedule are one object, so they should share a
		   baseline top and bottom. Centring left a ragged gap under whichever column was
		   shorter. The 4/5 ratio was only ever there to give the stage a shape before
		   anything measured it; with the dock gone the list can set the height and the
		   map fills it. Stacked (< 640px) the ratio still rules — there is nothing
		   beside it to match. */
		.bf-full {
			align-items: stretch;
		}

		.bf-full .bf-stage {
			aspect-ratio: auto;
			height: 100%;
		}
	}

	/* The map stage. Pre-JS it's a calm sea rectangle; the canvas paints the silhouette,
	   twilight wash and sweeping prayer lines over it once mounted. */
	/* Shared so the stage radius and the overlay's concentric inner radius cannot drift
	   apart — change the radius here and the corner geometry stays correct. */
	.bonetider-field {
		--bf-radius: 14px;
		--bf-inset: 0.55rem;
	}

	.bf-stage {
		position: relative;
		aspect-ratio: 4 / 5;
		border-radius: var(--bf-radius);
		overflow: hidden;
		/* The sea, before the canvas mounts. Must equal SEA in lib/bonetider/render-field.ts,
		   which is where the reasoning for this value lives — otherwise the stage visibly
		   changes colour the moment the renderer takes over. */
		background: light-dark(#c9cdca, #15171a);
		border: 1px solid var(--color-divider);
		box-shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 12px 28px -16px rgb(0 0 0 / 0.25);
	}

	.bf-canvas {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
	}

	/* Floating glass readout — the app's PrayerDock, distilled. Mostly opaque so its
	   rounded corners stay crisp over the colour-shifting wash. */
	.bf-overlay {
		position: absolute;
		left: var(--bf-inset);
		right: var(--bf-inset);
		bottom: var(--bf-inset);
		padding: 0.5rem 0.7rem;
		/* ⚠️ Concentric, not eyeballed: an inner radius must be the outer radius MINUS
		   the inset, or the two curves stop running parallel and the corner reads as a
		   mistake. This was 0.7rem (11.2px) against a 14px stage inset by 8.8px, where
		   the geometry asks for 5.2px — more than double, and it was the reason the
		   panel looked stuck on rather than set in. */
		border-radius: calc(var(--bf-radius) - var(--bf-inset));
		/* The page's own warm ground, not near-white: at 0.88 over the night sea the
		   old #fffdf8 picked up enough blue showthrough to read as a cold grey slab on
		   a warm page. Plus a hairline — a translucent panel over a busy image needs a
		   defined edge, which a downward drop shadow alone does not give it. */
		background: light-dark(rgb(255 246 232 / 0.9), rgb(29 25 18 / 0.86));
		border: 1px solid light-dark(rgb(26 23 18 / 0.1), rgb(232 229 224 / 0.14));
		backdrop-filter: blur(8px);
		box-shadow: 0 2px 12px -6px rgb(0 0 0 / 0.35);
	}

	/* The map now letters the marker with the town's name and the section heading
	   carries it too, so the dock repeating it made three "Stockholm" inside 300 px.
	   The home variant keeps it — there the marker is not lettered.
	   Scoped to the overlay: .bf-caption reuses .bf-place so the existing readout code
	   renames it, and that one must stay visible. */
	.bf-full .bf-overlay .bf-place {
		display: none;
	}

	/* Which town and which day the times belong to. The hub's H1 is national, so without
	   this the six times underneath belong to nobody. */
	.bf-caption {
		grid-column: 1 / -1;
		order: -1;
		margin: 0;
		font-family: var(--font-body);
		font-size: var(--step--2);
		color: var(--color-muted);
	}

	.bf-caption .bf-place {
		color: var(--color-text);
	}

	.bf-next {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.5rem;
		margin: 0;
	}

	/* Arabic name on top, the (sometimes long) Swedish gloss stacked beneath it, so a
	   wide name like "Solnedgångsbönen" gets the group's full width instead of being
	   clipped to "Solnedgång…" beside the countdown in the narrow home dock. */
	.bf-next-prayer {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.bf-next-name {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: var(--step--2);
		color: var(--color-text);
	}

	.bf-next-sub {
		font-family: var(--font-body);
		font-size: var(--step--4);
		color: var(--color-muted);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.bf-countdown {
		font-family: var(--font-body);
		font-variant-numeric: lining-nums tabular-nums;
		font-size: var(--step--2);
		color: var(--color-accent);
		white-space: nowrap;
	}

	.bf-place {
		margin: 0.1rem 0 0;
		font-family: var(--font-body);
		font-size: var(--step--4);
		color: var(--color-muted);
	}

	/* Today's schedule. */
	.bf-times {
		margin: 0;
		padding: 0;
	}

	.bf-t {
		display: grid;
		grid-template-columns: 1fr auto;
		grid-template-areas: "name time" "sv time";
		column-gap: 1rem;
		align-items: baseline;
		padding: 0.5rem 0.2rem 0.5rem 0.7rem;
		border-bottom: 1px solid var(--color-divider);
		/* --prayer-line is set per row from the canvas palette, so a row's rule is the
		   same colour as that prayer's isoline on the map beside it. */
		border-left: 3px solid var(--prayer-line, transparent);
	}

	.bf-t-name {
		grid-area: name;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: var(--step--1);
		color: var(--color-text);
	}

	.bf-t-sv {
		grid-area: sv;
		font-family: var(--font-body);
		font-size: var(--step--4);
		color: var(--color-muted);
	}

	.bf-t-time {
		grid-area: time;
		align-self: center;
		font-family: var(--font-body);
		font-variant-numeric: lining-nums tabular-nums;
		font-size: var(--step--1);
		color: var(--color-text);
	}

	/* The upcoming prayer. The rule keeps its own hue at every hour, so the emphasis is a
	   tint of that same hue — the chrome's answer to the wider glow the canvas gives the
	   next prayer's line. Not the border width: that would shift the row 1 px as the next
	   prayer advances. */
	.bf-t.is-next {
		background: color-mix(in oklab, var(--prayer-line) 8%, transparent);
	}

	.bf-t.is-next .bf-t-name,
	.bf-t.is-next .bf-t-time {
		color: var(--color-accent);
	}

	/* On the hub, the answer comes before the map in both desktop and phone layouts. */
	.bf-schedule-first {
		grid-template-areas: "caption" "times" "map";
		gap: 1rem;
	}
	.bf-schedule-first .bf-caption { grid-area: caption; margin: 0; }
	.bf-schedule-first .bf-caption .bf-place { font-size: var(--step-1); font-weight: 600; color: var(--color-text); }
	.bf-schedule-first .bf-times { grid-area: times; }
	.bf-schedule-first .bf-stage { grid-area: map; aspect-ratio: 4 / 3; }
	.bf-schedule-first .bf-t-time { font-family: var(--font-heading); font-size: var(--step-1); font-weight: 600; }
	.bf-next-label { display: none; margin-inline-start: 0.7rem; font-size: var(--step--4); font-weight: 400; }
	.is-next-today .bf-next-label { display: inline; }
	@media (width >= 640px) {
		.bf-schedule-first {
			grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
			grid-template-areas: "caption caption" "times map";
			column-gap: clamp(1.5rem, 4vw, 3rem);
		}
		.bf-schedule-first .bf-stage { aspect-ratio: auto; }
	}

	/* City pages lead with the map — it is the page's argument and the app's signature
	   screen, and it was previously a 342x256 diagram at position 6 of 12. Areas, not
	   source order: the six times are written before the stage so the answer stays first
	   in the document on the template that carries ~86% of the site's search clicks.
	   Only the paint order changes. */
	.bf-map-first {
		grid-template-areas: "map" "legend" "times";
		gap: 0.9rem;
	}
	.bf-map-first .bf-stage { grid-area: map; aspect-ratio: 4 / 3; }
	.bf-map-first .bf-legend { grid-area: legend; margin: 0; font-size: var(--step--3); line-height: 1.5; color: var(--color-muted); text-wrap: pretty; }
	.bf-map-first .bf-legend:empty { display: none; }
	.bf-map-first .bf-times { grid-area: times; }
	/* Match the hub: the time is apparatus, so it takes the sans face at a step up. */
	.bf-map-first .bf-t-time { font-family: var(--font-heading); font-size: var(--step-1); font-weight: 600; }

	/* The dock. The list below already names the next prayer and highlights its row, so
	   the dock exists for the countdown — the one fact the list cannot carry. */
	.bf-next-lead { font-family: var(--font-heading); font-size: var(--step--3); color: var(--color-muted); }
	.bf-next-when { display: flex; flex-direction: column; align-items: flex-end; gap: 0.05rem; }
	.bf-map-first .bf-next-time {
		font-family: var(--font-heading);
		font-size: var(--step-1);
		font-weight: 600;
		font-variant-numeric: tabular-nums lining-nums;
		color: var(--color-text);
		line-height: 1.1;
	}
	.bf-map-first .bf-countdown { font-size: var(--step--3); color: var(--color-muted); }

	/* The dock hugs the bottom LEFT and stops short of half the frame. Full width, it
	   sat over southern Sweden and hid Goteborg and Malmo behind the readout — on the
	   two pages most likely to be read. Open sea and Norway are what it covers here. */
	.bf-map-first .bf-overlay {
		right: auto;
		max-width: min(62%, 16rem);
	}
	.bf-map-first .bf-next { flex-direction: column; align-items: stretch; gap: 0.15rem; }
	.bf-map-first .bf-next-when { flex-direction: row; align-items: baseline; justify-content: space-between; gap: 0.6rem; }

	@media (width >= 640px) {
		.bf-map-first {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
			grid-template-areas: "map times" "legend times";
			align-items: start;
			column-gap: clamp(1.5rem, 4vw, 3rem);
		}
	}


	@media (prefers-reduced-motion: reduce) {
		.bf-canvas {
			/* The wash/lines still render; only the per-minute repaint is imperceptible. */
		}
	}
</style>

<script>
	import "../../scripts/bonetider-field";
</script>
