---
// The moskéskärm: today's prayer times for one mosque, on a 16:9 wall.
//
// THE COMPOSITION. Six prayers stand as one vertical rank, and the prayer that is next
// is set about two and a half times larger IN PLACE, carrying its iqāma and its
// countdown. Over the day the large row travels down the list and wraps back to Fajr.
// Nothing is stated twice — there is no separate "next prayer" card repeating a row
// below it — and the size difference is what lets the same screen be read at eight
// metres while walking past and at three metres while waiting for the iqāma.
//
// Every other prayer-times display on the market renders six identical rounded cards.
// This one has no cards, no boxes and no shadows: the rank is bare rows separated by
// air, per DESIGN.md Principle 5, with no rules between them at all.
//
// THE MAP IS NOT DECORATION. Each row carries a left rule in that prayer's own colour
// from solar/palette.ts — the exact stroke colour of its line on the canvas beside it.
// So the eye links the swelling ʿAṣr row to the amber line sweeping across Sweden: the
// map is the same data in another projection, keyed by colour. PrayerField.astro
// already establishes this idiom for the small card.
//
// WHY THE MAP IS A TALL PANEL and not a full-bleed background or a bottom band:
// neighbors-outline.ts is clipped to VIEW_BBOX [-8, 50, 30, 72], whose Mercator aspect
// is about 0.68 — taller than wide. A wide band would either crop Sweden to a sliver or
// float it in empty sea. The geometry is also the better design: a tall frame shows the
// north–south extent that makes Swedish prayer times interesting at all, and the prayer
// lines run roughly north–south, so a tall frame shows a line's whole length.
//
// SIZING IS IN CONTAINER-QUERY UNITS, not vh. That is what lets this exact component
// render as a live miniature inside the setup page — the mosque sees what the wall will
// show while it configures, which is the most useful thing the builder can do.
import JsonScript from "../JsonScript.astro";
import qrcode from "qrcode-generator";
import { PRAYER_LABELS, PRAYER_ORDER, PRAYER_SWEDISH_NAMES } from "../../lib/bonetider/prayer-times";
import { PRAYER_COLORS } from "../../lib/bonetider/solar/palette";
import { getMosques } from "../../lib/moskeer";
import { SITE_URL } from "../../lib/config";

interface Props {
	/** The preview inside the builder is not the wall, and must not grab the wake lock,
	 *  hide the cursor or schedule a reload. */
	preview?: boolean;
}

const { preview = false } = Astro.props;

// The one code on the screen that a phone can actually scan. A television has no
// camera, so a QR is worthless for getting a URL ONTO the wall — but a foyer full of
// people waiting for the iqāma is the best place on the internet to hand a Swedish
// muslim a prayer-times app. It points at /app, which sends iOS and Android on to their
// own stores, so one code serves both.
//
// Baked at build time into a single <path>: the URL never changes, and a wall display
// that has been up for three weeks must not need a library, a canvas or a network to
// draw it.
const APP_URL = `${SITE_URL}/app`;
const qr = qrcode(0, "M");
qr.addData(APP_URL);
qr.make();
const qrCount = qr.getModuleCount();
let qrPath = "";
for (let r = 0; r < qrCount; r++)
	for (let c = 0; c < qrCount; c++) if (qr.isDark(r, c)) qrPath += `M${c} ${r}h1v1h-1z`;

// Shurūq is in PRAYER_ORDER and takes a row — it is when Fajr ends, which a mosque
// wants on the wall — but it is not prayed in congregation, so it never gets an iqāma.
const rows = PRAYER_ORDER.map((key) => ({
	key,
	label: PRAYER_LABELS[key],
	sv: PRAYER_SWEDISH_NAMES[key],
	line: `light-dark(${PRAYER_COLORS[key].light}, ${PRAYER_COLORS[key].dark})`,
}));

// Every mosque in the directory — the /moskeer map's own list — as [lon, lat], for the
// canvas to light. Three decimals is about 100 m, finer than a light a few pixels across
// can show, and it keeps all of them to a few kilobytes inlined: the wall still fetches
// nothing it needs in order to draw.
const lights = getMosques().map((m) => [Number(m.lng.toFixed(3)), Number(m.lat.toFixed(3))]);
---

<div class="ms" class:list={{ "ms-preview": preview }} data-ready="0" data-preview={preview ? "1" : "0"}>
	<JsonScript class="ms-lights" data={lights} />
	<header class="ms-id">
		<p class="ms-mosque"></p>
		<p class="ms-place"></p>
	</header>

	<div class="ms-when">
		<p class="ms-dates">
			<time class="ms-date"></time>
			<span class="ms-hijri"></span>
		</p>
		<time class="ms-clock"
			><span class="ms-clock-h"></span><span class="ms-clock-colon">:</span><span class="ms-clock-m"
			></span></time
		>
	</div>

	{/* Each row is two stacks, not one shared grid. With the five parts on common grid rows
	    the Swedish name took its height from the large time beside it and sat 46 px under
	    »Fajr«, further from its own name than the next row was. Each stack now holds
	    together — what the prayer is called, and when — and the pair meets on the first
	    baseline. */}
	<ol class="ms-rank">
		{
			rows.map((r) => (
				<li
					class="ms-row"
					data-prayer={r.key}
					style={`--prayer-line: ${r.line}; view-transition-name: ms-row-${r.key}`}
				>
					<span class="ms-what">
						<span class="ms-name">{r.label}</span>
						<span class="ms-sv">{r.sv}</span>
					</span>
					<span class="ms-at">
						<span class="ms-adhan"></span>
						<span class="ms-iqama"></span>
						<span class="ms-count"></span>
					</span>
				</li>
			))
		}
	</ol>

	<div class="ms-stage">
		<canvas class="ms-canvas" aria-hidden="true"></canvas>
	</div>
	{/* The type pane: the map runs underneath it and shows through a little. The engine
	    measures its right edge to frame the map in what the pane leaves open. */}
	<div class="ms-pane" aria-hidden="true"></div>

	{/* The base of the left column: the mosque's own notice, then the way to take the
	    times home. Both used to sit under their own column; with the map running to the
	    edges there is no longer a foot under it, and the offer belongs with the type. */}
	<div class="ms-base">
		<p class="ms-notice"></p>

		{/* The foot: the way to take the times home, and the one place the site names
		    itself. A wall display is seen by people who have never heard of islam.se, and
		    the mark is how they find it — but both stay the quietest things on the screen,
		    because the times are why anyone looks. */}
		<div class="ms-foot">
			<div class="ms-app">
				{/* Dark modules on a light tile, even on the dark ground. An inverted code
				    would be prettier against the near-black, and some scanners refuse one —
				    ʿIshāʾ is exactly when the foyer is full, so this one is not worth the
				    elegance. */}
				<svg class="ms-qr" viewBox={`-2 -2 ${qrCount + 4} ${qrCount + 4}`} aria-hidden="true">
					<rect x="-2" y="-2" width={qrCount + 4} height={qrCount + 4} rx="2" fill="#f4f1e8"></rect>
					<path d={qrPath} fill="#1a1914"></path>
				</svg>
				<span class="ms-app-text">
					<span class="ms-app-label">Bönetider i mobilen</span>
					<span class="ms-mark" aria-label="islam.se">
						islam<svg class="ms-dot" viewBox="0 0 20 20" aria-hidden="true">
							<circle cx="10" cy="10" r="9" fill="var(--mark-blue)"></circle>
							<circle cx="10" cy="10" r="6.364" fill="var(--mark-gold)"></circle>
						</svg>se
					</span>
				</span>
			</div>
		</div>
	</div>

	{/* Never a blank wall: a mangled URL says so, in Swedish, with the way back. */}
	<p class="ms-issue" hidden></p>
</div>

<style>
	/* The screen is always dark. The ground used to follow the sun over the mosque —
	   parchment from sunrise, near-black from maghrib, a ninety-second cross-fade between
	   them — and a wall that looked different depending on when you walked past read as
	   random, not as sunset. Dark is also the panel that glares least in a dim hall at
	   Fajr and ʿIshāʾ.

	   Registered, so the values reach every element on the page and not only .ms: the
	   body, the fullscreen frame and the fullscreen button all sit outside it. While the
	   engine set these on .ms, the body stayed parchment, and the burn-in orbit uncovered
	   a bright strip of it along the type column — on a different edge every minute.

	   Values are the mobile app's dark palette (apps/mobile/src/theme/tokens.ts): paper,
	   ink, inkMuted and the brass highlight. The map beside the rank is the app's navy
	   basemap, and a warm near-black column next to it read as two products on one wall.
	   Literals, because a registered property needs a real initial value, not a reference. */
	@property --screen-bg {
		syntax: "<color>";
		inherits: true;
		initial-value: #161a26;
	}
	@property --screen-ink {
		syntax: "<color>";
		inherits: true;
		initial-value: #e8e3d8;
	}
	@property --screen-muted {
		syntax: "<color>";
		inherits: true;
		initial-value: #c1c6d4;
	}
	@property --screen-brass {
		syntax: "<color>";
		inherits: true;
		initial-value: #c89a48;
	}

	.ms {
		container-type: size;
		position: relative;
		display: grid;
		/* Type in a measured column, the map as the whole other half of the wall. The map
		   was a capped 44cqw panel for one reason — the coarse outlines ended past that
		   width, so Finland stopped in a straight cut — and it left a ~340 px dead gutter
		   in the middle of the screen. The wall now loads its own wide coastline
		   (map-detail.ts, clipped to lon −26…46), so the stage takes every
		   remaining pixel and runs to the edges (see .ms-stage). */
		grid-template-columns: minmax(0, 30cqw) minmax(0, 1fr);
		grid-template-rows: auto auto minmax(0, 1fr) auto;
		grid-template-areas:
			"id    stage"
			"when  stage"
			"rank  stage"
			"base  stage";
		column-gap: 5cqw;
		row-gap: 0;
		width: 100%;
		height: 100%;
		padding: 4cqh 4cqw;
		background: var(--screen-bg);
		color: var(--screen-ink);
		font-family: var(--font-body);
	}

	/* A wall display shows the same layout for months. Stepping the whole composition
	   through a few integer pixels once a minute is a compositor transform — the canvas
	   never re-renders — and it is what stops an OLED panel retaining the rank. */
	.ms {
		transform: translate(var(--ms-shift-x, 0px), var(--ms-shift-y, 0px));
		transition: transform 2s ease-in-out;
	}

	/* One clean paint. The config lives in the URL hash, so the server cannot know which
	   mosque this is; showing placeholder times for the wrong town for a frame would be
	   worse than showing nothing for one. */
	.ms[data-ready="0"] :is(.ms-id, .ms-when, .ms-rank, .ms-notice) {
		visibility: hidden;
	}

	/* --- the type scale ------------------------------------------------------ */

	/* Six sizes, each 1.25 times the one below, from 2cqh. The wall had fifteen — 9.2,
	   6.4, 5.2, 4.4, 4.0, 3.9, 3.8, 3.4, 2.6, 2.5, 2.4, 2.3, 2.2, 2.1 and 1.9 — so sizes
	   0.1cqh apart did different jobs and no size could be read as a rank. DESIGN.md's
	   rule for the site, every size on one scale, holds here as well; the wall has its own
	   scale only because it sizes by the screen rather than by the rem.

	   Steps 2 (3.13) and 6 (7.63) are skipped on purpose. A missing step either side of
	   the rows is what puts visible distance between reading the list and reading the hero.

	   Roughly, on a 55-inch panel, taking a legible cap height as a two-hundredth of the
	   distance: display reads at about 8 m, lead 5 m, title 4 m, row 3 m, meta 2 m, and
	   micro is for whoever is standing at the QR code.

	   Literals rather than pow(): the browsers inside signage sticks and older televisions
	   run years behind. */
	.ms {
		--ms-micro: 2cqh;
		--ms-meta: 2.5cqh;
		--ms-row: 3.9cqh;
		--ms-title: 4.88cqh;
		--ms-lead: 6.1cqh;
		--ms-display: 9.54cqh;
	}

	/* --- identity ------------------------------------------------------------ */

	.ms-id {
		grid-area: id;
	}

	/* A full step under the hero's name, not beside it. At 5.2cqh the mosque's name was
	   within 1.23x of »Fajr« and competed with it for the first look. The name is there
	   for the visitor who does not know the building; the regulars came for the time. */
	.ms-mosque {
		margin: 0;
		font-size: var(--ms-title);
		font-weight: 600;
		line-height: 1.05;
		letter-spacing: var(--tracking-display);
		text-wrap: balance;
	}

	/* A long name — "Islamiska Kulturföreningen i Kiruna" — wrapped to three lines at the
	   title size and pushed the rank into the base row. One step down, to the rows' size,
	   keeps it to two. The engine sets data-long from the name's length. */
	.ms-mosque[data-long="1"] {
		font-size: var(--ms-row);
	}

	.ms-place {
		margin: 0.6cqh 0 0;
		font-family: var(--font-heading);
		font-size: var(--ms-meta);
		font-weight: 400;
		line-height: 1.25;
		color: var(--screen-muted);
	}

	/* The header's structure is carried by distance alone. Inside a group — name and
	   place, date and Hijri date — lines sit 0.6cqh apart or touch; between the two groups
	   2.4cqh; before the times 3.6cqh. Each gap is wider than the gaps it contains, so the
	   eye reads three blocks without a rule anywhere. */
	.ms-when {
		grid-area: when;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2cqw;
		margin: 2.4cqh 0 0;
		/* No rule under the date. A hairline here read as a stray line above Fajr: the
		   rows already carry their own coloured edge, and the gap alone separates the
		   mosque and its date from the times. */
		padding-bottom: 3.6cqh;
		font-family: var(--font-heading);
		font-size: var(--ms-meta);
		font-variant-numeric: lining-nums tabular-nums;
	}

	.ms-dates {
		display: flex;
		flex-direction: column;
		margin: 0;
		line-height: 1.25;
	}

	.ms-hijri {
		color: var(--screen-muted);
	}

	/* Now. Right-aligned, so it heads the column of times it is read against, and set in
	   the label face rather than Literata, so it never reads as one more prayer time. At
	   the rows' size, no larger: it is what the times are read against, and at 4.4cqh bold
	   it was the second thing on the wall anyone saw, ahead of every prayer but one. */
	.ms-clock {
		font-size: var(--ms-row);
		font-weight: 600;
		line-height: 1;
		letter-spacing: -0.01em;
	}

	/* The screen's pulse: the colon dims and returns, a second each way, so anyone can see
	   the wall is live — and a wall that has frozen shows it at once, not a minute later.
	   The engine sets data-beat from its own tick rather than a CSS animation, because an
	   animation would keep beating on a page whose script had died. Dimmed, never gone,
	   so the time never reads as »1510«. */
	.ms-clock-colon {
		transition: opacity 400ms ease;
	}

	.ms-clock[data-beat="1"] .ms-clock-colon {
		opacity: 0.25;
	}

	@media (prefers-reduced-motion: reduce) {
		.ms-clock[data-beat="1"] .ms-clock-colon {
			opacity: 1;
		}
	}

	/* --- the rank of six ----------------------------------------------------- */

	.ms-rank {
		grid-area: rank;
		display: flex;
		flex-direction: column;
		/* NOT `center`. An overflowing centred column spills equally at BOTH ends, and
		   the rank overflowed by 50 px — which put the Fajr row 25 px above its own box,
		   sitting on the date rule. `space-between` can only ever spill downward, and it
		   distributes the slack as even air between the rows, so the ladder re-spaces
		   itself as the hero travels down it instead of being padded by hand. */
		justify-content: space-between;
		gap: 0;
		/* minmax(0,1fr) above lets the track shrink; this lets the flex column shrink
		   inside it. Without both, six rows — one of them 11.5cqh tall — push the notice
		   and the islam.se mark off the bottom of the wall. */
		min-height: 0;
		margin: 0;
		padding: 0;
	}

	.ms-row {
		--ms-rule: 0.35cqh;
		--ms-rule-gap: 1.4cqw;
		display: grid;
		/* What the prayer is called on the left, when it happens on the right, meeting on
		   the first baseline. The countdown belongs to the time: it once spanned the row
		   flush left and sat stranded under »Middagsbönen« with 300 px of nothing beside it. */
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: baseline;
		column-gap: 2cqw;
		/* The rule hangs in the margin, the way a typesetter hangs punctuation. Inside the
		   row it pushed every prayer name 1.4cqw off the stem that the mosque's name, the
		   date and the QR code share, so the column had two left edges 27 px apart. Hung,
		   the text keeps one edge from the top of the wall to the bottom, and the colours
		   stand beside it as markers. */
		margin-inline-start: calc(-1 * (var(--ms-rule) + var(--ms-rule-gap)));
		padding: 0.4cqh 0 0.4cqh var(--ms-rule-gap);
		/* The row's own prayer colour, the same stroke the canvas draws for it. This is
		   the whole link between the two halves of the screen. */
		border-left: var(--ms-rule) solid var(--prayer-line);
		/* The one reflow on the screen, once per prayer: the rank re-proportions as the
		   emphasis travels down it. It is not decoration — it IS the status change. */
		transition: padding 800ms ease;
	}

	/* Where the browser has view transitions, the hand-off is animated as one (below, and
	   bonetider-skarm.ts morphRank), and a padding transition running inside the live
	   snapshot would animate the same change a second time, out of step with the first. */
	@supports (view-transition-name: none) {
		.ms-row {
			transition: none;
		}
	}

	.ms-what {
		display: block;
		min-width: 0;
	}

	.ms-at {
		display: block;
		text-align: right;
		font-variant-numeric: lining-nums tabular-nums;
	}

	/* Name and time share the rows' size. Which of the pair is the data is said by the
	   right-hand column and the tabular figures, not by a 0.4cqh size difference that no
	   eye could read as a rank. */
	.ms-name {
		display: block;
		font-size: var(--ms-row);
		font-weight: 500;
		line-height: 1.1;
		/* One word, always one line. With the hamza's negative trailing margin, the grid sized
		   the name's column narrower than the word and »ʿIshāʾ« broke onto two lines, which
		   took its row from 81 to 118 px and the rank 31 px past the notice. */
		white-space: nowrap;
	}

	.ms-sv,
	.ms-count {
		display: none;
	}

	.ms-adhan {
		display: block;
		font-size: var(--ms-row);
		font-weight: 500;
		line-height: 1.1;
	}

	/* Brass means the congregation, and nothing else on the wall: this time, the khutba
	   on Fridays, the wait for the iqāma, »pågår« — and on the map, the mosque's own marker
	   and every other mosque in Sweden as a point of light (render-field.ts drawLights).
	   Among the times it is the one thing that is the mosque's decision, not the sun's. */
	.ms-iqama {
		display: block;
		/* Shurūq is never prayed in congregation, so its iqāma is empty — but collapsing the
		   slot made its row 67 px among rows of 105 and broke the one thing the rank needs:
		   an even ladder the eye can run down. The slot is reserved and simply left blank. */
		min-height: 1lh;
		font-family: var(--font-heading);
		/* Up from 2.1cqh, footnote size for the number the room actually gathers by. The
		   line height is set rather than inherited: the body's 1.6 made each of these lines
		   a third taller than its text and ate the air between the rows. */
		font-size: var(--ms-meta);
		line-height: 1.2;
		color: var(--screen-brass);
	}

	/* The next prayer. Everything that makes it the hero happens here, in place. */
	.ms-row[data-next="1"] {
		padding-block: 1.2cqh;
	}

	.ms-row[data-next="1"] .ms-name {
		font-size: var(--ms-lead);
		font-weight: 600;
		line-height: 1;
		letter-spacing: var(--tracking-display);
	}

	.ms-row[data-next="1"] .ms-sv {
		display: block;
		margin-top: 0.8cqh;
		font-family: var(--font-heading);
		font-size: var(--ms-meta);
		line-height: 1.2;
		color: var(--screen-muted);
	}

	.ms-row[data-next="1"] .ms-adhan {
		font-size: var(--ms-display);
		font-weight: 600;
		line-height: 1;
		letter-spacing: -0.02em;
	}

	.ms-row[data-next="1"] .ms-iqama {
		margin-top: 0.4cqh;
		font-size: var(--ms-row);
		line-height: 1.1;
	}

	.ms-row[data-next="1"] .ms-count {
		display: block;
		margin-top: 0.6cqh;
		font-family: var(--font-heading);
		font-size: var(--ms-meta);
		line-height: 1.2;
		color: var(--screen-muted);
	}

	/* Counting to the iqāma, or in the prayer: the brass of the congregation it belongs to.
	   Counting to an adhān it stays muted, which is also what keeps it from reading as a
	   second iqāma under the brass one. */
	.ms-row[data-next="1"] .ms-count[data-phase="iqama"],
	.ms-row[data-next="1"] .ms-count[data-phase="praying"] {
		color: var(--screen-brass);
	}

	/* The hand-off (bonetider-skarm.ts morphRank). Each row carries its own
	   view-transition-name, so every row glides to its new place while the next prayer swells
	   into the large one and the last shrinks back — one movement, where the rank used to
	   jump between two layouts.

	   Only the rows take part. Captured too, the page's root would be cross-faded as a still
	   image, and the map — which may be mid-move at that minute — would freeze for the length
	   of it. With the root out, everything but the six rows keeps drawing live. */
	:global(html:has(.ms)) {
		view-transition-name: none;
	}

	/* The 800 ms the padding transition had, on an ease-out that lands softly: the eye catches
	   this change part-way through, so its end is the part that has to look settled. */
	:global(::view-transition-group(*)) {
		animation-duration: 800ms;
		animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
	}

	/* Each row's old and new picture at its own size, never stretched: the row's box grows or
	   shrinks and reveals or cuts away what it holds. By default both pictures are fitted to
	   the box's width and spill out of it, and mid-way the swelling row's large time and its
	   countdown lay across the row below in two sizes at once. The rank's width never
	   changes, so only the height has to give. */
	:global(::view-transition-image-pair(*)) {
		overflow: clip;
	}

	/* The cross-fade in half the time the rows take to move. For the four rows that only change
	   place, old and new are the same picture and the fade cannot be seen at any speed; for the
	   two that change size, a fade as long as the move left both sizes of the same prayer on the
	   wall at once for most of it. */
	:global(::view-transition-old(*)),
	:global(::view-transition-new(*)) {
		height: 100%;
		object-fit: none;
		object-position: top;
		animation-duration: 400ms;
		animation-timing-function: ease;
	}

	/* --- the map ------------------------------------------------------------- */

	/* Full bleed on the top, right and bottom. The negative margins undo .ms's padding and
	   then overshoot, because the whole composition steps through a ±6 px orbit once a
	   minute against OLED burn-in (kiosk.ts pixelShiftAt); a map that stopped exactly at
	   the edge would open a strip of ground along it on every step.
