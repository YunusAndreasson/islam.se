---
import type { HTMLAttributes } from "astro/types";

type FactRow = {
	term: string;
	html: string;
};

type Props = HTMLAttributes<"dl"> & {
	items: readonly FactRow[];
};

const { class: className, items, ...attrs } = Astro.props;
---

<dl {...attrs} class:list={["ruled-facts", className]}>
	{items.map((item) => (
		<div>
			<dt>{item.term}</dt>
			<dd set:html={item.html} />
		</div>
	))}
</dl>

<style>
	/* A quiet ruled fact table: label left, fact right. */
	.ruled-facts {
		max-inline-size: var(--content-width);
		margin: var(--ruled-facts-margin, var(--space-phi) 0 0);
		padding: 0;
		border-block-start: var(--border-rule);
		font-size: var(--step--2);
	}

	.ruled-facts > div {
		display: grid;
		grid-template-columns: 11rem 1fr;
		gap: 0.5rem 1.5rem;
		padding: 0.65rem 0;
		border-block-end: var(--border-row);
	}

	/* Between rows, not under the last: what follows opens on its own line. */
	.ruled-facts > div:last-child {
		border-block-end: none;
	}

	.ruled-facts dt {
		font-family: var(--font-heading);
		font-size: var(--step--3);
		font-weight: 500;
		color: var(--color-muted);
		padding-block-start: 0.15em;
	}

	.ruled-facts dd {
		margin: 0;
		font-family: var(--font-body);
		color: var(--text-body);
	}

	@media (width <= 30rem) {
		.ruled-facts > div {
			grid-template-columns: 1fr;
			gap: 0.2rem;
		}
	}
</style>
