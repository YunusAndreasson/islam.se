---
import type { HTMLAttributes } from "astro/types";

type FactRow = {
	term: string;
	html: string;
};

type Props = HTMLAttributes<"dl"> & {
	items: readonly FactRow[];
};

const { class: className, items, ...attrs } = Astro.props;
---

<dl {...attrs} class:list={["ruled-facts", className]}>
	{items.map((item) => (
		<div>
			<dt>{item.term}</dt>
			<dd set:html={item.html} />
		</div>
	))}
</dl>

<style>
	/* A quiet ruled fact table: label left, fact right. */
	.ruled-facts {
		max-width: var(--content-width);
		margin: var(--ruled-facts-margin, var(--space-phi) 0 0);
		padding: 0;
		border-top: 1px solid var(--color-rule);
		font-size: var(--step--2);
	}

	.ruled-facts > div {
		display: grid;
		grid-template-columns: 11rem 1fr;
		gap: 0.5rem 1.5rem;
		padding: 0.65rem 0;
		border-bottom: 1px solid var(--color-divider);
	}

	.ruled-facts dt {
		font-family: var(--font-heading);
		font-size: var(--step--3);
		font-weight: 500;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		font-feature-settings: "case";
		color: var(--color-muted);
		padding-top: 0.15em;
	}

	.ruled-facts dd {
		margin: 0;
		font-family: var(--font-body);
		color: var(--text-body);
	}

	.ruled-facts a {
		color: var(--color-accent);
		text-decoration: none;
	}

	.ruled-facts a:hover {
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	@media (width <= 30rem) {
		.ruled-facts > div {
			grid-template-columns: 1fr;
			gap: 0.2rem;
		}
	}
</style>
