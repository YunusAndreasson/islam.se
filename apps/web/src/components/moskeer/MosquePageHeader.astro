---
import Breadcrumb from "../Breadcrumb.astro";
import type { Crumb } from "../../lib/jsonld";

type Props = {
	crumbs: Crumb[];
	title: string;
	meta: string;
	lead: string;
	updatedDate: string;
	updatedLabel: string;
};

const { crumbs, title, meta, lead, updatedDate, updatedLabel } = Astro.props;
---

<header class="mk-page-header">
	<Breadcrumb items={crumbs} />
	<h1>{title}</h1>
	<p class="mk-page-meta">
		{meta} · Senast uppdaterad <time datetime={updatedDate}>{updatedLabel}</time>
	</p>
	<p class="lead lead--page">{lead}</p>
</header>

<style>
	.mk-page-header h1 {
		margin: 0;
	}

	.mk-page-meta {
		font-family: var(--font-body);
		font-size: var(--step--3);
		color: var(--color-muted);
		margin: var(--space-half) 0 0;
		font-variant-numeric: lining-nums tabular-nums;
	}
</style>
