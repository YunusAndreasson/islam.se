---
// One crawlable card per mosque, shared by the county and city pages. Each <li> carries
// the mosque id as its anchor, so a /moskeer/<stad>/#<id> deep link (from the hub map or
// a bönetider page) lands on the right card. On county pages the name links to the city
// page (`cityLink`); on a city page the mosque IS the content, so the name is plain text.
import { type Mosque, directionsLinks, locationLabel, mosqueUrl, swedishAddress } from "../../lib/moskeer";
import { encodeScreenConfig, DEFAULT_SCREEN_CONFIG } from "../../lib/bonetider/screen-config";

/** A screen prefilled with this mosque — its name, its ort and its own coordinates, so
 *  the marker lands on the building rather than the town centre. The mosque still has to
 *  visit /bonetider/skarm/ to set its iqāma times, which is where this link points it
 *  next; what it gets here is the thing working, at once, with its own name on it. */
function screenHref(m: Mosque): string {
	return `/bonetider/skarm/visa/#${encodeScreenConfig({
		...DEFAULT_SCREEN_CONFIG,
		ort: m.citySlug,
		ortName: m.city,
		name: m.name,
		place: locationLabel(m),
		lat: m.lat,
		lon: m.lng,
	})}`;
}

interface Props {
	mosques: readonly Mosque[];
	/** Link each mosque name to its city page anchor (used on county pages). */
	cityLink?: boolean;
}
const { mosques, cityLink = false } = Astro.props;
---

<ul class="mk-list">
	{mosques.map((m) => {
		const dir = directionsLinks(m);
		return (
			<li class="mk-list-item" id={m.id}>
				{cityLink ? (
					<a href={`/moskeer/${m.citySlug}/#${m.id}`} class="mk-list-name mk-list-name-link">{m.name}</a>
				) : (
					<p class="mk-list-name">{m.name}</p>
				)}
				{m.address && <p class="mk-list-addr">{swedishAddress(m)}</p>}
				<p class="mk-list-meta">
					{locationLabel(m)}{m.opened ? ` · öppnad ${m.opened}` : ""}
				</p>
				{m.organisation && <p class="mk-list-org">Huvudman: {m.organisation}</p>}
				<p class="mk-list-dir">
					<a href={dir.apple} class="map-dir-btn">Apple Maps</a>
					<a href={dir.google} class="map-dir-btn">Google Maps</a>
					<span class="mk-list-canon"><a href={mosqueUrl(m)}>Länk till moskén</a></span>
					<span class="mk-list-canon"><a href={screenHref(m)}>Visa på storbild</a></span>
				</p>
			</li>
		);
	})}
</ul>

<style>
	.mk-list {
		margin: var(--space-half) 0 0;
		padding: 0;
		max-width: 44rem;
	}

	.mk-list-item {
		padding: var(--space-unit) 0;
		border-bottom: 1px solid var(--color-divider);
		/* Clears the sticky mast. See the :target rule in typography.css — same
		   reasoning, same fallback. */
		scroll-margin-top: calc(var(--mast-height, 5.5rem) + 0.5rem);
	}

	.mk-list-item:target {
		border-left: 2px solid var(--color-warm);
		padding-left: var(--space-half);
		margin-left: calc(-1 * var(--space-half) - 2px);
	}

	.mk-list-name {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: var(--step--1);
		color: var(--color-text);
		margin: 0 0 0.2rem;
		line-height: 1.25;
	}

	.mk-list-name-link {
		display: inline-block;
		color: var(--color-accent);
		text-decoration: none;
		width: fit-content;
	}

	.mk-list-name-link:hover {
		text-decoration: underline;
		text-underline-offset: var(--underline-offset);
	}

	.mk-list-addr {
		font-family: var(--font-body);
		font-size: var(--step--2);
		color: var(--color-text);
		margin: 0 0 0.15rem;
	}

	.mk-list-meta {
		font-family: var(--font-body);
		font-size: var(--step--3);
		color: var(--color-muted);
		margin: 0 0 0.15rem;
		font-variant-numeric: lining-nums tabular-nums;
	}

	.mk-list-org {
		font-family: var(--font-body);
		font-size: var(--step--3);
		color: var(--color-muted);
		margin: 0 0 0.35rem;
	}

	.mk-list-dir {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.6rem;
		margin: 0.6rem 0 0;
	}

	.mk-list-canon a {
		font-family: var(--font-body);
		font-size: var(--step--4);
		color: var(--color-muted);
		text-decoration: none;
	}

	.mk-list-canon a:hover {
		text-decoration: underline;
	}
</style>
