---
import EssayImage from "../EssayImage.astro";
import { PAGE_HERO_SIZES, PAGE_HERO_WIDTHS } from "../../lib/hero";
import { credit, type MosquePhoto } from "../../lib/moskeer/art";

// The photograph at the head of a town's mosque page. Rendered at the file's
// native 3:2 with no further crop — the crop that mattered was made when the
// file was cut (see lib/moskeer/art.ts), and cropping twice is how a minaret
// loses its tip.
//
// The caption is the licence, not decoration: CC BY and CC BY-SA both require
// the photographer's name, the terms, and a note that the picture was changed.

interface Props {
	photo: MosquePhoto;
	/** Set on the page's first image, which is its LCP candidate. */
	eager?: boolean;
}

const { photo, eager = false } = Astro.props;
---

<figure class="mk-hero">
	<div class="media-frame">
		<EssayImage
			src={photo.src}
			alt={photo.alt}
			widths={PAGE_HERO_WIDTHS}
			sizes={PAGE_HERO_SIZES}
			loading={eager ? "eager" : "lazy"}
			fetchpriority={eager ? "high" : "auto"}
		/>
	</div>
	<figcaption>
		<a href={photo.wikipedia} rel="noopener">{photo.mosque} på Wikipedia</a>. <a
			href={photo.source}
			rel="nofollow noopener">{credit(photo)}</a>
	</figcaption>
</figure>

<style>
	.mk-hero {
		margin: var(--space-phi) 0 0;
	}

	.mk-hero :global(img) {
		aspect-ratio: 3 / 2;
		width: 100%;
	}

	.mk-hero figcaption {
		font-family: var(--font-body);
		font-size: var(--step--3);
		color: var(--color-muted);
		margin-top: var(--space-half);
		max-width: var(--content-width);
		text-wrap: pretty;
	}

	.mk-hero figcaption a {
		color: inherit;
		text-underline-offset: var(--underline-offset);
	}

	.mk-hero figcaption a:hover {
		color: var(--color-accent);
	}
</style>
