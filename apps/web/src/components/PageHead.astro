---
// Shared header for every section/index page — Fakta (/vad-ar-islam/), Frågor &
// svar (/svar/), Essäer (/essaer), Trådar, Tänkare and Kalender — so they all open
// the same way: one title and one ingress paragraph, nothing else. The title is the
// page's navigation label (optionally extended, e.g. "Frågor & svar om islam"), so
// landing on a page instantly confirms which menu entry you followed. The ingress is
// a slot so each page can weave in its own links. This component owns the shared
// page opening, including the surrounding main element’s vertical spacing.
//
// A section may open with its drawing from the site's series (lib/ritningar.ts). Its
// size is the opening's, not a box of its own: from the title's top line to the last
// line of the opening's words (the ingress, and whatever the page adds under it in the
// `efter` slot — /ai-barometern/'s measurement line — unless the page sets `efterUnder`,
// as /vad-ar-islam/ does for its verse), in the column beyond the measure, flush with
// the canvas's edge the content below ends on, and never under 7rem. Drawing and words
// then share their top and bottom lines and read as one unit, a short opening gets a
// small drawing and a long one a large one. A fixed 11rem made the drawing outweigh a
// one-line ingress (Trådar) and stop halfway down a five-line one, and left a third of
// /vad-ar-islam/'s opening empty ("consider the size … so it looks balanced, not just
// added", 2026-09-26). On a phone the drawing stands beside the title, the words under
// both.
//
// Only beside an ingress: a drawing opens a section that opens with words. A tool page
// (Bönetider, Moskéer) opens on its tool, and there the drawing floated over the tool's
// first button and pushed the title below where every other section's stands.
//
// A page further in opens the same way, with two more parts the hand-built heads of the
// prayer, mosque and AI-barometern pages each wrote for themselves (2026-11-20): the
// breadcrumb above the title (`crumbs`, the trail the page's JSON-LD already carries)
// and one meta line under it (the `meta` slot: place, date, count, »senast
// uppdaterad«). Six copies set the gap between breadcrumb and title three ways.
import type { Crumb } from "../lib/jsonld";
import type { RitningPar } from "../lib/ritningar";
import Breadcrumb from "./Breadcrumb.astro";
import Kicker from "./Kicker.astro";
import Ritning from "./Ritning.astro";

interface Props {
	/** The title as text; a page whose title carries markup (a model's logo) fills the
	 *  `title` slot instead. */
	title?: string;
	ritning?: RitningPar;
	/** The trail to this page; the last crumb is the page itself. */
	crumbs?: Crumb[];
	/** For a script or a section that names the page by its title. */
	titleId?: string;
	/** The kind of page, over its title (Kicker's quiet form), as an essay's ämne. */
	kicker?: string;
	kickerHref?: string;
	/** The `efter` words stand under the drawing instead of beside it, so the drawing is as
	 *  tall as the title and the ingress only. /vad-ar-islam/'s verse: counted in, the Quran
	 *  on its stand grew to 400px, twice any other opening's drawing, beside the verse itself
	 *  (2026-11-21). AI-barometern's measurement line stays beside its drawing. */
	efterUnder?: boolean;
}

const { title, ritning, crumbs, titleId, kicker, kickerHref, efterUnder = false } = Astro.props;
const ingress = Astro.slots.has("default");
const efter = Astro.slots.has("efter");
const meta = Astro.slots.has("meta");
const medRitning = ritning !== undefined && ingress;
---

<header class:list={["page-head", medRitning && "page-head--ritning", medRitning && efterUnder && "page-head--efter-under"]}>
	{crumbs && <Breadcrumb items={crumbs} />}
	{kicker && <Kicker form="quiet" href={kickerHref} class="page-head-kicker">{kicker}</Kicker>}
	<h1 class="page-head-title" id={titleId}>{Astro.slots.has("title") ? <slot name="title" /> : title}</h1>
	{meta && <p class="meta-line page-head-meta"><slot name="meta" /></p>}
	{ingress && <p class="lead lead--page"><slot /></p>}
	{efter && <div class="page-head-efter"><slot name="efter" /></div>}
	{
		medRitning && (
			<div class="page-head-ritning">
				{/* `sizes`: the column, the most the drawing can be painted at. On a phone the
				    box is 6.5rem wide at most: the objects drawn 2026-11-21 run wider than the
				    landscapes before them (up to 2:1), and at 7.5rem the laptop and barometer
				    took the last 16px »AI-barometern« needed and split it at its hyphen at 390. */}
				<Ritning
					{...ritning}
					fyll
					hojd={[4.5, 18]}
					bredd={[6.5, 28]}
					sizes="(width >= 79rem) 31rem, (width >= 48rem) calc(100vw - 49rem), 6.5rem"
				/>
			</div>
		)
	}
</header>

<style>
	.page-head {
		margin: 0 0 var(--space-group);
	}

	.page-head-title {
		margin: 0;
		text-wrap: balance;
	}

	/* The kicker stands a half step over the title it names, as over an essay's. */
	.page-head :global(.page-head-kicker) {
		margin: 0 0 var(--space-half);
	}

	/* A meta line belongs to the title above it: tabular figures, so a date or a count
	   that a script refreshes keeps its width. */
	.page-head-meta {
		font-variant-numeric: lining-nums tabular-nums;
	}

	/* A phone: the drawing beside the title, the title standing on its foot line, the
	   words across the whole width under both. The breadcrumb stays above it all and
	   carries the gap to the title, so the drawing's cell starts on the title's line. */
	.page-head--ritning {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		grid-template-areas:
			"stig stig"
			"kicker kicker"
			"titel ritning"
			"meta meta"
			"ingress ingress"
			"efter efter";
		column-gap: var(--space-unit);
		align-items: end;
	}

	.page-head--ritning > :global(.breadcrumb) {
		grid-area: stig;
	}

	.page-head--ritning > :global(.page-head-kicker) {
		grid-area: kicker;
	}

	.page-head--ritning .page-head-title {
		grid-area: titel;
	}

	.page-head--ritning .page-head-meta {
		grid-area: meta;
	}

	.page-head--ritning :global(.lead--page) {
		grid-area: ingress;
	}

	.page-head-efter {
		grid-area: efter;
	}

	.page-head-ritning {
		grid-area: ritning;
	}

	/* Beside the words: the measure, then the drawing's column to the canvas's edge (at
	   least 8rem, so a narrow window takes it from the measure, not from the drawing).
	   The cell spans every row of the opening and the drawing fills it (Ritning `fyll`)
	   without adding height; the last row takes any height the 7rem floor adds. */
	@media (width >= 48rem) {
		.page-head--ritning {
			grid-template-columns: minmax(0, var(--content-width)) minmax(8rem, 1fr);
			grid-template-areas:
				"stig stig"
				"kicker kicker"
				"titel ritning"
				"meta ritning"
				"ingress ritning"
				"efter ritning";
			grid-template-rows: auto auto auto auto auto 1fr;
			column-gap: var(--grid-gutter);
			align-items: start;
		}

		.page-head-ritning {
			position: relative;
			align-self: stretch;
			min-block-size: 7rem;
		}

		/* The `efter` words under the drawing, in the measure, the column beside them left
		   open: the drawing spans the title and the ingress, and the ingress row takes any
		   height its 7rem floor adds. */
		.page-head--efter-under {
			grid-template-areas:
				"stig stig"
				"kicker kicker"
				"titel ritning"
				"meta ritning"
				"ingress ritning"
				"efter .";
			grid-template-rows: auto auto auto auto 1fr auto;
		}
	}
</style>
