---
// Shared header for every section/index page — Fakta (/vad-ar-islam/), Frågor &
// svar (/svar/), Essäer (/essaer), Trådar, Tänkare and Kalender — so they all open
// the same way: one title and one ingress paragraph, nothing else. The title is the
// page's navigation label (optionally extended, e.g. "Frågor & svar om islam"), so
// landing on a page instantly confirms which menu entry you followed. The ingress is
// a slot so each page can weave in its own links. This component owns the shared
// page opening, including the surrounding main element’s vertical spacing.
//
// A section may open with its drawing from the site's series (lib/ritningar.ts). Its
// size is the opening's, not a box of its own: from the title's top line to the last
// line of the opening's words (the ingress, and whatever the page adds under it in the
// `efter` slot — /vad-ar-islam/'s verse), in the column beyond the measure, flush with
// the canvas's edge the content below ends on, and never under 7rem. Drawing and words
// then share their top and bottom lines and read as one unit, a short opening gets a
// small drawing and a long one a large one. A fixed 11rem made the drawing outweigh a
// one-line ingress (Trådar) and stop halfway down a five-line one, and left a third of
// /vad-ar-islam/'s opening empty ("consider the size … so it looks balanced, not just
// added", 2026-09-26). On a phone the drawing stands beside the title, the words under
// both.
//
// Only beside an ingress: a drawing opens a section that opens with words. A tool page
// (Bönetider, Moskéer) opens on its tool, and there the drawing floated over the tool's
// first button and pushed the title below where every other section's stands.
import type { RitningPar } from "../lib/ritningar";
import Ritning from "./Ritning.astro";

interface Props {
	title: string;
	ritning?: RitningPar;
}

const { title, ritning } = Astro.props;
const ingress = Astro.slots.has("default");
const efter = Astro.slots.has("efter");
const medRitning = ritning !== undefined && ingress;
---

<header class:list={["page-head", medRitning && "page-head--ritning"]}>
	<h1 class="page-head-title">{title}</h1>
	{ingress && <p class="lead lead--page"><slot /></p>}
	{efter && <div class="page-head-efter"><slot name="efter" /></div>}
	{
		medRitning && (
			<div class="page-head-ritning">
				{/* `sizes`: the column, the most the drawing can be painted at. */}
				<Ritning
					{...ritning}
					fyll
					hojd={[4.5, 18]}
					bredd={[7.5, 28]}
					sizes="(min-width: 79rem) 31rem, (min-width: 48rem) calc(100vw - 49rem), 7.5rem"
				/>
			</div>
		)
	}
</header>

<style>
	/* Every index using PageHead shares one opening, regardless of its page class. */
	:global(main:has(> .page-head, > article > .page-head)) {
		margin-block: 0 var(--space-phi);
		padding-block-start: var(--space-group);
	}

	.page-head {
		margin: 0 0 var(--space-group);
	}

	.page-head-title {
		margin: 0;
		text-wrap: balance;
	}

	/* A phone: the drawing beside the title, the title standing on its foot line, the
	   words across the whole width under both. */
	.page-head--ritning {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		grid-template-areas:
			"titel ritning"
			"ingress ingress"
			"efter efter";
		column-gap: var(--space-unit);
		align-items: end;
	}

	.page-head--ritning .page-head-title {
		grid-area: titel;
	}

	.page-head--ritning :global(.lead--page) {
		grid-area: ingress;
	}

	.page-head-efter {
		grid-area: efter;
	}

	.page-head-ritning {
		grid-area: ritning;
	}

	/* Beside the words: the measure, then the drawing's column to the canvas's edge (at
	   least 8rem, so a narrow window takes it from the measure, not from the drawing).
	   The cell spans every row of the opening and the drawing fills it (Ritning `fyll`)
	   without adding height; the last row takes any height the 7rem floor adds. */
	@media (width >= 48rem) {
		.page-head--ritning {
			grid-template-columns: minmax(0, var(--content-width)) minmax(8rem, 1fr);
			grid-template-areas:
				"titel ritning"
				"ingress ritning"
				"efter ritning";
			grid-template-rows: auto auto 1fr;
			column-gap: var(--grid-gutter);
			align-items: start;
		}

		.page-head-ritning {
			position: relative;
			align-self: stretch;
			min-block-size: 7rem;
		}
	}
</style>
