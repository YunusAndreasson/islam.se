---
// One model's answer as a meter in a table cell (AnswerMeter.astro), and the
// full sentence goes to the tooltip and, as .sr-only text, to screen readers and the markdown twin.
import type { ScaleCell } from "../../lib/ai-barometern/aggregate";
import AnswerMeter from "./AnswerMeter.astro";
import AnswerSummary from "./AnswerSummary.astro";
import { cellTitle } from "../../lib/ai-barometern/site";

interface Props {
	label: string;
	cell: ScaleCell;
	/** The statement is about this model's own maker: the chip gets a ring. */
	own?: boolean;
}

const { label, cell, own = false } = Astro.props;
const title = `${cellTitle(label, cell)}${own ? ", om sitt eget företag" : ""}`;
---

<td>
	<details class="abm-cell-detail">
	<summary aria-label={title}>
	<AnswerMeter cell={cell} own={own} bare />
	</summary>
	<div class="abm-cell-reading"><strong>{label}</strong><AnswerSummary cell={cell} own={own} /></div>
	</details>
</td>
