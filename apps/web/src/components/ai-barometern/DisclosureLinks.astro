<script>
	import { onPage } from "../../scripts/page";

	function revealAnchor() {
		let id: string;
		try { id = decodeURIComponent(location.hash.slice(1)); } catch { return; }
		const target = document.getElementById(id);
		if (!target) return;
		let parent: Element | null = target;
		while (parent) {
			if (parent instanceof HTMLDetailsElement) parent.open = true;
			parent = parent.parentElement;
		}
		target.scrollIntoView({ block: "start" });
	}
	window.addEventListener("hashchange", revealAnchor);
	// Once per page, when it is there (page.ts). It ran at once and again at the router's
	// first page-load, which on a cold visit comes after the images — and a second
	// scrollIntoView then pulled back a reader who had already scrolled on.
	onPage(revealAnchor);
</script>
