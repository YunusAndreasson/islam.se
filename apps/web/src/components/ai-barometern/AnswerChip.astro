---
// One answer outside the matrix, as the matrix and the front page draw it: the meter
// (AnswerMeter.astro), on the findings, the comparisons on a model's page and the list of
// changes. With `label`, the answer is also printed beside or under it, for places that
// have no legend of their own; without, the words go to screen readers.
import type { ScaleCell } from "../../lib/ai-barometern/aggregate";
import { cellLabel } from "../../lib/ai-barometern/site";
import AnswerMeter from "./AnswerMeter.astro";

interface Props {
	cell: ScaleCell;
	own?: boolean | undefined;
	/** Print the answer in words beside the meter ("inline") or under it ("below"). */
	label?: "inline" | "below" | undefined;
	small?: boolean;
}

const { cell, own = false, label, small = false } = Astro.props;
const words = cell.state === "missing" ? "Inget svar" : cellLabel(cell);
---

<span class:list={["abm-answer-chip", label && `abm-answer-chip--${label}`]}>
	<AnswerMeter cell={cell} own={own} small={small} bare={!label} />
	{label ? <span class="abm-answer-chip-words">{words}</span> : <span class="sr-only">{words}</span>}
</span>
