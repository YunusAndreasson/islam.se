---
import type { ScaleCell } from "../../lib/ai-barometern/aggregate";
import { FAMILIES, familiesSingledOut } from "../../lib/ai-barometern/families";
import type { FamilyKey } from "../../lib/ai-barometern/types";
import AnswerChip from "./AnswerChip.astro";

interface Props {
	rows: readonly {
		label: string;
		href: string;
		own?: FamilyKey | undefined;
		cells: Readonly<Record<FamilyKey, ScaleCell>>;
	}[];
	caption: string;
	/** Family names explicitly mentioned by the finding. */
	emphasis?: string;
}
const { rows, caption, emphasis = "" } = Astro.props;
const named = familiesSingledOut(emphasis);
const initiallyOpen = named.length ? named.map((family) => family.key) : [FAMILIES[0]!.key];
const hasOwn = rows.some((row) => row.own);
const hasMixed = rows.some((row) => Object.values(row.cells).some((c) => c.state === "position" && !c.consistent));
---

<figure class="abm-labelled-comparison">
	<abm-mobile class="abm-comparison-mobile">
		{FAMILIES.map((family) => (
			<details open={initiallyOpen.includes(family.key)}>
				<summary>{family.label}</summary>
				<dl>{rows.map((row) => <div><dt><a href={row.href}>{row.label}</a></dt><dd><AnswerChip cell={row.cells[family.key]} own={row.own === family.key} label="inline" /></dd></div>)}</dl>
			</details>
		))}
	</abm-mobile>
	<div class="abm-scroll abm-comparison-desktop" tabindex="0" role="region" aria-label={caption}>
		<table>
			<caption class="sr-only">{caption}</caption>
			<thead><tr><th scope="col">Modell</th>{rows.map((row) => <th scope="col"><a href={row.href}>{row.label}</a></th>)}</tr></thead>
			<tbody>{FAMILIES.map((family) => (
				<tr data-emphasis={named.includes(family) ? "" : undefined}>
					<th scope="row">{family.label}</th>
					{rows.map((row) => <td><AnswerChip cell={row.cells[family.key]} own={row.own === family.key} label="below" /></td>)}
				</tr>
			))}</tbody>
		</table>
	</div>
	{/* One span: .chart-cap is a flex column, and bare text around the link broke into three lines. */}
	<figcaption class="chart-cap"><span>Sammanfattning av modellens tre svar.{hasMixed && " En prick i rutan: svaren skilde sig åt."}{hasOwn && " En ring: påståendet gäller modellens eget företag."} <a href={rows[0]?.href}>Läs påståendena och modellernas egna motiveringar</a>.</span></figcaption>
</figure>
