---
// AI-BAROMETERN IN THE SIDOLINJE — the hub's leading finding, drawn small.
//
// The rail runs by cadence: the last day's news above, this month's measurement here, the
// islamic year below. This block is islam.se's own measurement, so it keeps the SITE's voice —
// Literata under its own kicker, a full rule above — the way the calendar does, not the news
// column's Source Sans.
//
// One finding, and never a hand-picked one: frontPageFinding() takes the first non-classical
// finding from the same list the hub leads with, so it changes with each run and drops out on
// its own the day its pattern stops holding. The chips are the matrix's (MatrixCell), in a table
// narrow enough for a 17rem track: the five logos once as column heads, each statement on its
// own full-width row above its five answers.
//
// Styles: ai-barometern-chips.css and nothing else from the section. index.html inlines every
// stylesheet it imports, and the section's own sheet is 34 KB of rules this block never uses.
import { FAMILIES } from "../../lib/ai-barometern/families";
import { frontPageFinding, latestFindings } from "../../lib/ai-barometern/findings";
import { BASE_PATH, questionPath, shownData, svDateList } from "../../lib/ai-barometern/site";
import SectionLink from "../SectionLink.astro";
import MatrixCell from "./MatrixCell.astro";
import ModelLogo from "./ModelLogo.astro";
import "../../styles/ai-barometern-chips.css";
// For .sidolinje-rubrik, shared by every block in the track (see Markesdagar.astro).
import "../../styles/nyheter.css";

const finding = frontPageFinding(latestFindings());
const shownRuns = finding ? shownData().runs : [];
const source = `${shownRuns.length > 1 ? "Mätningarna" : "Mätningen"} ${svDateList(shownRuns.map((r) => r.date))}.`;
---

{
	finding && (
		<section class="barometer-rail abm" aria-labelledby="barometer-rail-rubrik">
			<h2 class="label sidolinje-rubrik" id="barometer-rail-rubrik">
				AI-barometern
			</h2>

			<p class="barometer-rail-fynd">
				<a href={finding.href}>
					<strong>{finding.lead}.</strong> {finding.text}
				</a>
			</p>

			<table class="barometer-rail-tabell">
				<caption class="sr-only">{`${finding.lead}. ${finding.text}`}</caption>
				<thead>
					<tr>
						{FAMILIES.map((f) => (
							<th scope="col">
								<ModelLogo family={f.key} />
								<span class="sr-only">{f.label}</span>
							</th>
						))}
					</tr>
				</thead>
				{finding.rows.map((row) => (
					<tbody>
						<tr>
							<th class="barometer-rail-pastaende" scope="colgroup" colspan={FAMILIES.length}>
								<a href={questionPath(row.question)}>{row.question.short}</a>
							</th>
						</tr>
						<tr>
							{FAMILIES.map((f) => (
								<MatrixCell
									label={f.label}
									cell={row.cells[f.key]}
									own={row.question.aboutFamily === f.key}
								/>
							))}
						</tr>
					</tbody>
				))}
			</table>

			<p class="barometer-rail-kalla">{source}</p>

			<p class="barometer-rail-fot">
				<SectionLink class="label arrow-link" href={BASE_PATH}>
					Hela mätningen
				</SectionLink>
			</p>
		</section>
	)
}

<style>
	/* The seam, drawn exactly as the calendar draws its own: two voices in one 17rem track
	   need a full rule between them, not only the kicker's tick. position: relative keeps the
	   cells' absolutely-positioned .sr-only labels inside this block. */
	.barometer-rail {
		position: relative;
		margin-top: var(--space-phi);
		padding-top: var(--space-unit);
		border-top: 1px solid var(--color-rule);
	}

	/* No news, no seam: this block is then the top of the track. `~`, never `+` — Astro
	   hoists the news component's <script> between the siblings (Markesdagar.astro). */
	:global(.nyheter-rail[hidden]) ~ .barometer-rail {
		margin-top: 0;
		padding-top: 0;
		border-top: 0;
	}

	/* The hub's own sentence: the bold lead, then what the models answered, the whole of it
	   one link to the comparison. A rung under body, the rail's reading size. */
	.barometer-rail-fynd {
		max-inline-size: 34rem;
		margin: 0 0 var(--space-half);
		font-size: var(--step--2);
		line-height: 1.5;
		color: var(--text-body);
		text-wrap: pretty;
	}

	.barometer-rail-fynd a {
		color: inherit;
		text-decoration: none;
	}

	.barometer-rail-fynd a:hover {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: var(--underline-offset);
	}

	.barometer-rail-fynd strong {
		font-weight: 600;
		color: var(--color-text);
	}

	/* Five equal columns: 17rem / 5 is 3.4rem, which clears the 2.75rem chip. Capped on a
	   single column, where the rail runs the canvas width and the five answers would
	   otherwise drift apart until they no longer read as one row. */
	.barometer-rail-tabell {
		inline-size: 100%;
		max-inline-size: 20rem;
		border-collapse: collapse;
		table-layout: fixed;
		font-family: var(--font-heading);
	}

	.barometer-rail-tabell thead th {
		padding: 0 0 0.35rem;
		font-weight: 400;
		text-align: center;
	}

	.barometer-rail-tabell thead :global(.abm-logo) {
		inline-size: 1rem;
		block-size: 1rem;
		vertical-align: middle;
	}

	.barometer-rail-pastaende {
		padding: 0.45rem 0 0.3rem;
		border-top: 1px solid var(--color-divider);
		font-size: var(--step--3);
		font-weight: 400;
		line-height: 1.3;
		text-align: start;
	}

	.barometer-rail-pastaende a {
		color: var(--text-strong);
		text-decoration: none;
	}

	.barometer-rail-pastaende a:hover {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: var(--underline-offset);
	}

	/* The cells are MatrixCell's <td>s, so they carry that component's scope, not this one's. */
	.barometer-rail-tabell :global(td) {
		padding: 0 0 0.2rem;
		text-align: center;
	}

	.barometer-rail-kalla {
		margin: var(--space-half) 0 0;
		font-family: var(--font-heading);
		font-size: var(--step--4);
		line-height: 1.4;
		color: var(--color-muted);
	}

	/* Placement only — the link inside is a `.section-link .arrow-link`, as in the other blocks. */
	.barometer-rail-fot {
		margin: var(--space-unit) 0 0;
	}
</style>
