---
// AI-BAROMETERN ON THE FRONT PAGE — what the measurement is, then three things it found.
//
// It used to open straight on one finding and draw it as the hub's chip matrix: a reader who had
// never heard of the barometer met »Väpnat motstånd mot ockupation« and a grid of »+ A + A +«
// pills with a key under them. In review the block "looked broken", the chips "scattered", and it
// explained one data point without ever saying what was being measured (2026-09-25). So it
// introduces first — what is asked, of whom, how often — and the findings follow as cases, each
// the hub's own sentence. The chips stay where they are explained, on the hub.
//
// Never hand-picked: frontPageFindings() takes the widest non-classical findings from the same
// list the hub leads with, so they change with each run and drop out on their own the day their
// pattern stops holding.
//
// Placement: its own movement on paper, between Tänkare and Praktiskt (index.astro). It stood
// under the news and the calendar in the live row until 2026-09-27, three voices on one tint,
// which read as crammed (»intryckt«, user review). The introduction and the cases side by side
// on one centre line; stacked in a narrow column.
// It keeps the SITE's voice — Literata under its own kicker — not the news column's sans.
//
// The introduction opens on the series' drawing of a Swedish farmhouse wall barometer, in
// the grammar of the podcast and app band above it (PoddAppHome): the drawing in a 10rem
// column, the words beside it, so the introduction's words start on »Podden«'s line. It
// was the longest stretch of words on the page with nothing to look at. The drawing is as
// tall as the introduction (DESIGN.md, »The Drawings«): in a 10rem box it stood 96px wide,
// its left edge 64px in from the kicker's line and its foot on no line at all ("doesn't
// look correctly aligned", 2026-09-26); at the introduction's height the upright barometer
// fills the column, on the kicker's line, from the ingress's first line to the link's.
//
// Styles: ai-barometern-chips.css for the logos' .abm-logo rule and nothing else from the section.
// index.html inlines every stylesheet it imports, and the section's own sheet is 34 KB of rules
// this block never uses.
import { FAMILIES } from "../../lib/ai-barometern/families";
import { frontPageFindings, latestFindings } from "../../lib/ai-barometern/findings";
import { BASE_PATH, shownData, svDateList } from "../../lib/ai-barometern/site";
import { RITNINGAR } from "../../lib/ritningar";
import Ritning from "../Ritning.astro";
import SectionLink from "../SectionLink.astro";
import ModelLogo from "./ModelLogo.astro";
import "../../styles/ai-barometern-chips.css";
// For .sidolinje-rubrik, shared by every block in the live row (see Markesdagar.astro).
import "../../styles/nyheter.css";

const cases = frontPageFindings(latestFindings(), 3);
const shown = shownData();
// Without this year's number, as every date line on the front page (formatDate).
const when = `Ur ${shown.runs.length > 1 ? "mätningarna" : "mätningen"} ${svDateList(
	shown.runs.map((r) => r.date),
).replace(new RegExp(` ${new Date().getFullYear()}$`), "")}`;
---

{
	cases.length > 0 && (
		<section class="barometer-rail abm home-movement" aria-labelledby="barometer-rail-rubrik">
			<div class="barometer-rail-ram">
				<h2 class="label sidolinje-rubrik" id="barometer-rail-rubrik">
					AI-barometern
				</h2>

				<div class="barometer-rail-intro">
					<div class="barometer-rail-ritning">
						<Ritning {...RITNINGAR.barometern} fyll hojd={[7, 17]} bredd={[7, 10]} />
					</div>
					<div class="barometer-rail-ord">
						<p class="barometer-rail-ingress">
							Vad svarar en AI-modell på frågor om klimatet, kriget, politiken och tron? Varje månad ställer
							AI-barometern samma {shown.questions} frågor till de fem stora modellerna och redovisar
							svaren som de lämnades.
						</p>
						<ul class="barometer-rail-modeller" aria-label="Modellerna">
							{FAMILIES.map((f) => (
								<li>
									<ModelLogo family={f.key} />
									{f.label}
								</li>
							))}
						</ul>
						<p class="barometer-rail-fot">
							<SectionLink class="label arrow-link" href={BASE_PATH}>
								Till AI-barometern
							</SectionLink>
						</p>
					</div>
				</div>

				<p class="barometer-rail-datum">{when}</p>

				<ol class="barometer-rail-fynd" role="list">
					{cases.map((f) => (
						<li>
							<h3 class="barometer-rail-rubrik">
								<a href={f.href}>{f.lead}</a>
							</h3>
							<p class="barometer-rail-text">{f.text}</p>
						</li>
					))}
				</ol>
			</div>
		</section>
	)
}

<style>
	/* A movement of its own: the change of ground above and below is its boundary, so
	   the rule that seamed it to the calendar went with the move. The container is what
	   the side-by-side layout below asks about. */
	.barometer-rail {
		container-type: inline-size;
	}

	/* The drawing above the words in a narrow column; beside them in the wide layout. */
	.barometer-rail-intro {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		row-gap: var(--space-unit);
		align-items: start;
	}

	/* The drawing's cell holds it at every width (from 48rem it fills the cell, Ritning
	   `fyll`): above the words it is a 7rem strip, the drawing flush left on their edge. */
	.barometer-rail-ritning {
		position: relative;
		min-block-size: 7rem;
	}

	.barometer-rail-ritning .ritning--fyll {
		justify-content: flex-start;
	}

	/* The question the whole barometer asks, at body size: this is the paragraph that says
	   what the block is, so it reads as prose, not as a caption. */
	.barometer-rail-ingress {
		max-inline-size: 34rem;
		margin: 0;
		font-size: var(--step-0);
		line-height: 1.55;
		color: var(--text-body);
		text-wrap: pretty;
	}

	/* The five, named once with their marks — the cast before the findings. */
	.barometer-rail-modeller {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		margin: var(--space-unit) 0 0;
		padding: 0;
		list-style: none;
		font-family: var(--font-heading);
		font-size: var(--step--3);
		color: var(--text-meta);
	}

	.barometer-rail-modeller li {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}

	.barometer-rail-fot {
		margin: var(--space-unit) 0 0;
	}

	.barometer-rail-datum {
		margin: var(--space-group) 0 var(--space-half);
		font-family: var(--font-heading);
		font-size: var(--step--3);
		color: var(--color-muted);
	}

	.barometer-rail-rubrik {
		margin: 0;
		font-size: var(--step-0);
		font-weight: 600;
		line-height: 1.25;
		text-wrap: balance;
	}

	.barometer-rail-rubrik a {
		color: var(--color-text);
		text-decoration: none;
	}

	.barometer-rail-rubrik a:hover {
		color: var(--color-accent);
	}

	.barometer-rail-text {
		margin: 0.25rem 0 0;
		font-size: var(--step--1);
		line-height: 1.5;
		color: var(--text-body);
		text-wrap: pretty;
	}

	/* Three cases, whitespace between them and no rules: each is a heading and one sentence. */
	.barometer-rail-fynd {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.barometer-rail-fynd > li + li {
		margin-top: var(--space-unit);
	}

	/* One finding while stacked: the three cases are 400px more of reading on a page
	   that already runs past 10 000px on a phone. The introduction says what the
	   barometer is; one case shows it; the hub has the rest, one tap away.
	   The SAME condition as the side-by-side layout below, on the same container. Until
	   2026-09-27 this asked the viewport (< 60rem) while the layout asked the container
	   (>= 40rem): from 700 to 959px the block stood in two columns with one finding in
	   the right, 127px beside a 658px introduction. */
	@container (inline-size < 56rem) {
		.barometer-rail-fynd > li:nth-child(n + 2) {
			display: none;
		}
	}

	/* SIDE BY SIDE, given the width: what the barometer is on the left, what it found on the
	   right, the date of the finding level with the kicker. The gutter is the page's 3rem, so
	   the two halves share the canvas's centre line with every other halved movement.
	   56rem, not 40rem: each half must hold the 10rem drawing, its 1.75rem gap and a text
	   column of ~14rem; at 40rem the words beside the drawing were 114px wide. */
	@container (inline-size >= 56rem) {
		.barometer-rail-ram {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			grid-template-areas:
				"rubrik datum"
				"intro  fynd";
			column-gap: var(--grid-gutter);
			align-items: start;
		}

		.sidolinje-rubrik {
			grid-area: rubrik;
		}

		.barometer-rail-intro {
			grid-area: intro;
			grid-template-columns: 10rem minmax(0, 1fr);
			column-gap: 1.75rem;
		}

		/* The column's full height beside the words, flush right, so its distance to
		   the words is the band's. */
		.barometer-rail-ritning {
			align-self: stretch;
		}

		.barometer-rail-ritning .ritning--fyll {
			justify-content: flex-end;
		}

		/* On the kicker's line, not a row of its own: 0.3rem is the kicker's own top margin. */
		.barometer-rail-datum {
			grid-area: datum;
			align-self: center;
			margin: 0.3rem 0 var(--space-half);
		}

		.barometer-rail-fynd {
			grid-area: fynd;
		}
	}
</style>
