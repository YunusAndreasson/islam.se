---
import type { ScaleCell } from "../../lib/ai-barometern/aggregate";
import { modelPath } from "../../lib/ai-barometern/site";
import type { Family } from "../../lib/ai-barometern/types";
import AnswerSummary from "./AnswerSummary.astro";

interface Props {
	rows: readonly { family: Family; model: string; cell: ScaleCell; own?: boolean }[];
	caption: string;
	source: string;
}
const { rows, caption, source } = Astro.props;
const columns = [
	{ label: "Tar helt avstånd", count: (c: ScaleCell) => c.values.filter((v) => v === -2).length },
	{ label: "Tar delvis avstånd", count: (c: ScaleCell) => c.values.filter((v) => v === -1).length },
	{ label: "Varken eller", count: (c: ScaleCell) => c.values.filter((v) => v === 0).length },
	{ label: "Instämmer delvis", count: (c: ScaleCell) => c.values.filter((v) => v === 1).length },
	{ label: "Instämmer helt", count: (c: ScaleCell) => c.values.filter((v) => v === 2).length },
	{ label: "Avstår", count: (c: ScaleCell) => c.abstained },
	{ label: "Vägrar svara", count: (c: ScaleCell) => c.refused },
	{ label: "Misslyckade försök", count: (c: ScaleCell) => c.failed },
].filter((c, i) => i < 5 || rows.some((r) => c.count(r.cell) > 0));
---

<figure class="abm-distribution">
	<abm-mobile class="abm-mobile-answers"><dl>
		{rows.map((r) => <div><dt><a href={modelPath(r.family.key)}>{r.family.label}</a><span class="abm-sample-note">{r.model}</span></dt><dd><AnswerSummary cell={r.cell} own={r.own} /></dd></div>)}
	</dl></abm-mobile>
	<details class="abm-distribution-detail disclosure" open>
		<summary>Visa fördelningen av alla svar</summary>
		<div class="abm-scroll" tabindex="0" role="region" aria-label="Fördelning av modellernas svar">
			<table class="abm-distribution-table">
				<caption class="sr-only">{caption}</caption>
				<thead><tr><th scope="col">Modell</th>{columns.map((c) => <th scope="col">{c.label}</th>)}</tr></thead>
				<tbody>{rows.map((r) => <tr>
					<th scope="row"><a href={modelPath(r.family.key)}>{r.family.label}</a><span class="abm-sample-note">{r.model}</span>{r.own && <span class="abm-sample-note">Om eget företag</span>}</th>
					{columns.map((c) => { const n = c.count(r.cell); return <td>{n > 0 ? <><span class="abm-dots" aria-hidden="true">{Array.from({ length: n }, () => <span class="abm-dot" />)}</span><span class="abm-sample-count">{n} av {r.cell.codes.length}</span></> : <span class="sr-only">0 svar</span>}</td>; })}
				</tr>)}</tbody>
			</table>
		</div>
	</details>
	<figcaption class="chart-cap"><span>{caption}</span><span>{source}</span></figcaption>
</figure>
<script>
	import { onPage } from "../../scripts/page";

	// Folded on a phone, open from the tablet's width: decided once per table.
	onPage(() => {
		for (const element of document.querySelectorAll<HTMLDetailsElement>(".abm-distribution-detail")) {
			if (!element.dataset.initialized) {
				element.open = !window.matchMedia("(width < 48rem)").matches;
				element.dataset.initialized = "true";
			}
		}
	});
</script>
