---
// One twin set on a question page: the reader's question, the statements side by side, and a
// line per model that answered them differently. Headings are h3 under the page's »Jämför«
// section, and each carries the anchor the hub links to.
import { questionPath, svDateList, type TwinRow, twinLines } from "../../lib/ai-barometern/site";
import LabelledComparison from "./LabelledComparison.astro";

interface Props {
	row: TwinRow;
	currentId: string;
	showKey?: boolean;
}

const { row } = Astro.props;
const lines = twinLines(row);
const dates = row.runs.map((r) => r.date);
const several = new Set(dates.map((d) => d.slice(0, 10))).size > 1;
const source = dates.length
	? `Källa: AI-barometern, ${several ? "mätningarna" : "mätningen"} ${svDateList(dates)}.`
	: "";
---

<div class="abm-twin">
	<h3 id={`jamfor-${row.set.key}`}>{row.set.title}</h3>
	<p class="abm-twin-look">{row.set.lookFor}</p>
	<LabelledComparison
		rows={row.members.map((m) => ({ label: m.question.short, href: questionPath(m.question), own: m.question.aboutFamily, cells: m.cells }))}
		caption={row.set.title}
	/>
	<p class="chart-cap">{source}</p>
	{
		lines.length > 0 && (
			<ul class="abm-twin-lines">
				{lines.map((line) => (
					<li>
						<strong>{line.who}</strong>
						{" – "}
						{line.parts.join("; ")}
					</li>
				))}
			</ul>
		)
	}
</div>
