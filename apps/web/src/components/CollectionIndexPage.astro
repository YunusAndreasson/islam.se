---
import Base from "../layouts/Base.astro";
import type { RitningPar } from "../lib/ritningar";
import PageHead from "./PageHead.astro";
import SectionLink from "./SectionLink.astro";

interface Props {
	title: string;
	pageTitle?: string;
	description: string;
	lead?: string;
	jsonLd: Record<string, unknown> | Record<string, unknown>[];
	backHref?: string;
	backLabel?: string;
	mainClass?: string;
	ogImageAlt?: string;
	/** The section's drawing, beside its title (PageHead). */
	ritning?: RitningPar;
}

const {
	title,
	pageTitle = `${title} – islam.se`,
	description,
	lead,
	jsonLd,
	backHref,
	backLabel,
	mainClass = "home",
	ogImageAlt,
	ritning,
} = Astro.props;
---

<Base
	title={pageTitle}
	description={description}
	{...(ogImageAlt === undefined ? {} : { ogImageAlt })}
	jsonLd={jsonLd}
>
	<main id="main" class={mainClass}>
		<PageHead title={title} {...(ritning ? { ritning } : {})}>
			{lead}
			<slot name="lead" />
			{/* The rest of the opening, under the ingress: counted into the drawing's height. */}
			{Astro.slots.has("efter") && <slot name="efter" slot="efter" />}
		</PageHead>
		<slot />
		{backHref && backLabel && (
			<p class="collection-back"><SectionLink href={backHref}>{backLabel}</SectionLink></p>
		)}
	</main>
	<slot name="after-main" />
</Base>
