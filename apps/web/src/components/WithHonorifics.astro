---
// Text from a data file that may carry an honorific glyph — ﷺ after the Prophet's name,
// ﷻ after God's — rendered with each glyph as <Honorific />: labelled for a screen
// reader and explained on hover, as rehype-honorific renders them in markdown. Four
// places split the text by hand, and two set the bare glyph, which a screen reader
// spells out as a ligature name.
import { noBreak } from "../lib/no-break";
import Honorific from "./Honorific.astro";

interface Props {
	text: string;
}

const { text } = Astro.props;
const parts = noBreak(text).split(/([ﷺﷻ])/u);
---

{parts.map((part) => (part === "ﷺ" ? <Honorific /> : part === "ﷻ" ? <Honorific type="swt" /> : part))}
