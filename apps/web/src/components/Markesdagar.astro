---
import HomeHead from "./HomeHead.astro";
import MarkesdagList from "./MarkesdagList.astro";
import { getMarkesdagar, gregorian, untilLabel } from "../lib/markesdagar";
// The calendar list's own rules live in styles/layout.css (.md-list--rail).

// The front page's calendar block — the next three observances, as a movement of its
// own: three dates on the page's thirds, under the tools for the day (PraktisktHome).
//
// Its places so far. A full-width section near the foot of the page: five rows, each
// with its explanatory note, plus two standing-fast paragraphs (both of which appear
// verbatim on /det-islamiska-aret/, which this block links straight to). Then the
// second half of a row it shared with the news (2026-09-25 to 2026-10-10), there to
// fill the track beside a column of headlines. When the news moved up under the lead
// (Nyheter.astro), the year went to what it belongs with: today's prayer times and
// the mosques stand directly above it, the day and then the year.
//
// ⚠️ It keeps the SITE's voice: Literata for the names, as islam.se's own writing.

const RADER = 3;

const events = getMarkesdagar();
const todayISO = new Date().toISOString().slice(0, 10);

// Mark which events are upcoming at build time (the no-JS view); scripts/markesdagar
// re-selects against the real Date.now() so the list never goes stale (§7.9).
let buildShown = 0;
const rows = events.map((e) => {
	const endISO = e.endISO ?? e.startISO;
	const upcoming = endISO >= todayISO && buildShown < RADER;
	// Only the first upcoming row counts down: the next thing the year brings is the
	// live fact; »om 150 dagar« under it too would just be arithmetic.
	const until = upcoming && buildShown === 0 ? untilLabel(e.startISO, e.endISO, todayISO) : "";
	if (upcoming) buildShown++;
	return { ...e, endISO, hidden: !upcoming, until, gregorian: gregorian(e.startISO, e.endISO) };
});
---

<section class="markesdagar-rail home-movement" aria-labelledby="markesdagar-kicker">
	<HomeHead label="Det islamiska året" id="markesdagar-kicker" href="/det-islamiska-aret/" linkLabel="Se hela året" />

	<MarkesdagList rows={rows} variant="rail" max={RADER} />
</section>

<style>
	/* Three dates across the page's thirds from 60rem, where every other row of three
	   on the page turns; one under the other below that. */
	@media (width >= 60rem) {
		.markesdagar-rail :global(.md-list--rail) {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			column-gap: var(--grid-gutter);
		}

		.markesdagar-rail :global(.md-list--rail .md-row) {
			padding-block: 0;
		}
	}
</style>

<script>
	// Shared with /det-islamiska-aret's list; walks every .md-list[data-max] on the
	// page, so this block's three rows and that page's five stay independent.
	import "../scripts/markesdagar";
</script>
