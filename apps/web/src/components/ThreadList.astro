---
import type { CollectionEntry } from "astro:content";
import { getArticles } from "../lib/articles";
import { leadSentences } from "../lib/format";
import { threadArt } from "../lib/tradar";
import CardList, { type CardItem } from "./CardList.astro";

// Trådar as cards. The grid, the type and the hairline all live in CardList —
// this file is only the mapping from a thread to a card, so /fordjupning/ and any
// future set of a-picture-and-a-sentence render identically without a second copy
// of the CSS.

type ThreadEntry = CollectionEntry<"tradar">;

interface Props {
	threads: readonly ThreadEntry[];
	headingLevel?: 2 | 3;
	compact?: boolean;
	prefetch?: "tap" | "hover" | "viewport" | "load";
	/** Forwarded to CardList — set it whenever the caller narrows --card-list-min. */
	sizes?: string;
}

const { threads, headingLevel = 2, compact = false, prefetch, sizes } = Astro.props;

// The parts that resolve to a published essay, as the front page and the series page
// count them, so the three never disagree on how many parts a series has.
const bySlug = new Map((await getArticles()).map((article) => [article.slug, article]));

const items: CardItem[] = threads.map((thread) => {
	const art = threadArt(thread.id);
	const parts = thread.data.essays.flatMap((slug) => bySlug.get(slug) ?? []);
	const minutes = parts.reduce((sum, article) => sum + article.readingTime, 0);
	return {
		href: `/tradar/${thread.id}/`,
		title: thread.data.title,
		// The framing's opening sentence, as the front page's essäserier set it
		// (TradarHome). The whole framing ran 91 to 371 characters, so three cards
		// abreast stood four lines against ten. The series page carries it whole.
		description: leadSentences(thread.data.framing, 150),
		// How long the series is, as the front page says it: a series is read whole.
		meta: `${parts.length} ${parts.length === 1 ? "del" : "delar"} · lästid ${minutes} min`,
		image: art ? { src: art, alt: thread.data.imageAlt ?? "" } : null,
	};
});
---

{/* Conditional spread, not `prefetch={prefetch}`: exactOptionalPropertyTypes is on,
    so passing an explicit undefined is a type error rather than an omission. */}
<CardList
	items={items}
	headingLevel={headingLevel}
	compact={compact}
	{...(prefetch === undefined ? {} : { prefetch })}
	{...(sizes === undefined ? {} : { sizes })}
/>
