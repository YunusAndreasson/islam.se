---
import { getImage, Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Article } from "../lib/articles";

interface Props {
	/** The essay whose hero photo to render. Omit when passing `src`. */
	article?: Article;
	/** A photograph that is not an essay hero — bespoke FAKTA art, say. Wins over
	    `article` when both are given, so a card can name its borrowed fallback and
	    its real art in one place. Art-directed mobile crops are an essay-frontmatter
	    feature and do not apply here. */
	src?: ImageMetadata;
	/** Override alt text. Pass "" for a decorative borrow (e.g. a FAKTA card where
	    the visible label already names the concept). Defaults to the essay's own
	    imageAlt, then its title. */
	alt?: string;
	widths?: number[];
	sizes?: string;
	loading?: "eager" | "lazy";
	fetchpriority?: "high" | "low" | "auto";
	class?: string;
}

const {
	article,
	src,
	alt,
	widths = [400, 800, 1200],
	sizes = "(max-width: 768px) 100vw, 50vw",
	loading = "lazy",
	fetchpriority = "auto",
	class: className,
} = Astro.props;

// Used by BOTH render paths below. The <Picture> branch used to inline
// `article.imageAlt ?? article.title` and so ignored the `alt` prop entirely —
// which meant a decorative borrow asking for alt="" (the FAKTA cards, whose
// visible label already names the concept) still read the borrowed essay's title
// aloud to a screen reader.
const altText = alt ?? article?.imageAlt ?? article?.title ?? "";

// `sizes="auto, …"` on a lazy image: a browser that supports it picks the file from
// the width the image is actually painted at, so a grid change can no longer leave
// a stale list fetching the wrong file. One that does not skips the unknown token
// and reads the caller's list — which is why every caller still owes an honest one.
// Eager images (the LCP heroes) must keep a plain list: `auto` is invalid there,
// since the browser has to choose before layout.
const sizesAttr = loading === "lazy" && !sizes.startsWith("auto") ? `auto, ${sizes}` : sizes;

const hero = src ?? article?.heroImage;
// Every picture is shown in the colour it was made or taken in (2026-11-07): no wash.
const imgClass = className;
// Only use a mobile-specific crop when it is landscape-ish. Every card layout
// (feature 3:2, recent 16:9, ämne lead 3:2) renders into a landscape box with
// object-fit: cover; some -mobile assets are authored as 2:3 portrait, and a
// portrait source forced into a landscape box shows a thin, zoomed middle slice
// (reads as a wrong/distorted crop on phones). A portrait crop is dropped so the
// image falls back to the landscape hero, which cover-crops cleanly to any box.
const mobileCandidate = src ? undefined : article?.mobileHeroImage;
const mobile =
	mobileCandidate && mobileCandidate.width >= mobileCandidate.height ? mobileCandidate : undefined;

// AVIF in production (~⅓ the bytes of webp on the LCP hero); webp-only in dev,
// because Astro's dev image endpoint serves AVIF with a `image/heif` content-type
// that Firefox refuses to decode (Chromium sniffs the bytes and copes). Production
// builds emit real `.avif` files with the correct type, so the win lands where it
// matters and local previews stay un-broken in every browser. webp is the universal
// fallback in both.
const FORMATS = import.meta.env.DEV ? (["webp"] as const) : (["avif", "webp"] as const);
const MIME = { avif: "image/avif", webp: "image/webp" } as const;
const MOBILE_WIDTHS = [360, 540, 720, 1080];

// The rare art-directed path (a few essays ship a landscape -mobile crop) hand-rolls
// one <source> per format for both the portrait-phone crop and the desktop hero.
const mobileSrcs: { type: string; srcset: string }[] = [];
const desktopSrcs: { type: string; srcset: string }[] = [];
let fallbackSrc = "";
if (mobile && hero) {
	for (const f of FORMATS) {
		mobileSrcs.push({
			type: MIME[f],
			srcset: (await getImage({ src: mobile, widths: MOBILE_WIDTHS, sizes: "100vw", format: f })).srcSet.attribute,
		});
		desktopSrcs.push({
			type: MIME[f],
			srcset: (await getImage({ src: hero, widths, sizes, format: f })).srcSet.attribute,
		});
	}
	fallbackSrc = (await getImage({ src: hero, widths, sizes, format: "webp" })).src;
}
---

{hero && (
	mobile ? (
		<picture>
			{/* The crop's own dimensions: the <img> below carries the desktop hero's, and
			    without these a phone reserved that shape and then changed it when the
			    mobile file arrived. */}
			{mobileSrcs.map((s) => (
				<source media="(max-width: 768px) and (orientation: portrait)" type={s.type} srcset={s.srcset} sizes="100vw" width={mobile.width} height={mobile.height} />
			))}
			{desktopSrcs.map((s) => <source type={s.type} srcset={s.srcset} sizes={sizesAttr} />)}
			<img
				src={fallbackSrc}
				width={hero.width}
				height={hero.height}
				alt={altText}
				loading={loading}
				fetchpriority={fetchpriority}
				decoding="async"
				class={imgClass}
			/>
		</picture>
	) : (
		<Picture
			src={hero}
			formats={[...FORMATS]}
			fallbackFormat="webp"
			alt={altText}
			widths={widths}
			sizes={sizesAttr}
			loading={loading}
			fetchpriority={fetchpriority}
			decoding="async"
			class={imgClass}
		/>
	)
)}

{/* NO TONAL WASH (2026-11-07). Every essay picture carried one in CSS (saturation 0.72,
    contrast 1.04, brightness 0.98, sepia 0.12) to pull the set toward the warm palette,
    easing to full colour under the pointer. So a reader saw every photograph faded until
    they hovered it, and the cover on an essay's own page, which is no link, faded always:
    the look the user does not want (»i do not like the desaturated look«, 2026-10-11). The
    pictures are made to one register now (the feature-image skill), documentary ones are
    cut from the original with no colour change, and both are shown as they are. A card's
    hover is its title's underline. */}
