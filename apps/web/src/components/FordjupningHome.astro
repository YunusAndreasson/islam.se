---
import { getCollection } from "astro:content";
import { resolveHero } from "../lib/fordjupning";
import CardList, { type CardItem } from "./CardList.astro";
import HomeHead from "./HomeHead.astro";

// FÖRDJUPNING on the front page — the encyclopedic layer, which until now had no
// presence on it at all.
//
// Fifteen pillar pages of 2 800–4 500 words, each the whole of one contested
// topic — the sources, the scholarship, the history and the Swedish legal
// position — and the only routes to them were the footer and the command
// palette. They are the most substantial single thing the site publishes and the
// front page did not know they existed.
//
// It sits directly under <FaktaBand>, which is the real relation between them:
// the band names the five pillars and the six articles of faith and opens a short
// answer for each; these are the same territory taken all the way down.

// CURATED, not ranked. An earlier version chose by art and then by date, which is
// the right instinct for a feed and the wrong one here: these four are the topics
// a Swedish reader actually arrives with, and that is an editorial judgement no
// sort key encodes. Three of the site's contested-practice pages — what a marriage
// is, what the veil verse says, how "halal" became a certificate — and then the
// one that is not about how to live but about how it ends, and where Sweden's own
// burial law is the obstacle. Ordered as they read, two by two.
//
// Ramadan is deliberately absent: the sidolinje beside this page already opens on
// it under "Det islamiska året", and the front page should not name the same thing
// twice in two registers.
const VALDA = ["aktenskap", "hijab", "halal", "doden"] as const;

const alla = await getCollection("fordjupning");

// Hard failure on a slug that names nothing, rather than a block that quietly
// renders three cards. A curated list is exactly the kind of thing that rots
// silently when a page is renamed, and the same reasoning already governs the
// `related` and `essays` references on these pages: a stale slug fails the build.
const valda = await Promise.all(
	VALDA.map(async (slug) => {
		const entry = alla.find((e) => e.id === slug);
		if (!entry) {
			throw new Error(
				`FordjupningHome: ingen fördjupning med slug "${slug}". ` +
					`Fanns: ${alla.map((e) => e.id).join(", ")}`,
			);
		}
		// resolveHero() throws on a heroEssay naming no essay, so a broken art
		// reference fails the build rather than silently rendering a card with a
		// hole in it — the same contract /fordjupning/ relies on.
		return { entry, hero: await resolveHero(entry) };
	}),
);

// CARDS, not the index rows this began as. Standing beside Trådar — a browse axis
// in full-dress cards with a picture each — a column of thin rows made the site's
// most substantial writing look like the apparatus and the way-in look like the
// work. The count line mirrors the threads' "6 essäer" exactly, because it is the
// same fact about the same kind of thing: how much is behind this door.
const rader: CardItem[] = valda.map(({ entry, hero }) => ({
	href: `/fordjupning/${entry.id}/`,
	title: entry.data.term,
	description: entry.data.blurb ?? entry.data.seoDescription ?? entry.data.description,
	meta: `${entry.data.related.length} frågor`,
	image: hero && {
		...(hero.src === undefined ? {} : { src: hero.src }),
		...(hero.article === undefined ? {} : { article: hero.article }),
		alt: hero.alt,
	},
}));
---

<section class="fordjupning-home home-movement" aria-labelledby="fordjupning-kicker">
	<HomeHead
		label="Fördjupning"
		id="fordjupning-kicker"
		href="/fordjupning/"
		linkLabel={`Alla ${alla.length} fördjupningar`}
	/>
	{/* h3: the head-row above renders the movement's h2, so a topic is a level
	    beneath it. Same reasoning AmnenHome uses for its department rows.

	    Two by two, the picture at the full width of its card and the words under
	    it — the same rhythm as the second tier of essays. A 12rem thumbnail beside
	    the text, and before it four in a row, turned these photographs into small
	    dark boxes (user review, 2026-09-25). A phone scrolls the four sideways. */}
	<CardList
		items={rader}
		headingLevel={3}
		prefetch="viewport"
		sizes="(min-width: 79rem) 37rem, (min-width: 48rem) 48vw, 78vw"
	/>
</section>

<style>
	/* No hairline under each card: whitespace separates them. */
	.fordjupning-home :global(.card-list-item) {
		border-bottom: 0;
	}

	@media (width >= 48rem) {
		.fordjupning-home :global(.card-list) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0 var(--grid-gutter);
		}

		.fordjupning-home :global(.card-list-title) {
			font-size: var(--step-1);
		}
	}

	/* 3:2, the card role of every photograph on the front page (the second tier,
	   these), so the pictures on the page come in two shapes, not five. */
	.fordjupning-home :global(.card-list-thumb img) {
		aspect-ratio: 3 / 2;
		object-fit: cover;
	}

	/* A PHONE scrolls the four sideways, the next card peeking at the edge, instead
	   of stacking four full-width photographs. The row reaches the screen edges and
	   snaps each card to the text column. `content-visibility: visible` because the
	   movement's paint containment would clip it (the same fix TradarHome carries). */
	@media (width < 48rem) {
		.fordjupning-home {
			content-visibility: visible;
		}

		.fordjupning-home :global(.card-list) {
			grid-auto-flow: column;
			grid-template-columns: none;
			grid-auto-columns: 78%;
			column-gap: var(--space-group);
			overflow-x: auto;
			overscroll-behavior-x: contain;
			scroll-snap-type: x mandatory;
			scroll-padding-inline: var(--safe-left);
			margin-inline: calc(-1 * var(--safe-left)) calc(-1 * var(--safe-right));
			padding-inline: var(--safe-left) var(--safe-right);
			scrollbar-width: none;
		}

		.fordjupning-home :global(.card-list-item) {
			scroll-snap-align: start;
		}

		.fordjupning-home :global(.card-list-title) {
			font-size: var(--step-0);
		}
	}
</style>
