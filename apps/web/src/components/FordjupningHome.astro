---
import { getCollection } from "astro:content";
import { FORDJUPNING_INGRESS, resolveHero } from "../lib/fordjupning";
import FordjupningCards from "./FordjupningCards.astro";
import HomeHead from "./HomeHead.astro";

// FÖRDJUPNING on the front page — the encyclopedic layer, which until now had no
// presence on it at all.
//
// Fifteen pillar pages of 2 800–4 500 words, each the whole of one contested
// topic — the sources, the scholarship, the history and the Swedish legal
// position — and the only routes to them were the footer and the command
// palette. They are the most substantial single thing the site publishes and the
// front page did not know they existed.
//
// It sits directly under <FaktaBand>, which is the real relation between them:
// the band names the five pillars and the six articles of faith and opens a short
// answer for each; these are the same territory taken all the way down.
//
// Directly under it, but NOT inside it. Until 2026-09-27 the two shared one tinted
// region, and one ground made this read as a sub-part of the facts — 2 550px of one
// block straight after the cover, "intryckt" (user review). Since 2026-10-10 both
// stand on paper, as one chapter between the page's two tinted rooms, and what makes
// this its own section is the rule it opens under and its own kicker row
// (editorial.css, »A rule opens a section«): paper has no edges to be pressed into.

// CURATED, not ranked. An earlier version chose by art and then by date, which is
// the right instinct for a feed and the wrong one here: these four are the topics
// a Swedish reader actually arrives with, and that is an editorial judgement no
// sort key encodes. Marriage and hijab sit alongside responsibility for AI and
// the history of Islam in Sweden. AI replaces halal to broaden the subjects
// represented in this opening selection (user, 2026-09-26).
//
// THREE, EACH WITH ITS PICTURE (2026-10-10). The list was four: two as picture cards
// and two under them in words. "It just look unbalanced with two large images then two
// without … maybe 3 images in one row for the most important, the link to the subpage"
// (user review). So three, alike, and »Alla fördjupningar« for the other twenty. The
// order here is the order on the page; to show another topic, put it in this list and
// take one out. »Islam i Sverige« was the fourth and is one tap away, first on the
// index page.
//
// Ramadan is deliberately absent: the Islamic year on this page already opens on
// it, and the front page should not name the same thing twice in two registers.
const VALDA = ["aktenskap", "hijab", "artificiell-intelligens"] as const;
const alla = await getCollection("fordjupning");

// Hard failure on a slug that names nothing, rather than a block that quietly
// renders three cards. A curated list is exactly the kind of thing that rots
// silently when a page is renamed, and the same reasoning already governs the
// `related` and `essays` references on these pages: a stale slug fails the build.
const valda = await Promise.all(
	VALDA.map(async (slug) => {
		const entry = alla.find((e) => e.id === slug);
		if (!entry) {
			throw new Error(
				`FordjupningHome: ingen fördjupning med slug "${slug}". ` +
					`Fanns: ${alla.map((e) => e.id).join(", ")}`,
			);
		}
		// resolveHero() throws on a heroEssay naming no essay, so a broken art
		// reference fails the build rather than silently rendering a card with a
		// hole in it — the same contract /fordjupning/ relies on.
		return { entry, hero: await resolveHero(entry) };
	}),
);

---

<section class="fordjupning-home home-movement" aria-labelledby="fordjupning-kicker">
	<HomeHead
		label="Fördjupning"
		id="fordjupning-kicker"
		href="/fordjupning/"
		linkLabel="Alla fördjupningar"
	/>
	{/* The Fördjupning page's own ingress, as the section's framing line: the two card
	    rows above this chapter each open with one (the ämne's, the series'), and this
	    was the one section a reader had to guess the meaning of from its name. */}
	<p class="home-tab-framing">{FORDJUPNING_INGRESS}</p>
	{/* h3: the head-row above renders the movement's h2, so a topic is a level
	    beneath it.

	    THREE PICTURE CARDS ON THE PAGE'S THIRDS: the card the essays by ämne and the
	    essäserier are set in, so the three card rows on the page are one kind of thing,
	    and the columns stand under the three columns of »Vad är islam?« directly above.

	    What came before, all the same autumn. Four in a row and a 12rem thumbnail beside
	    the text: on a 64rem canvas those were 230px pictures, "small dark boxes" (user
	    review, 2026-09-25). Two by two with four large pictures: 1 103px, the tallest
	    movement on the page, a second front page inside the first. Two large pictures
	    over an A–Ö run of every other title: "just like a list dumped there". Two large
	    pictures over two topics in words: unbalanced, two at full weight and two at a
	    fraction of it. A third of the 76rem canvas is 373px, the width the essay cards
	    have had all along. A phone and a tablet scroll the three sideways, in the row the
	    essäserier's parts scroll in. */}
	<FordjupningCards
		entries={valda}
		compact={false}
		headingLevel={3}
		sizes="(min-width: 79rem) 24rem, (min-width: 60rem) 31vw, (min-width: 40rem) 42vw, 80vw"
	/>
</section>

<style>
	/* The framing line supplies the opening gap (layout.css, .home-tab-framing). Shared
	   card padding doubled that gap; rows use an explicit gap here while collection-page
	   cards keep their defaults. */
	.fordjupning-home :global(.card-list) {
		margin-block-start: 0;
	}

	/* The card's own sizes are CardList's now, the essay card's (tokens.css, »The
	   picture card's inside«); this section patched them in until 2026-10-16. A blurb
	   here is one headline-like line that breaks once: broken evenly, not with two
	   words left on the second line. */
	.fordjupning-home :global(.card-list-framing) {
		text-wrap: balance;
	}

	/* THE PAGE'S THIRDS from 60rem, on its one gutter. Below that the three scroll
	   sideways, as the essäserier's parts do (editorial.css, »A row of cards that
	   scrolls sideways«). */
	@media (width >= 60rem) {
		.fordjupning-home :global(.card-list) {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: var(--space-group) var(--grid-gutter);
		}
	}
</style>
