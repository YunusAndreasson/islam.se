---
import { getArticles } from "../lib/articles";
import { getEssayConnections } from "../lib/related";
import EssayList from "./EssayList.astro";
import HomeHead from "./HomeHead.astro";
import Kicker from "./Kicker.astro";
import LeadPackage from "./LeadPackage.astro";
import Motet from "./Motet.astro";

interface Props {
	slug: string;
}

const { slug } = Astro.props;
const { amne, tankare, tradar, related, svar } = await getEssayConnections(slug);

type ContextRow = {
	label: string;
	links: { href: string; label: string }[];
};

const contextRows = [
	amne && {
		label: "Ämne",
		links: [{ href: `/amnen/${amne.slug}/`, label: amne.name }],
	},
	tradar.length > 0 && {
		// The series by name, and where in it this essay stands: the one fact a reader
		// needs to decide whether to go back to the start.
		label: tradar.length === 1 ? "Essäserie" : "Essäserier",
		links: tradar.map((t) => ({
			href: `/tradar/${t.id}/`,
			label: `${t.title}, del ${t.part} av ${t.parts}`,
		})),
	},
	// Tänkare is deliberately NOT a row here. It used to be, and as one flat
	// comma-separated list it said "filed under" about the one thing on this site
	// that is an argument rather than a category. It is rendered above, by <Motet>,
	// as the two traditions set against each other.
	// The one route out of the essay corpus and into the reference half of the site.
	// Derived in lib/related.ts, not authored per essay.
	svar.length > 0 && {
		// »Svar«, not »Fakta«: the rows link to answers in Frågor och svar, most of
		// them not on the Tro och lära page the word »Fakta« stood for (2026-10-16).
		label: "Svar",
		links: svar.map((s) => ({ href: `/svar/${s.slug}/`, label: s.title })),
	},
].filter((row): row is ContextRow => Boolean(row));

const hasContext = contextRows.length > 0;
const hasMotet = tankare.length > 0;

// A SERIES IS READ IN ORDER, so the first thing the end of a part offers is the part after
// it (DESIGN.md, »The Browse Axes«), set as the front page's series cards set a part: its
// number in brass, then its title. One essay stands in two series and gets one for each.
// The part itself, for its picture and the first sentence of its deck.
const bySlug = new Map((await getArticles()).map((a) => [a.slug, a]));
const nextParts = tradar.flatMap((t) =>
	t.next ? [{ series: t, next: t.next, article: bySlug.get(t.next.slug) }] : [],
);

// »Läs vidare« as the front page's picture cards when all three have a photograph
// (lib/related.ts offers pictured essays first); otherwise rows, never a half-pictured row.
const relatedAsCards = related.length > 0 && related.every((a) => a.heroImage);
---

{(hasContext || hasMotet || related.length > 0 || nextParts.length > 0) && (
	<aside class="essay-connections" aria-label="Läs vidare och sammanhang">
		{nextParts.map(({ series, next, article }) => (
			<div class="ec-next">
				<Kicker form="head" as="h2">Nästa del</Kicker>
				{article ? (
					<LeadPackage article={article} label={`Del ${series.part + 1} av ${series.parts} · ${series.title}`} />
				) : (
					<a class="ec-next-link" href={`/${next.slug}/`} data-astro-prefetch="viewport">
						<span class="part-ordinal">Del {series.part + 1} av {series.parts} · {series.title}</span>
						<span class="ec-next-title">{next.title}</span>
					</a>
				)}
			</div>
		))}

		{(hasMotet || hasContext) && (
			<div class:list={["ec-about", { "ec-about--both": hasMotet && hasContext }]}>
				<Motet tankare={tankare} />

				{hasContext && (
					<dl class="ec-context">
						{contextRows.map((row) => (
							<div class="ec-row">
								<dt class="label">{row.label}</dt>
								<dd>
									{row.links.map((link, i) => (
										<>
											{i > 0 && <span class="ec-sep" aria-hidden="true">·</span>}
											<a href={link.href}>{link.label}</a>
										</>
									))}
								</dd>
							</div>
						))}
					</dl>
				)}
			</div>
		)}

		{related.length > 0 && (
			<section class="ec-related" aria-labelledby="ec-related-rubrik">
				{/* The whole archive is the way on, on the head row as on the front page
				    (DESIGN.md, »The Essäer Page«: the archive from the end of every essay). */}
				<HomeHead label="Läs vidare" id="ec-related-rubrik" href="/essaer/" linkLabel="Alla essäer" />
				{relatedAsCards ? (
					<EssayList
						articles={related}
						itemVariant="card"
						class="essay-cards essay-cards--thirds ec-cards"
						cardSizes="(min-width: 79rem) 24rem, (min-width: 64rem) 30vw, (min-width: 40rem) 42vw, 80vw"
					/>
				) : (
					<EssayList articles={related} />
				)}
			</section>
		)}
	</aside>
)}

<style>
	/* THE END MATTER STEPS OUT ONTO THE CANVAS (2026-11-07). The essay is over: what
	   follows is the way on, and it is set as the site's browse pages set theirs, on the
	   mast's lines and the canvas's twelve columns, as the cover photograph above is
	   (`.reading-shell` in [...slug].astro is the container that measures the window).
	   It was a 42rem column of small rows under the last paragraph, and the next essay,
	   the one move that keeps a reader reading, was a line of text the size of a note.
	   Clear of the notes: a margin note hung beside the last lines must not run into it. */
	.essay-connections {
		--cover-width: min(var(--art-width), 100cqi - 2 * var(--padding-inline));
		clear: both;
		width: var(--cover-width);
		max-width: none;
		margin-inline: calc((100% - var(--cover-width)) / 2);
		margin-top: var(--space-section);
		padding-top: var(--space-group);
		border-top: var(--border-rule);
	}

	/* THE END MATTER'S HEADINGS are kickers in the head form, behind the brass point, as
	   an answer's and a fördjupning's are: one grammar for the foot of every reading page
	   (DESIGN.md, »One grammar off the front page«). The kicker brings its own
	   group-space. Each block after the first opens a section space under the one
	   before. */
	.essay-connections > * + * {
		margin-top: var(--space-section);
	}

	/* NÄSTA DEL, the one thing offered first, in the lead's grammar (LeadPackage): its
	   photograph in two thirds and its words in the last, the part's number
	   in the brass every ordinal on the site is set in, over its title. A part the
	   archive cannot find (a series naming a draft) is its number and title alone. */
	.ec-next-link {
		display: block;
		color: inherit;
		text-decoration: none;

		&:hover .ec-next-title {
			text-decoration: underline;
		}
	}

	.ec-next-title {
		display: block;
		font-family: var(--font-display);
		font-size: var(--step-2);
		font-weight: 600;
		line-height: 1.18;
		color: var(--color-text);
	}

	/* WHERE THE ESSAY STANDS: the two traditions it sets against each other (Mötet) in
	   two thirds, and its ämne, its essäserie and the answers it touches in the last. */
	.ec-context {
		margin: 0;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 0.4rem 1rem;
		align-items: baseline;
	}

	.ec-row {
		display: contents;
	}

	.ec-context dt {
		color: var(--color-muted);
		white-space: nowrap;
	}

	.ec-context dd {
		overflow-wrap: anywhere;
		margin: 0;
		font-family: var(--font-heading);
		font-size: var(--step--1);
		line-height: 1.5;
	}

	.ec-context a {
		/* Navigation chips, not words in a sentence: the 24px target floor applies. */
		display: inline-block;
		padding-block: 0.25rem;
		color: var(--color-accent);
		text-decoration: none;
		font-weight: 500;

		&:hover {
			text-decoration: underline;
			text-underline-offset: var(--underline-offset);
		}
	}

	.ec-sep {
		color: var(--color-divider);
		margin: 0 0.5rem;
	}

	.ec-about :global(.motet) {
		margin-bottom: 0;
	}

	/* In the last third each link is a line of its own: run on with »·« between them, a
	   separator was left at the end of a line. */
	@media (width >= 64rem) {
		.ec-about--both .ec-context a {
			display: block;
		}

		.ec-about--both .ec-sep {
			display: none;
		}
	}

	@media (width < 64rem) {
		.ec-about--both .ec-context {
			margin-top: var(--space-unit);
		}
	}

	/* LÄS VIDARE: the head row with the archive as its way on, then three picture cards on
	   the canvas's thirds, the size the front page sets its cards at. */
	.ec-related :global(.essay-cards) {
		margin-bottom: 0;
	}

	.ec-related :global(.archive-list) {
		margin-bottom: 0;
	}

	.ec-related :global(.archive-item:last-child) {
		padding-bottom: 0;
	}

	/* The canvas's divisions from 64rem, the line where the lead stands beside its rail. */
	@media (width >= 64rem) {
		.ec-about--both {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			column-gap: var(--grid-gutter);
			align-items: start;
		}

		.ec-about--both :global(.motet) {
			grid-column: 1 / 3;
		}

		/* The context key opens on the kicker's line beside Mötet, under the same group
		   space, so the two read as one row. */
		.ec-about--both .ec-context {
			padding-top: calc(var(--step--3) * 1.4 + var(--space-group));
		}
	}

	/* Thirds from 60rem, as every row of three picture cards on the site; under it they
	   keep one row and scroll it sideways (editorial.css, »A row of cards that scrolls
	   sideways«, which names this row with the front page's two). */
	@media (width >= 60rem) {
		.ec-related :global(.ec-cards) {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		/* Where the three are not all pictured they are rows, and across the canvas a
		   row's line ran 1 216px: they stand on the same thirds as text items, with no
		   rule under any (the next section's or the pager's space closes them). */
		.ec-related :global(.archive-list) {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			column-gap: var(--grid-gutter);
		}

		.ec-related :global(.archive-list > .archive-item) {
			padding-block: 0;
			border-bottom: none;
		}
	}
</style>
