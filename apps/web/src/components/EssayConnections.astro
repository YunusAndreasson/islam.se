---
import { getEssayConnections } from "../lib/related";
import EssayList from "./EssayList.astro";
import Motet from "./Motet.astro";
import SectionLink from "./SectionLink.astro";

interface Props {
	slug: string;
}

const { slug } = Astro.props;
const { amne, tankare, tradar, related, svar } = await getEssayConnections(slug);

type ContextRow = {
	label: string;
	links: { href: string; label: string }[];
};

const contextRows = [
	amne && {
		label: "Ämne",
		links: [{ href: `/amnen/${amne.slug}/`, label: amne.name }],
	},
	tradar.length > 0 && {
		// The series by name, and where in it this essay stands: the one fact a reader
		// needs to decide whether to go back to the start.
		label: tradar.length === 1 ? "Essäserie" : "Essäserier",
		links: tradar.map((t) => ({
			href: `/tradar/${t.id}/`,
			label: `${t.title}, del ${t.part} av ${t.parts}`,
		})),
	},
	// Tänkare is deliberately NOT a row here. It used to be, and as one flat
	// comma-separated list it said "filed under" about the one thing on this site
	// that is an argument rather than a category. It is rendered above, by <Motet>,
	// as the two traditions set against each other.
	// The one route out of the essay corpus and into the reference half of the site.
	// Derived in lib/related.ts, not authored per essay.
	svar.length > 0 && {
		// »Svar«, not »Fakta«: the rows link to answers in Frågor och svar, most of
		// them not on the Tro och lära page the word »Fakta« stood for (2026-10-16).
		label: "Svar",
		links: svar.map((s) => ({ href: `/svar/${s.slug}/`, label: s.title })),
	},
].filter((row): row is ContextRow => Boolean(row));

const hasContext = contextRows.length > 0;
const hasMotet = tankare.length > 0;

// A SERIES IS READ IN ORDER, so the first thing the end of a part offers is the part after
// it (DESIGN.md, »The Browse Axes«), set as the front page's series cards set a part: its
// number in brass, then its title. One essay stands in two series and gets one for each.
const nextParts = tradar.flatMap((t) => (t.next ? [{ series: t, next: t.next }] : []));
---

{(hasContext || hasMotet || related.length > 0 || nextParts.length > 0) && (
	<aside class="essay-connections" aria-label="Läs vidare och sammanhang">
		{nextParts.map(({ series, next }) => (
			<p class="ec-next">
				<span class="label ec-heading">Nästa del</span>
				<a class="ec-next-link" href={`/${next.slug}/`} data-astro-prefetch="viewport">
					<span class="ec-next-del">Del {series.part + 1} av {series.parts} · {series.title}</span>
					<span class="ec-next-title">{next.title}</span>
				</a>
			</p>
		))}

		<Motet tankare={tankare} />

		{hasContext && (
			<dl class="ec-context">
				{contextRows.map((row) => (
					<div class="ec-row">
						<dt class="label">{row.label}</dt>
						<dd>
							{row.links.map((link, i) => (
								<>
									{i > 0 && <span class="ec-sep" aria-hidden="true">·</span>}
									<a href={link.href}>{link.label}</a>
								</>
							))}
						</dd>
					</div>
				))}
			</dl>
		)}

		{related.length > 0 && (
			<div class="ec-related">
				<p class="label ec-heading">Läs vidare</p>
				<EssayList articles={related} />
				{/* The whole archive, from the end of every essay (DESIGN.md, »The Essäer Page«). */}
				<p class="ec-all"><SectionLink href="/essaer/">Alla essäer</SectionLink></p>
			</div>
		)}
	</aside>
)}

<style>
	/* A quiet index at the foot of each essay: where it sits in the graph (ämne /
	   trådar / tänkare) and the few essays nearest it. A hairline sets it apart
	   from the body without competing with the chronological prev/next nav. */
	.essay-connections {
		margin-top: var(--space-phi);
		padding-top: var(--space-unit);
		border-top: 1px solid var(--color-rule);
	}

	/* "Filed under" map. Each row is a small-caps label and its inline links,
	   aligned on a shared column so the three axes read as one compact key. */
	.ec-context {
		margin: 0 0 var(--space-unit);
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 0.4rem 1rem;
		align-items: baseline;
	}

	.ec-row {
		display: contents;
	}

	.ec-context dt {
		color: var(--color-muted);
		white-space: nowrap;
	}

	.ec-context dd {
		overflow-wrap: anywhere;
		margin: 0;
		font-family: var(--font-heading);
		font-size: var(--step--1);
		line-height: 1.5;
	}

	.ec-context a {
		/* These are navigation chips, not words in a sentence, so the 24px target
		   floor applies. They were 17px tall. inline-block + padding, with the row
		   gap tightened to absorb it so the key stays as compact as before. */
		display: inline-block;
		padding-block: 0.25rem;
		color: var(--color-accent);
		text-decoration: none;
		font-weight: 500;

		&:hover {
			text-decoration: underline;
			text-underline-offset: var(--underline-offset);
		}

	}

	.ec-sep {
		color: var(--color-divider);
		margin: 0 0.5rem;
	}

	.ec-heading {
		margin-bottom: var(--space-half);
		color: var(--color-muted);
	}

	/* Nästa del: the label, then the part as the front page's series cards set one, its
	   number in the brass every ordinal on the site is set in, over its title. */
	.ec-next {
		display: grid;
		margin: 0 0 var(--space-unit);
	}

	.ec-next .ec-heading {
		display: block;
	}

	.ec-next-link {
		display: block;
		color: inherit;
		text-decoration: none;

		&:hover .ec-next-title {
			text-decoration: underline;
			text-underline-offset: var(--underline-offset);
		}
	}

	.ec-next-del {
		display: block;
		margin-bottom: 0.2rem;
		font-family: var(--font-heading);
		font-size: var(--step--3);
		line-height: 1.4;
		letter-spacing: 0.01em;
		color: var(--color-brass-ink);
	}

	.ec-next-title {
		display: block;
		font-family: var(--font-display);
		font-size: var(--step-1);
		font-weight: 600;
		line-height: var(--card-title-leading);
		color: var(--color-text);
		text-wrap: balance;
	}

	.ec-all {
		margin: var(--space-unit) 0 0;
	}
</style>
