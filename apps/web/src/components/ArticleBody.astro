---
import type { MarkdownHeading } from "astro";
import Innehall from "./Innehall.astro";

interface Props {
	/** From `render(entry)` — the h2s become the contents list. */
	headings: MarkdownHeading[];
	/** A template's own hook on the prose element, e.g. `fordjupning-body`. */
	class?: string;
}

const { headings, class: className } = Astro.props;
---

{/* The one place the reading templates emit contents + prose. At 90rem the contents
    list becomes a sticky rail positioned against the body (`.reading-section`,
    styles/editorial.css), so the pairing is structural: an essay, an answer and a
    fördjupning must render the same wrapper or the rail lands somewhere else on each.
    Innehall renders nothing below two sections, and the wrapper is then layout-neutral. */}
<div class="reading-section">
	<Innehall headings={headings} />
	<div class:list={["article-body", "prose", className]}>
		<slot />
	</div>
</div>

<script>
	// The apparatus every reading template's prose carries — footnote and honorific
	// popovers, and the recitation players under quoted verses — wired where the prose is
	// emitted. Each template wired its own: answers wired only the players, so an answer
	// got its popovers only when the reader arrived from an essay, whose handler happened
	// to be still listening. Both inits are idempotent (one popover by id, one setup per
	// player).
	import { initFootnotePopovers } from "../scripts/footnote-popover";
	import { onPage } from "../scripts/page";
	import { initQuranPlayers } from "../scripts/quran-player";

	onPage(() => {
		if (!document.querySelector(".reading-section")) return;
		initFootnotePopovers();
		initQuranPlayers();
	});
</script>
