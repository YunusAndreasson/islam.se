---
import Base from "../layouts/Base.astro";
import type { Article } from "../lib/articles";
import ArticleHeader from "./ArticleHeader.astro";
import EssayList from "./EssayList.astro";
import SectionLink from "./SectionLink.astro";

interface Props {
	title: string;
	description: string;
	lead?: string;
	essays: Article[];
	kicker: string;
	countText: string;
	backHref: string;
	backLabel: string;
	/** An essäserie: the list is a reading order, and each row says which part it is. */
	numbered?: boolean;
	ogImage?: string;
	jsonLd: Record<string, unknown> | Record<string, unknown>[];
}

const {
	title,
	description,
	lead = description,
	essays,
	kicker,
	countText,
	backHref,
	backLabel,
	numbered = false,
	ogImage,
	jsonLd,
} = Astro.props;
---

<Base
	title={`${title} – islam.se`}
	description={description}
	{...(ogImage === undefined ? {} : { ogImage })}
	jsonLd={jsonLd}
>
	<main id="main" class="home">
		<ArticleHeader title={title} kicker={kicker} lead={lead}>
			<p class="label collection-count">{countText}</p>
		</ArticleHeader>

		<EssayList articles={essays} {...(numbered ? { class: "collection-delar" } : {})} />

		<p class="collection-back"><SectionLink href={backHref}>{backLabel}</SectionLink></p>
	</main>
</Base>

<style>
	/* AN ESSÄSERIE IS READ IN ORDER, and the page says so on every row: »Del 1«, »Del 2«
	   over the title, counted by the list itself. Without it the series page was the
	   ämne page with fewer rows, which is half of why the two were mistaken for one
	   another (user review, 2026-10-10). The counter sits in the title, so a screen
	   reader hears »Del 3, …« as the link's name.
	   ⚠️ :global — the list and its rows are EssayList's and EssayArchiveItem's. */
	:global(.collection-delar) {
		counter-reset: del;
	}

	:global(.collection-delar > .archive-item) {
		counter-increment: del;
	}

	:global(.collection-delar .archive-title)::before {
		content: "Del " counter(del);
		display: block;
		margin-bottom: 0.25rem;
		font-family: var(--font-heading);
		font-size: var(--step--3);
		font-weight: 400;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-meta);
	}
</style>
