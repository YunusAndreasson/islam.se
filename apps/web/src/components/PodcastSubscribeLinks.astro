---
import { Rss } from "@lucide/astro";
import type { HTMLAttributes } from "astro/types";
import { APPLE_PODCAST_URL, PODCAST_FEED, SPOTIFY_SHOW_URL } from "../lib/podcast";
import PodcastBrandIcon from "./PodcastBrandIcon.astro";

type Props = HTMLAttributes<"div"> & {
	actionClass: string;
	iconSize?: number;
	includeFeed?: boolean;
	showLabels?: boolean;
};

const {
	class: className,
	actionClass,
	iconSize = 14,
	includeFeed = false,
	showLabels = true,
	...rest
} = Astro.props;
---

<div {...rest} class:list={["subscribe-row", className]}>
	<a class={actionClass} href={APPLE_PODCAST_URL} target="_blank" rel="noopener" aria-label={showLabels ? undefined : "Apple Podcasts"}>
		<PodcastBrandIcon platform="apple" size={iconSize} />
		{showLabels && "Apple Podcasts"}
	</a>
	<a class={actionClass} href={SPOTIFY_SHOW_URL} target="_blank" rel="noopener" aria-label={showLabels ? undefined : "Spotify"}>
		<PodcastBrandIcon platform="spotify" size={iconSize} />
		{showLabels && "Spotify"}
	</a>
	{includeFeed && (
		<a class:list={[actionClass, "pill--quiet"]} href={PODCAST_FEED} aria-label={showLabels ? undefined : "RSS"}>
			<Rss size={iconSize} fill="currentColor" stroke-width={0} />
			{showLabels && "RSS"}
		</a>
	)}
</div>

<style>
	/* ⚠️ THE ROW LAYOUT LIVES HERE. Three callers once wrote their own `display: flex`
	   for this wrapper and all three were dead: the <div> is authored in THIS file.
	   It now forwards the caller's attributes, scope id included, so a caller's scoped
	   rule on its `class` does reach the wrapper — but the anchors are still authored
	   here, so a caller styles them through `:global()` under its wrapper class
	   (FloatingPlayer). The gap is tuned through `--subscribe-gap`. */
	.subscribe-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--subscribe-gap, 0.5rem);
	}

	/* RSS is the quieter, technical option — muted until hovered.

	   ⚠️ It lives HERE, not on the page that asks for the feed link. This rule sat in
	   podcast.astro for as long as the page has existed and never once applied: the
	   <a> is authored in THIS component, so it carries this component's scope id and
	   nothing else's, and a scoped selector written by the caller compiles to a
	   selector that matches nothing. The RSS pill has been rendering at full accent
	   strength beside Apple and Spotify the whole time. */
	.pill--quiet {
		color: var(--color-muted);
	}

	.pill--quiet:hover {
		color: var(--color-text);
	}
</style>
