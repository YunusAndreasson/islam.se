---
// One cornerstone card on the FAKTA hub: a photograph, the pillar /
// article-of-faith name, and a calm line — the whole card links to the existing
// answer at /svar/<slug>/. The photo is decorative (the label carries the meaning),
// so it renders with empty alt.
import type { ImageMetadata } from "astro";
import type { Article } from "../lib/articles";
import EssayImage from "./EssayImage.astro";
import Honorific from "./Honorific.astro";
import { CARD_WIDTHS } from "../lib/hero";

interface Props {
	href: string;
	label: string;
	blurb: string;
	/** Bespoke FAKTA photography for this card, when it exists (lib/fakta.ts). */
	art?: ImageMetadata;
	/** Essay whose hero is borrowed while `art` is missing; may be missing too. */
	image?: Article;
}

const { href, label, blurb, art, image } = Astro.props;
const hasPhoto = Boolean(art ?? image?.heroImage);
const imageSource = art ? { src: art } : image ? { article: image } : {};
---

<a class="fakta-card" href={href} data-astro-prefetch="viewport">
	{hasPhoto && (
		<div class="fakta-card-media media-frame">
			<EssayImage
				{...imageSource}
				alt=""
				widths={CARD_WIDTHS}
				sizes="(max-width: 768px) 50vw, 14rem"
			/>
		</div>
	)}
	<div class="fakta-card-text">
		<span class="fakta-card-label">{label}</span>
		{/* A bare ﷺ in the blurb string becomes the styled, labelled glyph. */}
		<p class="fakta-card-blurb">
			{blurb.split("ﷺ").map((part, i) => (i === 0 ? part : [<Honorific />, part]))}
		</p>
	</div>
</a>

<style>
	.fakta-card {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		color: inherit;
	}

	.fakta-card-media {
		margin-bottom: var(--space-half);
	}

	.fakta-card-media :global(img) {
		aspect-ratio: 3 / 2;
		width: 100%;
	}

	.fakta-card-label {
		display: block;
		font-family: var(--font-heading);
		font-size: var(--step-0);
		font-weight: 600;
		letter-spacing: 0;
		line-height: 1.2;
		color: var(--color-accent);
		text-wrap: balance;
	}

	.fakta-card-blurb {
		font-family: var(--font-body);
		font-size: var(--step--2);
		line-height: 1.5;
		color: var(--text-quiet);
		margin: 0.3rem 0 0;
		text-wrap: pretty;
	}

	.fakta-card:hover .fakta-card-label {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.15em;
	}

	.fakta-card:focus-visible {
		outline-offset: 0.4rem;
	}
</style>
