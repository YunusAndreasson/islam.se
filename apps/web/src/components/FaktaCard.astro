---
// One cornerstone card on the FAKTA hub: a photograph, the pillar /
// article-of-faith name, and a calm line — the whole card links to the existing
// answer at /svar/<slug>/. The photo is decorative (the label carries the meaning),
// so it renders with empty alt.
import type { ImageMetadata } from "astro";
import type { Article } from "../lib/articles";
import EssayImage from "./EssayImage.astro";
import WithHonorifics from "./WithHonorifics.astro";
import { CARD_WIDTHS } from "../lib/hero";

interface Props {
	href: string;
	label: string;
	blurb: string;
	/** Bespoke FAKTA photography for this card, when it exists (lib/fakta.ts). */
	art?: ImageMetadata;
	/** Essay whose hero is borrowed while `art` is missing; may be missing too. */
	image?: Article;
}

const { href, label, blurb, art, image } = Astro.props;
const hasPhoto = Boolean(art ?? image?.heroImage);
const imageSource = art ? { src: art } : image ? { article: image } : {};
---

<a class="fakta-card" href={href} data-astro-prefetch="viewport">
	{hasPhoto && (
		<div class="fakta-card-media media-frame">
			<EssayImage
				{...imageSource}
				alt=""
				widths={CARD_WIDTHS}
				sizes="(max-width: 768px) 50vw, 24rem"
			/>
		</div>
	)}
	<div class="fakta-card-text">
		<span class="fakta-card-label">{label}</span>
		<p class="fakta-card-blurb"><WithHonorifics text={blurb} /></p>
	</div>
</a>

<style>
	.fakta-card {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		color: inherit;
	}

	/* THE ONE PICTURE CARD (DESIGN.md, »A role is written once«): the inside of the
	   essay card and CardList, read from tokens.css (`--card-*`). This markup stays its
	   own for the ﷺ it renders as <Honorific/>. Until 2026-10-16 its title was a 19px
	   sans in the accent, so a pillar was set one way here and another in Grunden on the
	   front page, where the same names stand in Literata. */
	.fakta-card-media {
		margin-bottom: var(--card-media-gap);
	}

	.fakta-card-media :global(img) {
		aspect-ratio: 3 / 2;
		width: 100%;
	}

	.fakta-card-label {
		display: block;
		font-family: var(--font-display);
		font-variant-ligatures: common-ligatures;
		font-size: var(--step-1);
		font-weight: 600;
		letter-spacing: 0;
		line-height: var(--card-title-leading);
		color: var(--color-text);
		text-wrap: balance;
	}

	.fakta-card-blurb {
		font-family: var(--font-body);
		font-size: var(--step--2);
		line-height: var(--card-text-leading);
		color: var(--text-quiet);
		margin: var(--card-text-gap) 0 0;
		text-wrap: pretty;
	}

	.fakta-card:hover .fakta-card-label {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: var(--underline-offset);
	}

	.fakta-card:focus-visible {
		--focus-offset: 0.4rem;
	}
</style>
