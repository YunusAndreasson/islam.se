---
import { BookOpen, Download } from "@lucide/astro";
import { RITNINGAR } from "../lib/ritningar";
import PodcastSubscribeLinks from "./PodcastSubscribeLinks.astro";
import Ritning from "./Ritning.astro";

interface Props {
	count: number;
	variant?: "home" | "about";
}

const { count, variant = "home" } = Astro.props;
const year = new Date().getFullYear();
---

<section class:list={["bookpod", `bookpod--${variant}`]} aria-labelledby="bookpod-heading">
	{/* The homepage book shares the closing promotion region with PoddAppHome:
	    the drawn object, kicker, title, description and formats use the same grammar.
	    /om retains its typeset cover and combined book/podcast presentation. */}
	<div class="bookpod-inner">
		{
			variant === "home" ? (
				<a class="bookpod-mark" href="/samlingsvolym.pdf" download tabindex="-1" aria-hidden="true">
					<Ritning {...RITNINGAR.boken} hojd={[7, 10]} bredd={[7, 10]} />
				</a>
			) : (
				<a class="bookpod-cover" href="/samlingsvolym.pdf" download>
					<span class="bookpod-cover-brand">islam.se</span>
					<span class="bookpod-cover-title">Samlade<br />essäer</span>
					<span class="bookpod-cover-sub">Essäer om islamisk intellektuell tradition och svenskt kulturarv</span>
					<span class="bookpod-cover-ornament" aria-hidden="true"></span>
					<span class="bookpod-cover-year">{year}</span>
				</a>
			)
		}
		<div class="bookpod-text">
			{variant === "home" && (
				<>
					<h2 class="label home-kicker bookpod-kicker" id="bookpod-heading">Boken</h2>
					<h3 class="bookpod-titel">Samlade essäer</h3>
				</>
			)}
			{variant === "about" && <h2 id="bookpod-heading" class="bookpod-about-heading">Boken &amp; podden</h2>}
			<p class="bookpod-lead">
				{variant === "home"
					? `De ${count} essäerna finns samlade i en bok – som e-bok för läsplattan och som PDF för utskrift.`
					: `De ${count} essäerna finns samlade i en bok – som e-bok för läsplattan, som PDF för utskrift – och inlästa som podd.`}
			</p>
			<div class="bookpod-actions">
				{/* Two formats, one book, and they are not interchangeable: the PDF is the
				    typeset page — right for a desk, a printer, a big screen — while the EPUB
				    reflows, so it is the one that works on a phone or an e-reader. Naming
				    what each is FOR beats a row of file extensions; a reader who has to
				    guess picks the one they know and is sometimes wrong. */}
				<span class="bookpod-formats">
					<a class="bookpod-action" href="/samlingsvolym.epub" download>
						<BookOpen size={14} stroke-width={1.75} />
						E-bok
					</a>
					<a class="bookpod-action" href="/samlingsvolym.pdf" download>
						<Download size={14} stroke-width={1.75} />
						PDF
					</a>
				</span>
				{variant !== "home" && <PodcastSubscribeLinks class="bookpod-listen" actionClass="bookpod-action" />}
			</div>
		</div>
	</div>
</section>

<style>
	.bookpod-inner {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: center;
		gap: clamp(2rem, 5vw, 4rem);
	}

	/* ---- The book cover — a typographic rendering of the PDF title page,
	   presented as an object: A-series proportion, hairline edge, soft lift,
	   and a thin spine highlight along the binding edge. ---- */
	.bookpod-cover {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: flex-start;
		text-align: center;
		text-decoration: none;
		width: clamp(11rem, 22vw, 15rem);
		aspect-ratio: 1 / 1.414;
		padding: 12% 10% 9%;
		color: var(--color-text);
		background: var(--surface-1);
		border: 1px solid var(--color-divider);
		border-radius: 1px 3px 3px 1px;
		/* The spine stays (the inset); the float is a trace. A 2.5rem drop shadow was
		   the last lifted card on a page that now separates by ground and space. */
		box-shadow:
			inset 0.4rem 0 0.6rem -0.55rem rgb(0 0 0 / 0.35),
			0 0.6rem 1.2rem -0.9rem rgb(0 0 0 / 0.22);
		transition: transform 0.4s cubic-bezier(0.2, 0, 0.1, 1), box-shadow 0.4s ease;

		&:hover {
			transform: translateY(-3px);
			box-shadow:
				inset 0.4rem 0 0.6rem -0.55rem rgb(0 0 0 / 0.35),
				0 1rem 1.6rem -1rem rgb(0 0 0 / 0.26);
		}

		&:focus-visible {
			outline-offset: 4px;
		}
	}

	/* The cover sits on --surface-1 (a paper wash). --color-muted now clears AA on that
	   tint in both schemes (5.1:1 light / 8.1:1 dark, tokens.css), so this is no longer a
	   workaround — --text-meta is kept because a cover label wants a touch more presence
	   than a caption, and that is the tier for it. */
	.bookpod-cover {
		--cover-label: var(--text-meta);
	}

	.bookpod-cover-brand {
		font-family: var(--font-heading);
		font-size: var(--step--5);
		font-weight: 600;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--cover-label);
	}

	/* The book face's display cut, not Source Sans Light: set in the apparatus face at
	   300 the cover read as a placeholder, a template's grey title block, on the one
	   object on the page that is meant to look like a book. */
	.bookpod-cover-title {
		font-family: var(--font-headline);
		font-size: 2rem;
		font-weight: 500;
		line-height: 1.02;
		letter-spacing: -0.01em;
		margin-top: 1em;
	}

	.bookpod-cover-sub {
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--step--5);
		line-height: 1.4;
		color: var(--cover-label);
		margin-top: 0.9em;
		text-wrap: balance;
	}

	.bookpod-cover-ornament {
		width: 4.5rem;
		height: 0.85rem;
		margin-top: auto;
		margin-bottom: 0.9em;
		background: var(--color-divider);
		mask: url("/ornament.svg?v=4") center / 100% 100% no-repeat;
	}

	.bookpod-cover-year {
		font-family: var(--font-heading);
		font-size: var(--step--5);
		letter-spacing: 0.1em;
		color: var(--cover-label);
	}

	/* ---- Text + actions ---- */
	.bookpod-about-heading {
		margin-top: 0;
		margin-bottom: var(--space-half);
	}

	.bookpod-lead {
		font-family: var(--font-body);
		font-size: var(--step--1);
		line-height: 1.55;
		color: var(--text-body);
		margin: 0 0 var(--space-unit);
		max-width: 28rem;
	}

	/* The book action (PDF) sits apart from the two podcast links, which are tucked
	   close together — so the row still reads as two things (book · podcast) by
	   proximity alone, without spelling it out. The larger gap separates the book from
	   the podcast pair; the tight .bookpod-listen gap binds the two platforms. */
	.bookpod-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: clamp(1.25rem, 3.5vw, 2.25rem);
	}

	.bookpod-listen {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.bookpod-action {
		min-height: 2.75rem;
	}

	/* The two book formats belong together and apart from the podcast links: they are
	   one object offered twice, not three separate things to choose between. A tighter
	   gap than .bookpod-actions' own says so without a heading. */
	.bookpod-formats {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		/* 0.75rem, not the 1.25rem the outer row uses. Two things: it marks the two
		   formats as one group against the podcast links beside them, and it is what
		   makes the pair fit the about-page column — 432rem-worth of text column after
		   the cover and the gutter, against ~420 of buttons. At 1.25 they wrapped, and a
		   stacked pair beside a paired set of podcast links reads as four choices rather
		   than one book and one podcast. */
		gap: 0.5rem 0.75rem;
	}


	/* The book is the second row of the closing promotion region. The parent owns
	   its ground and outer spacing; /om keeps the standalone presentation. */
	.bookpod--home {
		/* No margin under the last band: <main> is a container (layout containment), so
		   it would not collapse into the footer's own and left a 190px hole of paper
		   between the band's edge and the footer's first line. */
		margin-block: var(--space-section) 0;
	}

	/* Share PoddAppHome's drawing column on desktop. */
	.bookpod--home .bookpod-inner {
		grid-template-columns: 10rem minmax(0, 1fr);
		align-items: start;
		gap: 1.75rem;
	}

	/* As PoddAppHome's mark: on the words' edge above them on a phone, on the column's
	   right edge beside them. No hover lift — a transform isolates the drawing's blend
	   and shows its paper as a square (Ritning.astro). */
	.bookpod-mark {
		display: block;
		justify-self: start;
	}

	@media (width >= 64rem) {
		.bookpod-mark {
			justify-self: end;
		}
	}

	.bookpod-kicker {
		margin: 0;
	}

	.bookpod-titel {
		margin: var(--space-half) 0 0;
		font-size: var(--step-1);
		font-weight: 600;
		line-height: 1.25;
	}

	.bookpod--home .bookpod-lead {
		max-inline-size: 32rem;
		margin: 0.35rem 0 var(--space-unit);
		line-height: 1.5;
	}

	/* The about-page variant lives in the 42rem reading column: smaller cover,
	   centred actions, so it mirrors the homepage module without competing. */
	.bookpod--about {
		margin-block: var(--space-phi);
	}

	.bookpod--about .bookpod-cover {
		width: clamp(9rem, 30vw, 11rem);
	}

	@media (width <= 768px) {
		.bookpod-cover-title {
			font-size: 1.5rem;
		}

		.bookpod-inner {
			grid-template-columns: 1fr;
			justify-items: center;
			gap: var(--space-unit);
			text-align: center;
		}

		.bookpod-lead {
			max-width: none;
		}

		.bookpod-actions {
			justify-content: center;
		}

		.bookpod-listen {
			justify-content: center;
		}

		/* The front page keeps the band's grammar on a phone too, as PoddAppHome does:
		   the object above the words at 7rem, flush left on their edge, not a centred
		   poster. */
		.bookpod--home .bookpod-inner {
			grid-template-columns: minmax(0, 1fr);
			justify-items: start;
			gap: var(--space-unit);
			text-align: start;
		}

		.bookpod--home .bookpod-actions {
			justify-content: flex-start;
		}
	}
	/* Match the podcast/app drawings: above the text through tablet widths,
	   beside it only when their shared 10rem illustration column has room. */
	@media (width < 64rem) {
		.bookpod--home .bookpod-inner {
			grid-template-columns: minmax(0, 1fr);
			justify-items: start;
			gap: var(--space-unit);
			text-align: start;
		}
	}

</style>
