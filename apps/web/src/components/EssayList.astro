---
import type { HTMLAttributes } from "astro/types";
import type { Article } from "../lib/articles";
import EssayArchiveItem from "./EssayArchiveItem.astro";

type Props = HTMLAttributes<"ul"> & {
	articles: Article[];
	itemVariant?: "row" | "card";
	showReadFlag?: boolean;
	showMinutesAttr?: boolean;
};

const {
	articles,
	itemVariant = "row",
	showReadFlag = false,
	showMinutesAttr = false,
	class: className,
	...attrs
} = Astro.props;

const isCardList = itemVariant === "card";
---

<ul {...attrs} class:list={[!isCardList && "archive-list", className]}>
	{articles.map((article) => (
		<EssayArchiveItem
			article={article}
			variant={itemVariant}
			showReadFlag={showReadFlag}
			showMinutesAttr={showMinutesAttr}
		/>
	))}
</ul>
