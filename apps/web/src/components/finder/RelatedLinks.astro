---
interface Props {
 label: string;
 links: { href: string; label: string }[];
}
const { label, links } = Astro.props;
---
<nav class="finder-links" aria-label={label}>
 {links.map(link => <a href={link.href}><span>{link.label}</span><span aria-hidden="true">→</span></a>)}
</nav>
<style>
 .finder-links { margin-top: var(--space-unit); border-top: 1px solid var(--color-divider); }
 a { display: flex; justify-content: space-between; gap: 1rem; min-height: 2.75rem; padding-block: .85rem; border-bottom: 1px solid var(--color-divider); text-decoration: none; font-family: var(--font-heading); }
 a:hover { text-decoration: underline; }
</style>
