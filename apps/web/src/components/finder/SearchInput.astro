---
import { Search } from "@lucide/astro";
interface Props {
 id: string;
 placeholder: string;
 controls?: string;
 class?: string;
}
const { id, placeholder, controls, class: className } = Astro.props;
---
<div class:list={["finder-input", className]}>
 <Search size={20} aria-hidden="true" />
 <input id={id} type="search" placeholder={placeholder} autocomplete="off" spellcheck="false" aria-controls={controls} />
</div>
<style>
 .finder-input { display: flex; flex: 1 1 20rem; align-items: center; gap: .65rem; min-width: 0; padding-inline: 1rem; border: 1px solid var(--color-divider); border-radius: var(--radius-sm); background: var(--color-bg); color: var(--color-muted); }
 .finder-input:focus-within { border-color: var(--color-accent); outline: 2px solid var(--color-accent); outline-offset: 2px; }
 svg { flex: none; }
 input { width: 100%; min-width: 0; min-height: 3rem; padding-block: .75rem; border: 0; background: transparent; color: var(--color-text); font-family: var(--font-body); font-size: 1rem; }
 input:focus-visible { outline: none; }
</style>
