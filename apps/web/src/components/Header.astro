---
import { Menu, Moon, Search, Sun } from "@lucide/astro";
import {
	computePrayerTimes,
	formatTime,
	nextPrayerKeyAt,
	PRAYER_LABELS,
} from "../lib/bonetider/prayer-times";
import Wordmark from "./Wordmark.astro";
import { DEFAULT_COORDS, DEFAULT_SETTINGS } from "../lib/bonetider/settings";
import { solarParams, sunPositionAt } from "../lib/bonetider/solar/sun";
import { MAST_SECTION_LINKS, MAST_UTILITY_LINKS } from "../lib/navigation";

const path = Astro.url.pathname;
const isHome = path === "/";
const here = (p: string) => path === p || path === `${p}/`;

// Next-prayer chip in the mast: a build-time Stockholm baseline (no flash); the
// client script (bonetider-field) recomputes it live for the real now and the
// visitor's saved location, and toggles the sun/moon icon by day vs night.
const mastNow = new Date();
const mastTimes = computePrayerTimes(DEFAULT_COORDS, mastNow, DEFAULT_SETTINGS);
const mastNextKey = nextPrayerKeyAt(mastTimes, mastNow.getTime()) ?? "fajr";
const { declRad: mastDecl, eotMin: mastEot } = solarParams(mastNow);
const mastUtcMin = mastNow.getUTCHours() * 60 + mastNow.getUTCMinutes();
const mastIsDay =
	sunPositionAt(DEFAULT_COORDS.latitude, DEFAULT_COORDS.longitude, mastUtcMin, mastDecl, mastEot)
		.altDeg >= 0;
---

{/* ⚠️ transition:name, NOT transition:persist. Persisting keeps the original nav
    node across swaps, which freezes the server-rendered aria-current on whichever
    page was loaded first. Naming it lets Astro swap in the correct mast while
    keeping it its own transition group, so it stays visually still. */}
<header class="site-header" transition:name="mast">
	<nav class="site-nav" aria-label="Huvudnavigering">
		<a class="site-home" href="/" aria-current={isHome ? "page" : undefined}><Wordmark /></a>
		{/* One row, two registers. The sections read at full strength; the utilities
		    follow behind a hairline, a step smaller and a step down the text ramp.
		    They were on a second row and it read as an afterthought — three centred
		    labels above four pushed to the right corner. */}
		<div class="site-links-wrap">
			<ul class="site-links">
				{MAST_SECTION_LINKS.map((l) => (
					<li><a href={l.href} aria-current={here(l.href) ? "page" : undefined}>{l.label}</a></li>
				))}
			</ul>
			<ul class="site-links site-links--util">
				{MAST_UTILITY_LINKS.map((l) => (
					<li><a href={l.href} aria-current={here(l.href) ? "page" : undefined}>{l.label}</a></li>
				))}
			</ul>
		</div>
		<div class="site-nav-end">
			<a
				class="bonetider-mast mast-prayer"
				href="/bonetider/"
				data-name={DEFAULT_COORDS.name}
				data-lat={DEFAULT_COORDS.latitude}
				data-lon={DEFAULT_COORDS.longitude}
				data-variant="strip"
				data-fixed="0"
				aria-label={`Nästa bön: ${PRAYER_LABELS[mastNextKey]} ${formatTime(mastTimes[mastNextKey])} – visa bönetider`}
			>
				<span class="bs-icon mast-prayer-icon" data-day={mastIsDay ? "true" : "false"} aria-hidden="true">
					<Sun class="mp-sun" stroke-width={1.6} />
					<Moon class="mp-moon" stroke-width={1.6} />
				</span>
				<span class="bf-next-name mast-prayer-name">{PRAYER_LABELS[mastNextKey]}</span>
				<span class="bf-next-time mast-prayer-time">{formatTime(mastTimes[mastNextKey])}</span>
			</a>
			{/* The theme switch used to stand here. It moved into the palette's utility
			    rail (SearchOverlay): a once-a-session choice was holding permanent mast
			    space next to a per-visit one, and on a phone that space is the whole
			    difference between a crowded mast and a calm one. Down there it also has
			    room for words, so it offers System/Ljust/Mörkt instead of the two states
			    a 34px glyph could carry. */}

			{/* No aria-label: the accessible name comes from the visible label span, which
			    CSS swaps "Sök" (pointer) ↔ "Meny" (touch) by media query. A fixed aria-label
			    matches only one, tripping WCAG 2.5.3 (label-in-name) on the other; letting the
			    visible text be the name keeps them in sync in every mode. The ⌘K kbd is
			    aria-hidden, so it never pollutes the name. */}
			<button class="search-trigger" type="button" aria-keyshortcuts="Meta+K Control+K">
			<Search class="search-trigger-icon search-trigger-icon--search" size={16} stroke-width={1.75} />
			<Menu class="search-trigger-icon search-trigger-icon--menu" size={16} stroke-width={1.75} />
			<span class="search-trigger-label search-trigger-label--search">Sök</span>
			<span class="search-trigger-label search-trigger-label--menu">Meny</span>
			<kbd class="search-trigger-kbd" aria-hidden="true"><span class="search-trigger-cmd">⌘</span>K</kbd>
		</button>
		</div>
	</nav>
</header>

<script>
	// Boot the prayer-times client glue site-wide so the mast's next-prayer chip ticks
	// live (real now + the visitor's saved location). Idempotent: the module self-boots
	// once and only mounts elements it hasn't already.
	import "../scripts/bonetider-field";

	// The mast is wordmark + a single palette trigger now (navigation lives in
	// the command palette). The only behaviour kept here is the auto-hide: the
	// mast slides away on scroll-down, returns on scroll-up.
	let scrollCtrl: AbortController | null = null;

	function bindHeader() {
		const header = document.querySelector(".site-header");
		if (!header) return;

		scrollCtrl?.abort();
		scrollCtrl = new AbortController();

		let lastY = window.scrollY;
		let upDist = 0;
		const threshold = 10;
		// The under-header fade shade only makes sense once content actually passes
		// underneath. Mirrored onto <html> for anything else that sticks (the category
		// row on /svar/ shades itself the same way).
		const setScrolled = (on: boolean) => {
			header.classList.toggle("is-scrolled", on);
			document.documentElement.classList.toggle("page-scrolled", on);
		};
		setScrolled(lastY > 4);
		// Mirrored onto <html> because the mast is a sibling of every page's content:
		// an element that sticks BELOW the mast (the category row on /svar/) has no CSS
		// route to the mast's own class. Inert on every page that ignores it.
		const setHidden = (on: boolean) => {
			header.classList.toggle("header-hidden", on);
			document.documentElement.classList.toggle("mast-hidden", on);
		};
		setHidden(false);
		// The mast's padding is fluid, so its height is not a number a stylesheet can
		// state. Anything that sticks below it reads this instead of guessing.
		const publishHeight = () =>
			document.documentElement.style.setProperty(
				"--mast-height",
				`${(header as HTMLElement).offsetHeight}px`,
			);
		publishHeight();
		window.addEventListener("resize", publishHeight, {
			passive: true,
			signal: scrollCtrl.signal,
		});
		window.addEventListener(
			"scroll",
			() => {
				const y = window.scrollY;
				const dy = y - lastY;
				setScrolled(y > 4);
				if (y < threshold) {
					upDist = 0;
					setHidden(false);
				} else if (dy > 0) {
					upDist = 0;
					// Don't hide until the mast has fully scrolled past itself.
					if (y > (header as HTMLElement).offsetHeight) setHidden(true);
				} else if (dy < 0) {
					// Accumulate slow upward panning across events — a single-event
					// delta never reaches the threshold on smooth touch scrolling.
					upDist -= dy;
					if (upDist > threshold) setHidden(false);
				}
				lastY = y;
			},
			{ passive: true, signal: scrollCtrl.signal },
		);

		// A hidden mast still holds focusable controls — reveal it the moment
		// keyboard focus lands inside so focus is never on an invisible element.
		header.addEventListener("focusin", () => setHidden(false), {
			signal: scrollCtrl.signal,
		});
	}

	document.addEventListener("astro:page-load", bindHeader);
</script>
