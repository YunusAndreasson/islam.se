---
import { amnenWithEssays } from "../lib/amnen";
import { type Article, getArticles } from "../lib/articles";
import EssayList from "./EssayList.astro";
import HomeTabs from "./HomeTabs.astro";
import Kicker from "./Kicker.astro";
import SectionLink from "./SectionLink.astro";

interface Props { exclude?: Set<string>; }
const { exclude } = Astro.props;
const groups = amnenWithEssays(await getArticles()).filter(({ amne }) => amne.slug !== "norden").map(({ amne, essays }) => {
	const available = essays.filter((essay) => !exclude?.has(essay.slug));
	// Real article images only; illustrated essays lead, with text-only essays
	// filling subjects whose archive contains fewer than three illustrations.
	const pick = (items: Article[]) => [
		...items.filter((essay) => essay.heroImage),
		...items.filter((essay) => !essay.heroImage),
	].slice(0, 3);
	return { amne, shown: pick(available.length ? available : essays) };
});
---

<section class="amnen home-movement" aria-labelledby="amnen-kicker" data-home-tabs>
	{/* A kicker like its sibling's (Essäserier), not a title: the two shelvings of the
	    essays open alike. As a 33px title over a tracked label it read as that
	    section's parent, and was the only section on the page without the brass point
	    (2026-10-10). */}
	<Kicker form="head" as="h2" id="amnen-kicker">Essäer efter ämne</Kicker>
	<HomeTabs
		aria-label="Välj ämne"
		tabs={groups.map(({ amne }) => ({ id: `subject-tab-${amne.slug}`, href: `/amnen/${amne.slug}/`, label: amne.name }))}
	/>
	{groups.map(({ amne, shown }, i) => (
		<div class="amnen-panel" id={`subject-panel-${amne.slug}`} data-tab-panel hidden={i !== 0}>
			<p class="home-tab-framing">{amne.framing}</p>
			<EssayList articles={shown} itemVariant="card" class="home-cards" cardSizes="(min-width: 60rem) 31vw, (min-width: 40rem) 45vw, 100vw" />
			<p class="home-tab-more"><SectionLink href={`/amnen/${amne.slug}/`}>Alla essäer om {amne.omForm}</SectionLink></p>
		</div>
	))}
</section>
