---
import { FAKTA_CLUSTERS } from "../lib/fakta";
import { RITNINGAR } from "../lib/ritningar";
import Ritning from "./Ritning.astro";
import SectionLink from "./SectionLink.astro";

/** The homepage introduction: an illustrated opening, five actions in reading
 * order, then six beliefs grouped at a quieter rank. Shared alignments and space
 * carry the hierarchy without adding cards or rules to the editorial canvas. */

// No count in the closing link (2026-09-27): none of the publications this site
// measures itself against (DN, SvD, NE, Bokmässan) puts a number in an onward link.
const [pelare, trosartiklar] = FAKTA_CLUSTERS;
---

<section class="fakta-band grunden home-movement" aria-labelledby="fakta-band-title">
	<div class="grunden-head">
		<p class="label home-kicker">Fakta om islam</p>
		<h2 class="grunden-title" id="fakta-band-title">
			<a href="/vad-ar-islam/">Vad är islam?</a>
		</h2>
		<p class="grunden-lead">
			Islam bygger på tron på en enda Gud och på Muhammed ﷺ som hans sändebud.
		</p>
		<p class="grunden-intro-link">
			<SectionLink href="/vad-ar-islam/">Läs introduktionen till islam</SectionLink>
		</p>
		<div class="grunden-ritning">
			<Ritning
				{...RITNINGAR.grunden}
				fyll
				ankare="vanster"
				hojd={[4.5, 10]}
				bredd={[7, 14]}
				sizes="(min-width: 79rem) 23.3rem, (min-width: 48rem) calc((100vw - 10rem) / 3), 7rem"
			/>
		</div>
	</div>

	{pelare && (
		<div class="grunden-group" aria-labelledby="grunden-pelare">
			<h3 class="label grunden-group-head" id="grunden-pelare">
				{pelare.overview ? <a href={`/svar/${pelare.overview}/`}>{pelare.name}</a> : pelare.name}
			</h3>
			<ol class="grunden-pelare">
				{pelare.items.map((item, i) => (
					<li class="grunden-item">
						<span class="grunden-num" aria-hidden="true">{i + 1}</span>
						<a class="grunden-name" href={`/svar/${item.svarSlug}/`}>{item.label}</a>
						<span class="grunden-tr" lang="ar-Latn">{item.translit}</span>
						<p class="grunden-blurb">{item.blurb}</p>
					</li>
				))}
			</ol>
		</div>
	)}

	{trosartiklar && (
		<div class="grunden-group" aria-labelledby="grunden-tro">
			<h3 class="label grunden-group-head" id="grunden-tro">
				{trosartiklar.overview ? <a href={`/svar/${trosartiklar.overview}/`}>{trosartiklar.name}</a> : trosartiklar.name}
			</h3>
			<ul class="grunden-tro">
				{trosartiklar.items.map((item) => (
					<li class="grunden-item">
						<a class="grunden-name" href={`/svar/${item.svarSlug}/`}>{item.label}</a>
						<span class="grunden-tr" lang="ar-Latn">{item.translit}</span>
						<p class="grunden-blurb">{item.blurb}</p>
					</li>
				))}
			</ul>
		</div>
	)}

	<p class="grunden-more">
		<SectionLink href="/svar/">Alla frågor och svar</SectionLink>
	</p>
</section>

<style>
	/* The kicker and the title beside the drawing, the lead under both on a phone;
	   beside the lead too once there is room. */
	.grunden-head {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		grid-template-areas:
			"kicker ritning"
			"titel ritning"
			"lead lead"
			"intro intro";
		column-gap: var(--space-unit);
		margin-bottom: var(--space-phi);
	}

	.grunden-head > :global(.home-kicker) {
		grid-area: kicker;
	}

	.grunden-title {
		grid-area: titel;
	}

	.grunden-lead {
		grid-area: lead;
	}

	.grunden-intro-link {
		grid-area: intro;
		margin: var(--space-control) 0 0;
		font-size: var(--step--2);
	}

	.grunden-ritning {
		grid-area: ritning;
		align-self: end;
	}

	/* As the site's section openings are (PageHead): the drawing as tall as the opening,
	   kicker to the introduction link. Its column is the movement's own third, standing
	   on the third line (x 950 at 1440) where »Skrifterna«, »Domedagen« and »Ödet« start
	   below: on the canvas's edge it hung 400px from the words on a line nothing near it
	   drew — the pillar rows are ragged and end 200px short (user review, 2026-09-26). */
	@media (width >= 48rem) {
		.grunden-head {
			grid-template-columns: minmax(0, 1fr) calc((100% - 2 * var(--grid-gutter)) / 3);
			grid-template-areas:
				"kicker ritning"
				"titel ritning"
				"lead ritning"
				"intro ritning";
			grid-template-rows: auto auto auto 1fr;
			column-gap: var(--grid-gutter);
		}

		.grunden-ritning {
			position: relative;
			align-self: stretch;
			min-block-size: 7rem;
		}
	}

	/* The one visible heading on the page carrying the head term: a real h2 at the
	   section-heading rung, in the text cut like every other heading on the page. */
	.grunden-title {
		font-size: var(--step-3);
		margin: 0 0 var(--space-half);
	}

	.grunden-title a {
		color: inherit;
		text-decoration: none;

		&:hover {
			text-decoration: underline;
			text-decoration-thickness: 1px;
			text-underline-offset: 0.12em;
		}
	}

	.grunden-lead {
		margin: 0;
		max-width: 34em;
		font-size: var(--step-0);
		line-height: 1.55;
		color: var(--text-body);
		text-wrap: pretty;
	}

	.grunden-group + .grunden-group {
		margin-top: var(--space-phi2);
	}

	.grunden-group-head {
		margin: 0 0 var(--space-group);
		font-size: var(--step--2);
		font-weight: 600;
		color: var(--text-quiet);
	}

	.grunden-group-head a {
		color: inherit;
		text-decoration: none;

		&:hover {
			color: var(--color-accent);
			text-decoration: underline;
			text-underline-offset: var(--underline-offset);
		}
	}

	.grunden-pelare,
	.grunden-tro {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-unit) var(--grid-gutter);
	}

	.grunden-num {
		display: block;
		/* Match the title's metrics so each ordinal reads as part of its row. */
		font-family: var(--font-display);
		font-size: var(--step-1);
		font-weight: 400;
		line-height: 1.2;
		color: var(--color-brass-ink);
		font-variant-numeric: lining-nums tabular-nums;
	}

	.grunden-name {
		display: block;
		font-family: var(--font-display);
		font-size: var(--step-1);
		font-weight: 600;
		line-height: 1.2;
		color: var(--color-text);
		text-decoration: none;

		&:hover {
			text-decoration: underline;
			text-decoration-thickness: 1px;
			text-underline-offset: var(--underline-offset);
		}
	}

	.grunden-pelare .grunden-name {
		margin-top: var(--space-half);
	}

	.grunden-tr {
		display: block;
		margin-top: 0.2rem;
		font-family: var(--font-body);
		font-style: italic;
		font-size: var(--step--2);
		color: var(--color-muted);
	}

	.grunden-blurb {
		margin: var(--space-control) 0 0;
		font-size: var(--step--2);
		line-height: 1.5;
		color: var(--text-quiet);
		text-wrap: pretty;
	}

	/* Below the wide layout, keep every pillar as a numbered row and group the
	   beliefs in pairs. Tablet widths retain their glosses; phones show the terms.
	   56.25rem is the mast's own line (900px, where its links collapse into Meny): at
	   56rem the two turned 4px apart, a band of widths with the narrow mast over the
	   wide pillars. */
	@media (width < 56.25rem) {
		.grunden-tro {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--space-group) var(--space-unit);
		}

		/* A pillar on a phone: the numeral beside the name, the gloss beneath — five
		   rows of a numeral alone would cost 450px of phone. */
		.grunden-pelare .grunden-item {
			display: grid;
			grid-template-columns: auto minmax(0, 1fr);
			grid-template-areas:
				"num name"
				"num tr"
				".   blurb";
			column-gap: 0.9rem;
			align-items: baseline;
		}

		.grunden-pelare .grunden-num {
			grid-area: num;
		}

		.grunden-pelare .grunden-name {
			grid-area: name;
			margin-top: 0;
		}

		.grunden-pelare .grunden-tr {
			grid-area: tr;
		}

		.grunden-pelare .grunden-blurb {
			grid-area: blurb;
		}

		.grunden-tro .grunden-name {
			font-size: var(--step-0);
		}
	}

	@media (width < 48rem) {
		.grunden-tro .grunden-blurb {
			display: none;
		}
	}

	/* Wide rows and the beliefs share column starts. Keep each numeral close to
	   its name so proximity identifies the pair before the eye crosses to the gloss. */
	@media (width >= 56.25rem) {
		.grunden-tro {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			row-gap: var(--space-phi);
		}

		.grunden-pelare .grunden-item {
			display: grid;
			grid-template-columns: 2.25rem max(15rem, calc((100% - 2 * var(--grid-gutter)) / 3 - 2.25rem)) minmax(0, 1fr);
			grid-template-areas:
				"num name blurb"
				"num tr   blurb";
			align-items: baseline;
		}

		.grunden-pelare .grunden-num {
			grid-area: num;
		}

		.grunden-pelare .grunden-name {
			grid-area: name;
			margin-top: 0;
		}

		.grunden-pelare .grunden-tr {
			grid-area: tr;
		}

		.grunden-pelare .grunden-blurb {
			grid-area: blurb;
			margin: 0 0 0 var(--grid-gutter);
			max-width: 44rem;
			font-size: var(--step--1);
		}
	}

	@media (width < 23rem) {
		.grunden-head {
			column-gap: var(--space-half);
		}

		.grunden-title {
			font-size: var(--step-2);
		}
	}

	.grunden-more {
		margin: var(--space-phi) 0 0;
		font-family: var(--font-heading);
		font-size: var(--step--2);
	}
</style>
