---
type MarkesdagRow = {
	name: string;
	note?: string;
	startISO: string;
	endISO?: string;
	gregorian: string;
	hijriLabel: string;
	hidden?: boolean;
	/** Rail only: »om 136 dagar« on the first upcoming row, empty on the rest. */
	until?: string;
};

interface Props {
	rows: readonly MarkesdagRow[];
	/** `rail` stacks the row (date, name, Hijri) and drops the explanatory note —
	 *  see the .md-list--rail block in styles/layout.css for why the note goes. */
	variant?: "full" | "rail";
	/** How many upcoming rows to keep visible. Published to the DOM as `data-max`
	 *  and read by scripts/markesdagar.ts, so two lists on one page can hold
	 *  different counts. OMIT IT to opt out: /det-islamiska-aret lists every
	 *  upcoming observance and runs its own year-aware filter, and the shared
	 *  script only claims lists that carry the attribute. */
	max?: number;
}

const { rows, variant = "full", max } = Astro.props;

const isRail = variant === "rail";
---

<ul class:list={["md-list", isRail && "md-list--rail"]} data-max={max}>
	{rows.map((e) => (
		<li class="md-row" data-end={e.endISO ?? e.startISO} hidden={e.hidden}>
			<p class="label md-greg">
				<time datetime={e.startISO}>{e.gregorian}</time>
				{isRail && <span class="md-until" data-until>{e.until}</span>}
			</p>
			<div class="md-body">
				<p class="md-name">{e.name}</p>
				{e.note && !isRail && <p class="md-note">{e.note}</p>}
			</div>
			<p class="md-hijri">{e.hijriLabel}</p>
		</li>
	))}
</ul>

{/* The list owns the script that keeps its `max` honest against the reader's clock, as
    Arslinje owns its own. Its only import sat in a component deleted on 2026-10-11, and
    the front page's next observance stood frozen at the build's date until it was put
    back here. A list without `max` is left to its page. */}
<script>
	import "../scripts/markesdagar";
</script>
