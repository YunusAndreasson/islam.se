---
import { amneByName } from "../lib/amnen";
import type { Article } from "../lib/articles";
import { inlineMarkdown } from "../lib/articles";
import { FEATURE_HERO_SIZES, FEATURE_HERO_WIDTHS } from "../lib/hero";
import { heroPlaceholder } from "../lib/lqip";
import ArticleMeta from "./ArticleMeta.astro";
import EssayImage from "./EssayImage.astro";
import HomeHead from "./HomeHead.astro";

interface Props {
	article: Article;
	/** The next essays, as a rail of titles beside the lead: titles and dates only. No
	 *  pictures (the lead's photograph is the only one on the first screen) and no decks
	 *  (the lead has one; four more made the top a wall of text). Six stand in the rail
	 *  on a wide screen; a phone and a tablet show the first three. */
	also?: Article[];
}

const { article, also = [] } = Astro.props;

// Inlined 20px blur of this very photograph, so the spread is never an empty
// rectangle while the real file lands. ~150 bytes, no extra request.
const placeholder = await heroPlaceholder(article.slug);

// The eyebrow names the DEPARTMENT this essay belongs to, not the shelf it was put
// on. "Senast publicerat" told a reader the one thing the position on the page
// already told them; the ämne tells them what the piece is about and hands them a
// way further in. Falls back to the old literal for the single essay that carries
// no category, so the eyebrow is never empty.
const amne = article.category ? amneByName.get(article.category) : undefined;

// A headline is set by its length, as on any front page: past this many characters it
// steps down a size on a wide screen, where 64px would stand it on four lines. Three
// titles in the archive pass 44 characters and one passes 50 (2026-10-10).
const LONG_TITLE = 50;
---

{/* THE LEAD. Two links to one essay: the headline (the real, focusable link) and
    the picture (a pointer convenience, hidden from the tab order and from assistive
    tech so the essay is announced once). The deck and meta sit outside both — a
    paragraph wrapped in a link reads as one long link name. */}
<section class="feature home-movement" aria-labelledby="feature-title">
	<div class="feature-text">
		<p class="label home-kicker feature-kicker">
			{amne ? <a href={`/amnen/${amne.slug}/`}>{amne.name}</a> : "Senast publicerat"}
		</p>
		<h2 id="feature-title" class:list={["feature-title", { "feature-title--long": article.title.length > LONG_TITLE }]}>
			<a class="feature-link" href={`/${article.slug}/`} data-astro-prefetch="viewport">{article.title}</a>
		</h2>
		{article.description && (
			<p class="feature-lead home-ingress" set:html={inlineMarkdown(article.description)} />
		)}
		<div class="feature-meta-row">
			<ArticleMeta class="label feature-meta" publishedAt={article.publishedAt} readingTime={article.readingTime} />
		</div>
	</div>
	<a class="feature-media-link" href={`/${article.slug}/`} tabindex="-1" aria-hidden="true">
		<div
			class="feature-media media-frame"
			style={placeholder ? `--lqip: url("${placeholder}")` : undefined}
		>
			<EssayImage
				article={article}
				widths={FEATURE_HERO_WIDTHS}
				sizes={FEATURE_HERO_SIZES}
				loading="eager"
				fetchpriority="high"
			/>
		</div>
	</a>
	{also.length > 0 && (
		<section class="feature-also" aria-labelledby="feature-also-rubrik">
			{/* The way on to every essay stands in the head row, as on the other
			    movements, not as a line of its own under the list. */}
			<HomeHead label="Senast publicerat" id="feature-also-rubrik" href="/essaer/" linkLabel="Alla essäer" />
			<ol class="feature-also-lista" role="list">
				{also.map((a) => (
					<li>
						<h3 class="feature-also-titel">
							<a href={`/${a.slug}/`} data-astro-prefetch="viewport">{a.title}</a>
						</h3>
						<ArticleMeta class="label feature-also-meta" publishedAt={a.publishedAt} readingTime={a.readingTime} />
					</li>
				))}
			</ol>
		</section>
	)}
</section>

<style>
	/* `.home-movement` turns on `content-visibility: auto`. The cover is always on
	   the first screen, so there is never anything here to skip, and a placeholder
	   height would only put the LCP picture at risk. */
	.feature {
		content-visibility: visible;
		display: flex;
		flex-direction: column;
	}

	/* Phone and tablet: one column in reading order — kicker, headline, picture,
	   deck, date. The text block dissolves into the column so the picture can sit
	   between the headline and the deck without a second copy of either. */
	.feature-text {
		display: contents;
	}

	.feature-kicker {
		order: 0;
		margin-bottom: var(--space-half);
	}

	.feature-title {
		order: 1;
	}

	.feature-media-link {
		order: 2;
		display: block;
	}

	.feature-lead {
		order: 3;
	}

	.feature-meta-row {
		order: 4;
	}

	/* The list after it, under a rule: on one column it is a second rank, and the
	   rule says where the lead's own words end. */
	.feature-also {
		order: 5;
		margin-top: var(--space-section);
		padding-top: var(--space-phi);
		border-top: 1px solid var(--color-rule);
	}

	.feature-also-lista {
		margin: var(--space-group) 0 0;
		padding: 0;
		list-style: none;
	}

	.feature-also-lista > li + li {
		margin-top: var(--space-group);
	}

	.feature-also-titel {
		margin: 0;
		font-size: var(--step-1);
		font-weight: 600;
		line-height: 1.25;
		text-wrap: balance;
	}

	.feature-also-titel a {
		color: var(--color-text);
		text-decoration: none;

		&:hover {
			text-decoration: underline;
			text-decoration-thickness: 1px;
			text-underline-offset: 0.12em;
		}
	}

	.feature-also :global(.feature-also-meta) {
		margin: 0.5rem 0 0;
	}

	/* The head row brings its own space below; the list already carries the gap. */
	.feature-also :global(.home-head) {
		margin-bottom: 0;
	}

	/* The eyebrow is a link and sits outside the headline link, so it needs the
	   underline discipline the rest of the mast-level labels use. Padded to clear
	   WCAG 2.5.8; the negative margin gives the space back. Lifted over the headline:
	   its link is inline on a 1.04 line, so its box reaches up past the trimmed cap
	   height and lay over the lower half of this one, where a click opened the essay
	   instead of the ämne. */
	.feature-kicker a {
		position: relative;
		z-index: 1;
		display: inline-block;
		padding: 0.3rem 0.4rem;
		margin: -0.3rem -0.4rem;
		color: inherit;
		text-decoration: none;

		&:hover {
			text-decoration: underline;
			text-underline-offset: var(--underline-offset);
		}

		&:focus-visible {
			border-radius: var(--radius-xs);
		}
	}

	/* The display cut (--font-headline, Literata at opsz 72): drawn for this size,
	   with the tighter fit and finer hairlines the text cut only imitates when it is
	   scaled up. A deliberate exception to the type scale — the one headline on the
	   site composed for one place — stepped at breakpoints, never with vw, so it
	   answers to zoom. */
	.feature-title {
		font-family: var(--font-headline);
		font-size: 2.5rem;
		font-weight: 560;
		line-height: 1.04;
		letter-spacing: -0.012em;
		margin: 0 0 var(--space-half);
		max-width: 18ch;
		text-wrap: balance;
		font-feature-settings: "dlig" 1;
	}

	@supports (text-box-trim: trim-start) {
		.feature-title {
			text-box-trim: trim-start;
			text-box-edge: cap alphabetic;
			margin-top: 0.12em;
		}
	}

	.feature-link {
		color: inherit;
		text-decoration: none;
	}

	/* Either link lights the headline: the picture is the larger target, and a
	   hover on it should say where it goes. */
	.feature:has(.feature-link:hover, .feature-media-link:hover) .feature-title,
	.feature-link:focus-visible {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.12em;
	}

	.feature-media {
		--frame-zoom: 1.02;
		/* The picture arrives seated in its own tones instead of on an empty warm
		   rectangle — a 20px WebP of the same photograph, blurred by the browser. */
		background-image: var(--lqip, none);
		background-size: cover;
		background-position: center;
	}

	/* ⚠️ The <img> carries EssayImage's style scope, not ours — hence :global.
	   ONE ratio per layout, never one that tracks the window height: a crop that
	   slides as the window resizes reads as a stretch (see git history of this
	   file, 2026-08, for the 2.35 band that did exactly that). */
	.feature-media :global(img) {
		aspect-ratio: 3 / 2;
	}

	@media (48rem < width < 64rem) {
		.feature-media :global(img) {
			aspect-ratio: 16 / 9;
		}

		.feature-title {
			font-size: 3.2rem;
		}
	}

	.feature-lead {
		margin: var(--space-unit) 0 0;
		max-width: 38em;
	}

	.feature-meta-row {
		margin-top: var(--space-half);
	}

	.feature-meta-row :global(.feature-meta) {
		margin: 0;
	}

	/* THE LEAD AS ONE PACKAGE (product decision, 2026-10-10). From 64rem the opening is
	   two columns that start and end on the same lines. Two thirds hold the lead: kicker,
	   headline, deck and date, and directly under them its photograph, at the same width.
	   The last third, behind a hairline, is a rail of the six essays before it.

	   Level by construction, because two independent columns never stay level on their
	   own (the rail's titles run one to three lines and change with every essay): the
	   picture's row is the flexible one, so the photograph is as tall as the rail needs
	   it to be and never flatter than 5:2. When the rail is the shorter column instead,
	   its list spreads to the foot. Nothing here measures anything.

	   What this replaced the same day: the words and an index of three on top with the
	   picture across the whole canvas under both. In Chrome at 1440×900 the words ended
	   at y=380 and the index at 450, with 100px of empty paper under the date; the
	   picture belonged to neither column (it ran under three essays it does not show);
	   and the fold cut it at every laptop size. The first screen offered four essays.
	   ft.com's offers a dozen, in columns that end together.

	   Seven arrangements came before that one (six in one evening, user reviews
	   2026-09-25): a spread with the picture in seven columns (barely larger than the
	   cards below); the full-width picture with a short headline beside the deck ("the big
	   empty field under the headline"); the lead's words in a row of thirds beside two
	   picture cards ("unconventional and confusing"); the lead with picture cards in a
	   side column, then with a list of decks there — every version with three photographs
	   or four decks read as unbalanced, and "maybe simply too much text"; and the picture
	   across the canvas on top with the words under it, which put the headline under the
	   fold of a 1280×720 laptop. What holds through all of them: one picture, one deck,
	   and a list of titles.

	   Keep the width in step with FEATURE_HERO_SIZES in lib/hero.ts. */
	@media (width < 64rem) {
		/* One condition for the layout and for how much it shows (DESIGN.md, Principle
		   8): in one column every row is a row to scroll past before the first ämne. */
		.feature-also-lista > li:nth-child(n + 4) {
			display: none;
		}
	}

	@media (width >= 64rem) {
		.feature {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			/* The words take what they need; the picture takes the rest of the rail. */
			grid-template-rows: auto 1fr;
			column-gap: var(--grid-gutter);
		}

		.feature-text {
			display: block;
			grid-column: 1 / 3;
			grid-row: 1;
		}

		.feature-kicker {
			margin-bottom: var(--space-half);
		}

		/* The column is the measure here, not 18ch: a title of forty characters takes
		   two lines of it. The longest in the archive (62 characters) still stood on four
		   at 64px, and takes three a size down. */
		.feature-title {
			font-size: 4rem;
			max-width: none;
		}

		.feature-title--long {
			font-size: 3.25rem;
		}

		.feature-lead {
			max-width: 40rem;
			margin-top: var(--space-half);
		}

		/* The photograph fills its row. The strut is the floor (5:2 of the column, the
		   crop every hero is checked against); the frame and the picture are taken out
		   of flow so the row's height is the rail's to give, not the file's. */
		.feature-media-link {
			position: relative;
			grid-column: 1 / 3;
			grid-row: 2;
			margin-top: var(--space-unit);
		}

		.feature-media-link::before {
			content: "";
			display: block;
			padding-top: 40%;
		}

		.feature-media {
			position: absolute;
			inset: 0;
		}

		.feature-media :global(img) {
			position: absolute;
			inset: 0;
			height: 100%;
			aspect-ratio: auto;
		}

		/* The rail: behind a hairline in the middle of the gutter, its kicker level
		   with the lead's, running the height of the whole package. */
		.feature-also {
			grid-column: 3;
			grid-row: 1 / 3;
			display: flex;
			flex-direction: column;
			margin: 0 0 0 calc(var(--grid-gutter) / -2);
			/* Less the hairline's own pixel, so the words stand on the page's third
			   line (x 950 at 1440) and not one past it. */
			padding: 0 0 0 calc(var(--grid-gutter) / 2 - 1px);
			border: 0;
			border-left: 1px solid var(--color-rule);
		}

		.feature-also-lista {
			flex: 1;
			display: flex;
			flex-direction: column;
			justify-content: space-between;
			margin-top: var(--space-group);
		}

		/* A rule between the titles: six in a column are a list, and the rules are what
		   keeps the spacing reading as a rhythm when the list spreads. */
		.feature-also-lista > li + li {
			margin-top: 0;
			padding-top: var(--space-half);
			border-top: 1px solid var(--color-divider);
		}

		.feature-also-lista > li:not(:last-child) {
			padding-bottom: var(--space-half);
		}
	}
</style>
