---
import type { Article } from "../lib/articles";
import { inlineMarkdown } from "../lib/articles";
import { CARD_WIDTHS } from "../lib/hero";
import ArticleMeta from "./ArticleMeta.astro";
import EssayImage from "./EssayImage.astro";

interface Props {
	articles: Article[];
}

const { articles } = Astro.props;

// Image always left; the side used to alternate row by row. Don't reinstate.
const rows = articles.map((article) => ({
	article,
	side: article.heroImage ? "left" : "none",
}));
---

<section class="recent home-movement" aria-labelledby="recent-heading">
	<p class="label home-kicker" id="recent-heading">Fler essäer</p>
	<ul class="recent-list">
		{rows.map(({ article, side }) => (
			<li class:list={["recent-item", `recent-item--${side}`]}>
				<a class="recent-link" href={`/${article.slug}`} data-astro-prefetch="viewport">
					{side !== "none" && (
						<div class="recent-media media-frame">
							<EssayImage
								article={article}
								widths={CARD_WIDTHS}
								sizes="(max-width: 768px) 100vw, 18rem"
							/>
						</div>
					)}
					<div class="recent-text">
						<h3 class="recent-title cap-trim-start">{article.title}</h3>
						{article.description && (
							<p class="recent-lead" set:html={inlineMarkdown(article.description)} />
						)}
						<ArticleMeta class="label recent-meta" publishedAt={article.publishedAt} readingTime={article.readingTime} />
					</div>
				</a>
			</li>
		))}
	</ul>
</section>

<style>
	.recent-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.recent-item {
		border-top: 1px solid var(--color-rule);
	}

	.recent-item:first-child {
		border-top: none;
	}

	.recent-link {
		--focus-offset: 0.5rem; /* pushes the site-wide keyboard ring clear of the row */
		display: grid;
		align-items: start;
		gap: clamp(1.5rem, 4vw, 3rem);
		padding-block: var(--space-unit);
		text-decoration: none;
		color: inherit;

		&:hover,
		&:visited,
		&:active {
			text-decoration: none;
			color: inherit;
		}
	}

	/* Fixed track, not fractional, so every thumbnail crops the same. */
	.recent-link {
		grid-template-columns: 18rem 1fr;
	}

	/* Image-less rows stay in column 2 so the title edge never breaks. */
	.recent-item--none .recent-text {
		grid-column: 2;
		max-width: 38rem;
	}

	/* Frame, grain + vignette come from the shared .media-frame utility on the
	   wrapper (layout.css). The base tonal wash + its transition live on the img
	   in EssayImage. The crop is pinned here via :global(img) (NOT a class on
	   EssayImage — a scoped class never reaches its inner <img>), so every
	   thumbnail is a uniform 4:3 regardless of the source file's proportions. */
	/* Cover fit + hover colour-bloom are shared on .media-frame (layout.css); here
	   we set only the crop — a uniform 4:3 regardless of the source proportions. */
	.recent-media :global(img) {
		aspect-ratio: 4 / 3;
	}

	.recent-title {
		font-family: var(--font-heading);
		font-size: var(--step-2);
		font-weight: 620;
		line-height: 1.18;
		letter-spacing: 0;
		color: var(--color-accent);
		margin: 0;
		text-wrap: balance;
	}

	.recent-link:hover .recent-title,
	.recent-link:focus-visible .recent-title {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.12em;
	}

	.recent-lead {
		font-family: var(--font-body);
		font-size: var(--step--1);
		line-height: 1.5;
		color: var(--text-quiet);
		margin: 0.625rem 0 0;
		max-width: 36rem;
	}

	.recent-meta {
		margin: 0.625rem 0 0;
	}

	@media (width <= 768px) {
		/* No room for a side-by-side row: image over text, one column. */
		.recent-link {
			grid-template-columns: 1fr;
			gap: var(--space-half);
		}

		.recent-item--none .recent-text {
			grid-column: auto;
		}

		.recent-media :global(img) {
			aspect-ratio: 16 / 9;
		}

		.recent-title {
			font-size: 1.35rem;
		}

		.recent-lead {
			font-size: var(--step--2);
		}
	}
</style>
