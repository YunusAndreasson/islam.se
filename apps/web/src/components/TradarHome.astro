---
import { getCollection } from "astro:content";
import HomeHead from "./HomeHead.astro";
import ThreadList from "./ThreadList.astro";

// `limit` keeps the /essaer/ intro glimpse to its curated top few; the /tradar
// index renders the collection unbounded. Lead with the threads carrying the
// most essays (§7.7).
interface Props {
	limit?: number;
}
const { limit } = Astro.props;

let threads = await getCollection("tradar");
if (limit) {
	threads = [...threads]
		.sort((a, b) => b.data.essays.length - a.data.essays.length)
		.slice(0, limit);
}
---

<section class="tradar-home home-movement" aria-labelledby="tradar-kicker">
	<HomeHead label="Trådar" id="tradar-kicker" href="/tradar/" linkLabel="Alla trådar" />
	<ThreadList threads={threads} headingLevel={3} prefetch="viewport" />
</section>
