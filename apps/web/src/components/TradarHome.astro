---
import { getCollection } from "astro:content";
import { leadSentences } from "../lib/format";
import { seriesLength } from "../lib/series";
import { seriesParts } from "../lib/tradar";
import EssayArchiveItem from "./EssayArchiveItem.astro";
import HomeHead from "./HomeHead.astro";
import HomeTabs from "./HomeTabs.astro";
import SectionLink from "./SectionLink.astro";
import ThreadList from "./ThreadList.astro";

// `limit` keeps the glimpse to its curated top few; the /tradar index renders the
// collection unbounded. Lead with the threads carrying the most essays (§7.7).
//
// `variant`: the front page sets the series behind TABS, one series at a time (the
// default, `routes`); /essaer/ keeps one picture card per series, because there the
// series sit among essay cards and a picture is what the archive reader scans for.
//
// `ids` names the threads outright, in the order given, and wins over `limit`: the
// front page picks its three by hand, because »most essays« can never surface a
// short series on something happening now (Folkmordet i Gaza, two essays, 2026-10).
interface Props {
	limit?: number;
	ids?: readonly string[];
	variant?: "routes" | "cards";
	nested?: boolean;
}
const { limit, ids, variant = "routes", nested = false } = Astro.props;
/** As many cards as a tab of the essays by ämne shows. */
const DELAR = 3;

let threads = await getCollection("tradar");
if (ids) {
	threads = ids.map((id) => {
		const thread = threads.find((t) => t.id === id);
		if (!thread) throw new Error(`TradarHome: no essäserie with id "${id}" in tradar.json`);
		return thread;
	});
} else if (limit) {
	threads = [...threads]
		.sort((a, b) => b.data.essays.length - a.data.essays.length)
		.slice(0, limit);
}

// Curated order, exactly as the thread page keeps it — a tråd is the only sequence
// on the site, and the order IS the argument (lib/tradar.ts, seriesParts).
const routes = await Promise.all(threads.map(async (thread) => {
	const essays = await seriesParts(thread);
	const newestFirst = [...essays].sort((a, b) => Date.parse(b.publishedAt) - Date.parse(a.publishedAt));
	return {
		id: thread.id,
		title: thread.data.title,
		// The opening sentence, whole: the full framing ran three routes to uneven
		// heights, a clamp cut it mid-sentence (user reviews, 2026-09-25).
		framing: leadSentences(thread.data.framing, 150),
		essays,
		// Preview the latest parts first; the series page keeps its reading order.
		shown: newestFirst.slice(0, DELAR),
		rest: newestFirst.slice(DELAR),
		length: seriesLength(essays),
	};
}));
---

<section
	class="tradar-home home-movement"
	aria-labelledby="tradar-kicker"
	data-home-tabs={variant === "cards" ? undefined : ""}
>
	<HomeHead label="Essäserier" id="tradar-kicker" href="/tradar/" linkLabel="Alla essäserier" headingLevel={nested ? 3 : 2} />
	{variant === "cards" ? (
		/* A compact preview: these routes lead into the essays below. */
		<ThreadList
			threads={threads}
			headingLevel={3}
			compact
			prefetch="viewport"
			sizes="(min-width: 79rem) 24rem, (min-width: 63rem) 30vw, (min-width: 42rem) 45vw, 100vw"
		/>
	) : (
		/* THE DESIGN OF THE ESSAYS BY ÄMNE, with a series' one difference. A tab per
		   series, and under it the series' framing, its first three parts as picture
		   cards on the page's thirds, and the way on to the whole of it: the panel
		   »Essäer efter ämne« has directly above (layout.css, .home-tabs and .home-cards;
		   scripts/home-tabs.ts). The two are the same essays shelved two ways, and stood
		   as picture cards over three columns of numbered titles they read as unrelated
		   ("we could use same design for ESSÄSERIER as we do for ESSÄER EFTER ÄMNE with
		   possibly just small adjustments", user review 2026-10-10).

		   The difference is the ORDER, and every card says it: »Del 1«, »Del 2«, »Del 3«
		   over the title, in the brass every ordinal on the page is set in. A series
		   shown without its numbers is an ämne again (DESIGN.md, »The Browse Axes«).

		   Three forms came before it the same autumn. A line with a ring per part, filled
		   once read: it drew a route and named no order. The part's number inside the
		   ring, for an hour: a 12px digit in a circle is an app's badge. Then each series
		   as a numbered list of all its titles, three lists side by side: the order was
		   there, and fifteen titles in small type under the picture cards read as a
		   different kind of thing. */
		<>
			<HomeTabs
				aria-label="Välj essäserie"
				tabs={routes.map((route) => ({ id: `serie-flik-${route.id}`, href: `/tradar/${route.id}/`, label: route.title }))}
			/>
			{routes.map((route, i) => (
				<div class="trad-route" id={`serie-panel-${route.id}`} data-tab-panel hidden={i !== 0}>
					<p class="home-tab-framing">{route.framing}</p>
					<ul
						class="home-cards trad-delar"
						role="list"
						aria-label={`${route.title}, senaste delarna först`}
					>
						{route.shown.map((article) => (
							<EssayArchiveItem
								article={article}
								variant="card"
								style={`counter-reset: del ${route.essays.indexOf(article) + 1}`}
								cardSizes="(min-width: 60rem) 31vw, (min-width: 40rem) 42vw, 80vw"
							/>
						))}
					</ul>
					{/* Counted with the cards when the reader's progress is, and never shown. */}
					{route.rest.map((essay) => (
						<span data-slug={essay.slug} hidden />
					))}
					<p class="home-tab-more">
						<SectionLink href={`/tradar/${route.id}/`} data-astro-prefetch="viewport">Hela essäserien</SectionLink>
						<span class="label article-meta trad-meta">
							{route.length}
							<span class="trad-progress" hidden />
						</span>
					</p>
				</div>
			))}
		</>
	)}
</section>

{/* Unconditional: a processed script is bundled once per component, not per
    render, and it does nothing on a page without routes (the /essaer/ cards).
    (Never write the tag itself in an .astro comment: Vite's dependency scanner
    reads it as a real script and the dev server skips pre-bundling.) */}
<script>
	import "../scripts/trad-routes";
</script>

<style>
	/* How long the whole series is, on the way-on's line. */
	.trad-meta {
		margin: 0;
	}

	.trad-progress::before {
		content: " · ";
	}
</style>
