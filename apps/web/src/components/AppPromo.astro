---
// Web → app promotion. Concentrated where prayer-time intent is highest; never a
// pop-up or interstitial (Google demotes those in mobile search). Both store
// badges render server-side — crawlable and working without JS — then a small
// client script narrows to the visitor's platform on mobile (Android → Google
// Play only, iPhone → App Store only). Desktop / unknown shows both.
import { Image } from "astro:assets";
import appKarta from "../assets/app/app-karta.png";
import appQibla from "../assets/app/app-qibla.png";
import appTider from "../assets/app/app-tider.png";
import { APP_CITY_FEATURES, APP_FEATURES, APP_STORE_URL, APP_TAGLINE, PLAY_STORE_URL } from "../lib/app";

interface Props {
	/** section = full card; compact = one-line (metod); page = /app landing;
	 *  city = the lead item of "Ta med tiderna" on the 2 128 prayer pages. */
	variant?: "section" | "compact" | "page" | "city";
}
const { variant = "section" } = Astro.props;
const showHeading = variant !== "compact";
// Features earn their place where there is room to read them: the /app landing, and
// the city pages, where a bare badge was asking for a download without saying why.
const showFeatures = variant === "page" || variant === "city";
const features = variant === "city" ? APP_CITY_FEATURES : APP_FEATURES;
// The city card sits inside a <TitledSection>, whose own h2 is "Ta med tiderna".
const Heading = variant === "city" ? "h3" : "h2";
// Show it, don't describe it. The first two are the same screen in two states — the
// times listed over the map, and the sheet pulled down so the Maghrib and ʿIshāʾ
// lines the reader has just watched on this page are visible with the day-scrubber
// under them. That scrubber is the thing the web map cannot do: drag it and the
// light moves. The compass is the third, and the plainest thing this page will
// never offer.
const CITY_SHOTS = [
	{ src: appTider, alt: "Appens bönetidslista över kartan, med reglaget för dygnet." },
	{ src: appKarta, alt: "Appens karta: Maghrib och ʿIshāʾ som linjer över Norden." },
	{ src: appQibla, alt: "Appens kompass som pekar mot Kaba." },
];
const lead = variant === "city"
	? "Samma karta i telefonen – och det som en webbsida inte kan göra."
	: APP_TAGLINE;

---

<aside class:list={["apppromo", `apppromo--${variant}`]} data-platform="other" aria-label="Ladda ned islam.se-appen">
	{/* No kicker: it said "Appen" above a heading that now says "Bönetidsappen". */}
	<div class="apppromo-body">
		<div class="apppromo-text">
			{showHeading && <Heading class="apppromo-heading">Bönetidsappen</Heading>}
			{variant === "compact" ? (
				<p class="apppromo-lead"><strong>islam.se i mobilen.</strong> {APP_TAGLINE}</p>
			) : (
				<p class="apppromo-lead">{lead}</p>
			)}
			{variant === "city" && (
				<div class="apppromo-shots">
					{CITY_SHOTS.map((s) => (
						<Image class="apppromo-shot" src={s.src} alt={s.alt} widths={[150, 300, 450]} sizes="(max-width: 40rem) 25vw, 8rem" loading="lazy" />
					))}
				</div>
			)}
			{showFeatures && (
				<ul class="apppromo-features">
					{features.map((f) => (
						<li>
							<span class="apppromo-feature-term">{f.term}</span>
							<span class="apppromo-feature-gloss">{f.gloss}</span>
						</li>
					))}
				</ul>
			)}
		</div>
		<div class="apppromo-badges">
			{/* Black badge in both themes. Apple: use the black badge whenever another
			    platform's badge sits alongside — and Google forbids recolouring theirs,
			    so white here would never have a match. The grey border is in the art. */}
			<a class="apppromo-badge apppromo-badge--ios" href={APP_STORE_URL} aria-label="Ladda ned islam.se på App Store">
				<img src="/badge-appstore-sv.svg" alt="" width="120" height="40" loading="lazy" decoding="async" />
			</a>
			<a class="apppromo-badge apppromo-badge--android" href={PLAY_STORE_URL} aria-label="Ladda ned islam.se på Google Play">
				<img src="/badge-googleplay-sv.png" alt="" width="646" height="250" loading="lazy" decoding="async" />
			</a>
		</div>
	</div>
</aside>

<script>
	// Narrow the visible badge to the device's store. Both stay visible until this
	// runs (and on desktop / unknown), so no-JS and crawlers see both links.
	function applyPlatform() {
		const cards = document.querySelectorAll<HTMLElement>(".apppromo");
		if (cards.length === 0) return;
		const nav = navigator as Navigator & { userAgentData?: { platform?: string } };
		const ua = navigator.userAgent;
		const uaData = nav.userAgentData?.platform?.toLowerCase() ?? "";
		let platform: "ios" | "android" | "other" = "other";
		if (uaData === "android" || /Android/i.test(ua)) {
			platform = "android";
		} else if (
			/iPad|iPhone|iPod/.test(ua) ||
			// iPadOS Safari reports as desktop macOS — distinguish by touch points.
			(navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1)
		) {
			platform = "ios";
		}
		for (const c of cards) c.dataset.platform = platform;
	}
	document.addEventListener("astro:page-load", applyPlatform);
</script>

<style>
	.apppromo {
		font-family: var(--font-body);
	}

	.apppromo-heading {
		font-family: var(--font-heading);
		font-size: var(--step-1-sans);
		margin: 0;
	}

	.apppromo-lead {
		font-size: var(--step--1);
		line-height: 1.55;
		color: var(--text-body);
		margin: var(--space-half) 0 0;
		max-width: 38rem;
		text-wrap: pretty;
	}

	.apppromo-lead strong {
		font-weight: 600;
		color: var(--color-text);
	}

	.apppromo-features {
		margin: var(--space-unit) 0 0;
		padding: 0;
		display: grid;
		gap: 1rem 2rem;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
		max-width: 40rem;
	}

	/* Two columns: a brass-tick gutter and the text. The term and gloss both sit in
	   column 2 so the gloss aligns under the term, not under the tick. */
	.apppromo-features li {
		display: grid;
		grid-template-columns: 0.7rem 1fr;
		column-gap: 0.7rem;
	}

	.apppromo-feature-term {
		grid-column: 2;
		grid-row: 1;
		font-weight: 600;
		color: var(--color-text);
	}

	.apppromo-feature-gloss {
		grid-column: 2;
		grid-row: 2;
		margin-top: 0.15rem;
		font-size: var(--step--2);
		line-height: 1.45;
		/* --text-meta, not --color-muted: the card's 3 % tint takes muted to 4.44:1,
		   under AA. The tier exists for exactly this — meta on a tinted panel. */
		color: var(--text-meta);
	}

	/* The tick is its own grid cell, vertically centred on the term's line via
	   align-self — no hand-tuned em offset that drifts when the text reflows. */
	.apppromo-features li::before {
		content: "";
		grid-column: 1;
		grid-row: 1;
		align-self: center;
		width: 0.7rem;
		height: 2px;
		background: var(--color-warm);
	}

	.apppromo-badges {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1rem;
		margin-top: var(--space-unit);
	}

	.apppromo-badge {
		display: inline-flex;
		border-radius: 9px;
		transition: transform var(--dur-fast) ease, opacity var(--dur-fast) ease;
	}

	.apppromo-badge img {
		display: block;
		width: auto;
	}

	/* Equalise optical pill height: Apple's art is tight (pill ≈ 0.92 of the image),
	   Google's generic badge bakes in clear space (pill ≈ 0.77), so Google needs a
	   taller box for the two pills to line up. */
	.apppromo-badge--ios img {
		height: 2.6rem;
	}

	.apppromo-badge--android img {
		height: 3.1rem;
	}

	.apppromo-badge:hover {
		opacity: 0.85;
	}

	.apppromo-badge:active {
		transform: scale(0.97);
	}

	.apppromo-badge:focus-visible {
		outline-offset: 3px;
	}

	/* Per-platform gating — JS sets data-platform; default (other / no-JS) shows both. */
	.apppromo[data-platform="ios"] .apppromo-badge--android,
	.apppromo[data-platform="android"] .apppromo-badge--ios {
		display: none;
	}

	/* ---- section: a calm card on prayer pages, on a faintly raised surface so the
	   dark badge pills keep contrast in dark mode too. ---- */
	.apppromo--section {
		margin-top: var(--space-phi);
		padding: var(--space-unit);
		border: 1px solid var(--color-divider);
		border-radius: 12px;
		background: var(--surface-1);
	}

	.apppromo--section .apppromo-heading {
		font-family: var(--font-heading);
	}

	/* ---- city: the lead item of "Ta med tiderna" on the prayer pages. The same calm
	   card as --section, but it names what the page cannot do rather than showing a
	   badge pair on its own. It used to sit below the FAQ and the facts list. ---- */
	.apppromo--city {
		margin-block: 0 var(--space-unit);
		padding: var(--space-half) var(--space-unit) var(--space-unit);
		border: 1px solid var(--color-divider);
		border-radius: 12px;
		background: var(--surface-1);
	}

	.apppromo--city .apppromo-heading {
		font-family: var(--font-heading);
		font-size: var(--step-1);
		margin-top: var(--space-half);
	}

	/* The phones. Three, small, sitting in the card's own rhythm — not a hero band: the
	   app does the same job the page just did, so it argues rather than interrupts.
	   Sized by the card, not the viewport: at 27vw each, three phones and their gaps
	   came to 81vw + 1rem, wider than the padded card on any phone, and the compass
	   poked through the card's right border at 390px. */
	.apppromo-shots {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 8rem));
		gap: .5rem;
		margin-block: var(--space-half);
	}

	.apppromo-shot {
		width: 100%;
		height: auto;
		border-radius: 1.1rem;
		border: 1px solid light-dark(var(--color-divider), var(--color-warm));
	}

	/* ---- compact: a quiet one-liner for the homepage teaser and the method page. ---- */
	.apppromo--compact {
		margin-top: var(--space-unit);
		padding-top: var(--space-unit);
		border-top: 1px solid var(--color-rule);
	}

	.apppromo--compact .apppromo-lead {
		margin-top: 0;
	}

	/* ---- page: the /app landing, given a little more room. ---- */
	.apppromo--page {
		margin-top: var(--space-unit);
	}

	.apppromo--page .apppromo-heading {
		font-family: var(--font-heading);
		font-size: var(--step-2-sans);
	}
</style>
