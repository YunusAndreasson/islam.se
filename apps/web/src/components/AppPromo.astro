---
// The app's own page (/app/): what it does and the two stores, beside its screenshots.
// Everywhere else the app is offered in the form the front page closes on (Promo, via
// PoddAppHome `only="appen"`); this card's section, compact and city forms — a bordered,
// tinted panel with its own screenshots on the 2 128 prayer pages — went on 2026-11-20.
// The store badges render server-side (crawlable, working without scripts) and the
// device's own store is the one shown on a phone (Base.astro stamps the platform).
import { APP_CAMPAIGNS, APP_FEATURES, APP_TAGLINE, appStoreUrl, playStoreUrl } from "../lib/app";
---

<aside class="apppromo" aria-label="Ladda ned islam.se-appen">
	<h2 class="apppromo-heading">Bönetidsappen</h2>
	<p class="apppromo-lead">{APP_TAGLINE}</p>
	{/* The page's one action comes before the list of what the app does: after the
	    features the two stores stood below the first screen at 1440×900 (2026-10-16). */}
	<div class="apppromo-badges">
		<a class="apppromo-badge apppromo-badge--ios" href={appStoreUrl(APP_CAMPAIGNS.appPage)} aria-label="Ladda ned islam.se på App Store">
			<img src="/badge-appstore-sv.svg" alt="" width="120" height="40" decoding="async" />
		</a>
		<a class="apppromo-badge apppromo-badge--android" href={playStoreUrl(APP_CAMPAIGNS.appPage)} aria-label="Ladda ned islam.se på Google Play">
			<img src="/badge-googleplay-sv.png" alt="" width="646" height="250" decoding="async" />
		</a>
	</div>
	<ul class="apppromo-features">
		{APP_FEATURES.map((f) => (
			<li>
				<span class="apppromo-feature-term">{f.term}</span>
				<span class="apppromo-feature-gloss">{f.gloss}</span>
			</li>
		))}
	</ul>
</aside>


<style>
	.apppromo {
		font-family: var(--font-body);
	}

	/* The tool pages' h2 (layout.css, `.tool-section > h2`). */
	.apppromo-heading {
		font-family: var(--font-heading);
		font-size: var(--step-1-sans);
		margin: 0;
	}

	.apppromo-lead {
		font-size: var(--step--1);
		line-height: 1.55;
		color: var(--text-body);
		margin: var(--space-half) 0 0;
		max-width: 38rem;
		text-wrap: pretty;
	}

	.apppromo-features {
		margin: var(--space-unit) 0 0;
		padding: 0;
		display: grid;
		gap: 1rem 2rem;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
		max-width: 40rem;
	}

	/* Two columns: a brass-tick gutter and the text. The term and gloss both sit in
	   column 2 so the gloss aligns under the term, not under the tick. */
	.apppromo-features li {
		display: grid;
		grid-template-columns: 0.7rem 1fr;
		column-gap: 0.7rem;
	}

	.apppromo-feature-term {
		grid-column: 2;
		grid-row: 1;
		font-weight: 600;
		color: var(--color-text);
	}

	.apppromo-feature-gloss {
		grid-column: 2;
		grid-row: 2;
		margin-top: 0.15rem;
		font-size: var(--step--2);
		line-height: 1.45;
		/* --text-meta, not --color-muted: the card's 3 % tint takes muted to 4.44:1,
		   under AA. The tier exists for exactly this — meta on a tinted panel. */
		color: var(--text-meta);
	}

	/* The tick is its own grid cell, vertically centred on the term's line via
	   align-self — no hand-tuned em offset that drifts when the text reflows. */
	.apppromo-features li::before {
		content: "";
		grid-column: 1;
		grid-row: 1;
		align-self: center;
		width: 0.7rem;
		height: 2px;
		background: var(--color-warm);
	}

	.apppromo-badges {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1rem;
		margin-top: var(--space-unit);
	}

	.apppromo-badge {
		display: inline-flex;
		border-radius: 9px;
		transition: transform var(--dur-fast) var(--ease-standard), opacity var(--dur-fast) var(--ease-standard);
	}

	.apppromo-badge img {
		display: block;
		width: auto;
	}

	/* Equalise optical pill height: Apple's art is tight (pill ≈ 0.92 of the image),
	   Google's generic badge bakes in clear space (pill ≈ 0.77), so Google needs a
	   taller box for the two pills to line up. */
	.apppromo-badge--ios img {
		height: 2.6rem;
	}

	.apppromo-badge--android img {
		height: 3.1rem;
	}

	.apppromo-badge:hover {
		opacity: 0.85;
	}

	.apppromo-badge:active {
		transform: scale(0.97);
	}

	.apppromo-badge:focus-visible {
		--focus-offset: 3px;
	}

	/* The device's own store only: Base.astro stamps the platform on <html> before paint.
	   A desktop, or a page without scripts, shows both. */
	:global(html[data-platform="ios"]) .apppromo-badge--android,
	:global(html[data-platform="android"]) .apppromo-badge--ios {
		display: none;
	}

	/* Under the lead, then what the app does. */
	.apppromo {
		margin-top: var(--space-unit);
	}

	.apppromo-badges {
		margin: var(--space-group) 0 var(--space-unit);
	}
</style>
