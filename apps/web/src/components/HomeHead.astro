---
// A section's head row (DESIGN.md, »Every section opens the same way«): the kicker in the
// head form, and on its baseline the quiet way on, »Alla …«. The styling lives with the
// rest of the home vocabulary in styles/layout.css (.home-head / .home-head-all).
import Kicker from "./Kicker.astro";
import SectionLink from "./SectionLink.astro";

interface Props {
	label: string;
	/** Kicker element id, referenced by the owning section's aria-labelledby. */
	id: string;
	href: string;
	linkLabel: string;
	headingLevel?: 2 | 3;
}

const { label, id, href, linkLabel, headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 3 ? "h3" : "h2";
---

<div class="home-head">
	<Kicker form="head" as={Heading} id={id}>{label}</Kicker>
	<SectionLink class="label home-head-all" href={href}>{linkLabel}</SectionLink>
</div>
