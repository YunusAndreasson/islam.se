---
import type { MarkdownHeading } from "astro";

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const labelId = "innehall-rubrik";

// ⚠️ GFM footnotes emit their own `<h2 class="sr-only" id="footnote-label">`. Whether it
// reaches `headings` depends on where in the pipeline the footnote section is built, so
// filter it either way — it must never become a table-of-contents row.
const sections = headings.filter((h) => h.depth === 2 && h.slug !== "footnote-label");
---

{
	sections.length > 1 && (
		<nav class="innehall" aria-labelledby={labelId}>
			<details class="contents-disclosure disclosure" open>
			<summary class="label" id={labelId}>
				Innehåll
			</summary>
			<ol>
				{sections.map((h) => (
					<li>
						<a href={`#${h.slug}`}>{h.text}</a>
					</li>
				))}
			</ol>
			</details>
		</nav>
	)
}

<style>
	/* No rules and no padding. The hairlines boxed the list into a band that read louder
	   than the prose it indexes, and the padding only existed to hold the rows off them —
	   without the rules it was just dead space. The margin alone separates it. */
	.innehall {
		margin-block: var(--space-phi);
	}

	.innehall .label {
		margin: 0 0 var(--space-half);
	}

	/* One column at every width. Two columns from 40rem split an essay's three to nine
	   numbered sections into a top-to-bottom grid (1–4 left, 5–7 right) that read as
	   cramped and broke the sequence; no essay has enough sections to need the height. */
	.innehall ol {
		margin: 0;
		padding: 0;
		font-family: var(--font-heading);
		font-size: var(--step--1);
		line-height: 1.5;
	}

	.innehall li {
		margin-block-end: var(--space-half);
		counter-increment: toc;
		position: relative;
		padding-left: 1.6rem;
	}

	.innehall ol {
		counter-reset: toc;
	}

	/* Inset from the row's edge to leave room for the current-section bar below. The bar
	   has to sit inside the row: the rail scrolls (overflow-y: auto), so anything hung
	   off its left edge is clipped. Two digits still clear the 1.6rem title indent. */
	.innehall li::before {
		content: counter(toc);
		position: absolute;
		left: 0.5rem;
		font-size: var(--step--3);
		color: var(--color-muted);
		font-variant-numeric: tabular-nums;
	}

	/* ⚠️ Component styles are unlayered and therefore beat @layer base outright,
	   including its :hover — so both states must be declared here. These rows are
	   navigation, not prose: every row IS a link and the heading says so, which makes
	   the base at-rest underline stack into a wall of rules.

	   Padding + matching negative margin: a standalone row link measured 23px, under
	   the 24px WCAG 2.5.8 floor, and the inline exception doesn't cover it. The negative
	   margin gives the space back to the list rhythm.

	   At rest the rows sit one tier down the text ramp (--text-quiet, tokens.css): the
	   list is wayfinding, and at full accent it competed with the headline for the first
	   look. Still above the APCA body-text floor in both schemes. Hover and focus bring
	   the accent back, so the row being pointed at is the one that stands out. */
	.innehall a {
		display: inline-block;
		padding-block: 0.25rem;
		margin-block: -0.25rem;
		color: var(--text-quiet);
		text-decoration-color: transparent;
		transition: color var(--dur-fast) ease;
	}

	.innehall a:hover,
	.innehall a:focus-visible {
		color: var(--color-accent);
		text-decoration-color: currentColor;
	}

	/* The section being read, set by the script below. Colour alone is one ramp tier —
	   too quiet to find in peripheral vision from the rail while reading — so the row
	   also takes a bar in the counter's gutter. No weight change: a bolder title rewraps
	   and shifts every row under it. */
	.innehall a[aria-current] {
		color: var(--color-text);
	}

	.innehall li:has(> a[aria-current])::before {
		color: var(--color-text);
	}

	.innehall li:has(> a[aria-current])::after {
		content: "";
		position: absolute;
		inset-block: 0.2em;
		left: 0;
		width: 2px;
		border-radius: 1px;
		background: var(--color-accent);
	}
</style>

<script>
	import { onPage } from "../scripts/page";

	onPage((signal) => {
		const nav = document.querySelector<HTMLElement>(".innehall");
		const disclosure = nav?.querySelector<HTMLDetailsElement>(".contents-disclosure");
		if (!nav || !disclosure) return;

		const compact = matchMedia("(width <= 37.5rem)");
		const sync = () => { disclosure.open = !compact.matches; disclosure.querySelector("summary")?.setAttribute("tabindex", compact.matches ? "0" : "-1"); };
		sync();
		disclosure.dataset.synced = "";
		compact.addEventListener("change", sync, { signal });
		disclosure.addEventListener("click", (event) => {
			if (compact.matches && (event.target as Element).closest("a")) disclosure.open = false;
		}, { signal });

		// The current section: from the moment its heading crosses the reading line, a third
		// of the way down, until the next heading does. Before the first heading nothing is
		// current. "Last heading above the line", not "heading in view" — a long section
		// spends most of its length with its own heading scrolled away.
		// Measured on scroll (rAF-throttled, at most eleven rects, stopping at the first
		// heading below the line) rather than by IntersectionObserver, which fires only on
		// crossings and so never hears about the sections an End key or a far jump skips.
		// ⚠️ Not CSS `scroll-target-group` + `:target-current`: Gecko does not support them
		// (measured absent in Firefox 150), and Gecko is what Zen, the house browser, runs.
		const rows = [...nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')].flatMap((link) => {
			const heading = document.getElementById(link.getAttribute("href")?.slice(1) ?? "");
			return heading ? [{ link, heading }] : [];
		});
		let current: HTMLAnchorElement | undefined;
		const mark = (link: HTMLAnchorElement | undefined) => {
			if (link === current) return;
			current?.removeAttribute("aria-current");
			link?.setAttribute("aria-current", "location");
			current = link;
			// A rail taller than the viewport scrolls; keep the marked row inside it. By hand,
			// because scrollIntoView would scroll the page along with it.
			if (link && nav.scrollHeight > nav.clientHeight) {
				const box = nav.getBoundingClientRect();
				const row = link.getBoundingClientRect();
				if (row.top < box.top) nav.scrollTop -= box.top - row.top;
				else if (row.bottom > box.bottom) nav.scrollTop += row.bottom - box.bottom;
			}
		};

		let pinned = false;
		let queued = false;
		const spy = () => {
			queued = false;
			if (pinned) return;
			const line = innerHeight / 3;
			let next: HTMLAnchorElement | undefined;
			for (const { link, heading } of rows) {
				if (heading.getBoundingClientRect().top > line) break;
				next = link;
			}
			mark(next);
		};
		const queue = () => {
			if (queued) return;
			queued = true;
			requestAnimationFrame(spy);
		};
		addEventListener("scroll", queue, { passive: true, signal });
		addEventListener("resize", queue, { passive: true, signal });
		spy();

		// A click names the section outright. Hold it until the smooth scroll lands, or the
		// highlight walks through every section in between on its way there.
		let release: ReturnType<typeof setTimeout> | undefined;
		const unpin = () => {
			clearTimeout(release);
			pinned = false;
			queue();
		};
		nav.addEventListener("click", (event) => {
			const link = (event.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
			if (!link) return;
			mark(link);
			pinned = true;
			addEventListener("scrollend", unpin, { once: true, signal });
			// Covers a jump that never scrolled (already there) and engines without scrollend.
			clearTimeout(release);
			release = setTimeout(unpin, 1000);
		}, { signal });

		return () => clearTimeout(release);
	});
</script>
<style>
	/* A phone shows the list closed, and only a script can close it, after the first paint;
	   the markup stays `open` so a reader without scripts has the list. Until the script has
	   run, a phone with scripts already draws it closed: the list stood open over the essay's
	   first lines and collapsed under the reader's eyes on a slow connection (layout shift
	   0.02–0.04 on every essay, 2026-10-30). `data-js` is stamped before paint (Base.astro). */
	@media (width <= 37.5rem) {
		:global(:root[data-js]) .contents-disclosure:not([data-synced]) > ol { display: none; }
		/* A closed fold keeps a margin under its summary apart and an open one collapses it into
		   the nav's, 12px between the two states. The list carries its own margin when open. */
		.innehall .label { margin: 0; }
	}

	/* The marker is the site's disclosure chevron (layout.css), at the row's far edge. */
	.contents-disclosure summary { min-height: var(--tap-target); display: flex; align-items: center; justify-content: space-between; }
	.contents-disclosure ol { margin-top: var(--space-control); }
	@media (width > 37.5rem) { .contents-disclosure summary { pointer-events: none; } .contents-disclosure summary::after { display: none; } }
	@media (width >= 90rem) { .innehall ol { font-size: var(--step--2); } }
	/* Paper has no "where you are": a half-read page must not print one row marked. */
	@media print { .contents-disclosure > ol { display: block; } .innehall li:has(> a[aria-current])::after { display: none; } }
</style>
