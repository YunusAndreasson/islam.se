---
type FilterOverlayItem =
	| {
			label: string;
			href: string;
	  }
	| {
			label: string;
			buttonClass: "overlay-jump";
			target: string;
	  }
	| {
			label: string;
			buttonClass: "overlay-length";
			min: number;
			max: number;
	  };

interface Props {
	items: readonly FilterOverlayItem[];
}

const { items } = Astro.props;
---

<ul class="overlay-list">
	{items.map((item) => (
		<li>
			{"href" in item ? (
				<a href={item.href}>{item.label}</a>
			) : item.buttonClass === "overlay-jump" ? (
				<button type="button" class={item.buttonClass} data-target={item.target}>{item.label}</button>
			) : (
				<button type="button" class={item.buttonClass} data-min={item.min} data-max={item.max}>{item.label}</button>
			)}
		</li>
	))}
</ul>

<style>
	.overlay-list {
		margin: 0;
		padding: 0;
	}

	.overlay-list li {
		margin-bottom: 0.25rem;
	}

	.overlay-list a,
	.overlay-jump,
	.overlay-length {
		display: inline-block;
		font-family: var(--font-heading);
		font-size: var(--step-0);
		font-weight: 500;
		color: var(--color-accent);
		text-decoration: none;
		background: transparent;
		border: none;
		padding: 0.4rem 0;
		cursor: pointer;
		text-align: start;

		&:hover {
			text-decoration: underline;
			text-underline-offset: 0.15em;
		}

	}

</style>
