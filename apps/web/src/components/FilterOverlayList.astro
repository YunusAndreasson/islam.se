---
type FilterOverlayItem =
	| {
			label: string;
			href: string;
	  }
	| {
			label: string;
			buttonClass: "overlay-jump";
			target: string;
	  }
	| {
			label: string;
			buttonClass: "overlay-length";
			min: number;
			max: number;
	  };

interface Props {
	items: readonly FilterOverlayItem[];
}

const { items } = Astro.props;
---

<ul class="overlay-list">
	{items.map((item) => (
		<li>
			{"href" in item ? (
				<a href={item.href}>{item.label}</a>
			) : item.buttonClass === "overlay-jump" ? (
				<button type="button" class={item.buttonClass} data-target={item.target}>{item.label}</button>
			) : (
				<button
					type="button"
					class={item.buttonClass}
					data-min={item.min}
					data-max={item.max}
					aria-pressed={item.min === 0 && item.max === 999 ? "true" : "false"}
				>
					{item.label}
				</button>
			)}
		</li>
	))}
</ul>

<style>
	.overlay-list {
		margin: 0;
		padding: 0;
	}

	.overlay-list li {
		margin-block-end: 0.25rem;
	}

	.overlay-list a,
	.overlay-jump,
	.overlay-length {
		display: inline-block;
		font-family: var(--font-heading);
		font-size: var(--step-0);
		font-weight: 500;
		color: var(--color-accent);
		text-decoration: none;
		background: transparent;
		border: none;
		padding: 0.4rem 0;
		cursor: pointer;
		text-align: start;

		&:hover {
			text-decoration: underline;
			text-underline-offset: var(--underline-offset);
		}
	}

	/* The length in force, in the site's one chosen look (ink on the selection wash), the
	   wash reaching past the words so they do not move. */
	.overlay-length[aria-pressed="true"] {
		color: var(--color-text);
		background: var(--wash-selected);
		border-radius: var(--radius-sm);
		padding-inline: 0.5rem;
		margin-inline: -0.5rem;
	}

</style>
