---
import type { ImageMetadata } from "astro";
import type { Article } from "../lib/articles";
import EssayImage from "./EssayImage.astro";
import { CARD_LIST_WIDTHS } from "../lib/hero";

// The card grid — picture over title over a line of framing, with a quiet count
// beneath. Compact collection cards use whitespace between entries.
//
// It was ThreadList, and it was ThreadList's alone: the trådar on /tradar/, on
// the front page and in the /essaer/ intro. Fördjupning arrived on the front page
// as thin index rows beside it and lost the comparison badly — the same page was
// offering a browse axis in full-dress cards and the site's most substantial
// writing as a list. The cards were never about threads; they are what this site
// does when a handful of things each deserve a picture and a sentence. So the
// grid is generic now and ThreadList is a five-line mapper over it.

export interface CardItem {
	href: string;
	title: string;
	/** One line of framing under the title. */
	description?: string;
	/** A quiet last line — "6 essäer", "5 frågor". */
	meta?: string;
	/** `src` for bespoke art, `article` to borrow an essay's hero; either goes
	 *  through EssayImage, so both get the site-wide tonal wash and the frame's
	 *  hover bloom. Null renders a card that simply starts at its title. */
	image?: {
		src?: ImageMetadata;
		article?: Article;
		alt?: string;
	} | null;
}

interface Props {
	items: readonly CardItem[];
	headingLevel?: 2 | 3;
	/** Compact cards for collection indexes and related reading. */
	compact?: boolean;
	prefetch?: "tap" | "hover" | "viewport" | "load";
	/** The caller knows how wide its column is; the default suits the two-up grid
	 *  of the default 26rem --card-list-min: two ~29rem tracks in the 61rem canvas,
	 *  one full-width track below ~60rem. It said `26rem` — the track's MINIMUM,
	 *  not its width — and at 728px on a tablet the browser was fetching for 416. */
	sizes?: string;
}

const {
	items,
	headingLevel = 2,
	compact = false,
	prefetch,
	sizes = "(min-width: 67rem) 29rem, (min-width: 60rem) 45vw, 100vw",
} = Astro.props;

const Heading = `h${headingLevel}` as const;
---

<ul class:list={["card-list", compact && "card-list--compact"]}>
	{items.map((item) => (
		<li class="card-list-item">
			<a href={item.href} data-astro-prefetch={prefetch}>
				{item.image && (
					<span class="card-list-thumb media-frame">
						<EssayImage
							{...(item.image.src === undefined ? {} : { src: item.image.src })}
							{...(item.image.article === undefined ? {} : { article: item.image.article })}
							alt={item.image.alt ?? ""}
							widths={CARD_LIST_WIDTHS}
							sizes={sizes}
							loading="lazy"
						/>
					</span>
				)}
				<Heading class="card-list-title">{item.title}</Heading>
				{item.description && <p class="card-list-framing">{item.description}</p>}
				{item.meta && <p class="label card-list-count">{item.meta}</p>}
			</a>
		</li>
	))}
</ul>

<style>
	/* --card-list-min lets a caller trade card width for column count: the /tradar
	   index wants two wide cards, the front page three narrower ones. */
	/* ONE PICTURE CARD (DESIGN.md, »A role is written once«). This card and the essay
	   card (layout.css, `.essay-card`) are two markups for one object, and both read the
	   card's inside from tokens.css (`--card-*`): the title at the card-title step, the
	   line under it at the dense-prose step, whitespace and no hairline between cards.
	   Until 2026-10-16 only the front page's Fördjupning patched this one to those
	   numbers, so the same fördjupning card was 22.8px there and 19px on /fordjupning/
	   and /svar/, and a series card was 27.4px under a hairline on /tradar/. */
	.card-list {
		margin: var(--space-unit) 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--card-list-min, 26rem)), 1fr));
		gap: var(--space-group) var(--grid-gutter);
	}

	.card-list a {
		display: block;
		text-decoration: none;
		color: inherit;

		&:hover .card-list-title {
			text-decoration: underline;
			text-underline-offset: var(--underline-offset);
		}

		&:focus-visible {
			outline-offset: 0.4rem;
		}
	}

	/* Picture above the title, full card width. A card without art simply has no
	   thumb and the title starts it. */
	.card-list-thumb {
		display: block;
		margin-bottom: var(--card-media-gap);
	}

	.card-list-thumb :global(img) {
		display: block;
		width: 100%;
		aspect-ratio: 3 / 2;
		object-fit: cover;
	}

	.card-list-title {
		font-family: var(--font-display);
		font-variant-ligatures: common-ligatures;
		font-weight: 600;
		line-height: var(--card-title-leading);
		letter-spacing: 0;
		color: var(--color-text);
		margin: 0;
		font-size: var(--step-1);
	}

	.card-list-framing {
		font-family: var(--font-body);
		line-height: var(--card-text-leading);
		color: var(--text-quiet);
		margin: var(--card-text-gap) 0 0;
		font-size: var(--step--2);
	}

	.card-list-count {
		text-transform: none;
		letter-spacing: 0.01em;
		margin: 0.5rem 0 0;
	}

	/* Compact is the narrower track only: same card, more of them to a row. */
	.card-list--compact {
		--card-list-min: 18rem;
		margin: 0 0 var(--space-group);
	}
</style>
