---
import { ChevronUp } from "@lucide/astro";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import FloatingPlayer from "../components/FloatingPlayer.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import SearchOverlay from "../components/SearchOverlay.astro";
import { APP_STORE_ID } from "../lib/app";
import { articleJsonLd, breadcrumbList, organization, webSite } from "../lib/jsonld";
import "../styles/tokens.css";
import "../styles/reset.css";
import "../styles/typography.css";
import "../styles/layout.css";
import "../styles/dialog.css";
import "../styles/quran-verse.css";
import "../styles/chart.css";
import "../styles/editorial.css";

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
	/** Alt text for the OG/Twitter image. Defaults to the page title on essays and
	 *  a site descriptor elsewhere; pass an explicit value when the share card shows
	 *  page-specific content (e.g. a city's prayer-time card). */
	ogImageAlt?: string;
	/** Pixel size of `ogImage`, when it is not the 1200×630 share card. The default
	 *  is right for the generated /og/*.png cards, which is what most pages send;
	 *  a page passing a real photograph (a mosque hero, an essay hero) should say
	 *  its actual shape so a chat client reserves the right box instead of a
	 *  letterboxed one. Hint only — every crawler re-measures the fetched file. */
	ogImageWidth?: number;
	ogImageHeight?: number;
	/** Single-URL LCP preload (non-responsive images). */
	preloadImage?: string;
	/** Responsive LCP preload — the exact `srcset`/`sizes` the page's `<Image>`
	 *  emits, so the browser preloads the same candidate it will paint. */
	preloadImageSrcset?: string;
	preloadImageSizes?: string;
	/** MIME type of the preloaded candidate (e.g. "image/avif"), so the preload
	 *  matches the right `<source>` in the painted `<picture>`. */
	preloadImageType?: string;
	/** Preload Amiri Quran on pages that always paint Arabic — kills the font-swap
	 *  restyle of the verses. ~45 kB once, cached site-wide. */
	preloadArabicFont?: boolean;
	/** Preload Literata + Source Sans on pages with no competing LCP image preload.
	 *  Body/heading stay unpreloaded site-wide (see the comment below — that
	 *  bandwidth is reserved for the hero image), but a page with no hero has no
	 *  such contention, and text set high enough to still be visible when the
	 *  fonts land otherwise costs real CLS on this page's font-swap reflow. */
	preloadTextFonts?: boolean;
	/** Preload Literata Display (50 kB) where it sets the page's h1 — the essay, svar
	 *  and fördjupning titles (editorial.css). Same bandwidth rule as preloadTextFonts:
	 *  only where no hero image is competing for it. */
	preloadHeadlineFont?: boolean;
	articleMeta?: {
		publishedAt: string;
		/** Genuine later revision only — emits dateModified (freshness signal). */
		updatedAt?: string;
		wordCount: number;
		description: string;
		slug: string;
		/** Ämne (primary category) → emitted as the article:section OG tag. */
		section?: string;
		/** Sources cited by the essay (derived from Quran footnotes) → schema citation. */
		citations?: { name: string; url: string }[];
		/** Prebuilt schema.org ImageObject for the essay's original hero photo. When
		 *  present it becomes the Article's representative `image` (the clean photo,
		 *  not the OG share card) — see lib/jsonld.ts `imageObject()`. */
		image?: Record<string, unknown>;
	};
	/** Open Graph article tags for non-essay articles (svar, fördjupning) that build
	 *  their own Article JSON-LD. Only the og:type/article:* tags follow from it — no
	 *  Article block or essay breadcrumb, which `articleMeta` would add. */
	ogArticle?: {
		publishedAt: string;
		updatedAt?: string;
		section?: string;
	};
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	/** Utility pages with no search value (the correction form). */
	noindex?: boolean;
}

const {
	title,
	description = "Essäer om islamisk intellektuell tradition och svenskt kulturarv.",
	ogImage,
	ogImageAlt,
	ogImageWidth = 1200,
	ogImageHeight = 630,
	preloadImage,
	preloadImageSrcset,
	preloadImageSizes,
	preloadImageType,
	preloadArabicFont = false,
	preloadTextFonts = false,
	preloadHeadlineFont = false,
	articleMeta,
	ogArticle: ogArticleProp,
	jsonLd,
	noindex = false,
} = Astro.props;
const ogArticle = articleMeta ?? ogArticleProp;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage
	? new URL(ogImage, Astro.site).href
	: new URL("/og-default.png", Astro.site).href;
const pageTitle = title.replace(/ [–—] islam\.se$/, "").replace(/^islam\.se [–—] /, "");
const resolvedOgImageAlt =
	ogImageAlt ??
	(articleMeta ? pageTitle : "islam.se – essäer om islamisk intellektuell tradition och svenskt kulturarv");
const essaySectionHref = articleMeta ? "/essaer/" : undefined;
const mastSectionHref =
	essaySectionHref ??
	(Astro.url.pathname.startsWith("/fordjupning/") ? "/svar/" : undefined);

// Every page carries the canonical Organization + WebSite entity nodes; page-
// and article-level blocks reference them by @id so all claims merge onto one
// well-connected entity — the strongest AI-citation signal.
const jsonLdBlocks: Record<string, unknown>[] = [organization(), webSite()];

if (jsonLd) {
	jsonLdBlocks.push(...(Array.isArray(jsonLd) ? jsonLd : [jsonLd]));
}

if (articleMeta) {
	jsonLdBlocks.push(articleJsonLd({
		headline: title.replace(/ [–—] islam\.se$/, ""),
		description: articleMeta.description,
		publishedAt: articleMeta.publishedAt,
		...(articleMeta.updatedAt === undefined ? {} : { updatedAt: articleMeta.updatedAt }),
		wordCount: articleMeta.wordCount,
		url: canonicalUrl.href,
		// Prefer the clean hero ImageObject (Google Images / Licensable badge);
		// fall back to the OG card URL so image-less essays still carry an image.
		...(articleMeta.image
			? { image: articleMeta.image }
			: ogImage
				? { image: new URL(ogImage, Astro.site).href }
				: {}),
		...(articleMeta.citations === undefined ? {} : { citations: articleMeta.citations }),
	}));
	jsonLdBlocks.push(
		breadcrumbList([
			{ name: "Hem", url: "/" },
			{ name: "Essäer", url: "/essaer" },
			{ name: pageTitle, url: canonicalUrl.href },
		]),
	);
}
---

<!doctype html>
<html lang="sv">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content="#fff6e8" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#1d1912" media="(prefers-color-scheme: dark)" />

		{/* The theme switch, whole. It lives inline in the <head> — not in a bundled
		    module — for two reasons, both about the reader:

		    1. It must stamp the stored theme BEFORE first paint. A deferred script
		       lets the page paint in the OS scheme and then flip, and a light page
		       flashing dark (or the reverse) is the most jarring thing we can show.
		    2. The choice is handled by delegation on `document`, so the control works
		       from the moment it exists rather than from whenever a module finishes
		       downloading. Binding it in a component's module script measurably lost
		       early presses on a cold load — the reader pressed and nothing happened.

		    Delegation also means there is nothing to re-bind: the control survives
		    every ClientRouter swap on its own.

		    All it changes is one attribute; tokens.css turns that into a palette via
		    `color-scheme`, so no colour is defined twice. No stored value means no
		    attribute, which means the site follows the OS — we only override a
		    system setting the reader has explicitly overridden themselves. The
		    control itself is the Automatiskt/Ljust/Mörkt group in the site footer
		    (components/ThemePicker.astro). */}
		<script is:inline>
			(() => {
				const KEY = "theme";
				const LIGHT = "#fff6e8";
				const DARK = "#1d1912";
				// The search pill's shortcut hint: ⌘K on Apple keyboards, Ctrl K everywhere
				// else (the handler accepts both). Stamped here, before paint, so a Windows
				// reader never sees a ⌘ flash in and turn into Ctrl. Case-insensitive: Chromium
				// reports userAgentData.platform as »macOS«, Safari navigator.platform as »MacIntel«.
				const MAC = /mac|iphone|ipad|ipod/i.test(navigator.userAgentData?.platform || navigator.platform || "");
				const read = () => {
					try {
						const v = localStorage.getItem(KEY);
						return v === "light" || v === "dark" ? v : null;
					} catch {
						return null; // private mode / storage blocked — follow the OS
					}
				};

				const stamp = () => {
					const chosen = read();
					const root = document.documentElement;
					if (chosen) root.dataset.theme = chosen;
					else delete root.dataset.theme;
					if (MAC) root.dataset.kbd = "mac";
					// Under an override both media-scoped metas get the chosen colour, so
					// whichever one the OS matches paints the right browser chrome. Back on
					// "System" each meta must be handed its own colour again — they were
					// overwritten, and the media query alone can no longer tell them apart.
					for (const m of document.querySelectorAll('meta[name="theme-color"]')) {
						const dark = chosen ? chosen === "dark" : (m.getAttribute("media") || "").includes("dark");
						m.setAttribute("content", dark ? DARK : LIGHT);
					}
				};

				const paintControl = () => {
					const val = read() ?? "system";
					for (const el of document.querySelectorAll('input[name="theme-choice"]'))
						el.checked = el.value === val;
				};

				stamp(); // the reason this script is inline and in the head

				document.addEventListener("change", (e) => {
					const t = e.target;
					if (!t || t.name !== "theme-choice") return;
					// System removes the override and restores the reader’s OS preference.
					try {
						if (t.value === "system") localStorage.removeItem(KEY);
						else localStorage.setItem(KEY, t.value);
					} catch {
						/* storage blocked — nothing to persist, but still repaint below */
					}
					stamp();
				});

				// ClientRouter swaps in the new document's <html> attributes, dropping
				// data-theme on every navigation; re-stamp before the new page paints.
				for (const ev of ["DOMContentLoaded", "astro:after-swap"])
					document.addEventListener(ev, () => {
						stamp();
						paintControl();
					});
			})();
		</script>

		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		{/* Native iOS Smart App Banner — a subtle, dismissible nudge in Safari on every
		    page; the strong in-page promo stays on the prayer surfaces. */}
		<meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />
		{/* Text-led pages preload normal faces. Italic shares the body family and loads
		    on demand; image-led pages leave bandwidth available for the hero. */}
		<Font cssVariable="--font-body" preload={preloadTextFonts ? [{ style: "normal" }] : false} />
		{preloadTextFonts ? <Font cssVariable="--font-heading" preload /> : <Font cssVariable="--font-heading" />}
		{preloadArabicFont ? <Font cssVariable="--font-arabic" preload /> : <Font cssVariable="--font-arabic" />}
		{preloadHeadlineFont ? <Font cssVariable="--font-headline" preload /> : <Font cssVariable="--font-headline" />}
		{preloadImageSrcset ? (
			<link rel="preload" as="image" type={preloadImageType} imagesrcset={preloadImageSrcset} imagesizes={preloadImageSizes} fetchpriority="high" />
		) : preloadImage ? (
			<link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
		) : null}
		<title>{title}</title>
		<meta name="description" content={description} />
		{/* Every content page is indexable; non-canonical URLs are 301-redirected at the edge, never
		    served. Only utility pages that opt in via `noindex` are held back. The preview directives
		    are the part Google actually reads: max-image-preview:large makes each page eligible for a
		    large image in Search and Discover (so the OG/hero card can show big), and max-snippet:-1 /
		    max-video-preview:-1 lift the text- and video-snippet caps.
		    A JSX-style comment keeps this rationale in source without shipping it on every page. */}
		<meta
			name="robots"
			content={
				noindex
					? "noindex, follow"
					: "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
			}
		/>
		<link rel="canonical" href={canonicalUrl.href} />

		<!-- Open Graph -->
		<meta property="og:type" content={ogArticle ? "article" : "website"} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl.href} />
		<meta property="og:site_name" content="islam.se" />
		<meta property="og:locale" content="sv_SE" />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content={String(ogImageWidth)} />
		<meta property="og:image:height" content={String(ogImageHeight)} />
		<meta property="og:image:alt" content={resolvedOgImageAlt} />
		{ogArticle && <meta property="article:published_time" content={ogArticle.publishedAt} />}
		{ogArticle && <meta property="article:modified_time" content={ogArticle.updatedAt ?? ogArticle.publishedAt} />}
		{ogArticle && <meta property="article:author" content="https://islam.se" />}
		{ogArticle?.section && <meta property="article:section" content={ogArticle.section} />}

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content={resolvedOgImageAlt} />

		<!-- RSS -->
		<link rel="alternate" type="application/rss+xml" title="islam.se" href="/rss.xml" />
		<link rel="alternate" type="application/rss+xml" title="islam.se podcast" href="/podcast.xml" />

		<!-- AI / LLM discovery: curated site map + a clean-markdown copy of each essay -->
		<link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
		{articleMeta && <link rel="alternate" type="text/markdown" title={pageTitle} href={`/${articleMeta.slug}.md`} />}

		<!-- View Transitions -->
		<ClientRouter />

		<!-- JSON-LD -->
		{jsonLdBlocks.map((block) => (
			<script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />
		))}
	</head>
	<body>
		<a href="#main" class="skip-link">Hoppa till innehållet</a>
		{/* Reading progress is an essay metaphor — browse pages get no bar. */}
		{articleMeta && <div class="reading-progress" aria-hidden="true" data-slug={articleMeta.slug} data-title={pageTitle} />}
		<Header {...(mastSectionHref === undefined ? {} : { activeHref: mastSectionHref })} />
		<slot />
		<Footer {...(essaySectionHref === undefined ? {} : { activeHref: essaySectionHref })} />
		<div class="fixed-actions">
			{articleMeta && (
				<button class="share-btn label" type="button" aria-label="Dela essä" data-title={pageTitle} data-url={canonicalUrl.href}>Dela</button>
			)}
			<button class="btn-circle back-to-top" type="button" aria-label="Tillbaka till toppen">
				<ChevronUp size={20} stroke-width={1.75} />
			</button>
		</div>
		<script>
			import { recordProgress } from "../scripts/reading-progress";

			document.addEventListener("astro:page-load", () => {
				const actions = document.querySelector<HTMLElement>(".fixed-actions");
				const btn = document.querySelector<HTMLButtonElement>(".back-to-top");
				if (!actions || !btn) return;
				const ctrl = new AbortController();
				let shown = false;
				const progressBar = document.querySelector<HTMLElement>(".reading-progress");
				const nativeProgress = CSS.supports("animation-timeline", "scroll(root y)");
				const slug = progressBar?.dataset.slug;
				const title = progressBar?.dataset.title;
				let lastSave = 0;
				const shareBtn = document.querySelector<HTMLButtonElement>(".share-btn");

				function scrollPct() {
					const scrollable = document.documentElement.scrollHeight - window.innerHeight;
					return scrollable > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollable)) : 0;
				}

				const saveProgress = () => {
					if (slug) recordProgress(slug, scrollPct(), title);
				};

				const updateScroll = () => {
					const shouldShow = window.scrollY > window.innerHeight;
					if (shouldShow !== shown) {
						shown = shouldShow;
						actions.classList.toggle("visible", shown);
					}
					if (progressBar) {
						if (!nativeProgress) progressBar.style.transform = `scaleX(${scrollPct()})`;
						if (slug && Date.now() - lastSave > 500) {
							lastSave = Date.now();
							saveProgress();
						}
					}
				};
				window.addEventListener("scroll", updateScroll, { passive: true, signal: ctrl.signal });
				window.addEventListener("resize", updateScroll, { passive: true, signal: ctrl.signal });
				// Restore the controls and fallback bar when arriving at a saved scroll position.
				updateScroll();

				btn.addEventListener("click", () => {
					const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
					window.scrollTo({ top: 0, behavior: reduced ? "instant" : "smooth" });
				}, { signal: ctrl.signal });

				if (shareBtn) {
					shareBtn.addEventListener("click", async () => {
						const title = shareBtn.dataset.title || "";
						const url = shareBtn.dataset.url || location.href;
						if (navigator.share) {
							try { await navigator.share({ title, url }); } catch {}
						} else {
							// writeText rejects without a secure context or clipboard permission;
							// say nothing rather than claim a copy that did not happen.
							try {
								await navigator.clipboard.writeText(url);
							} catch {
								return;
							}
							shareBtn.textContent = "Kopierad";
							setTimeout(() => { shareBtn.textContent = "Dela"; }, 2000);
						}
					}, { signal: ctrl.signal });
				}

				document.addEventListener("visibilitychange", () => {
					if (document.visibilityState === "hidden") saveProgress();
				}, { signal: ctrl.signal });

				document.addEventListener("astro:before-swap", () => {
					saveProgress();
					ctrl.abort();
				}, { once: true });
			});
		</script>
		<FloatingPlayer />
		<SearchOverlay {...(essaySectionHref === undefined ? {} : { activeHref: essaySectionHref })} />
	</body>
</html>
