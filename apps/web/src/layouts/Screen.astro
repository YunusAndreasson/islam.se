---
// The chrome-free shell for the moskéskärm. Base.astro is the wrong parent here: it
// unconditionally renders the header (with its own prayer chip), the footer, the
// floating audio player, the ⌘K palette, a skip link and a back-to-top button — every
// one of which is furniture for a reader, and none of which belongs on a television
// mounted three metres up a wall in a foyer.
//
// What is deliberately NOT here, and why:
//
//  • <ClientRouter /> — the page never navigates. View transitions would only add a
//    router that re-stamps <html> attributes on a page that has no second page.
//  • The pre-paint theme IIFE — the screen is always dark, whatever the reader's
//    stored preference. data-theme below pins it; MosqueScreen.astro says why.
//  • Analytics, JSON-LD, Open Graph — nobody shares a wall display.
//
// What is kept: the fonts (preloaded, because there is no competing hero image and the
// whole page is type), the token and reset stylesheets, and the viewport meta.
import { Font } from "astro:assets";
import "../styles/tokens.css";
import "../styles/reset.css";
import "../styles/typography.css";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="sv" data-theme="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		{/* Dark whatever the OS prefers, so the site tokens the screen borrows (the mark's
		    blue and gold) resolve to the same half as its own ground. */}
		<meta name="color-scheme" content="dark" />
		{/* The screen's own navy (MosqueScreen.astro, --screen-bg): a tablet pinned to a
		    home screen paints its status bar from this, and the site's parchment would be
		    a cream strip across the top of a dark wall. */}
		<meta name="theme-color" content="#161a26" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title}</title>

		{/* Preloaded, unlike everywhere else on the site: there is no hero image to
		    compete with for early bandwidth, and every pixel of this page is type. */}
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-heading" preload />

		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
	</head>
	<body class="screen-body">
		<slot />
		{/* The reload guard fetches this page and looks for this marker before it dares
		    reload the wall. A 200 from a captive portal is not proof the page is
		    reachable; this string is. See kiosk.ts proveOnline(). */}
		<!--skarm-ok-->
		<style is:global>
			/* reset.css reserves a scrollbar gutter on every page so the site's column never
			   jumps when a scrollbar appears. This page never scrolls, and the reserved strip
			   was not painted: in the builder's iframe it showed as a 10 px band of the
			   parchment page down the right edge of the preview, and a signage browser with
			   classic scrollbars would draw the same band down the wall. */
			html:has(> .screen-body) {
				scrollbar-gutter: auto;
			}
			.screen-body {
				margin: 0;
				overflow: hidden;
				background: var(--screen-bg, #161a26);
			}
			/* A wall display has no pointer. Hiding the cursor after it stops moving is
			   the difference between a finished screen and someone's laptop. */
			.screen-body[data-idle="1"] {
				cursor: none;
			}
		</style>
	</body>
</html>
