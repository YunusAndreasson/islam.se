---
import { getImage } from "astro:assets";
import { ChevronDown } from "@lucide/astro";
import SectionLink from "../components/SectionLink.astro";
import TitledSection from "../components/TitledSection.astro";
import SearchInput from "../components/finder/SearchInput.astro";
import PageHead from "../components/PageHead.astro";
import LocationButton from "../components/finder/LocationButton.astro";
import RelatedLinks from "../components/finder/RelatedLinks.astro";
import Base from "../layouts/Base.astro";
import { formatDate } from "../lib/articles";
import { breadcrumbList, dataset } from "../lib/jsonld";
import { directionsLinks, getMosques, lanSlug, locationLabel, mosqueUrl, mosquesByLan, swedishAddress } from "../lib/moskeer";
import { MOSQUE_PHOTOS } from "../lib/moskeer/art";
import { MOSKEER_DATA_DATE } from "../lib/moskeer/meta";
import { burialLocationLabel, getBurialGrounds, sectionLabel } from "../lib/begravningsplatser";
import { BURIAL_GLYPH_GRID, BURIAL_GLYPH_PATH } from "../lib/begravningsplatser/glyph";
import { fold } from "../lib/search-text";
// ⚠️ maplibre-gl.css is NOT imported here. In the frontmatter it joins the page's
// stylesheet graph, and `inlineStylesheets: "always"` then inlines 130 kB of it into
// <head>. scripts/moskeer-map.ts imports it alongside the map bundle instead.

const mosques = getMosques();
const groups = mosquesByLan();
const total = mosques.length;
const cityCount = new Set(mosques.map((m) => m.citySlug)).size;
const updated = formatDate(MOSKEER_DATA_DATE);

// Share card: the first mosque in the gallery rather than the site default. A
// link to this page should preview as a Swedish mosque, which is the whole
// claim the page makes.
const cardPhoto = MOSQUE_PHOTOS[0];
const card = cardPhoto ? await getImage({ src: cardPhoto.src, width: 1200, format: "webp" }) : undefined;

// The per-mosque detail the map callout needs, looked up by id on click. Kept lean and
// embedded once as JSON; `<` is escaped so a name can never break out of the script tag.
const payload = mosques.map((m) => {
	const d = directionsLinks(m);
	return {
		id: m.id,
		name: m.name,
		lng: m.lng,
		lat: m.lat,
		location: locationLabel(m),
		address: m.address,
		opened: m.opened,
		organisation: m.organisation,
		google: d.google,
		apple: d.apple,
		geo: d.geo,
	};
});
const payloadJson = JSON.stringify(payload).replace(/</g, "\\u003c");

// The Muslim burial grounds, drawn on the same map as a second kind of place (see
// lib/begravningsplatser). The list beside the map stays the mosques': that is the directory
// this page is, and a cemetery filed among the mosques of its län would be a wrong answer to
// "which mosques are in Skåne". The map is where the two meet.
const burialPayload = getBurialGrounds().map((b) => {
	const d = directionsLinks(b);
	return {
		id: b.id,
		name: b.name,
		section: sectionLabel(b),
		lng: b.lng,
		lat: b.lat,
		lan: b.lan,
		location: burialLocationLabel(b),
		address: b.address,
		opened: b.opened,
		source: b.source,
		google: d.google,
		apple: d.apple,
	};
});
const burialJson = JSON.stringify(burialPayload).replace(/</g, "\\u003c");

const description = `Hitta bland ${total} moskéer på ${cityCount} orter i Sverige. Karta, adresser och vägbeskrivningar, ordnade efter län. Uppdaterad ${updated}.`;


---

<Base
	title="Moskéer i Sverige – karta och adresser län för län – islam.se"
	description={description}
	{...(card === undefined ? {} : { ogImage: card.src })}
	{...(cardPhoto === undefined ? {} : { ogImageAlt: cardPhoto.alt })}
	{...(card === undefined ? {} : { ogImageWidth: 1200, ogImageHeight: 800 })}
	jsonLd={[
		{
			"@context": "https://schema.org",
			"@type": "CollectionPage",
			name: "Moskéer i Sverige",
			description,
			url: "https://islam.se/moskeer/",
			inLanguage: "sv",
		},
		dataset({
			name: "Moskéer i Sverige",
			description:
				"Öppen karta över moskéer och muslimska församlingar i Sverige med plats (kommun och län), öppningsår och, där det är känt, huvudman eller finansiering.",
			url: "/moskeer",
			license: "https://creativecommons.org/licenses/by/4.0/",
			creator: ["islam.se", "OpenStreetMap-bidragsgivare"],
			spatialCoverage: "Sverige",
		}),
		{
			"@context": "https://schema.org",
			"@type": "ItemList",
			name: "Moskéer i Sverige",
			numberOfItems: total,
			itemListElement: mosques.map((m, i) => ({
				"@type": "ListItem",
				position: i + 1,
				name: m.name,
				url: mosqueUrl(m),
			})),
		},
		breadcrumbList([
			{ name: "Hem", url: "/" },
			{ name: "Moskéer i Sverige", url: "/moskeer" },
		]),
	]}
>
	<main id="main" class="home moskeer">
		<PageHead title="Moskéer" />
		<label class="sr-only" for="mk-search">Sök moské eller ort</label>

		<div class="mk-controls">
			<SearchInput id="mk-search" class="mk-search-wrap" placeholder="Sök moské eller ort" />
			<label class="mk-lan-filter">
				<span class="visually-hidden">Filtrera efter län</span>
				<select id="mk-lan" aria-label="Filtrera efter län">
					<option value="">Alla län</option>
					{groups.map((g) => <option value={g.lan}>{g.lanLabel}</option>)}
				</select>
				<ChevronDown class="mk-lan-chevron" size={16} />
			</label>
			<LocationButton id="mk-geo" class="mk-geo" aria-describedby="mk-geo-status">Nära mig</LocationButton>
		</div>
		<div class="mk-result-bar">
			<p id="mk-count" class="mk-count" aria-live="polite">{total} moskéer</p>
			{/* Legend and switch in one: the glyph says what the map's second kind of mark is,
			    and the box hides them. Hidden until the map is up — without the map there is
			    nothing for it to switch. */}
			<label class="mk-graves" hidden>
				<input type="checkbox" id="mk-graves" checked />
				<svg class="mk-graves-glyph" viewBox={`0 0 ${BURIAL_GLYPH_GRID} ${BURIAL_GLYPH_GRID}`} aria-hidden="true"><path d={BURIAL_GLYPH_PATH} /></svg>
				Muslimska gravkvarter
			</label>
			<div class="mk-view-switch" role="group" aria-label="Visning" hidden>
				<button type="button" data-mk-view="list" aria-pressed="true" aria-controls="mk-results-pane">Lista</button>
				<button type="button" data-mk-view="map" aria-pressed="false" aria-controls="mk-stage">Karta</button>
			</div>
			<button type="button" id="mk-reset" class="mk-reset" hidden>Rensa filter</button>
		</div>
		<p id="mk-geo-status" class="mk-geo-status" role="status"></p>

		<div class="mk-explorer">
		<div class="mk-stage" id="mk-stage">
			<p class="mk-loading" role="status">Laddar kartan …</p>
			{/* role="region", inte "application". `application` säger åt skärmläsaren att lämna
			    över ALLA tangenttryck till widgeten och stänga av sitt eget läsläge — rimligt
			    för en redigerare, fel för en karta som inte har någon egen tangentmodell. Följden
			    var att pil- och läskommandon slutade fungera i en 700 px hög ruta utan innehåll
			    att läsa. `region` ger etiketten och landmärket utan att kapa tangentbordet. */}
			<div id="moskeer-map" class="mk-map" role="region" aria-label="Karta över moskéer och muslimska gravkvarter i Sverige"></div>
			<aside id="mk-callout" class="mk-callout" aria-label="Vald moské" aria-live="polite" hidden></aside>
		</div>
		<noscript>
			<p class="mk-noscript">Den interaktiva kartan kräver JavaScript. Alla moskéer finns i länslistan.</p>
		</noscript>

		<TitledSection class="mk-results" sectionId="mk-results-pane" id="mk-find" title="Län och moskéer">
			<div class="mk-lan-groups">
				{groups.map((g) => (
					<details class="mk-lan" data-lan={g.lan}>
 <summary><span class="mk-lan-name">{g.lanLabel}</span><span class="mk-lan-count">{g.mosques.length}</span><ChevronDown size={16} aria-hidden="true" /></summary>
						<ul class="mk-lan-list">
							{g.mosques.map((m) => (
								<li>
									<a
										href={mosqueUrl(m)}
										class="mk-item"
										data-id={m.id}
										data-lan={g.lan}
										data-search={fold(`${m.name} ${locationLabel(m)} ${m.address ?? ""}`)}
									>
										<span class="mk-item-name">{m.name}</span>
										{m.address && <span class="mk-item-addr">{swedishAddress(m)}</span>}
										<span class="mk-item-loc">
											{locationLabel(m)}
										</span>
									</a>
								</li>
							))}
						</ul>
						<SectionLink class="mk-lan-all" href={`/moskeer/lan/${lanSlug(g.lan)}/`}>
							Alla moskéer i {g.lanLabel}
						</SectionLink>
					</details>
				))}
			</div>
			<div id="mk-empty" class="mk-empty" hidden>
				<p class="mk-empty-msg">Inga moskéer matchar din sökning.</p>
				<button type="button" id="mk-clear" class="mk-clear">Rensa filter</button>
			</div>
		</TitledSection>

		</div>

		<RelatedLinks label="Mer om moskéer" links={[
			{href: "/moskeer/om/", label: "Om moskéer · historia och besök"},
			{href: "/bonetider/", label: "Bönetider för din ort"},
		]} />

		<p class="mk-attrib">
			Uppdaterad <time datetime={MOSKEER_DATA_DATE}>{updated}</time>. Underlaget kan vara ofullständigt. Adresser och positioner är ungefärliga. Varje gravkvarter på kartan länkar till källan som bekräftar det.
		</p>
	</main>

	<script id="moskeer-data" type="application/json" is:inline set:html={payloadJson}></script>
	<script id="begravning-data" type="application/json" is:inline set:html={burialJson}></script>
</Base>

<script>
	import "../scripts/moskeer-view";
	import "../scripts/moskeer-map";
</script>

<style>




	/* Controls row above the map — one cohesive toolbar: the search field, län filter and
	   the geolocation CTA share a shape, height and focus treatment. */

	/* stretch, not center: the search box carries its border outside a 3rem input and so stands
	   50px, while the select and the button keep their border inside 3rem and stand 48. Centred,
	   the three drew six edges at four different heights; stretched, the shorter two take the
	   row's height and the ends line up. The bönetider finder has always done it this way. */
	.mk-controls {
		display: flex;
		flex-wrap: wrap;
		align-items: stretch;
		gap: var(--space-half);
		margin-bottom: var(--space-half);
	}





	/* The label is the flex item that stretches; the select inside has to fill it, or it keeps
	   its own 48 inside a 50px box and nothing is gained. */
	.mk-lan-filter {
		position: relative;
		display: inline-flex;
		align-items: stretch;
	}

	/* Centred on its own, not by the parent's align-items: an absolutely positioned flex child
	   still takes its static position from that, so stretching the row sent the chevron to the
	   top of the select. */
	.mk-lan-chevron {
		position: absolute;
		top: 50%;
		right: 0.8rem;
		transform: translateY(-50%);
		color: var(--color-accent);
		pointer-events: none;
	}

	#mk-lan {
		appearance: none;
		font-family: var(--font-heading);
		font-size: var(--step--2);
		color: var(--color-accent);
		background: var(--color-bg);
		border: 1px solid var(--color-divider);
		border-radius: var(--radius-sm);
		padding: 0.55rem 2.4rem 0.55rem 1rem;
		cursor: pointer;
	}





	.mk-search:focus-visible,
	#mk-lan:focus-visible,
	.mk-geo:focus-visible,
	.mk-clear:focus-visible {
		outline-offset: 1px;
	}

	.mk-reset {
		font-family: var(--font-heading);
		font-size: var(--step--2);
		color: var(--color-muted);
		background: transparent;
		border: 1px solid var(--color-divider);
		border-radius: var(--radius-sm);
		cursor: pointer;
		padding: 0.5rem 1rem;
		transition:
			color var(--dur-fast),
			border-color var(--dur-fast);
	}

	.mk-reset:hover {
		color: var(--color-accent);
		border-color: var(--color-warm);
	}

	.mk-count {
		font-family: var(--font-body);
		font-size: var(--step--3);
		color: var(--color-muted);
		margin: 0;
		margin-left: auto;
		font-variant-numeric: lining-nums tabular-nums;
	}

	/* Geolocation feedback (denial / errors). Collapses when empty so it never adds a gap.
	   --color-muted, not --color-warm: this is the only place the reader is told why
	   "Nära mig" did nothing, set at --step--3, and --color-warm is the 3:1 UI/border
	   tier (3.01:1) — under AA for text. */
	.mk-geo-status {
		font-family: var(--font-body);
		font-size: var(--step--3);
		color: var(--color-muted);
		margin: 0 0 var(--space-half);
	}

	.mk-geo-status:empty {
		display: none;
	}

	/* The map stage — mirrors the Bönetider field's framing. */
	.mk-stage {
		position: relative;
	}

	.mk-map {
		/* Taller than wide-ish: Sweden is a portrait country, so give it vertical room
		   (the dimension that bounds the fit) and it fills the frame instead of floating
		   in sea. */
		height: 540px;
		min-height: 360px;
		border-radius: var(--radius-lg);
		overflow: hidden;
		/* Anchors .is-error before maplibre sets it on the container itself. */
		position: relative;
		/* Water tone from PALETTE in scripts/moskeer-map.ts — keep in step. */
		background: light-dark(#bcd0de, #15171a);
		border: 1px solid var(--color-divider);
		box-shadow: 0 1px 2px rgb(var(--hero-black) / 0.04), 0 12px 28px -16px rgb(var(--hero-black) / 0.25);
	}

	/* In fullscreen the stage fills the screen; the map (normally a fixed height) and its
	   callout must grow to fill it. FullscreenControl targets .mk-stage so the callout +
	   controls stay inside the fullscreen subtree. */
	.mk-stage:fullscreen {
		width: 100%;
		height: 100%;
		background: var(--color-bg);
	}

	.mk-stage:fullscreen .mk-map {
		height: 100%;
		min-height: 0;
		border: 0;
		border-radius: 0;
	}

	.mk-callout {
		position: absolute;
		/* Bottom-right: clear of the top-right control stack and of Sweden's dense
		   south-west cluster (the attribution sits bottom-left). */
		right: 0.75rem;
		bottom: 0.75rem;
		width: min(22rem, calc(100% - 1.5rem));
		padding: 0.85rem 1rem 0.95rem;
		border-radius: var(--radius-lg);
		background: color-mix(in srgb, var(--color-bg) 94%, transparent);
		backdrop-filter: blur(10px);
		max-height: 60%;
		overflow-y: auto;
		border: 1px solid var(--color-divider);
		box-shadow: 0 1px 14px -4px rgb(var(--hero-black) / 0.45);
		z-index: 2;
	}

	/* On phones the card becomes a bottom sheet pinned to the foot of the map. */
	@media (width <= 37.5rem) {
		.mk-callout {
			right: 0;
			left: 0;
			bottom: 0;
			width: 100%;
			border-radius: var(--radius-lg) var(--radius-lg) 0 0;
			padding-bottom: calc(0.95rem + env(safe-area-inset-bottom, 0px));
		}
	}

	.mk-noscript {
		font-family: var(--font-body);
		color: var(--color-muted);
		margin-top: var(--space-half);
	}


	.mk-lead a {
		color: var(--color-accent);
	}

	.mk-item {
		display: flex;
		flex-direction: column;
		gap: 0.05rem;
		width: 100%;
		text-align: left;
		background: none;
		border: none;
		border-left: 2px solid transparent;
		padding: 0.3rem 0.2rem 0.3rem 0.6rem;
		cursor: pointer;
	}

	.mk-item:hover .mk-item-name,
	.mk-item:focus-visible .mk-item-name {
		color: var(--color-accent);
		text-decoration: underline;
		text-underline-offset: var(--underline-offset);
	}

	.mk-item:focus-visible {
		outline-offset: 1px;
	}

	.mk-item.is-active {
		border-left-color: var(--color-warm);
	}

	.mk-item.is-active .mk-item-name {
		color: var(--color-accent);
	}

	.mk-item-name {
		font-family: var(--font-heading);
		font-size: var(--step--1);
		font-weight: 600;
		color: var(--color-text);
	}

	.mk-item-addr {
		font-family: var(--font-body);
		font-size: var(--step--3);
		color: var(--color-muted);
	}

	.mk-item-loc {
		font-family: var(--font-body);
		font-size: var(--step--3);
		color: var(--color-muted);
	}

	/* Placement only — the rest is `.section-link .arrow-link`. */
	.mk-lan-all {
		margin-top: var(--space-half);
	}

	/* Shown by the map script when a search/filter matches nothing. */
	.mk-empty {
		padding: var(--space-unit) 0;
		text-align: center;
	}

	.mk-empty-msg {
		font-family: var(--font-body);
		color: var(--color-muted);
		margin: 0 0 var(--space-half);
	}

	.mk-clear {
		font-family: var(--font-heading);
		font-size: var(--step--2);
		font-weight: 600;
		color: var(--color-accent);
		background: var(--color-bg);
		border: 1px solid var(--color-divider);
		border-radius: var(--radius-sm);
		padding: 0.45rem 1.1rem;
		cursor: pointer;
		transition: border-color var(--dur-fast) ease;
	}

	.mk-clear:hover {
		border-color: var(--color-warm);
	}


 .mk-result-bar { display: flex; align-items: center; flex-wrap: wrap; gap: 1rem; min-height: 2.75rem; }
 .mk-result-bar .mk-count { margin: 0; font-family: var(--font-heading); font-size: var(--step--2); }
 .mk-graves:not([hidden]) { display: inline-flex; align-items: center; gap: .45rem; min-height: 2.75rem; font: var(--step--2) var(--font-heading); color: var(--color-muted); cursor: pointer; }
 .mk-graves input { accent-color: var(--color-brass); width: 1rem; height: 1rem; margin: 0; }
 .mk-graves-glyph { width: 1.15rem; height: 1.15rem; fill: var(--color-brass); flex: none; }
 .mk-result-bar .mk-reset { margin-left: auto; padding: .5rem 0; border: 0; text-decoration: underline; text-underline-offset: .2em; min-height: 2.75rem; }
 .mk-list-jump { font-family: var(--font-heading); font-size: var(--step--2); padding-block: .5rem; }
 @media (width >= 50rem) { .mk-list-jump { display: none; } }
 #mk-lan { min-height: 3rem; }

 .mk-explorer { display: grid; gap: var(--space-unit); margin-top: var(--space-half); }
 .mk-results { min-width: 0; padding: 1rem; border: 1px solid var(--color-divider); border-radius: var(--radius-lg); }
 .mk-results :global(h2) { font-family: var(--font-heading); font-size: var(--step--2); font-weight: 500; color: var(--color-muted); margin: 0 0 .75rem; }
 .mk-lan-groups { display: block; }
 .mk-lan { margin-bottom: 0; padding-bottom: .25rem; }
 .mk-lan summary { min-height: 2.75rem; align-items: center; font-size: var(--step--2); font-weight: 500; }
 .mk-lan-list li + li { border-top: 1px solid var(--color-divider); }
 .mk-lan-name { min-width: 0; overflow-wrap: anywhere; }
 .mk-lan-count { margin-left: auto; flex: none; }
 .mk-lan summary :global(svg) { flex: none; }
 .mk-lan[open] summary :global(svg) { transform: rotate(180deg); }
 .mk-item { min-height: 2.75rem; padding: .85rem .5rem; gap: .2rem; }
 .mk-item:hover, .mk-item.is-active { background: var(--wash-hover); }
 @media (width >= 50rem) {
  .mk-explorer { grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); align-items: start; }
  .mk-stage { grid-column: 2; grid-row: 1; }
  .mk-results { grid-column: 1; grid-row: 1; max-height: 540px; overflow-y: auto; padding-right: .75rem; scrollbar-gutter: stable; }
 }
 @media (width < 50rem) { .mk-map { height: 26.25rem; } }
 @media (width < 30rem) { .mk-search-wrap { flex-basis: 100%; } .mk-lan-filter { flex: 1 1 calc(50% - .5rem); } #mk-lan { width: 100%; max-width: 100%; } .mk-geo { flex: 1 1 calc(50% - .5rem); } }

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
		border: 0;
	}

	@media (width <= 30rem) {
		.mk-count {
			margin-left: 0;
		}
	}

	.mk-loading { position: absolute; inset: 1rem 3rem auto 1rem; z-index: 1; margin: 0; color: var(--color-muted); font: var(--step--2) var(--font-heading); }
	.mk-stage:has(.is-ready) .mk-loading,
	.mk-stage:has(.is-error) .mk-loading { display: none; }
	.mk-view-switch { display: none; }
	.mk-item { text-decoration: none; }
	@media (width < 50rem) {
		.mk-view-switch:not([hidden]) { display: flex; border: 1px solid var(--color-rule); border-radius: var(--radius-sm); padding: .2rem; }
		.mk-view-switch button { min-height: 2.75rem; padding: .5rem 1rem; border: 0; border-radius: var(--radius-xs); background: transparent; color: var(--color-text); font: var(--step--2) var(--font-heading); cursor: pointer; }
		.mk-view-switch button[aria-pressed="true"] { background: var(--color-text); color: var(--color-bg); }
		.moskeer[data-view="list"] .mk-stage,
		.moskeer[data-view="map"] .mk-results { display: none; }
	}
</style>

<!-- Callout internals are injected by JS (innerHTML), so scoped styles can't reach
     them — style them globally, scoped by the .mk-callout prefix. -->
<style is:global>
	.mk-callout-close {
		position: absolute;
		top: 0.4rem;
		right: 0.5rem;
		background: none;
		border: none;
		font-size: var(--step-0);
		line-height: 1;
		color: var(--color-muted);
		cursor: pointer;
		padding: 0.1rem 0.3rem;
	}

