---
import { Search } from "@lucide/astro";
import Ritning from "../components/Ritning.astro";
import SectionOrnament from "../components/SectionOrnament.astro";
import Base from "../layouts/Base.astro";
import { MAST_SECTION_LINKS, MAST_UTILITY_LINKS } from "../lib/navigation";
import { RITNINGAR } from "../lib/ritningar";

// A miss should end somewhere: the search, then the doorways the mast offers. Built
// from the mast arrays so the list cannot drift from the site's own navigation.
const onward = [{ href: "/", label: "Startsidan" }, ...MAST_SECTION_LINKS, MAST_UTILITY_LINKS[0]!];
---

{/* Cloudflare Pages serves this file with a real HTTP 404, so it is not indexable in
    practice — but it is reachable at /404/ as an ordinary page, where it would emit a
    self-referencing canonical and an index directive for a page that says "här finns
    ingenting". `noindex, follow` costs nothing and removes the ambiguity. */}
<Base
	title="Sidan finns inte"
	description="Sidan du söker finns inte."
	noindex={true}
>
	<main id="main" class="content-column notfound">
		{/* An empty bench and a lantern by a path that turns away: the page went elsewhere. */}
		<Ritning {...RITNINGAR.vilse} class="notfound-ritning" hojd={[7, 10]} bredd={[10, 14]} />
		<p class="label notfound-code">404</p>
		<h1 class="notfound-title">Sidan finns inte</h1>
		<p class="notfound-lead">
			Adressen kan ha ändrats, eller så har sidan tagits bort.
		</p>
		{/* [data-open-search] is picked up by SearchOverlay's click delegation. */}
		<button class="notfound-search" type="button" data-open-search>
			<Search size={16} stroke-width={1.75} aria-hidden="true" />
			Sök på islam.se
		</button>
		<nav class="notfound-links" aria-label="Vidare">
			{onward.map((link) => <a href={link.href}>{link.label}</a>)}
		</nav>
		<SectionOrnament />
	</main>
</Base>

<style>
	.notfound {
		min-height: 56vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		text-align: center;
		padding-block: var(--space-phi2);
	}

	/* .label sets this at small-caps size, so it is small text and takes the
	   4.5:1 tier. --color-warm is the 3:1 UI/border tier (3.01:1) and fails it. */
	.notfound-ritning {
		align-self: center;
		margin-bottom: var(--space-unit);
	}

	.notfound-code {
		color: var(--color-muted);
		margin: 0 0 var(--space-half);
	}

	.notfound-title {
		margin: 0;
	}

	.notfound-lead {
		font-family: var(--font-body);
		font-size: var(--step--1);
		line-height: 1.55;
		color: var(--text-body);
		max-width: 30rem;
		margin: var(--space-unit) auto 0;
	}

	.notfound-search {
		display: inline-flex;
		align-items: center;
		align-self: center;
		gap: 0.5rem;
		min-height: var(--tap-target);
		margin-top: var(--space-unit);
		padding: 0 1.1rem;
		border: var(--border-row);
		border-radius: var(--radius-pill);
		background: transparent;
		color: var(--color-accent);
		font-family: var(--font-heading);
		font-size: var(--step--1);
		font-weight: 500;
		cursor: pointer;
		transition:
			color var(--dur-fast) ease,
			border-color var(--dur-fast) ease;

		&:hover {
			border-color: var(--color-warm);
		}
	}

	/* Padded so each doorway is a real target (2.75rem tall), not a bare word. */
	.notfound-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		column-gap: 1.25rem;
		margin-top: var(--space-half);
		font-family: var(--font-heading);
		font-size: var(--step--1);
		font-weight: 500;
	}

	.notfound-links a {
		display: inline-flex;
		align-items: center;
		min-height: var(--tap-target);
		color: var(--color-accent);
		text-decoration: none;

		&:hover,
		&:focus-visible {
			text-decoration: underline;
			text-underline-offset: var(--underline-offset);
		}
	}

	.notfound .section-ornament {
		margin-top: var(--space-phi);
	}
</style>
