---
import SectionOrnament from "../components/SectionOrnament.astro";
import Base from "../layouts/Base.astro";
---

{/* Cloudflare Pages serves this file with a real HTTP 404, so it is not indexable in
    practice — but it is reachable at /404/ as an ordinary page, where it would emit a
    self-referencing canonical and an index directive for a page that says "här finns
    ingenting". `noindex, follow` costs nothing and removes the ambiguity. */}
<Base
	title="Sidan finns inte — islam.se"
	description="Sidan du söker finns inte."
	noindex={true}
>
	<main id="main" class="content-column notfound">
		<p class="label notfound-code">404</p>
		<h1 class="notfound-title">Här finns ingenting</h1>
		<p class="notfound-lead">
			Sidan du sökte finns inte här. Den kan ha flyttat eller bytt adress. Vägen tillbaka är kort.
		</p>
		<nav class="notfound-links" aria-label="Vidare">
			<a href="/">Startsidan</a>
			<span class="nav-dot" aria-hidden="true">&middot;</span>
			<a href="/essaer/">Alla essäer</a>
		</nav>
		<SectionOrnament />
	</main>
</Base>

<style>
	.notfound {
		min-height: 56vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		text-align: center;
		padding-block: var(--space-phi2);
	}

	.notfound-code {
		color: var(--color-warm);
		margin: 0 0 var(--space-half);
	}

	.notfound-title {
		margin: 0;
	}

	.notfound-lead {
		font-family: var(--font-body);
		font-size: var(--step--1);
		line-height: 1.55;
		color: var(--text-body);
		max-width: 30rem;
		margin: var(--space-unit) auto 0;
	}

	.notfound-links {
		display: flex;
		align-items: baseline;
		justify-content: center;
		gap: 0.6rem;
		margin-top: var(--space-unit);
		font-family: var(--font-heading);
		font-size: var(--step--1);
		font-weight: 500;
	}

	.notfound-links a {
		color: var(--color-accent);
		text-decoration: none;

		&:hover {
			text-decoration: underline;
			text-underline-offset: 0.15em;
		}
	}

	.notfound .section-ornament {
		margin-top: var(--space-phi);
	}
</style>
