---
import DefinitionList from "../../components/DefinitionList.astro";
import MosqueList from "../../components/moskeer/MosqueList.astro";
import MosquePageHeader from "../../components/moskeer/MosquePageHeader.astro";
import NearbyLinkList from "../../components/NearbyLinkList.astro";
import SectionLink from "../../components/SectionLink.astro";
import TitledSection from "../../components/TitledSection.astro";
import Base from "../../layouts/Base.astro";
import { formatDate } from "../../lib/articles";
import { SCB_POP_YEAR } from "../../lib/bonetider/meta";
import { nearbyPlaces, officialPopulation, placeBySlug } from "../../lib/bonetider/places-index";
import { nf0 } from "../../lib/format";
import { ORG_ID, breadcrumbList, cityPlace, faqPageJsonLd } from "../../lib/jsonld";
import {
	type MosqueCityGroup,
	cityBySlug,
	lanSlug,
	mosqueItemList,
	mosqueUrl,
	mosquesByCity,
	oldestMosque,
	pluralMoske,
	siblingCityGroups,
} from "../../lib/moskeer";
import { MOSKEER_DATA_DATE } from "../../lib/moskeer/meta";

export function getStaticPaths() {
	return mosquesByCity().map((g) => ({ params: { stad: g.citySlug }, props: g }));
}

type Props = MosqueCityGroup;
const { citySlug, city, kommun, lan, lanLabel, mosques } = Astro.props;
const n = mosques.length;

// Place context (geo + official population) from the shared bönetider dataset. citySlug
// is generated FROM the bönetider place index (scripts/build-moskeer.ts), so a miss here
// means the two datasets have drifted — fail the build rather than render a city page
// with the wrong coordinates.
const place = placeBySlug(citySlug);
if (!place) {
	throw new Error(
		`moskeer/${citySlug}: no bönetider place found for this city slug — the moskeer and bönetider datasets have drifted. Re-run scripts/build-moskeer.ts.`,
	);
}
const lat = place.lat;
const lon = place.lon;
const county = place.county || lan;
const hasScb = place.scbPopulation != null;
const pop = officialPopulation(place);

const popText = nf0.format(pop);

// Nearby towns that ALSO have a moské page — webs the city pages together for crawl
// depth and gives the reader a sensible next step.
const nearbyCities = nearbyPlaces(place, 8)
	.map((p) => cityBySlug(p.slug))
	.filter((g): g is MosqueCityGroup => g !== undefined)
	.slice(0, 6);
const nearbyCityLinks = nearbyCities.map((g) => ({ href: `/moskeer/${g.citySlug}/`, label: g.city }));

const updated = formatDate(MOSKEER_DATA_DATE);

const oldest = oldestMosque(mosques);

const whereKommun = kommun && kommun !== city ? `, ${kommun} kommun` : "";
const popClause = hasScb ? ` ${city} har ${popText} invånare.` : "";

// A kommun seat (Stockholm, Göteborg) hands off to its stadsdelar; a stadsdel points
// back up. Without the hand-off the page answering "moskéer i stockholm" would list 4
// of the kommun's 20 mosques.
const siblings = kommun ? siblingCityGroups(kommun, citySlug) : [];
const isSeat = kommun === city;
const seatGroup = !isSeat && kommun ? siblings.find((g) => g.city === kommun) : undefined;
const siblingTotal = siblings.reduce((sum, g) => sum + g.mosques.length, 0);
const listedMosques = isSeat ? [...mosques, ...siblings.flatMap((g) => g.mosques)] : mosques;

const leadTail =
	isSeat && siblingTotal > 0
		? ` Ytterligare ${pluralMoske(siblingTotal)} finns i stadsdelarna, längre ned på sidan.`
		: "";
const lead = `I ${city}${whereKommun} finns ${pluralMoske(n, true)}. Här hittar du adress, öppningsår, huvudman och vägbeskrivning till ${n === 1 ? "moskén" : "varje moské"}.${popClause}${leadTail}`;

// The bönetider side suppresses this parenthetical when the name repeats the county —
// "Örebro (Örebro län)" in a snippet. ⚠️ Test the SHORT county form: `lanLabel` is
// "Stockholms län", which never starts with "Stockholm " and let the shape through.
const descPlace = lan === city ? city : `${city} (${lanLabel})`;
const description = `Moskéer i ${descPlace}: adress, öppningsår, huvudman och vägbeskrivning till ${n === 1 ? "moskén" : "varje moské"}. Se även bönetider för ${city}.`;

const faq = [
	{
		q: `Hur många moskéer finns i ${city}?`,
		a: `Enligt vår sammanställning finns ${pluralMoske(n, true)} i ${city}. Uppgifterna kan vara ofullständiga.`,
	},
	{
		q: `Var ligger ${mosques[0].name}?`,
		a: mosques[0].address
			? `${mosques[0].name} ligger på ${mosques[0].address}${mosques[0].postalCode ? `, ${mosques[0].postalCode}` : ""}, i ${kommun} kommun (${lanLabel}). På sidan finns vägbeskrivning via Apple Maps och Google Maps.`
			: `${mosques[0].name} ligger i ${kommun} kommun (${lanLabel}). På sidan finns vägbeskrivning via Apple Maps och Google Maps.`,
	},
];
if (oldest?.opened) {
	faq.push({
		q: n === 1 ? `När öppnade moskén i ${city}?` : `När öppnade den äldsta moskén i ${city}?`,
		a:
			n === 1
				? `${oldest.name} öppnade ${oldest.opened}.`
				: `Den äldsta registrerade moskén i ${city} med känt öppningsår är ${oldest.name}, öppnad ${oldest.opened}.`,
	});
}
---

<Base
	title={`${n === 1 ? "Moské" : "Moskéer"} i ${city} — adress och vägbeskrivning — islam.se`}
	description={description}
	jsonLd={[
		{
			"@context": "https://schema.org",
			"@type": "WebPage",
			name: `Moskéer i ${city}`,
			description,
			url: `https://islam.se/moskeer/${citySlug}/`,
			inLanguage: "sv",
			dateModified: MOSKEER_DATA_DATE,
			about: {
				...cityPlace({
					slug: citySlug,
					name: city,
					county,
					lat,
					lon,
					// ⚠️ The PLACE record's kommun, not the mosque's — /bonetider/[stad] passes
					// the same field, and sourcing them differently gave 14 towns two City nodes
					// that disagreed about the kommun ring.
					kommun: place?.kommun,
					population: hasScb ? pop : undefined,
					populationYear: SCB_POP_YEAR,
				}),
				// City→Mosque containment by @id — the same nodes the ItemList below defines
				// in full, and the same @ids the /bonetider/[stad] page references. Both pages
				// then merge onto one entity graph rather than describing rival City nodes.
				containsPlace: mosques.map((m) => ({ "@id": mosqueUrl(m) })),
			},
			// Reciprocal related-resource edge back to the town's prayer-times page.
			relatedLink: `https://islam.se/bonetider/${citySlug}/`,
			publisher: { "@id": ORG_ID },
		},
		// Every mosque the page actually lists, so the structured data matches the DOM:
		// on a kommun seat that includes the stadsdel groups below.
		mosqueItemList(listedMosques, `Moskéer i ${city}`),
		faqPageJsonLd(faq),
		breadcrumbList([
			{ name: "Hem", url: "/" },
			{ name: "Moskéer", url: "/moskeer" },
			{ name: city, url: `/moskeer/${citySlug}` },
		]),
	]}
>
	<main id="main" class="home moskeer-stad">
		<MosquePageHeader
			title={`${n === 1 ? "Moské" : "Moskéer"} i ${city}`}
			meta={`${lanLabel} · ${pluralMoske(n)}`}
			lead={lead}
			updatedDate={MOSKEER_DATA_DATE}
			updatedLabel={updated}
		/>

		<MosqueList mosques={mosques} />

		{isSeat && siblings.length > 0 && (
			<TitledSection class="mk-section" id="mk-stad-delar" title={`Moskéer i ${city}s stadsdelar`}>
				<p class="mk-stad-note">
					{pluralMoske(siblingTotal)} till i {kommun} kommun, ordnade efter stadsdel.
				</p>
				{siblings.map((g) => (
					<section class="mk-city-group" aria-label={`Moskéer i ${g.city}`}>
						<h3 class="mk-city-head">
							<a href={`/moskeer/${g.citySlug}/`}>{g.city}</a>
							<span class="mk-city-count">{g.mosques.length}</span>
						</h3>
						<MosqueList mosques={g.mosques} cityLink={true} />
					</section>
				))}
			</TitledSection>
		)}

		<section class="mk-section mk-cross" aria-label="Se även">
			<p>
				<SectionLink href={`/bonetider/${citySlug}/`}>Bönetider i {city}</SectionLink>
			</p>
			{seatGroup && (
				<p>
					<SectionLink href={`/moskeer/${seatGroup.citySlug}/`}>
						Alla moskéer i {kommun} kommun
					</SectionLink>
				</p>
			)}
			<p>
				<SectionLink href={`/moskeer/lan/${lanSlug(lan)}/`}>Alla moskéer i {lanLabel}</SectionLink>
			</p>
		</section>

		<TitledSection class="mk-section" id="mk-stad-faq" title="Vanliga frågor">
			<DefinitionList items={faq} />
		</TitledSection>

		{nearbyCities.length > 0 && (
			<TitledSection class="mk-section" id="mk-stad-nearby" title="Moskéer i närliggande orter">
				<NearbyLinkList class="mk-nearby" items={nearbyCityLinks} />
			</TitledSection>
		)}

		<p class="mk-attrib">
			Underlaget kan vara ofullständigt. Adresser och positioner är ungefärliga.
			<a class="arrow-link" href="/moskeer/">Karta över alla moskéer i Sverige</a>
		</p>
	</main>
</Base>

<style>
	.moskeer-stad {
		margin-block: var(--space-phi);
		overflow-x: clip;
	}

	.mk-cross {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.5rem;
	}

	.mk-cross p {
		margin: 0;
	}

	.mk-stad-note {
		font-size: var(--step--1);
		color: var(--color-muted);
		margin: 0;
		max-width: 44rem;
	}

	.mk-city-group {
		margin-top: var(--space-unit);
	}

	.mk-city-head {
		font-size: var(--step-0);
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		margin: 0;
	}

	.mk-city-head a {
		color: var(--color-accent);
		text-decoration: none;
	}

	.mk-city-head a:hover {
		text-decoration: underline;
		text-underline-offset: 0.12em;
	}

	.mk-city-count {
		font-family: var(--font-body);
		font-size: var(--step--3);
		font-weight: 400;
		color: var(--color-muted);
		font-variant-numeric: lining-nums tabular-nums;
	}

</style>
