---
import DefinitionList from "../../../components/DefinitionList.astro";
import MosqueList from "../../../components/moskeer/MosqueList.astro";
import MosquePageHeader from "../../../components/moskeer/MosquePageHeader.astro";
import TitledSection from "../../../components/TitledSection.astro";
import Base from "../../../layouts/Base.astro";
import { formatDate } from "../../../lib/articles";
import { ORG_ID, breadcrumbList, faqPageJsonLd } from "../../../lib/jsonld";
import {
	type Mosque,
	lanSlug,
	mosqueItemList,
	mosquesByCity,
	mosquesByLan,
	oldestMosque,
	pluralMoske,
	pluralOrt,
} from "../../../lib/moskeer";
import { MOSKEER_DATA_DATE } from "../../../lib/moskeer/meta";

export function getStaticPaths() {
	return mosquesByLan().map((g) => ({
		params: { lan: lanSlug(g.lan) },
		props: { lan: g.lan, lanLabel: g.lanLabel, mosques: g.mosques },
	}));
}

interface Props {
	lan: string;
	lanLabel: string;
	mosques: Mosque[];
}
const { lan, lanLabel, mosques } = Astro.props;
const total = mosques.length;

// The county's mosques by city, cities alphabetical, so the list reads ort-by-ort
// and each city heading funnels to its own /moskeer/[stad] page.
const cityGroups = mosquesByCity().filter((g) => g.lan === lan);
const cityCount = cityGroups.length;

const oldest = oldestMosque(mosques);

const updated = formatDate(MOSKEER_DATA_DATE);

const cityNames = cityGroups.map((g) => g.city);
const cityList =
	cityNames.length <= 1
		? cityNames.join("")
		: `${cityNames.slice(0, -1).join(", ")} och ${cityNames[cityNames.length - 1]}`;

const lead = `I ${lanLabel} finns ${pluralMoske(total, true)} i ${pluralOrt(cityCount)}. Nedan hittar du adress, öppningsår och vägbeskrivning till varje moské, ordnade efter ort.`;

const description = `Moskéer i ${lanLabel}: ${pluralMoske(total)} i ${pluralOrt(cityCount)} med adress, öppningsår och vägbeskrivning. Hitta närmaste moské på kartan över hela Sverige.`;

const faq = [
	{
		q: `Hur många moskéer finns i ${lanLabel}?`,
		a: `Enligt vår sammanställning finns ${pluralMoske(total, true)} i ${lanLabel}, fördelade på ${pluralOrt(cityCount)}. Uppgifterna kan vara ofullständiga.`,
	},
	{
		q: `Vilka orter i ${lanLabel} har en moské?`,
		a: `Orter med minst en registrerad moské i ${lanLabel}: ${cityList}.`,
	},
];
if (oldest?.opened) {
	faq.push({
		q: `Vilken är den äldsta moskén i ${lanLabel}?`,
		a: `Den äldsta registrerade moskén i ${lanLabel} med känt öppningsår är ${oldest.name} i ${oldest.city}, öppnad ${oldest.opened}.`,
	});
}
---

<Base
	title={`Moskéer i ${lanLabel} — ${pluralMoske(total)} med adress — islam.se`}
	description={description}
	jsonLd={[
		{
			"@context": "https://schema.org",
			"@type": "CollectionPage",
			name: `Moskéer i ${lanLabel}`,
			description,
			url: `https://islam.se/moskeer/lan/${lanSlug(Astro.props.lan)}/`,
			inLanguage: "sv",
			dateModified: MOSKEER_DATA_DATE,
			about: { "@type": "AdministrativeArea", name: lanLabel, containedInPlace: { "@type": "Country", name: "Sverige" } },
			publisher: { "@id": ORG_ID },
		},
		mosqueItemList(mosques, `Moskéer i ${lanLabel}`),
		faqPageJsonLd(faq),
		breadcrumbList([
			{ name: "Hem", url: "/" },
			{ name: "Moskéer", url: "/moskeer" },
			{ name: lanLabel, url: `/moskeer/lan/${lanSlug(Astro.props.lan)}` },
		]),
	]}
>
	<main id="main" class="home moskeer-lan">
		<MosquePageHeader
			title={`Moskéer i ${lanLabel}`}
			meta={`${pluralMoske(total)} · ${pluralOrt(cityCount)}`}
			lead={lead}
			updatedDate={MOSKEER_DATA_DATE}
			updatedLabel={updated}
		/>

		{cityGroups.map((g) => (
			<section class="mk-city-group" aria-label={`Moskéer i ${g.city}`}>
				<h2 class="mk-city-head">
					<a href={`/moskeer/${g.citySlug}/`}>{g.city}</a>
					<span class="mk-city-count">{g.mosques.length}</span>
				</h2>
				<MosqueList mosques={g.mosques} cityLink={true} />
			</section>
		))}

		<TitledSection class="mk-section" id="mk-lan-faq" title="Vanliga frågor">
			<DefinitionList items={faq} />
		</TitledSection>

		<p class="mk-attrib">
			Underlaget kan vara ofullständigt. Adresser och positioner är ungefärliga.
			<a class="arrow-link" href="/moskeer/">Karta över alla moskéer i Sverige</a>
		</p>
	</main>
</Base>

<style>
	.moskeer-lan {
		margin-block: var(--space-phi);
		overflow-x: clip;
	}

	.mk-city-group {
		margin-top: var(--space-phi);
	}

	.mk-city-head {
		font-size: var(--step-1-sans);
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		margin: 0;
	}

	.mk-city-head a {
		color: var(--color-accent);
		text-decoration: none;
	}

	.mk-city-head a:hover {
		text-decoration: underline;
		text-underline-offset: 0.12em;
	}

	.mk-city-count {
		font-family: var(--font-body);
		font-size: var(--step--3);
		font-weight: 400;
		color: var(--color-muted);
		font-variant-numeric: lining-nums tabular-nums;
	}

</style>
