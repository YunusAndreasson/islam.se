---
import { getCollection } from "astro:content";
import FaktaCard from "../components/FaktaCard.astro";
import HairlineLinkList from "../components/HairlineLinkList.astro";
import Honorific from "../components/Honorific.astro";
import PageHead from "../components/PageHead.astro";
import QuranVerse from "../components/QuranVerse.astro";
import TitledSection from "../components/TitledSection.astro";
import { getArticles } from "../lib/articles";
import { FAKTA_ART, FAKTA_CLUSTERS } from "../lib/fakta";
import { ORG_ID, WEBSITE_ID, breadcrumbList, collectionPageJsonLd } from "../lib/jsonld";
import Base from "../layouts/Base.astro";

// The "Fakta" hub — the encyclopedic answer for the head term "islam" / "vad är
// islam" / "fakta om islam". It opens with the head-term introduction, then
// presents islam's cornerstone as two image-led card grids: the Five Pillars (what
// a muslim does) and the six Articles of Faith (what a muslim believes). Each card
// opens an existing answer at its unchanged /svar/<slug>/ URL; the full Q&A list
// lives at /svar/.
const url = "https://islam.se/vad-ar-islam/";
const published = "2026-06-27T00:00:00Z";
const description =
	"Vad är islam? En klar, källbelagd introduktion: ordets betydelse, de fem pelarna (det en muslim gör) och de sex trosartiklarna (det en muslim tror) – islams kärna förklarad, grundad i Koranen och klassisk sunnitisk lärdom.";

// Resolve each cornerstone card's art + the answer entry it links to (for the
// cluster-overview heading link and the collection JSON-LD). Art is two-tier:
// bespoke FAKTA photography when the card has it, the borrowed essay hero when
// it does not — see FAKTA_ART in lib/fakta.ts.
const articleBySlug = new Map((await getArticles()).map((a) => [a.slug, a]));
const svarBySlug = new Map((await getCollection("svar")).map((e) => [e.id, e]));

const clusters = FAKTA_CLUSTERS.map((c) => ({
	slug: c.slug,
	name: c.name,
	intro: c.intro,
	overview: c.overview,
	cards: c.items.map((it) => ({
		href: `/svar/${it.svarSlug}/`,
		label: it.label,
		blurb: it.blurb,
		art: FAKTA_ART.get(it.svarSlug),
		image: articleBySlug.get(it.image),
		entry: svarBySlug.get(it.svarSlug),
	})),
}));

const furtherLinks = [
	{ label: "Alla frågor och svar om islam", href: "/svar/" },
	{ label: "Bönetider för hela Sverige", href: "/bonetider/" },
	{ label: "Det islamiska året och dess högtider", href: "/det-islamiska-aret/" },
	{ label: "Essäer om islamisk tradition och svenskt kulturarv", href: "/essaer/" },
];

// The cornerstone answers, for the collection structured data (preserves a Q&A
// CollectionPage signal on the hub; the full corpus lives at /svar/).
const cornerstone = clusters.flatMap((c) => [
	...(c.overview ? [svarBySlug.get(c.overview)] : []),
	...c.cards.map((cd) => cd.entry),
]);
const cornerstoneEssays = cornerstone
	.filter((e): e is NonNullable<typeof e> => Boolean(e))
	.map((e) => ({ title: e.data.title, slug: `svar/${e.id}` }));

const jsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "Article",
		headline: "Vad är islam?",
		description,
		inLanguage: "sv",
		url,
		mainEntityOfPage: url,
		isPartOf: { "@id": WEBSITE_ID },
		datePublished: published,
		dateModified: published,
		author: { "@id": ORG_ID },
		publisher: { "@id": ORG_ID },
		about: { "@type": "Thing", name: "Islam" },
	},
	collectionPageJsonLd({
		name: "Islams fem pelare och sex trosartiklar",
		description:
			"Islams kärna – de fem pelarna (dyrkan) och de sex trosartiklarna (tron), källbelagt förklarade.",
		url,
		essays: cornerstoneEssays,
	}),
	breadcrumbList([
		{ name: "Hem", url: "/" },
		{ name: "Fakta", url },
	]),
];
---

<Base
	title="Vad är islam? Fakta, de fem pelarna och trosartiklarna — islam.se"
	description={description}
	ogImageAlt="Vad är islam? — islam.se"
	jsonLd={jsonLd}
>
	<main id="main" class="pillar-page home">
		<article>
			<PageHead title="Pelare & tro">
				Islam betyder <strong>underkastelse under Guds vilja</strong>. Religionen förkunnades på
				600-talet genom profeten Muhammed{" "}
				<Honorific />{" "}
				och har i dag omkring två miljarder anhängare. Dess kärna
				är <strong>de fem pelarna</strong>, det en muslim gör, och <strong>de sex trosartiklarna</strong>,
				det en muslim tror. Båda hämtas ur Koranen och den klassiska islamiska lärdomen.
			</PageHead>

			{/* Sura al-Ikhlās — the most concentrated statement of what a muslim
			    believes, and so the shortest possible answer to the question this page
			    asks. Paired with its Swedish exactly as the answer pages pair theirs:
			    the reader meets the meaning first, then can hear it recited with each
			    word lighting as it is read. Audio and word timing come from the same
			    committed data the essays use. */}
			<div class="pillar-verse">
				<blockquote>
					{/* <abbr> matches what the answer pages get: their markdown pipeline wraps
					    an all-caps opener so it sets as small caps (typography.css). Written by
					    hand here because that plugin only runs on markdown. */}
					<p>
						<abbr>SÄG</abbr>: »Han är Gud – En, Gud, den Evige, den av skapelsen Oberoende, av
						vilken alla beror. Han har inte avlat och inte blivit avlad, och ingen finns som kan
						liknas vid Honom.«
					</p>
				</blockquote>
				<QuranVerse ayah="112:1-4" name="al-Ikhlās" />
			</div>

			{clusters.map((c) => (
				<section class="fakta-cluster" id={c.slug} aria-labelledby={`fc-${c.slug}`}>
					<header class="fakta-cluster-head">
						<h2 id={`fc-${c.slug}`}>
							{c.overview ? <a href={`/svar/${c.overview}/`}>{c.name}</a> : c.name}
						</h2>
						<p class="lead">{c.intro}</p>
					</header>
					<div class="fakta-grid">
						{c.cards.map((cd) => (
							<FaktaCard href={cd.href} label={cd.label} blurb={cd.blurb} art={cd.art} image={cd.image} />
						))}
					</div>
				</section>
			))}

			<TitledSection class="pillar-more" id="pillar-mer" title="Läs vidare">
				<HairlineLinkList class="pillar-links" items={furtherLinks} />
				<p class="pillar-fiqh">
					För fördjupade rättsliga (fiqh-)frågor hänvisar vi till{" "}
					<a href="https://al-ibadah.com" rel="noopener">al-ibadah.com</a>.
				</p>
			</TitledSection>
		</article>
	</main>
</Base>

<script>
	// Wire the recitation player. Same component and same script as the essays and
	// the answer pages.
	import { initQuranPlayers } from "../scripts/quran-player";
	document.addEventListener("astro:page-load", () => initQuranPlayers());
</script>

<style>
	.pillar-page {
		margin-block: var(--space-phi);
	}

	/* The verse sits in the reading column, not the 64rem card canvas — it is prose,
	   and prose keeps its measure. */
	.pillar-verse {
		max-width: var(--content-width);
		margin-top: var(--space-phi);
	}

	.pillar-verse blockquote {
		margin-block: 0;
	}

	.fakta-cluster {
		margin-top: var(--space-phi2);
		padding-top: var(--space-phi);
		border-top: 1px solid var(--color-rule);
	}

	.fakta-cluster-head {
		margin-bottom: var(--space-unit);
	}

	.fakta-cluster-head h2 {
		font-size: var(--step-2);
		letter-spacing: 0;
		margin: 0;
	}
	.fakta-cluster-head h2 a {
		color: var(--color-text);
		text-decoration: none;
	}
	.fakta-cluster-head h2 a:hover {
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	.fakta-cluster-head .lead {
		--lead-color: var(--color-muted);
		--lead-margin: 0.4rem 0 0;
	}

	/* auto-fit fills the 64rem canvas with as many ~16rem cards as fit — 3 across on
	   desktop, 2 on a tablet, 1 on a phone — so both the 5-card and 6-card cluster
	   stay even without a breakpoint. */
	.fakta-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
		gap: var(--space-phi) clamp(1.25rem, 3vw, 2.5rem);
	}

	.pillar-more {
		margin-top: var(--space-phi2);
		padding-top: var(--space-phi);
		border-top: 1px solid var(--color-rule);
	}

	.pillar-more h2 {
		font-size: var(--step-1);
		margin: 0 0 var(--space-half);
	}

	.pillar-fiqh {
		font-family: var(--font-body);
		font-size: var(--step--2);
		color: var(--color-muted);
		margin: var(--space-unit) 0 0;
	}
	.pillar-fiqh a {
		color: var(--color-accent);
	}
</style>
