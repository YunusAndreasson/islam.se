---
import { getCollection } from "astro:content";
import FaktaCard from "../components/FaktaCard.astro";
import Honorific from "../components/Honorific.astro";
import Kicker from "../components/Kicker.astro";
import OnwardLinks from "../components/OnwardLinks.astro";
import PageHead from "../components/PageHead.astro";
import QuranVerse from "../components/QuranVerse.astro";
import { getArticles } from "../lib/articles";
import { FAKTA_ART, FAKTA_CLUSTERS } from "../lib/fakta";
import { articleJsonLd, breadcrumbList, collectionPageJsonLd } from "../lib/jsonld";
import { destinations } from "../lib/navigation";
import { RITNINGAR } from "../lib/ritningar";
import Base from "../layouts/Base.astro";

// The "Fakta" hub — the encyclopedic answer for the head term "islam" / "vad är
// islam" / "fakta om islam". It opens with the head-term introduction, then
// presents islam's cornerstone as two image-led card grids: the Five Pillars (what
// a muslim does) and the six Articles of Faith (what a muslim believes). Each card
// opens an existing answer at its unchanged /svar/<slug>/ URL; the full Q&A list
// lives at /svar/.
const url = "https://islam.se/vad-ar-islam/";
const published = "2026-06-27T00:00:00Z";
const description =
	"Vad betyder islam? Läs om tron, islams fem pelare och trons sex pelare, med hänvisningar till Koranen och sunna.";

// Resolve each cornerstone card's art + the answer entry it links to (for the
// cluster-overview heading link and the collection JSON-LD). Art is two-tier:
// bespoke FAKTA photography when the card has it, the borrowed essay hero when
// it does not — see FAKTA_ART in lib/fakta.ts.
const articleBySlug = new Map((await getArticles()).map((a) => [a.slug, a]));
const svarBySlug = new Map((await getCollection("svar")).map((e) => [e.id, e]));

const clusters = FAKTA_CLUSTERS.map((c) => ({
	slug: c.slug,
	name: c.name,
	intro: c.intro,
	overview: c.overview,
	cards: c.items.map((it) => ({
		href: `/svar/${it.svarSlug}/`,
		label: it.label,
		blurb: it.blurb,
		art: FAKTA_ART.get(it.svarSlug),
		image: articleBySlug.get(it.image),
		entry: svarBySlug.get(it.svarSlug),
	})),
}));

// The ways on, each by its one name and the menu's line for it (lib/navigation.ts).
const furtherLinks = destinations(["/svar/", "/essaer/", "/bonetider/", "/det-islamiska-aret/"]);

// The cornerstone answers, for the collection structured data (preserves a Q&A
// CollectionPage signal on the hub; the full corpus lives at /svar/).
const cornerstone = clusters.flatMap((c) => [
	...(c.overview ? [svarBySlug.get(c.overview)] : []),
	...c.cards.map((cd) => cd.entry),
]);
const cornerstoneEssays = cornerstone
	.filter((e): e is NonNullable<typeof e> => Boolean(e))
	.map((e) => ({ title: e.data.title, slug: `svar/${e.id}` }));

const jsonLd = [
	articleJsonLd({
		headline: "Vad är islam?",
		description,
		url,
		publishedAt: published,
		about: { "@type": "Thing", name: "Islam" },
	}),
	collectionPageJsonLd({
		name: "Islams fem pelare och trons sex pelare",
		description:
			"Islams kärna – islams fem pelare (dyrkan) och trons sex pelare (tron), källbelagt förklarade.",
		url,
		essays: cornerstoneEssays,
	}),
	breadcrumbList([
		{ name: "Hem", url: "/" },
		{ name: "Tro och lära", url },
	]),
];
---

<Base
	title="Vad är islam? Fakta om islams fem pelare och trons sex pelare – islam.se"
	description={description}
	ogImageAlt="Vad är islam? – islam.se"
	jsonLd={jsonLd}
	preloadFonts={["body", "sans", "arabic"]}
>
	<main id="main" class="pillar-page home">
		<article>
			{/* The opening is the title, the ingress and the verse, so the verse goes in
			    PageHead's `efter` slot: the section's drawing — the Quran on its stand, the
			    same as its movement's on the front page (Grunden) — is then as tall as all
			    three, beside them, where a third of the page stood empty (user review,
			    2026-09-26). */}
			<PageHead title="Tro och lära" ritning={RITNINGAR.grunden}>
				Islam betyder <strong>underkastelse under Guds vilja</strong>. Religionen förkunnades på
				600-talet genom profeten Muhammed{" "}
				<Honorific />{" "}
				och har i dag omkring två miljarder anhängare. <strong>Islams fem pelare</strong> beskriver
				religionens grundläggande handlingar. <strong>Trons sex pelare</strong>, även kallade
				de sex trosartiklarna, beskriver vad en muslim tror på. Båda har sin grund i Koranen och i profetens sunna.

				{/* Sura al-Ikhlās — the most concentrated statement of what a muslim
				    believes, and so the shortest possible answer to the question this page
				    asks. Paired with its Swedish exactly as the answer pages pair theirs:
				    the reader meets the meaning first, then can hear it recited with each
				    word lighting as it is read. Audio and word timing come from the same
				    committed data the essays use. */}
				<div class="pillar-verse" slot="efter">
					<blockquote>
						{/* <abbr> matches what the answer pages get: their markdown pipeline wraps
						    an all-caps opener so it sets as small caps (typography.css). Written by
						    hand here because that plugin only runs on markdown. */}
						<p>
							<abbr>SÄG</abbr>: »Han är Gud – En, Gud, den Evige, den av skapelsen Oberoende, av
							vilken alla beror. Han har inte avlat och inte blivit avlad, och ingen finns som kan
							liknas vid Honom.«
						</p>
					</blockquote>
					<QuranVerse ayah="112:1-4" name="al-Ikhlās" />
				</div>
			</PageHead>

			{/* Each cluster opens like a section on the front page (layout.css,
			    `.page-section`): its name as the kicker, the very label the front page's
			    Grunden heads the same two lists with, linking to the cluster's overview
			    answer; its sentence as the framing line. The first stands under the
			    opening and takes no rule. */}
			{clusters.map((c, i) => (
				<section
					class:list={["fakta-cluster", "page-section", i === 0 && "page-section--first"]}
					id={c.slug}
					aria-labelledby={`fc-${c.slug}`}
				>
					<Kicker form="head" as="h2" id={`fc-${c.slug}`} href={c.overview ? `/svar/${c.overview}/` : undefined}>
						{c.name}
					</Kicker>
					<p class="home-tab-framing">{c.intro}</p>
					<div class="fakta-grid">
						{c.cards.map((cd) => (
							<FaktaCard
								href={cd.href}
								label={cd.label}
								blurb={cd.blurb}
								{...(cd.art === undefined ? {} : { art: cd.art })}
								{...(cd.image === undefined ? {} : { image: cd.image })}
							/>
						))}
					</div>
				</section>
			))}

			<section class="pillar-more page-section" aria-labelledby="pillar-mer">
				<Kicker form="head" as="h2" id="pillar-mer">Läs vidare</Kicker>
				<OnwardLinks items={furtherLinks} />
			</section>
		</article>
	</main>
</Base>

<script>
	// Wire the recitation player. Same component and same script as the essays and
	// the answer pages.
	import { initQuranPlayers } from "../scripts/quran-player";
	document.addEventListener("astro:page-load", () => initQuranPlayers());
</script>

<style>

	/* The verse sits in the reading column, not the 64rem card canvas — it is prose,
	   and prose keeps its measure. */
	.pillar-verse {
		max-width: var(--content-width);
		margin-top: var(--space-phi);
	}

	.pillar-verse blockquote {
		margin-block: 0;
	}

	/* The clusters and »Läs vidare« are `.page-section`s (layout.css): their rules, gaps
	   and kickers are the shared grammar's, so none are set here. */

	/* auto-fit fills the canvas with as many ~16rem cards as fit — 2 on a tablet, 1 on a
	   phone. On the full 76rem canvas that made four (4 + 1 and 4 + 2); five and six to
	   a row made the pictures "very small and tight", and the last two pillars stretched
	   to fill their row looked drawn out (user reviews, 2026-09-26). So the page's thirds,
	   every card one size: the pillars 3 + 2 and the articles 3 + 3, ranged left like
	   every other card grid on the site. On the page's one gutter and from the front
	   page's card line (60rem): the gap was its own clamp (40px at 1440), which put the
	   second and third columns 6px off the thirds every other section stands on. */
	.fakta-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
		gap: var(--space-group) var(--grid-gutter);
	}

	@media (width >= 60rem) {
		.fakta-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
