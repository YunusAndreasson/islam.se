---
import { getImage } from "astro:assets";
import { render } from "astro:content";
import AudioPlayer from "../components/AudioPlayer.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import ArticleMeta from "../components/ArticleMeta.astro";
import EssayConnections from "../components/EssayConnections.astro";
import EssayImage from "../components/EssayImage.astro";
import Rattelse from "../components/Rattelse.astro";
import Base from "../layouts/Base.astro";
import { amneByName } from "../lib/amnen";
import type { Article } from "../lib/articles";
import { getArticles, inlineMarkdown } from "../lib/articles";
import { getVersesByEssay } from "../lib/citations";
import { imageObject } from "../lib/jsonld";
import { PAGE_HERO_SIZES, PAGE_HERO_WIDTHS } from "../lib/hero";

export async function getStaticPaths() {
	const articles = await getArticles();
	return articles.map((article, index) => ({
		params: { slug: article.slug },
		props: {
			article,
			prev: articles[index - 1] ?? null,
			next: articles[index + 1] ?? null,
		},
	}));
}

interface Props {
	article: Article;
	prev: Article | null;
	next: Article | null;
}

const { article, prev, next } = Astro.props;
const { Content } = await render(article.entry);
const amne = article.category ? amneByName.get(article.category) : undefined;

// Quran verses this essay cites in its footnotes → machine-readable citation[] on
// the Article JSON-LD. Derived from the corpus, ordered surah:ayah.
const citedAyahs = [...((await getVersesByEssay()).get(article.slug) ?? [])].sort((a, b) => {
	const [sa, aa] = a.split(":").map(Number);
	const [sb, ab] = b.split(":").map(Number);
	return sa - sb || aa - ab;
});
const citations = citedAyahs.map((key) => {
	const [surah, ayah] = key.split(":");
	return { name: `Koranen ${key}`, url: `https://quran.com/${surah}/${ayah}` };
});

// Build a schema.org ImageObject for the original hero photo so the CLEAN image —
// not the text-laden OG share card — becomes the Article's representative `image`
// (Google Images + Licensable badge). contentUrl is a canonical 1200px webp rendition.
let heroImageObject: Record<string, unknown> | undefined;
if (article.heroImage) {
	const rendition = await getImage({ src: article.heroImage, width: 1200, format: "webp" });
	heroImageObject = imageObject({
		contentUrl: new URL(rendition.src, Astro.site).href,
		url: new URL(Astro.url.pathname, Astro.site).href,
		name: article.imageAlt ?? article.title,
		caption: article.imageCaption,
		width: 1200,
		height: Math.round((1200 * article.heroImage.height) / article.heroImage.width),
	});
}
---

{/* `description` is the visible deck and runs well past the ~155 characters a
    result actually shows; `seoDescription` is the authored short form for the
    meta tag. Falls back to the deck, so an essay without one is unchanged. The
    JSON-LD keeps the full deck — it is a description of the work, not a snippet. */}
<Base
	title={`${article.title} — islam.se`}
	description={article.seoDescription ?? article.description}
	ogImage={`/og/${article.slug}.png`}
	articleMeta={{ publishedAt: article.publishedAt, updatedAt: article.updatedAt, wordCount: article.wordCount, description: article.description, slug: article.slug, section: article.category, citations, image: heroImageObject }}
	preloadArabicFont
>
	<main id="main" class="reading">
		<article>
			{/* The standfirst. `description` is an authored ~270-character deck and it
			    rendered on every card on the site EXCEPT the page the reader actually
			    lands on, where the headline handed straight off to a date. Every
			    publication this site is measured against runs one: it is the contract
			    between the headline and the first paragraph. */}
			<ArticleHeader
				title={article.title}
				kicker={amne?.name}
				kickerHref={amne ? `/amnen/${amne.slug}` : undefined}
				kickerClass="article-kicker"
				leadHtml={inlineMarkdown(article.description)}
				leadClass="article-standfirst"
			>
				<ArticleMeta class="label article-meta" publishedAt={article.publishedAt} updatedAt={article.updatedAt} readingTime={article.readingTime} />
			</ArticleHeader>

			{article.heroImage && (
				<figure class="article-hero">
					{/* The frame wraps the image only. With the figcaption inside it,
					    the caption sat on .media-frame's warm image-decode placeholder
					    and underneath the frame's vignette and film-grain layers — a
					    brown band clipped by the frame's rounded corners. */}
					<div class="article-hero-frame media-frame">
						<EssayImage
							article={article}
							widths={PAGE_HERO_WIDTHS}
							sizes={PAGE_HERO_SIZES}
							loading="eager"
							fetchpriority="high"
						/>
					</div>
					{article.imageCaption && <figcaption class="hero-caption">{article.imageCaption}</figcaption>}
				</figure>
			)}

			{article.audioFile && <AudioPlayer src={`/audio/${article.audioFile}`} title={article.title} artwork={article.heroImage?.src} />}

			<div class="article-body prose">
				<Content />
			</div>
		</article>

		<EssayConnections slug={article.slug} />

		<nav class="article-nav" aria-label="Nyare och äldre essä">
			{prev && (
				<a href={`/${prev.slug}`} rel="prev">
					<span class="label nav-label back-link">Nyare</span>
					{prev.title}
				</a>
			)}
			{next && (
				<a href={`/${next.slug}`} rel="next">
					<span class="label nav-label arrow-link">Äldre</span>
					{next.title}
				</a>
			)}
		</nav>

		<Rattelse />
	</main>

	<button class="resume-pill label" type="button" hidden>Fortsätt där du slutade</button>
</Base>

<style>
	/* A contained hero at the head of each essay — column-width, seated in the
	   shared media frame (grain + vignette + soft corners from .media-frame). The
	   crop is pinned via :global(img) because the <img> carries EssayImage's own
	   style scope, so a plain scoped rule would never reach it. */
	.article-hero {
		margin: var(--space-unit) 0 var(--space-phi);
	}

	/* Cover fit is shared on .media-frame (layout.css); only the crop is per-page.
	   No hover bloom here — the hero is a <figure>, not a link. */
	.article-hero :global(img) {
		aspect-ratio: 3 / 2;
	}

	/* The caption is set to the reading measure and left-aligned with the prose
	   below it, rather than running the full width of the 64rem image. */
	.hero-caption {
		max-width: var(--content-width);
		margin-inline: auto;
	}

	/* A quiet editorial caption under the hero — a descriptive line only (never a
	   credit; photographer attribution lives in the ImageObject structured data).
	   Reads as a plate caption, not a stock label: small, muted, lightly italic,
	   left-aligned to the prose column. */
	.hero-caption {
		margin-top: 0.7rem;
		font-size: var(--step--3);
		line-height: 1.45;
		font-style: italic;
		color: var(--color-muted);
		text-wrap: pretty;
	}

	@media (width <= 768px) {
		.article-hero {
			margin-bottom: var(--space-unit);
		}
	}

	/* "Continue where you left off" — appears only when this essay was left
	   part-read (saved scroll progress). A quiet pill at the bottom-centre that
	   scrolls to the saved spot, then gets out of the way. Sits clear of the
	   bottom-right fixed actions (share / back-to-top). */
	.resume-pill {
		position: fixed;
		left: 50%;
		bottom: calc(var(--safe-bottom, 0px) + 1.25rem);
		transform: translateX(-50%) translateY(0.5rem);
		z-index: 50;
		padding: 0.6rem 1.1rem;
		border: 1px solid var(--color-divider);
		border-radius: 1.5rem;
		background: var(--color-bg);
		color: var(--color-accent);
		cursor: pointer;
		box-shadow: 0 2px 14px color-mix(in srgb, var(--color-text), transparent 86%);
		opacity: 0;
		transition: opacity 0.25s ease, transform 0.25s ease;
	}

	.resume-pill[data-visible] {
		opacity: 1;
		transform: translateX(-50%) translateY(0);
	}

	/* Same lift as .fixed-actions: the player owns the bottom edge and shares this z-index. */
	html[data-player-visible] .resume-pill {
		bottom: calc(var(--safe-bottom, 0px) + 1.25rem + 3.5rem);
	}

	.resume-pill:hover {
		border-color: var(--color-warm);
		color: var(--color-text);
	}

	@media (prefers-reduced-motion: reduce) {
		.resume-pill {
			/* Deliberate survivor: opacity-only fade, no motion. !important beats
			   the global kill-switch in typography.css. */
			transition: opacity 0.25s ease;
			transition-duration: 0.25s !important;
			transform: translateX(-50%);
		}
		.resume-pill[data-visible] {
			transform: translateX(-50%);
		}
	}
</style>

<script>
	import { navigate } from "astro:transitions/client";
	import { initFootnotePopovers } from "../scripts/footnote-popover";

	document.addEventListener("astro:page-load", () => {
		if (!document.querySelector(".article-body")) return;
		const ctrl = new AbortController();

		// Resume reading — offer to jump back to the saved scroll position when this
		// essay was left part-read. The pill scrolls there, then bows out; it also
		// retires itself once the reader passes the saved spot on their own.
		const resumeSlug = document.querySelector<HTMLElement>(".reading-progress")?.dataset.slug;
		const pill = document.querySelector<HTMLButtonElement>(".resume-pill");
		if (resumeSlug && pill) {
			const savedPct = +(localStorage.getItem(`rp:${resumeSlug}`) || 0);
			if (savedPct > 0.06 && savedPct < 0.85) {
				const reveal = () => { pill.hidden = false; requestAnimationFrame(() => pill.setAttribute("data-visible", "")); };
				const retire = () => {
					pill.removeAttribute("data-visible");
					setTimeout(() => { pill.hidden = true; }, 280);
				};
				// Hold off a beat so it reads as an offer, not a flash on load.
				setTimeout(reveal, 600);
				pill.addEventListener("click", () => {
					const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
					const target = (document.documentElement.scrollHeight - window.innerHeight) * savedPct;
					window.scrollTo({ top: target, behavior: reduced ? "instant" : "smooth" });
					retire();
				}, { signal: ctrl.signal });
				window.addEventListener("scroll", () => {
					const scrollable = document.documentElement.scrollHeight - window.innerHeight;
					if (scrollable > 0 && window.scrollY / scrollable >= savedPct - 0.02) retire();
				}, { passive: true, signal: ctrl.signal });
			}
		}

		// Move footnotes below article-nav for easier access to prev/next
		const footnotes = document.querySelector(".article-body .footnotes");
		const nav = document.querySelector(".article-nav");
		if (footnotes && nav) {
			footnotes.classList.remove("footnotes");
			footnotes.classList.add("footnotes-relocated");
			nav.after(footnotes);
		}
		// Swipe between articles — guarded so it can't collide with the OS edge
		// back-gesture, multi-touch, slow drags or text-selection drags.
		const prevLink = document.querySelector<HTMLAnchorElement>(".article-nav a[rel=prev]");
		const nextLink = document.querySelector<HTMLAnchorElement>(".article-nav a[rel=next]");
		if (prevLink || nextLink) {
			let startX = 0;
			let startY = 0;
			let startT = 0;
			let eligible = false;
			document.addEventListener("touchstart", (e) => {
				startX = e.touches[0].clientX;
				startY = e.touches[0].clientY;
				startT = performance.now();
				// Edge starts belong to the browser's back/forward gesture.
				eligible = e.touches.length === 1 && startX >= 28 && startX <= window.innerWidth - 28;
			}, { passive: true, signal: ctrl.signal });
			document.addEventListener("touchend", (e) => {
				if (!eligible || e.changedTouches.length !== 1) return;
				if (performance.now() - startT > 700) return;
				if (document.getSelection()?.toString()) return;
				const dx = e.changedTouches[0].clientX - startX;
				const dy = e.changedTouches[0].clientY - startY;
				if (Math.abs(dx) > 80 && Math.abs(dx) > Math.abs(dy) * 2) {
					if (dx > 0 && prevLink) navigate(prevLink.href);
					else if (dx < 0 && nextLink) navigate(nextLink.href);
				}
			}, { passive: true, signal: ctrl.signal });
		}

		// Footnote + honorific popovers. Shared with the /fordjupning/ route, which carries
		// the same footnote apparatus; it owns its own AbortController and teardown.
		initFootnotePopovers();

		document.addEventListener("astro:before-swap", () => { ctrl.abort(); }, { once: true });
	});
</script>

<script>
	// Wire any Quran recitation players injected into the essay body
	// (rehype-quran-verse). They exist only on essay pages, so init lives here.
	import { initQuranPlayers } from "../scripts/quran-player";
	document.addEventListener("astro:page-load", () => initQuranPlayers());
</script>
