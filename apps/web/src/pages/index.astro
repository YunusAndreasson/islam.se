---
import AmnenHome from "../components/AmnenHome.astro";
import BarometerRail from "../components/ai-barometern/BarometerRail.astro";
import BookPod from "../components/BookPod.astro";
import FaktaBand from "../components/FaktaBand.astro";
import FeatureEssay from "../components/FeatureEssay.astro";
import FordjupningHome from "../components/FordjupningHome.astro";
import PoddAppHome from "../components/PoddAppHome.astro";
import Nyheter from "../components/Nyheter.astro";
import PraktisktHome from "../components/PraktisktHome.astro";
import SkarmPromo from "../components/SkarmPromo.astro";
import TradarHome from "../components/TradarHome.astro";
import { getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import { getArticles } from "../lib/articles";
import { FEATURE_HERO_SIZES, FEATURE_HERO_WIDTHS } from "../lib/hero";
import { HOME_DOORWAYS } from "../lib/navigation";

const articles = await getArticles();


// EDITORIAL RANK. The page used to run the newest essay with art and then eight
// identical rows, so every piece after the lead carried the same weight and 55
// essays read as an undifferentiated list. Three ranks now:
//
//   1. the lead      — the newest essay with art: its words and, under them, its
//                      photograph, across two thirds of the canvas
//   2. the second tier — the next six as a rail of titles beside it (three on a
//                      phone and a tablet)
//   3. the departments — grouped under their ämne and its authored framing line
//
// The lead is drawn from the essays that carry art, because it is art-led; falls
// back to the most recent essay if somehow none carry an image.
const withImage = articles.filter((a) => a.heroImage);
const feature = withImage[0] ?? articles[0];
// The next six, pictures or not: the rail beside the lead.
const recent = articles.filter((a) => a.slug !== feature?.slug).slice(0, 6);

// Everything already spent above, so a department cannot show the lead twice.
const used = new Set([feature?.slug, ...recent.map((a) => a.slug)].filter(Boolean) as string[]);

// The share card: the lead's photograph cut to the card's own 1200×630, as a JPEG.
// The raw hero went out before (1672×941 WebP) under og:image:width/height of
// 1200×630, so a chat client reserved one box and received another.
const ogImage = feature?.heroImage
	? await getImage({ src: feature.heroImage, width: 1200, height: 630, fit: "cover", format: "jpeg" })
	: null;

// LCP preload: the feature hero renders through Astro's responsive <Image>, so a
// preload must carry the same srcset/sizes (not the raw original URL) for the
// browser to preload the exact candidate it will paint. getImage() with identical
// options yields the same optimized URLs the <Image> emits.
const heroPreload = feature?.heroImage
	? await getImage({
			src: feature.heroImage,
			widths: FEATURE_HERO_WIDTHS,
			sizes: FEATURE_HERO_SIZES,
			// Match what EssayImage paints: webp in dev (Astro's dev endpoint mislabels
			// AVIF as image/heif → Firefox rejects it), AVIF in the production build.
			format: import.meta.env.DEV ? "webp" : "avif",
		})
	: null;
---

{/* "Vad är islam?" is reserved for /vad-ar-islam/ — do not put it back in this title. */}
<Base
	title="Islam: fakta om tron, reglerna och livet som muslim – islam.se"
	description="Fakta om islam på svenska: tron, de fem pelarna och livet som muslim i Sverige. Svar om mat, klädsel och bön med hänvisningar till Koranen och sunna."
	{...(ogImage && feature ? { ogImage: ogImage.src, ogImageAlt: feature.imageAlt ?? feature.title } : {})}
	{...(heroPreload ? { preloadImageSrcset: heroPreload.srcSet.attribute } : {})}
	preloadImageSizes={FEATURE_HERO_SIZES}
	{...(heroPreload
		? { preloadImageType: import.meta.env.DEV ? "image/webp" : "image/avif" }
		: {})}
	preloadFonts={["display", "body", "sans"]}
>
	{/* .front is the full-width query container a band bleeds against (layout.css);
	    .home is the canvas, here at the mast's 76rem (tokens.css) rather than the
	    64rem every other collection page uses. */}
	<main id="main" class="front">
	<div class="home">
		<h1 class="sr-only">islam.se – kunskap om islam på svenska</h1>

		{/* THE ORDER (product decisions, 2026-10-10; DESIGN.md, »The Startpage«). Two
		    chapters on paper, each followed by a tinted room, and a close:

		      the opening   the lead and the latest essays, the day's news as one bar
		      chapter 1     the essays two ways: by ämne and by essäserie
		      room          AI-barometern: what was measured
		      chapter 2     what Islam is, then the same territory taken all the way down
		      room          the day and the year as two lines, and the mosques' map
		      the close     the ways to take it all elsewhere

		    Paper is for what is written and the tint for what is measured, so a change of
		    ground says a different KIND of thing has begun, twice, not that the next item
		    has (until this round the grounds alternated by movement: nine stripes, each a
		    layout of its own, "stuffed … looks good in isolation but doesn't read well as
		    a whole"). Inside a chapter every section opens the same way: a rule, its
		    kicker, and the way on (editorial.css, »A rule opens a section«). */}
		{feature && <FeatureEssay article={feature} also={recent} />}

		{/* The day's news, at the foot of the opening: the newest thing on the page in
		    its smallest type, because it is not the site's own. */}
		<Nyheter />

		{/* Match the header's width-based navigation: these doorways appear only when
		    the inline mast links are hidden, including on wide touch devices. */}
		<nav class="home-pillars" aria-label="Sajtens huvudingångar">
			{HOME_DOORWAYS.map((link) => (
				<a class="home-pillar" href={link.href}>
					<span class="home-pillar-title">{link.label}</span>
					<span class="home-pillar-desc">{link.sub}</span>
				</a>
			))}
		</nav>

		{/* CHAPTER 1. The essays two ways, shelved by ämne and in reading order by
		    essäserie, in one design: a tab, a framing line, three picture cards. The
		    third way through them, by tänkare, stands on /essaer/ since 2026-10-10
		    ("let's move TÄNKARE into a suitable place in the ESSÄER subpage", user
		    review): it is a way to browse the archive, and that is where the archive is. */}
		<div class="home-chapter">
			<AmnenHome exclude={used} />
			<TradarHome ids={["folkmordet-i-gaza", "maskinen-och-manniskan", "valet-2026"]} />
		</div>

		{/* The first room. The site's own reporting stands with the site's own writing,
		    and the monthly before the evergreen: it stood last but one, under the prayer
		    times, 5 100px down. */}
		<BarometerRail />

		{/* CHAPTER 2. Facts, then depth: the pillars and the articles of faith, then the
		    same territory taken all the way down. */}
		<div class="home-chapter">
			<FaktaBand />
			<FordjupningHome />
		</div>

		{/* The second room: time and place. The year stands under the day in it, two
		    lines in one hand; it was a movement of its own under the room until this
		    round. */}
		<PraktisktHome />

		{/* One common region for ways to take the publication and its tools elsewhere, on
		    paper under the second room: four promotions in one grammar (Promo.astro) on
		    one grid of two halves (editorial.css). The podcast and the app, then the book
		    and the mosque screen. */}
		<div class="home-promotions">
			<PoddAppHome />
			<BookPod count={articles.length} variant="home" />
			<SkarmPromo />
		</div>
	</div>
	</main>
</Base>

<style>
	/* The doorways — the mast's six destinations, set in the site voice, whitespace-
	   grouped rather than boxed, under one rule.

	   Shown ONLY where the mast's inline links are hidden — at or below 900px, the same
	   condition the header uses to collapse its nav into the "Meny" trigger. On a wide
	   pointer screen those links are already visible in the mast, so this row would just
	   echo the menu directly beneath it; there it is hidden. (The links stay in the DOM
	   either way, so crawlers still see them, each with the line that says what it is.)

	   Three to a row, two on a phone — never auto-fit: six doorways at an 11rem minimum
	   drew five on a tablet and left the sixth alone on a row.

	   ON THE PAGE'S GUTTERS, like everything round them: the page's own between the
	   three, and one group-space between a phone's two, which is what the phone's other
	   two-ups have (the six beliefs, the footer). They had a fluid gap of their own
	   (3vw), and on a phone their second column stood 4px left of the two lists' under
	   it. All of it is here: half of these rules were also written in editorial.css,
	   where three of the declarations had been losing to these for as long as both
	   existed (measured 2026-10-11). */
	.home-pillars {
		display: none;
	}

	@media (width <= 56.25rem) {
		.home-pillars {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: var(--space-half) var(--grid-gutter);
			border-top: 1px solid var(--color-rule);
		}
	}

	@media (width <= 37.5rem) {
		.home-pillars {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: var(--space-group);
		}
	}

	.home-pillar {
		display: flex;
		align-items: center;
		text-decoration: none;
		/* A touch of block padding so the tap target clears WCAG 2.5.8 comfortably. */
		padding-block: 0.2rem;
	}

	/* These six are the whole navigation on a phone (the mast drops .site-links),
	   so they carry the full thumb target rather than the 2.5.8 floor. */
	@media (hover: none), (pointer: coarse) {
		.home-pillar {
			min-height: 2.75rem;
		}
	}

	.home-pillar-title {
		font-family: var(--font-heading);
		font-size: var(--step--1);
		font-weight: 600;
		letter-spacing: 0;
		color: var(--color-accent);
	}

	.home-pillar:hover .home-pillar-title {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: var(--underline-offset);
	}

	/* Never painted: where the doorways show there is room for the names only. */
	.home-pillar-desc {
		display: none;
	}

	.home-pillar:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
		border-radius: 2px;
	}
</style>
