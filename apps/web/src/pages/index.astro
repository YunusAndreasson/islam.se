---
import AmnenHome from "../components/AmnenHome.astro";
import BookPod from "../components/BookPod.astro";
import EssayList from "../components/EssayList.astro";
import FaktaBand from "../components/FaktaBand.astro";
import FeatureEssay from "../components/FeatureEssay.astro";
import Markesdagar from "../components/Markesdagar.astro";
import TankareGroups from "../components/TankareGroups.astro";
import TradarHome from "../components/TradarHome.astro";
import { getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import { getArticles } from "../lib/articles";
import { FEATURE_HERO_SIZES, FEATURE_HERO_WIDTHS } from "../lib/hero";

const articles = await getArticles();

// EDITORIAL RANK. The page used to run the newest essay with art and then eight
// identical rows, so every piece after the lead carried the same weight and 55
// essays read as an undifferentiated list. Three ranks now:
//
//   1. the lead      — bleeds past the canvas; nothing else on the page does
//   2. the second tier — two art-led cards, one type step down
//   3. the departments — grouped under their ämne and its authored framing line
//
// The lead and the tier are drawn from the essays that carry art, because those two
// ranks are art-led; the departments below are deliberately text-first (only 28 of
// 55 essays have a hero, and Skriften has 1 of 6). Falls back to the most recent
// essay if somehow none carry an image.
const withImage = articles.filter((a) => a.heroImage);
const feature = withImage[0] ?? articles[0];
const secondTier = withImage.filter((a) => a.slug !== feature?.slug).slice(0, 2);

// Everything already spent above, so a department cannot show the lead twice.
const used = new Set([feature?.slug, ...secondTier.map((a) => a.slug)].filter(Boolean) as string[]);

const ogImage = feature?.heroImage;

// LCP preload: the feature hero renders through Astro's responsive <Image>, so a
// preload must carry the same srcset/sizes (not the raw original URL) for the
// browser to preload the exact candidate it will paint. getImage() with identical
// options yields the same optimized URLs the <Image> emits.
const heroPreload = feature?.heroImage
	? await getImage({
			src: feature.heroImage,
			widths: FEATURE_HERO_WIDTHS,
			sizes: FEATURE_HERO_SIZES,
			// Match what EssayImage paints: webp in dev (Astro's dev endpoint mislabels
			// AVIF as image/heif → Firefox rejects it), AVIF in the production build.
			format: import.meta.env.DEV ? "webp" : "avif",
		})
	: null;
---

{/* "Vad är islam?" is reserved for /vad-ar-islam/ — do not put it back in this title. */}
<Base
	title="Islam: fakta om tron, reglerna och livet som muslim — islam.se"
	description="Fakta om islam på svenska: tron och de fem pelarna, reglerna för mat, klädsel och bön, och livet som muslim i Sverige. Källbelagda svar ur Koranen och sunna."
	{...(ogImage ? { ogImage: ogImage.src } : {})}
	{...(heroPreload ? { preloadImageSrcset: heroPreload.srcSet.attribute } : {})}
	preloadImageSizes={FEATURE_HERO_SIZES}
	{...(heroPreload
		? { preloadImageType: import.meta.env.DEV ? "image/webp" : "image/avif" }
		: {})}
>
	<main id="main" class="home">
		<h1 class="sr-only">islam.se — kunskap om islam på svenska</h1>

		{/* One line of orientation. The page otherwise opened straight on a
		    photograph and an essay title, so a first-time visitor — most of whom
		    arrive from a search for "vad är islam" or "fakta om islam" — was never
		    told what this site is. Deliberately one sentence in body type: the
		    heavier three-pillar portal that stood here before was removed for
		    being too much, and this is not an attempt to bring it back. */}
		<p class="lead home-intro">
			Islam på svenska, förklarad ur källorna – Koranen, sunna och de tidiga
			generationernas lärda.
		</p>

		{/* The homepage body opens on the latest published — the feature + recent feed —
		    then the reference band, the Islamic calendar and the book/podcast. The other
		    sections are reached from the intro links, the doorways and the mast. */}
		{feature && <FeatureEssay article={feature} />}

		{/* Below the feature, not above it. These render only where the mast's inline
		    links are hidden — i.e. on touch — and there the descriptions are hidden too,
		    so what a phone actually got was four bare labels stacked under a mast that
		    already carries a MENY trigger 40 px above them: a menu rendered as content,
		    duplicating an adjacent affordance, ahead of the photograph. The orientation
		    line above still tells a cold visitor what this is; wayfinding follows the
		    thesis. (Desktop is unchanged — they were never displayed there.) */}
		<nav class="home-pillars" aria-label="Sajtens huvudingångar">
			<a class="home-pillar" href="/vad-ar-islam/">
				<span class="home-pillar-title">Pelare &amp; tro</span>
				<span class="home-pillar-desc">Vad är islam – tron och de fem pelarna</span>
			</a>
			<a class="home-pillar" href="/svar/">
				<span class="home-pillar-title">Frågor &amp; svar</span>
				<span class="home-pillar-desc">Svar på vanliga frågor om islam</span>
			</a>
			<a class="home-pillar" href="/essaer/">
				<span class="home-pillar-title">Essäer</span>
				<span class="home-pillar-desc">Islamisk tradition och svenskt kulturarv</span>
			</a>
			<a class="home-pillar" href="/bonetider/">
				<span class="home-pillar-title">Bönetider</span>
				<span class="home-pillar-desc">Dagens tider för hela Sverige</span>
			</a>
			<a class="home-pillar" href="/moskeer/">
				<span class="home-pillar-title">Moskéer</span>
				<span class="home-pillar-desc">Karta över Sveriges moskéer</span>
			</a>
		</nav>

		{/* Rank 2. Two, never auto-fill: a tier of four is a feed again. */}
		{secondTier.length > 0 && (
			<section class="home-second home-movement" aria-label="Fler essäer">
				<EssayList articles={secondTier} itemVariant="card" class="essay-cards" />
			</section>
		)}

		{/* Rank 3, and the act boundary. The seven ämnen have carried an authored
		    framing line since the taxonomy was built and no reader has ever seen one:
		    the front page named no section at all. Three departments here, the rest
		    behind /amnen/.

		    `art` runs the rows with their hero thumbnails and lets a department
		    prefer its illustrated essays. Rank is still carried by size and by the
		    rules above — the lead bleeds past the canvas, the tier runs two cards,
		    and these are 7rem thumbs on a row — so the page does not flatten into
		    three tiers of the same picture. */}
		<AmnenHome limit={3} exclude={used} art />

		{/* The two curated axes through the corpus. Both are first-class authored data
		    — the trådar carry framing prose, the tänkare are derived from the essay
		    bodies — and both were reachable only from the footer. */}
		<TradarHome limit={4} />

		{/* The site's thesis, shown rather than declared: the classical tradition and
		    the Swedish voices in two facing columns, with counts derived from the
		    corpus at build time. No explanatory paragraph — the composition is the
		    argument. It owns its own movement and head-row when `limit` is set. */}
		<TankareGroups limit={6} />

		{/* The encyclopedic half of the site. Placed AFTER the essays on purpose:
		    the opening screen is a composed spread and stays as it is. This is the only
		    place on the homepage that carries "Vad är islam" in visible text. */}
		<FaktaBand />

		<Markesdagar />

		<BookPod count={articles.length} variant="home" />
	</main>
</Base>

<style>
	/* RANK 2 — the second tier.
	   ⚠️ :global() is not optional here. layout.css records that a page's scope id
	   lands on the list root but NEVER on its <li>s, so `.essay-card` written plain
	   in this block would compile to a selector that matches nothing. */
	.home-second {
		padding-top: var(--space-phi);
		border-top: 1px solid var(--color-rule);
	}

	/* Two, not auto-fill. The global .essay-cards grid fills the 64rem canvas with
	   four 16rem tracks, and a rank of four is a feed — which is the thing this tier
	   exists to stop being. */
	.home-second :global(.essay-cards) {
		grid-template-columns: 1fr 1fr;
		/* .essay-cards carries --space-phi below itself for the pages where it is the
		   whole content. Here the movement's own rhythm follows, and the two stacked
		   into a hole. */
		margin-bottom: 0;
	}

	/* One step above the archive card (--step-0) and well below the lead's 3rem: the
	   tier is expressed by size and by the rule above it, never by a badge or a
	   number. Nothing on this site is a sequence except a tråd. */
	.home-second :global(.essay-card .archive-title) {
		font-size: var(--step-2);
	}

	.home-second :global(.essay-card .essay-card-desc) {
		font-size: var(--step--1);
		-webkit-line-clamp: 3;
	}

	@media (width <= 600px) {
		.home-second :global(.essay-cards) {
			grid-template-columns: 1fr;
		}
	}

	/* The orientation line: what this site is, for a visitor arriving cold from a
	   search. Deliberately says nothing the mast already says — listing the
	   sections here just echoes the menu a few pixels below it.

	   Set flush left, at body size, on the same edge as the kicker, the headline
	   and every module below it. It used to be centred, which made the one
	   sentence on the opening screen the only centred thing on a left-aligned
	   page — a stray line rather than the page's standfirst. Sharing the edge is
	   what makes the opening read as one composed block. */
	.home-intro {
		--lead-size: var(--step-0);
		/* No measure: at body size the sentence still sits on ONE line inside the
		   64rem canvas, and one line is what keeps the opening screen tall enough
		   for the whole spread. It only wraps below ~1000px, where balance splits
		   it evenly instead of leaving a two-word stub. */
		--lead-measure: none;
		/* The top margin is not optional: .site-header::after lays a 1.5rem
		   background-to-transparent fade over the top of <main>, and anything
		   flush against it gets washed out. */
		--lead-margin: var(--space-unit) 0 var(--space-unit);
		text-wrap: balance;
	}

	/* Primary doorways — a calm four-up of the site's highest-intent destinations,
	   set in the site voice (heading link + a muted line), whitespace-grouped rather
	   than boxed. The feature's own φ² top margin carries the gap down to it.

	   Shown ONLY where the mast's inline links are hidden — on touch/coarse pointers
	   and below 900px, the same conditions the header uses to collapse its nav into
	   the "Meny" trigger. On a wide pointer screen those links are already visible in
	   the mast, so this row would just echo the menu directly beneath it; there it is
	   hidden. (The links stay in the DOM either way, so crawlers still see them.) */
	.home-pillars {
		display: none;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
		gap: var(--space-unit) clamp(1.25rem, 3vw, 2.75rem);
		margin: 0;
	}

	@media (hover: none), (pointer: coarse) {
		.home-pillars {
			display: grid;
		}
	}

	@media (width <= 900px) {
		.home-pillars {
			display: grid;
			gap: var(--space-half) clamp(1rem, 3vw, 2rem);
		}

		.home-pillar-desc {
			display: none;
		}
	}

	.home-pillar {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.25rem;
		text-decoration: none;
		/* A touch of block padding so the tap target clears WCAG 2.5.8 comfortably. */
		padding-block: 0.2rem;
	}

	/* These four are the whole navigation on a phone (the mast drops .site-links),
   so they carry the full thumb target rather than the 2.5.8 floor. */
	@media (hover: none), (pointer: coarse) {
		.home-pillar {
			min-height: 2.75rem;
		}
	}

	.home-pillar-title {
		font-family: var(--font-heading);
		font-size: var(--step--1);
		font-weight: 600;
		letter-spacing: 0;
		color: var(--color-accent);
	}

	.home-pillar:hover .home-pillar-title {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.15em;
	}

	.home-pillar-desc {
		font-family: var(--font-body);
		font-size: var(--step--2);
		line-height: 1.4;
		color: var(--color-muted);
		text-wrap: pretty;
	}

	.home-pillar:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
		border-radius: 2px;
	}

	/* Two-up on tablets, single column on the narrowest phones. */
	@media (width <= 768px) {
		.home-pillars {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (width <= 26rem) {
		.home-pillars {
			grid-template-columns: 1fr;
		}
	}

</style>
