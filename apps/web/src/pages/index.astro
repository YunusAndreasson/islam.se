---
import AmnenHome from "../components/AmnenHome.astro";
import BarometerRail from "../components/ai-barometern/BarometerRail.astro";
import BookPod from "../components/BookPod.astro";
import FaktaBand from "../components/FaktaBand.astro";
import FeatureEssay from "../components/FeatureEssay.astro";
import FordjupningHome from "../components/FordjupningHome.astro";
import PoddAppHome from "../components/PoddAppHome.astro";
import Markesdagar from "../components/Markesdagar.astro";
import Nyheter from "../components/Nyheter.astro";
import PraktisktHome from "../components/PraktisktHome.astro";
import TankareGroups from "../components/TankareGroups.astro";
import TradarHome from "../components/TradarHome.astro";
import { getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import { getArticles } from "../lib/articles";
import { FEATURE_HERO_SIZES, FEATURE_HERO_WIDTHS } from "../lib/hero";
import { HOME_DOORWAYS } from "../lib/navigation";

const articles = await getArticles();


// EDITORIAL RANK. The page used to run the newest essay with art and then eight
// identical rows, so every piece after the lead carried the same weight and 55
// essays read as an undifferentiated list. Three ranks now:
//
//   1. the lead      — the newest essay with art: its photograph across the
//                      canvas, its words directly under it
//   2. the second tier — the next three as an index of titles beside the lead
//   3. the departments — grouped under their ämne and its authored framing line
//
// The lead is drawn from the essays that carry art, because it is art-led; falls
// back to the most recent essay if somehow none carry an image.
const withImage = articles.filter((a) => a.heroImage);
const feature = withImage[0] ?? articles[0];
// The next three, pictures or not: an index of titles beside the lead's words.
const recent = articles.filter((a) => a.slug !== feature?.slug).slice(0, 3);

// Everything already spent above, so a department cannot show the lead twice.
const used = new Set([feature?.slug, ...recent.map((a) => a.slug)].filter(Boolean) as string[]);

const ogImage = feature?.heroImage;

// LCP preload: the feature hero renders through Astro's responsive <Image>, so a
// preload must carry the same srcset/sizes (not the raw original URL) for the
// browser to preload the exact candidate it will paint. getImage() with identical
// options yields the same optimized URLs the <Image> emits.
const heroPreload = feature?.heroImage
	? await getImage({
			src: feature.heroImage,
			widths: FEATURE_HERO_WIDTHS,
			sizes: FEATURE_HERO_SIZES,
			// Match what EssayImage paints: webp in dev (Astro's dev endpoint mislabels
			// AVIF as image/heif → Firefox rejects it), AVIF in the production build.
			format: import.meta.env.DEV ? "webp" : "avif",
		})
	: null;
---

{/* "Vad är islam?" is reserved for /vad-ar-islam/ — do not put it back in this title. */}
<Base
	title="Islam: fakta om tron, reglerna och livet som muslim — islam.se"
	description="Fakta om islam på svenska: tron och de fem pelarna, reglerna för mat, klädsel och bön, och livet som muslim i Sverige. Källbelagda svar ur Koranen och sunna."
	{...(ogImage ? { ogImage: ogImage.src } : {})}
	{...(heroPreload ? { preloadImageSrcset: heroPreload.srcSet.attribute } : {})}
	preloadImageSizes={FEATURE_HERO_SIZES}
	{...(heroPreload
		? { preloadImageType: import.meta.env.DEV ? "image/webp" : "image/avif" }
		: {})}
>
	{/* .front is the full-width query container a band bleeds against (layout.css);
	    .home is the canvas, here at the mast's 76rem (tokens.css) rather than the
	    64rem every other collection page uses. */}
	<main id="main" class="front">
	<div class="home">
		<h1 class="sr-only">islam.se — kunskap om islam på svenska</h1>

		{/* The masthead: what this site is, and nothing competing with it.

		    The prayer-day horizon stood here for an evening (PrayerHorizon.astro) and
		    was moved down into Praktiskt, beside the Bönetider row: above the intro it
		    competed with the one sentence that says what the site is, and the mast's
		    own chip already carries the next prayer in the top right corner (user
		    review, 2026-09-25).

		    One line of orientation. Most first-time visitors arrive from a
		    search for "vad är islam" or "fakta om islam" and were otherwise never
		    told what this site is. Deliberately one sentence in body type: the
		    heavier three-pillar portal that stood here before was removed for being
		    too much, and this is not an attempt to bring it back. */}
		<div class="home-masthead">
			<p class="lead home-intro" data-fortsatt>
				Islam på svenska, förklarad ur källorna – Koranen, sunna och de tidiga
				generationernas lärda.
			</p>
		</div>

		{/* The sequence, in this order and for this reason (DESIGN.md, »The Startpage«):

		      det nya        the lead and its index, the podcast and app band, the
		                     live row and the departments — what has happened here
		                     and in the world since the reader last looked
		      vad är islam   the pillars and the articles of faith, then the
		                     fördjupningar — the encyclopedia, which is the larger
		                     half of the site and used to be its tail
		      vägar in       trådar and tänkare: ways THROUGH the corpus, which only
		                     mean something once the corpus has been shown
		      avslut         what the site does besides the reading, then the book

		    Every movement is one --space-section apart (editorial.css); the groups
		    read by their kickers and their content, not by a larger gap. Everything
		    else is reached from the doorways, the mast and the palette. */}
		{/* The lead and, beside its words, an index of the next three essays (rank 2)
		    — one composition, FeatureEssay.astro. */}
		{feature && <FeatureEssay article={feature} also={recent} />}

		{/* Below the feature, not above it. These render only where the mast's inline
		    links are hidden — i.e. on touch and under 900px — and there the mast
		    already carries a MENY trigger 40 px above them, so they follow the
		    thesis rather than stand as a menu ahead of the photograph. (Desktop is
		    unchanged — they were never displayed there.)

		    Built from HOME_DOORWAYS, which navigation.ts derives from the mast's own
		    two link groups. The hand-typed row that stood here still listed five
		    doorways after AI-barometern joined the mast, so a phone was the one
		    place the section could not be found without opening the menu. */}
		<nav class="home-pillars" aria-label="Sajtens huvudingångar">
			{HOME_DOORWAYS.map((link) => (
				<a class="home-pillar" href={link.href}>
					<span class="home-pillar-title">{link.label}</span>
					<span class="home-pillar-desc">{link.sub}</span>
				</a>
			))}
		</nav>

		{/* The podcast and the app, promoted side by side in one short band
		    (PoddAppHome.astro). After the doorways, so a phone keeps them near the top. */}
		<PoddAppHome />


		{/* Rank 3: the live row, then three departments.

		    The seven ämnen have carried an authored framing line since the taxonomy
		    was built; three departments show here and the rest are grouped on
		    /essaer/. `art` gives each department one 3:2 picture and lets it prefer
		    its illustrated essays. Rank is still carried by size — the cover runs the
		    whole canvas, the index is titles only, and these are three columns of a
		    picture and two essays — so the page does not flatten into tiers of the
		    same picture.

		    The live blocks (.home-sidolinje) render after the departments in the
		    source but come first at every width (`order: -1`, nyheter.css »The live
		    row«): the day's news four screens down is news nobody finds. It stood
		    beside Ämnen as a 17rem rail until the departments took their pictures
		    and the two columns could no longer be kept level (2026-09-25). */}
		<div class="home-akt2">
			<div class="home-akt2-huvud">
				<AmnenHome limit={3} exclude={used} art />
			</div>

			{/* The live blocks: the day's news and the islamic year side by side, then
			    this month's AI-barometern finding under both at the full width (the
			    layout is in nyheter.css, »The live row«). The news is quoted material
			    and speaks in the sans; the other two are the site's own. The source
			    order is the reading order at every width, so a phone stacks them the
			    same way. Why a hidden news block must not leave a rule above nothing is
			    in Markesdagar.astro. */}
			<div class="home-sidolinje">
				<Nyheter />
				<Markesdagar />
				<BarometerRail />
			</div>
		</div>

		{/* The encyclopedic half, and the page's second thesis.

		    This band used to stand at position six of eight, below Trådar and
		    Tänkare, on the argument that "the opening screen is a composed spread
		    and stays as it is". The spread does stay as it is; what was wrong was
		    everything between. Measured on the built page, "Vad är islam?" — the
		    head term this site's <title> targets, the doorway to 64 answers and 15
		    fördjupningar, more pages than the essay corpus has — began at 63% of
		    the scroll on a laptop and 68% on a phone. Five modules of essays came
		    first, two of which (Trådar, Tänkare) are not new work at all but ways
		    THROUGH work the reader had already been shown three times.

		    A reader arriving cold from "vad är islam" met a magazine and had to
		    scroll past most of it to reach the encyclopedia. That is not a balance
		    between the site's two halves; it is one half with the other in a
		    footnote. Nothing new may go above this band without measuring that
		    again — which is why AI-barometern joined the rail instead of standing
		    as a movement of its own. */}
		<FaktaBand />

		{/* Fördjupning had NO front-page presence whatsoever — fifteen pillar pages
		    of 2 800–4 500 words each, reachable only from the footer and the palette.
		    It sits under FaktaBand because that is the real relation: the band names
		    the pillars and the articles of faith, and these are the same territory
		    taken all the way down. */}
		<FordjupningHome />

		{/* The two curated axes through the corpus. Both are first-class authored
		    data — the trådar carry framing prose, the tänkare are derived from the
		    essay bodies — and both were reachable only from the footer.

		    Below the reference movements, which is where a way-through belongs: the
		    reader has to have been shown the work before a path through it means
		    anything. The trådar are drawn as routes — the only sequences on the
		    site, shown as sequences, with the reader's own read stops filled in. */}
		<TradarHome limit={3} />

		{/* The site's thesis, shown rather than declared: the classical tradition and
		    the Swedish voices in two facing columns, and between them the lines of
		    the essays in which they meet — derived from the corpus at build time. No
		    explanatory paragraph; the composition is the argument. On the page's own
		    ground: as a full-bleed dark band it read as a second site (2026-09-25). */}
		<TankareGroups limit={6} />

		{/* The close, first half: what the site does besides the reading — bönetider
		    with the reader's own next prayer, the map of mosques and burial grounds,
		    the moskéskärm and the app. At desktop widths the mast names only the first
		    two, so a reader who never opened the menu met the other two in the footer.
		    Sweden is drawn beside them, dotted with its mosques (PraktisktHome.astro
		    says why a static SVG is not the map that was removed). */}
		<PraktisktHome />

		{/* The close, second half: the book, on the last tint, in the grammar of the
		    podcast and app band under the cover (BookPod.astro) — so the page ends on
		    the same kind of object it promoted at the top, and paper and tint
		    alternate all the way to the footer. The podcast left this slot for that
		    band on 2026-09-26. */}
		<BookPod count={articles.length} variant="home" />
	</div>
	</main>
</Base>

<style>
	/* The masthead block: the orientation line.

	   The top margin is not optional: .site-header::after lays a 1.5rem
	   background-to-transparent fade over the top of <main>, and anything flush
	   against it gets washed out.

	   No bottom margin, because it would never be seen — the feature's own top
	   margin collapses through it. */
	.home-masthead {
		margin: var(--space-unit) 0 0;
	}

	/* The orientation line: what this site is, for a visitor arriving cold from a
	   search. Deliberately says nothing the mast already says — listing the
	   sections here just echoes the menu a few pixels below it.

	   Set flush left, at body size, on the same edge as the kicker, the headline
	   and every module below it. It used to be centred, which made the one
	   sentence on the opening screen the only centred thing on a left-aligned
	   page — a stray line rather than the page's standfirst. Sharing the edge is
	   what makes the opening read as one composed block. */
	.home-intro.is-fortsatt :global(a) {
		color: inherit;
		text-decoration-thickness: 1px;
		text-underline-offset: var(--underline-offset);
	}

	.home-intro {
		--lead-size: var(--step-0);
		/* No measure: at body size the sentence still sits on ONE line inside the
		   64rem canvas, and one line is what keeps the opening screen tall enough
		   for the whole spread. It only wraps below ~1000px, where balance splits
		   it evenly instead of leaving a two-word stub. */
		--lead-measure: none;
		--lead-margin: 0;
		text-wrap: balance;
	}

	/* The doorways — the mast's six destinations, set in the site voice (heading
	   link + a muted line), whitespace-grouped rather than boxed.

	   Shown ONLY where the mast's inline links are hidden — on touch/coarse pointers
	   and below 900px, the same conditions the header uses to collapse its nav into
	   the "Meny" trigger. On a wide pointer screen those links are already visible in
	   the mast, so this row would just echo the menu directly beneath it; there it is
	   hidden. (The links stay in the DOM either way, so crawlers still see them.)

	   Three to a row, two on a phone — never auto-fit: six doorways at an 11rem
	   minimum drew five on a tablet and left the sixth alone on a row. */
	.home-pillars {
		display: none;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-unit) clamp(1.25rem, 3vw, 2.75rem);
		margin: 0;
	}

	@media (hover: none), (pointer: coarse) {
		.home-pillars {
			display: grid;
		}
	}

	@media (width <= 900px) {
		.home-pillars {
			display: grid;
			gap: var(--space-half) clamp(1rem, 3vw, 2rem);
		}

		.home-pillar-desc {
			display: none;
		}
	}

	@media (width <= 600px) {
		.home-pillars {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.home-pillar {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.25rem;
		text-decoration: none;
		/* A touch of block padding so the tap target clears WCAG 2.5.8 comfortably. */
		padding-block: 0.2rem;
	}

	/* These six are the whole navigation on a phone (the mast drops .site-links),
	   so they carry the full thumb target rather than the 2.5.8 floor. */
	@media (hover: none), (pointer: coarse) {
		.home-pillar {
			min-height: 2.75rem;
		}
	}

	.home-pillar-title {
		font-family: var(--font-heading);
		font-size: var(--step--1);
		font-weight: 600;
		letter-spacing: 0;
		color: var(--color-accent);
	}

	.home-pillar:hover .home-pillar-title {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: var(--underline-offset);
	}

	.home-pillar-desc {
		font-family: var(--font-body);
		font-size: var(--step--2);
		line-height: 1.4;
		color: var(--color-muted);
		text-wrap: pretty;
	}

	.home-pillar:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
		border-radius: 2px;
	}
</style>

<script>
	// A returning reader who left an essay part-read is offered it back, in the slot the
	// orientation sentence holds for a first visit — they know what this site is; what
	// they want is the essay they were in. localStorage only (reading-progress.ts), no
	// account, nothing fetched: the title was stored when the essay was read.
	//
	// The line keeps its height (min-height via CSSOM, which the CSP allows where a
	// style attribute is not), so swapping one sentence for the other moves nothing
	// on the opening screen.
	import { unfinished } from "../scripts/reading-progress";

	document.addEventListener("astro:page-load", () => {
		const line = document.querySelector<HTMLElement>("[data-fortsatt]");
		const last = unfinished();
		if (!(line && last)) return;
		line.style.minHeight = `${line.offsetHeight}px`;
		const link = document.createElement("a");
		link.href = `/${last.slug}/`;
		link.textContent = `»${last.title}«`;
		line.classList.add("is-fortsatt");
		line.replaceChildren(
			"Fortsätt läsa ",
			link,
			` – ${Math.round(last.pct * 100)}\u00a0% läst.`,
		);
	});
</script>
