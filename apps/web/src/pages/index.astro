---
import AmnenHome from "../components/AmnenHome.astro";
import BarometerRail from "../components/ai-barometern/BarometerRail.astro";
import BookPod from "../components/BookPod.astro";
import FaktaBand from "../components/FaktaBand.astro";
import FeatureEssay from "../components/FeatureEssay.astro";
import FordjupningHome from "../components/FordjupningHome.astro";
import PoddAppHome from "../components/PoddAppHome.astro";
import Markesdagar from "../components/Markesdagar.astro";
import Nyheter from "../components/Nyheter.astro";
import PraktisktHome from "../components/PraktisktHome.astro";
import TankareGroups from "../components/TankareGroups.astro";
import SkarmPromo from "../components/SkarmPromo.astro";
import TradarHome from "../components/TradarHome.astro";
import { getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import { getArticles } from "../lib/articles";
import { FEATURE_HERO_SIZES, FEATURE_HERO_WIDTHS } from "../lib/hero";
import { HOME_DOORWAYS } from "../lib/navigation";

const articles = await getArticles();


// EDITORIAL RANK. The page used to run the newest essay with art and then eight
// identical rows, so every piece after the lead carried the same weight and 55
// essays read as an undifferentiated list. Three ranks now:
//
//   1. the lead      — the newest essay with art: its words and, under them, its
//                      photograph, across two thirds of the canvas
//   2. the second tier — the next six as a rail of titles beside it (three on a
//                      phone and a tablet)
//   3. the departments — grouped under their ämne and its authored framing line
//
// The lead is drawn from the essays that carry art, because it is art-led; falls
// back to the most recent essay if somehow none carry an image.
const withImage = articles.filter((a) => a.heroImage);
const feature = withImage[0] ?? articles[0];
// The next six, pictures or not: the rail beside the lead.
const recent = articles.filter((a) => a.slug !== feature?.slug).slice(0, 6);

// Everything already spent above, so a department cannot show the lead twice.
const used = new Set([feature?.slug, ...recent.map((a) => a.slug)].filter(Boolean) as string[]);

// The share card: the lead's photograph cut to the card's own 1200×630, as a JPEG.
// The raw hero went out before (1672×941 WebP) under og:image:width/height of
// 1200×630, so a chat client reserved one box and received another.
const ogImage = feature?.heroImage
	? await getImage({ src: feature.heroImage, width: 1200, height: 630, fit: "cover", format: "jpeg" })
	: null;

// LCP preload: the feature hero renders through Astro's responsive <Image>, so a
// preload must carry the same srcset/sizes (not the raw original URL) for the
// browser to preload the exact candidate it will paint. getImage() with identical
// options yields the same optimized URLs the <Image> emits.
const heroPreload = feature?.heroImage
	? await getImage({
			src: feature.heroImage,
			widths: FEATURE_HERO_WIDTHS,
			sizes: FEATURE_HERO_SIZES,
			// Match what EssayImage paints: webp in dev (Astro's dev endpoint mislabels
			// AVIF as image/heif → Firefox rejects it), AVIF in the production build.
			format: import.meta.env.DEV ? "webp" : "avif",
		})
	: null;
---

{/* "Vad är islam?" is reserved for /vad-ar-islam/ — do not put it back in this title. */}
<Base
	title="Islam: fakta om tron, reglerna och livet som muslim – islam.se"
	description="Fakta om islam på svenska: tron och de fem pelarna, reglerna för mat, klädsel och bön, och livet som muslim i Sverige. Källbelagda svar ur Koranen och sunna."
	{...(ogImage && feature ? { ogImage: ogImage.src, ogImageAlt: feature.imageAlt ?? feature.title } : {})}
	{...(heroPreload ? { preloadImageSrcset: heroPreload.srcSet.attribute } : {})}
	preloadImageSizes={FEATURE_HERO_SIZES}
	{...(heroPreload
		? { preloadImageType: import.meta.env.DEV ? "image/webp" : "image/avif" }
		: {})}
	preloadFonts={["display", "body", "sans"]}
>
	{/* .front is the full-width query container a band bleeds against (layout.css);
	    .home is the canvas, here at the mast's 76rem (tokens.css) rather than the
	    64rem every other collection page uses. */}
	<main id="main" class="front">
	<div class="home">
		<h1 class="sr-only">islam.se – kunskap om islam på svenska</h1>

		{/* THE ORDER (product decisions, 2026-10-10). Four acts, each in the order a
		    reader needs it:

		      read      the lead and the latest essays; the news of the day as one bar
		                under them; the essays by ämne, by tema, by the thinkers they
		                bring to one table
		      learn     what Islam is, then the same territory taken all the way down
		      practise  today's prayer times and the mosques, then the year ahead
		      measure   AI-barometern, last of the mast's own second group

		    and the ways to take it all elsewhere to close. Things that belong together
		    stand together (the year under the day, the news under the newest essay), and
		    what goes stale soonest stands highest. */}
		{feature && <FeatureEssay article={feature} also={recent} />}

		{/* The day's news, at the foot of the opening: the newest thing on the page in
		    its smallest type, because it is not the site's own. */}
		<Nyheter />

		{/* Match the header's width-based navigation: these doorways appear only when
		    the inline mast links are hidden, including on wide touch devices. */}
		<nav class="home-pillars" aria-label="Sajtens huvudingångar">
			{HOME_DOORWAYS.map((link) => (
				<a class="home-pillar" href={link.href}>
					<span class="home-pillar-title">{link.label}</span>
					<span class="home-pillar-desc">{link.sub}</span>
				</a>
			))}
		</nav>

		<AmnenHome exclude={used} />

		<TradarHome ids={["folkmordet-i-gaza", "maskinen-och-manniskan", "valet-2026"]} />

		{/* The site's thesis, shown rather than declared: the classical tradition and
		    the Swedish voices in two facing columns, and between them the lines of
		    the essays in which they meet — derived from the corpus at build time. No
		    explanatory paragraph; the composition is the argument. On the page's own
		    ground: as a full-bleed dark band it read as a second site (2026-09-25). */}
		<TankareGroups limit={6} />

		{/* Facts, then depth: adjacent, but two movements on two grounds. The facts
		    carry the tint; Fördjupning stands on paper under them. They shared one
		    tinted region until 2026-09-27, which read as one 2 550px block (user
		    review, »intryckt«). The grounds alternate by movement all the way down —
		    paper, tint, paper … — so every change of ground is a boundary and no
		    tint ever holds two sections (editorial.css). */}
		<FaktaBand />
		<FordjupningHome />

		{/* The day, then the year: today's prayer times and their annual rhythm, the
		    mosque directory and the mosque screen, and under them the next three
		    observances. The app belongs to the illustrated promotion below. */}
		<PraktisktHome />
		<Markesdagar />

		{/* AI-barometern, its own movement since 2026-09-27: a monthly measurement with
		    its own destination in the mast, after Bönetider and Moskéer there and here. */}
		<BarometerRail />

		{/* One common region for ways to take the publication and its tools elsewhere.
		    The wrapper owns the outer space; its two rows retain their headings. On paper,
		    the last step of the alternation (editorial.css). The second row is the book and
		    the mosque screen on the same two halves as the podcast and the app above them. */}
		<div class="home-promotions">
			<PoddAppHome />
			<div class="home-promotions-par">
				<BookPod count={articles.length} variant="home" />
				<SkarmPromo />
			</div>
		</div>
	</div>
	</main>
</Base>

<style>
	/* The doorways — the mast's six destinations, set in the site voice (heading
	   link + a muted line), whitespace-grouped rather than boxed.

	   Shown ONLY where the mast's inline links are hidden —
	   at or below 900px, the same condition the header uses to collapse its nav into
	   the "Meny" trigger. On a wide pointer screen those links are already visible in
	   the mast, so this row would just echo the menu directly beneath it; there it is
	   hidden. (The links stay in the DOM either way, so crawlers still see them.)

	   Three to a row, two on a phone — never auto-fit: six doorways at an 11rem
	   minimum drew five on a tablet and left the sixth alone on a row. */
	.home-pillars {
		display: none;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-unit) clamp(1.25rem, 3vw, 2.75rem);
		margin: 0;
	}

	@media (width <= 56.25rem) {
		.home-pillars {
			display: grid;
			gap: var(--space-half) clamp(1rem, 3vw, 2rem);
		}

		.home-pillar-desc {
			display: none;
		}
	}

	@media (width <= 37.5rem) {
		.home-pillars {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.home-pillar {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.25rem;
		text-decoration: none;
		/* A touch of block padding so the tap target clears WCAG 2.5.8 comfortably. */
		padding-block: 0.2rem;
	}

	/* These six are the whole navigation on a phone (the mast drops .site-links),
	   so they carry the full thumb target rather than the 2.5.8 floor. */
	@media (hover: none), (pointer: coarse) {
		.home-pillar {
			min-height: 2.75rem;
		}
	}

	.home-pillar-title {
		font-family: var(--font-heading);
		font-size: var(--step--1);
		font-weight: 600;
		letter-spacing: 0;
		color: var(--color-accent);
	}

	.home-pillar:hover .home-pillar-title {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: var(--underline-offset);
	}

	.home-pillar-desc {
		font-family: var(--font-body);
		font-size: var(--step--2);
		line-height: 1.4;
		color: var(--color-muted);
		text-wrap: pretty;
	}

	.home-pillar:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
		border-radius: 2px;
	}
</style>
