---
import AmnenHome from "../components/AmnenHome.astro";
import BarometerRail from "../components/ai-barometern/BarometerRail.astro";
import BookPod from "../components/BookPod.astro";
import EssayList from "../components/EssayList.astro";
import FaktaBand from "../components/FaktaBand.astro";
import FeatureEssay from "../components/FeatureEssay.astro";
import FordjupningHome from "../components/FordjupningHome.astro";
import Markesdagar from "../components/Markesdagar.astro";
import Nyheter from "../components/Nyheter.astro";
import PraktisktHome from "../components/PraktisktHome.astro";
import TankareGroups from "../components/TankareGroups.astro";
import TradarHome from "../components/TradarHome.astro";
import { getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import { getArticles } from "../lib/articles";
import { dagstampel } from "../lib/dagstampel";
import { FEATURE_HERO_SIZES, FEATURE_HERO_WIDTHS } from "../lib/hero";
import { HOME_DOORWAYS } from "../lib/navigation";

const articles = await getArticles();

// Build-time value; the client corrects it on load. See lib/dagstampel.ts for
// why a statically-shipped date cannot be left to stand on its own.
const dagensDatum = dagstampel(new Date());

// EDITORIAL RANK. The page used to run the newest essay with art and then eight
// identical rows, so every piece after the lead carried the same weight and 55
// essays read as an undifferentiated list. Three ranks now:
//
//   1. the lead      — bleeds past the canvas; nothing else on the page does
//   2. the second tier — two art-led cards, one type step down
//   3. the departments — grouped under their ämne and its authored framing line
//
// The lead and the tier are drawn from the essays that carry art, because those two
// ranks are art-led; the departments below are deliberately text-first (only 28 of
// 55 essays have a hero, and Skriften has 1 of 6). Falls back to the most recent
// essay if somehow none carry an image.
const withImage = articles.filter((a) => a.heroImage);
const feature = withImage[0] ?? articles[0];
const secondTier = withImage.filter((a) => a.slug !== feature?.slug).slice(0, 2);

// Everything already spent above, so a department cannot show the lead twice.
const used = new Set([feature?.slug, ...secondTier.map((a) => a.slug)].filter(Boolean) as string[]);

const ogImage = feature?.heroImage;

// LCP preload: the feature hero renders through Astro's responsive <Image>, so a
// preload must carry the same srcset/sizes (not the raw original URL) for the
// browser to preload the exact candidate it will paint. getImage() with identical
// options yields the same optimized URLs the <Image> emits.
const heroPreload = feature?.heroImage
	? await getImage({
			src: feature.heroImage,
			widths: FEATURE_HERO_WIDTHS,
			sizes: FEATURE_HERO_SIZES,
			// Match what EssayImage paints: webp in dev (Astro's dev endpoint mislabels
			// AVIF as image/heif → Firefox rejects it), AVIF in the production build.
			format: import.meta.env.DEV ? "webp" : "avif",
		})
	: null;
---

{/* "Vad är islam?" is reserved for /vad-ar-islam/ — do not put it back in this title. */}
<Base
	title="Islam: fakta om tron, reglerna och livet som muslim — islam.se"
	description="Fakta om islam på svenska: tron och de fem pelarna, reglerna för mat, klädsel och bön, och livet som muslim i Sverige. Källbelagda svar ur Koranen och sunna."
	{...(ogImage ? { ogImage: ogImage.src } : {})}
	{...(heroPreload ? { preloadImageSrcset: heroPreload.srcSet.attribute } : {})}
	preloadImageSizes={FEATURE_HERO_SIZES}
	{...(heroPreload
		? { preloadImageType: import.meta.env.DEV ? "image/webp" : "image/avif" }
		: {})}
>
	<main id="main" class="home">
		<h1 class="sr-only">islam.se — kunskap om islam på svenska</h1>

		{/* The masthead: what day it is, then what this site is.

		    One line of orientation. The page otherwise opened straight on a
		    photograph and an essay title, so a first-time visitor — most of whom
		    arrive from a search for "vad är islam" or "fakta om islam" — was never
		    told what this site is. Deliberately one sentence in body type: the
		    heavier three-pillar portal that stood here before was removed for
		    being too much, and this is not an attempt to bring it back.

		    The date STACKS above it rather than sharing its line, which is not the
		    obvious composition and was arrived at by measuring. The sentence runs
		    to roughly 950px and the canvas is 1024 — there is no room beside it for
		    anything, so a two-ended row would have wrapped the one line the opening
		    screen depends on. Nor can the date sit on the feature's own eyebrow row:
		    beside "SAMHÄLLE" it reads as that essay's date, and the essay's real
		    date (14 augusti, on a piece the reader meets on the 22nd) is six hundred
		    pixels further down. Page-level facts belong above the feature. */}
		<div class="home-masthead">
			<p class="label home-dagstampel" data-dagstampel>{dagensDatum}</p>
			<p class="lead home-intro">
				Islam på svenska, förklarad ur källorna – Koranen, sunna och de tidiga
				generationernas lärda.
			</p>
		</div>

		{/* The sequence, in this order and for this reason (DESIGN.md, »The Startpage«):

		      det nya        the lead, the second tier, the departments and the rail
		                     beside them — what has happened here and in the world
		                     since the reader last looked
		      vad är islam   the pillars and the articles of faith, then the
		                     fördjupningar — the encyclopedia, which is the larger
		                     half of the site and used to be its tail
		      vägar in       trådar and tänkare: ways THROUGH the corpus, which only
		                     mean something once the corpus has been shown
		      avslut         what the site does besides the reading, then the book
		                     and the podcast

		    Every movement is one --space-section apart (editorial.css); the groups
		    read by their kickers and their content, not by a larger gap. Everything
		    else is reached from the doorways, the mast and the palette. */}
		{feature && <FeatureEssay article={feature} />}

		{/* Below the feature, not above it. These render only where the mast's inline
		    links are hidden — i.e. on touch and under 900px — and there the mast
		    already carries a MENY trigger 40 px above them, so they follow the
		    thesis rather than stand as a menu ahead of the photograph. (Desktop is
		    unchanged — they were never displayed there.)

		    Built from HOME_DOORWAYS, which navigation.ts derives from the mast's own
		    two link groups. The hand-typed row that stood here still listed five
		    doorways after AI-barometern joined the mast, so a phone was the one
		    place the section could not be found without opening the menu. */}
		<nav class="home-pillars" aria-label="Sajtens huvudingångar">
			{HOME_DOORWAYS.map((link) => (
				<a class="home-pillar" href={link.href}>
					<span class="home-pillar-title">{link.label}</span>
					<span class="home-pillar-desc">{link.sub}</span>
				</a>
			))}
		</nav>

		{/* Rank 2. Two, never auto-fill: a tier of four is a feed again. */}
		{secondTier.length > 0 && (
			<section class="home-second home-movement" aria-label="Fler essäer">
				<EssayList
					articles={secondTier}
					itemVariant="card"
					class="essay-cards"
					cardSizes="(max-width: 600px) 100vw, (min-width: 67rem) 30rem, 50vw"
				/>
			</section>
		)}

		{/* Rank 3: three departments, and the rail beside them.

		    The seven ämnen have carried an authored framing line since the taxonomy
		    was built; three departments show here and the rest are grouped on
		    /essaer/. `art` runs the rows with their hero thumbnails and lets a
		    department prefer its illustrated essays. Rank is still carried by size —
		    the lead bleeds past the canvas, the tier runs two cards, and these are
		    thumbs on a row — so the page does not flatten into three tiers of the
		    same picture.

		    The rail runs beside Ämnen and nothing else, which is a measurement rather
		    than a preference. Beside the whole act it left 1 990px of empty column
		    and cost the rank-2 essays a third of their width. Ämnen is the tallest
		    movement on the page, so the two tracks end near each other; Trådar and
		    Tänkare stay full width, since Tänkare is a two-facing-column composition
		    that 655px would break.

		    Under 60rem the grid collapses and the rail takes `order: -1`, landing
		    directly under the second tier: a 17rem column of headlines is a rail on
		    a laptop and a cramped mess on a phone. */}
		<div class="home-akt2">
			<div class="home-akt2-huvud">
				<AmnenHome limit={3} exclude={used} art />
			</div>

			{/* The rail, by cadence: the last day's news, this month's AI-barometern
			    finding, the islamic year. The news is quoted material and speaks in the
			    sans; the other two are the site's own and each sits under its own kicker
			    and rule. The seams, and why a hidden news block must not leave a rule
			    above nothing, are in Markesdagar.astro and BarometerRail.astro. */}
			<div class="home-sidolinje">
				<Nyheter />
				<BarometerRail />
				<Markesdagar />
			</div>
		</div>

		{/* The encyclopedic half, and the page's second thesis.

		    This band used to stand at position six of eight, below Trådar and
		    Tänkare, on the argument that "the opening screen is a composed spread
		    and stays as it is". The spread does stay as it is; what was wrong was
		    everything between. Measured on the built page, "Vad är islam?" — the
		    head term this site's <title> targets, the doorway to 64 answers and 15
		    fördjupningar, more pages than the essay corpus has — began at 63% of
		    the scroll on a laptop and 68% on a phone. Five modules of essays came
		    first, two of which (Trådar, Tänkare) are not new work at all but ways
		    THROUGH work the reader had already been shown three times.

		    A reader arriving cold from "vad är islam" met a magazine and had to
		    scroll past most of it to reach the encyclopedia. That is not a balance
		    between the site's two halves; it is one half with the other in a
		    footnote. Nothing new may go above this band without measuring that
		    again — which is why AI-barometern joined the rail instead of standing
		    as a movement of its own. */}
		<FaktaBand />

		{/* Fördjupning had NO front-page presence whatsoever — fifteen pillar pages
		    of 2 800–4 500 words each, reachable only from the footer and the palette.
		    It sits under FaktaBand because that is the real relation: the band names
		    the pillars and the articles of faith, and these are the same territory
		    taken all the way down. */}
		<FordjupningHome />

		{/* The two curated axes through the corpus. Both are first-class authored
		    data — the trådar carry framing prose, the tänkare are derived from the
		    essay bodies — and both were reachable only from the footer.

		    Below the reference movements, which is where a way-through belongs: the
		    reader has to have been shown the work before a path through it means
		    anything. */}
		<TradarHome limit={3} />

		{/* The site's thesis, shown rather than declared: the classical tradition and
		    the Swedish voices in two facing columns, with counts derived from the
		    corpus at build time. No explanatory paragraph — the composition is the
		    argument. It owns its own movement and head-row when `limit` is set. */}
		<TankareGroups limit={6} />

		{/* The close, first half: what the site does besides the reading — bönetider
		    with the reader's own next prayer, the map of mosques and burial grounds,
		    the moskéskärm and the app. At desktop widths the mast names only the first
		    two, so a reader who never opened the menu met the other two in the footer.
		    Text only; see PraktisktHome.astro for why there is no map here. */}
		<PraktisktHome />

		{/* The close, second half: the book and the podcast. The podcast left the mast
		    on 2026-09-13 to make room for AI-barometern; this is its place on the front
		    page. `Det islamiska året` used to stand here too; it moved into the rail,
		    where the page's live layer belongs, and both of its authored standing-fast
		    lines already appear verbatim on /det-islamiska-aret/. */}
		<BookPod count={articles.length} variant="home" />
	</main>
</Base>

<style>
	/* RANK 2 — the second tier.
	   ⚠️ :global() is not optional here. layout.css records that a page's scope id
	   lands on the list root but NEVER on its <li>s, so `.essay-card` written plain
	   in this block would compile to a selector that matches nothing. */
	.home-second {
		padding-top: var(--space-phi);
		border-top: 1px solid var(--color-rule);
	}

	/* Two, not auto-fill. The global .essay-cards grid fills the 64rem canvas with
	   four 16rem tracks, and a rank of four is a feed — which is the thing this tier
	   exists to stop being. */
	.home-second :global(.essay-cards) {
		grid-template-columns: 1fr 1fr;
		/* .essay-cards carries --space-phi below itself for the pages where it is the
		   whole content. Here the movement's own rhythm follows, and the two stacked
		   into a hole. */
		margin-bottom: 0;
	}

	/* One step above the archive card (--step-0) and well below the lead's 3rem: the
	   tier is expressed by size and by the rule above it, never by a badge or a
	   number. Nothing on this site is a sequence except a tråd. */
	.home-second :global(.essay-card .archive-title) {
		font-size: var(--step-2);
	}

	/* Four lines, up from three. At --step--1 in a half-canvas card three lines cut
	   the median deck (~270 characters) about four fifths of the way through, which
	   is the worst place to stop: long enough that the reader commits to the
	   sentence, short enough that it never arrives. The fourth line costs ~25px of
	   a card that has nothing under it but the rule of the next movement. */
	.home-second :global(.essay-card .essay-card-desc) {
		font-size: var(--step--1);
		-webkit-line-clamp: 4;
	}

	/* PICTURE BEFORE HEADLINE — and no rule is needed to get it.
	   This tier carried `order: -1` on the title from 2026-07, lifting the headline
	   above its crop so the two cards mirrored the feature. Removed 2026-08: a card
	   is not the feature. At 3rem with a bleeding spread the headline-first
	   composition is a masthead; at --step-2 in a half-canvas card it just split
	   each card's own text around its picture — title on top, deck and date
	   underneath — so neither block of type read as one. Image-first is the DOM
	   order (EssayArchiveItem.astro) and now the paint order too, here and in the
	   identical `.essay-card` that renders the fördjupning band on /svar/.
	   Do not put the `order` back.

	   The title's `margin-bottom: var(--space-half)` went with it. It existed to
	   hold the headline off the picture below; under the picture it stacked with
	   `.essay-card-desc`'s own 0.4rem top margin (flex items don't collapse
	   margins) and opened 1.35rem between headline and deck. Spacing is the shared
	   card rhythm from layout.css again: 0.85rem under the media, 0.4rem over the
	   deck. */

	@media (width <= 600px) {
		.home-second :global(.essay-cards) {
			grid-template-columns: 1fr;
		}
	}

	/* The masthead block: the day-stamp over the orientation line.

	   The top margin is not optional and lives here now rather than on the lead:
	   .site-header::after lays a 1.5rem background-to-transparent fade over the top
	   of <main>, and anything flush against it gets washed out.

	   No bottom margin, because it would never be seen — the feature's own top
	   margin collapses through it. Which is also why the day-stamp is close to
	   free: the block grows by the stamp's own line and nothing more. */
	.home-masthead {
		margin: var(--space-unit) 0 0;
	}

	/* Sentence case at a readable rung, not the tracked caps `.label` supplies.
	   Two reasons, and the second is the real one: "8 ṢAFAR 1448" sets a
	   transliteration with its diacritics shouting, which this site does not do
	   anywhere else; and a folio line is a quiet statement of fact, not a piece of
	   wayfinding. The register is the one `.nyheter-avsandare` already established
	   for a line that states rather than directs. */
	.home-dagstampel {
		margin: 0 0 0.3rem;
		font-size: var(--step--2);
		text-transform: none;
		letter-spacing: 0;
	}

	/* The orientation line: what this site is, for a visitor arriving cold from a
	   search. Deliberately says nothing the mast already says — listing the
	   sections here just echoes the menu a few pixels below it.

	   Set flush left, at body size, on the same edge as the kicker, the headline
	   and every module below it. It used to be centred, which made the one
	   sentence on the opening screen the only centred thing on a left-aligned
	   page — a stray line rather than the page's standfirst. Sharing the edge is
	   what makes the opening read as one composed block — and the day-stamp above
	   it shares that same edge for the same reason. */
	.home-intro {
		--lead-size: var(--step-0);
		/* No measure: at body size the sentence still sits on ONE line inside the
		   64rem canvas, and one line is what keeps the opening screen tall enough
		   for the whole spread. It only wraps below ~1000px, where balance splits
		   it evenly instead of leaving a two-word stub. */
		--lead-measure: none;
		--lead-margin: 0;
		text-wrap: balance;
	}

	/* The doorways — the mast's six destinations, set in the site voice (heading
	   link + a muted line), whitespace-grouped rather than boxed.

	   Shown ONLY where the mast's inline links are hidden — on touch/coarse pointers
	   and below 900px, the same conditions the header uses to collapse its nav into
	   the "Meny" trigger. On a wide pointer screen those links are already visible in
	   the mast, so this row would just echo the menu directly beneath it; there it is
	   hidden. (The links stay in the DOM either way, so crawlers still see them.)

	   Three to a row, two on a phone — never auto-fit: six doorways at an 11rem
	   minimum drew five on a tablet and left the sixth alone on a row. */
	.home-pillars {
		display: none;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-unit) clamp(1.25rem, 3vw, 2.75rem);
		margin: 0;
	}

	@media (hover: none), (pointer: coarse) {
		.home-pillars {
			display: grid;
		}
	}

	@media (width <= 900px) {
		.home-pillars {
			display: grid;
			gap: var(--space-half) clamp(1rem, 3vw, 2rem);
		}

		.home-pillar-desc {
			display: none;
		}
	}

	@media (width <= 600px) {
		.home-pillars {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.home-pillar {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.25rem;
		text-decoration: none;
		/* A touch of block padding so the tap target clears WCAG 2.5.8 comfortably. */
		padding-block: 0.2rem;
	}

	/* These six are the whole navigation on a phone (the mast drops .site-links),
	   so they carry the full thumb target rather than the 2.5.8 floor. */
	@media (hover: none), (pointer: coarse) {
		.home-pillar {
			min-height: 2.75rem;
		}
	}

	.home-pillar-title {
		font-family: var(--font-heading);
		font-size: var(--step--1);
		font-weight: 600;
		letter-spacing: 0;
		color: var(--color-accent);
	}

	.home-pillar:hover .home-pillar-title {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: var(--underline-offset);
	}

	.home-pillar-desc {
		font-family: var(--font-body);
		font-size: var(--step--2);
		line-height: 1.4;
		color: var(--color-muted);
		text-wrap: pretty;
	}

	.home-pillar:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
		border-radius: 2px;
	}
</style>

<script>
	// The day-stamp is rendered at build time so it is in the served HTML, and
	// corrected here because the site is built statically and shipped by hand: the
	// line would otherwise be a day stale every morning after a deploy. Same shape
	// as the mast's prayer chip and the calendar list — server value first, client
	// truth over the top, nothing flashing in between.
	import { dagstampel } from "../lib/dagstampel";

	document.addEventListener("astro:page-load", () => {
		const el = document.querySelector<HTMLElement>("[data-dagstampel]");
		if (el) el.textContent = dagstampel(new Date());
	});
</script>
