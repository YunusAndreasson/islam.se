---
import { getCollection } from "astro:content";
import EssayCollectionPage from "../../components/EssayCollectionPage.astro";
import type { Article } from "../../lib/articles";
import { breadcrumbList, collectionPageJsonLd } from "../../lib/jsonld";
import { seriesLength } from "../../lib/series";
import { seriesParts, threadArt } from "../../lib/tradar";

export async function getStaticPaths() {
	const threads = await getCollection("tradar");
	return Promise.all(
		threads.map(async (thread) => ({
			params: { slug: thread.id },
			props: {
				title: thread.data.title,
				framing: thread.data.framing,
				imageAlt: thread.data.imageAlt ?? "",
				// The curated thread order, not the feed's date order.
				essays: await seriesParts(thread),
			},
		})),
	);
}

interface Props {
	title: string;
	framing: string;
	imageAlt: string;
	essays: Article[];
}

const { title, framing, imageAlt, essays } = Astro.props;
const slug = Astro.params.slug;
// The series' own picture, the one /tradar/ and the front page show it by.
const art = threadArt(slug ?? "");
---

<EssayCollectionPage
	title={title}
	description={framing}
	essays={essays}
	kicker="Essäserie"
	countText={seriesLength(essays)}
	numbered
	cover={art && { src: art, alt: imageAlt }}
	backHref="/tradar/"
	backLabel="Alla essäserier"
	ogImage={`/tradar/${slug}/og.png`}
	jsonLd={[
		collectionPageJsonLd({
			name: title,
			description: framing,
			url: `/tradar/${slug}`,
			essays,
		}),
		breadcrumbList([
			{ name: "Hem", url: "/" },
			{ name: "Essäserier", url: "/tradar" },
			{ name: title, url: `/tradar/${slug}` },
		]),
	]}
/>
