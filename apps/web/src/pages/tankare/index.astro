---
import CollectionIndexPage from "../../components/CollectionIndexPage.astro";
import TankareGroups from "../../components/TankareGroups.astro";
import { breadcrumbList } from "../../lib/jsonld";
---

<CollectionIndexPage
	title="Tänkare"
	description="De återkommande samtalspartnerna: den klassiska islamiska traditionen och de svenska och västerländska rösterna som essäerna håller samman."
	lead="De röster essäerna återvänder till: den klassiska islamiska traditionen, och de svenska och västerländska tänkare som läses tillsammans med den."
	backHref="/essaer/"
	backLabel="Hela arkivet"
	jsonLd={[
		{
			"@context": "https://schema.org",
			"@type": "CollectionPage",
			name: "Tänkare",
			url: "https://islam.se/tankare/",
			inLanguage: "sv",
		},
		breadcrumbList([
			{ name: "Hem", url: "/" },
			{ name: "Tänkare", url: "/tankare" },
		]),
	]}
>
	<TankareGroups />
</CollectionIndexPage>
