---
import CollectionIndexPage from "../../components/CollectionIndexPage.astro";
import TankareGroups from "../../components/TankareGroups.astro";
import { breadcrumbList } from "../../lib/jsonld";
import { RITNINGAR } from "../../lib/ritningar";
---

<CollectionIndexPage
	title="Tänkare"
	ritning={RITNINGAR.tankare}
	description="Filosofer, författare och lärda som förekommer i essäerna, från den islamiska traditionen och västerländsk litteratur och filosofi."
	lead="Filosofer, författare och lärda som förekommer i essäerna. Här finns både klassiska islamiska lärda och svenska och andra västerländska tänkare."
	backHref="/essaer/"
	backLabel="Alla essäer"
	jsonLd={[
		{
			"@context": "https://schema.org",
			"@type": "CollectionPage",
			name: "Tänkare",
			url: "https://islam.se/tankare/",
			inLanguage: "sv",
		},
		breadcrumbList([
			{ name: "Hem", url: "/" },
			{ name: "Tänkare", url: "/tankare" },
		]),
	]}
>
	<TankareGroups />
</CollectionIndexPage>
