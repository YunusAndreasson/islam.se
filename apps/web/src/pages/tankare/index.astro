---
import PageHead from "../../components/PageHead.astro";
import TankareGroups from "../../components/TankareGroups.astro";
import Base from "../../layouts/Base.astro";
import { breadcrumbList } from "../../lib/jsonld";
---

<Base
	title="Tänkare — islam.se"
	description="De återkommande samtalspartnerna: den klassiska islamiska traditionen och de svenska och västerländska rösterna som essäerna håller samman."
	jsonLd={[
		{
			"@context": "https://schema.org",
			"@type": "CollectionPage",
			name: "Tänkare",
			url: "https://islam.se/tankare/",
			inLanguage: "sv",
		},
		breadcrumbList([
			{ name: "Hem", url: "/" },
			{ name: "Tänkare", url: "/tankare" },
		]),
	]}
>
	<main id="main" class="home">
		<PageHead title="Tänkare">
			De röster essäerna återvänder till: den klassiska islamiska traditionen, och de svenska och
			västerländska tänkare som läses tillsammans med den.
		</PageHead>

		<TankareGroups />

		<p class="collection-back"><a class="section-link arrow-link" href="/essaer/">Hela arkivet</a></p>
	</main>
</Base>
