---
import AppPromo from "../../components/AppPromo.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import DefinitionList from "../../components/DefinitionList.astro";
import NearbyLinkList from "../../components/NearbyLinkList.astro";
import OmBonen from "../../components/bonetider/OmBonen.astro";
import PrayerField from "../../components/bonetider/PrayerField.astro";
import PrayerSettings from "../../components/bonetider/PrayerSettings.astro";
import PrayerTable from "../../components/bonetider/PrayerTable.astro";
import SectionLink from "../../components/SectionLink.astro";
import TitledSection from "../../components/TitledSection.astro";
import Base from "../../layouts/Base.astro";
import { ORG_ID, breadcrumbList, cityPlace, faqPageJsonLd } from "../../lib/jsonld";
import { nf0, nf1 } from "../../lib/format";
import { SCB_POP_YEAR, SCB_REF, SCB_SOURCE } from "../../lib/bonetider/meta";
import { placeFacts } from "../../lib/bonetider/place-facts";
import { type IndexedPlace, INDEXED_PLACES, nearbyPlaces, officialPopulation, OG_POPULATION } from "../../lib/bonetider/places-index";
import { computePrayerTimes, formatTime, stockholmMonthLabel } from "../../lib/bonetider/prayer-times";
import { DEFAULT_SETTINGS } from "../../lib/bonetider/settings";
import { slugify } from "../../lib/bonetider/slug";
import { cityBySlug, directionsLinks, locationLabel, mosqueUrl, nearestMosques } from "../../lib/moskeer";
import { hijriLabel } from "../../lib/markesdagar";
import { nextRamadan, ramadanRange, ramadanTimes } from "../../lib/bonetider/ramadan";

// These 2 128 pages are 84 % of the whole build (75 s of 90 s). They only change when
// the day rolls over, so `pnpm build:fast` sets BONETIDER_SAMPLE to build a handful
// instead — a design/essay iteration does not need every town in Sweden.
//
// ⚠️ OPT-IN, and it must stay that way: an unset variable builds all of them. A sampled
// build is NOT deployable — shipping one strands 2 128 live URLs. `pnpm ship` never
// sets it, and scripts/assert-full-build.mjs blocks the deploy if one slips through.
// ⚠️ Read INSIDE getStaticPaths: Astro hoists this function into its own chunk, so a
// module-level const declared out here is not defined when it runs.
export function getStaticPaths() {
	const sample = Number(process.env.BONETIDER_SAMPLE ?? 0);
	const places = sample > 0 ? INDEXED_PLACES.slice(0, sample) : INDEXED_PLACES;
	return places.map((place) => ({ params: { stad: place.slug }, props: { place } }));
}

interface Props {
	place: IndexedPlace;
}
const { place } = Astro.props;
const location = { name: place.name, latitude: place.lat, longitude: place.lon };

const now = new Date();

const lat1 = place.lat.toFixed(2).replace(".", ",");
const lon1 = place.lon.toFixed(2).replace(".", ",");
const highNorth = place.lat >= 62;
const nearby = nearbyPlaces(place, 8);
const nearbyLinks = nearby.map((p) => ({ href: `/bonetider/${p.slug}/`, label: p.name }));
// Mosques within ~20 km of the place — surfaced so a reader checking prayer times can
// also find the nearest physical mosque (links into the /moskeer map, deep-selected).
const nearbyMosques = nearestMosques(place.lat, place.lon, 3, 20);
// The town's OWN mosques — its /moskeer/[stad] page shares this slug. A city that
// actually contains a mosque is the strongest "there's a mosque here" signal, so we
// surface it in the lead, the meta description, a dedicated FAQ, and as City→Mosque
// containment in the JSON-LD. That binds this prayer-times page to its mosque page as
// one topical cluster (bönetider + moské for the same town), which is what lifts a
// city into Google's favour for the combined intent.
const mosqueCity = cityBySlug(place.slug);
// One derived flag, not a repeated `mosqueCity !== undefined` at each call site: it
// drives the lead paragraph, the meta description, the FAQ entry, the City→Mosque
// JSON-LD and the on-page block, which must agree. A description promising "se även
// moskéer i {stad}" is a promise in 2118 search snippets that the page has to keep.
const hasMosquePage = mosqueCity !== undefined;
const cityMosques = mosqueCity?.mosques ?? [];
const cityMosqueCount = cityMosques.length;
// "en registrerad moské" / "N registrerade moskéer" — reused across lead, FAQ and prose.
const cityMosquePhrase = cityMosqueCount === 1 ? "en registrerad moské" : `${cityMosqueCount} registrerade moskéer`;
// The mosque set shown in the on-page block: the town's own (heading "Moskéer i {stad}",
// the exact target query) when it has them, else the nearest within 20 km. Capped so a
// metro's page stays a teaser that hands off to the full /moskeer/[stad] list.
const featuredMosques = (hasMosquePage ? cityMosques : nearbyMosques).slice(0, 6);
// 54 queries pair "moské" with "bönetider" for one town, and this heading carried only
// the first word while the FAQ below carried neither. The reciprocal section on
// /moskeer/[stad] now shows the same times, so both entry points answer the pair.
const featuredMosquesTitle = hasMosquePage
	? `Moskéer och bönetider i ${place.name}`
	: `${featuredMosques.length === 1 ? "Moské" : "Moskéer"} nära ${place.name}`;

// Official SCB statistics are present only where we matched a tätort. Everything in
// the stat block + the population claims is gated on this, so unmatched places never
// show a figure we can't stand behind.
const hasScb = place.scbPopulation != null;
const pop = officialPopulation(place);
const facts = placeFacts(place.lat, place.lon);

// Visible date for the "Dagens bönetider" block. Static build → this is the build
// date; the inline script below refreshes it to the reader's real today on load, and
// a daily rebuild keeps the crawled value current. Stockholm time = the times' zone.
const todayIso = now.toLocaleDateString("sv-SE", { timeZone: "Europe/Stockholm" });
const todayLabel = new Intl.DateTimeFormat("sv-SE", {
	weekday: "long",
	day: "numeric",
	month: "long",
	year: "numeric",
	timeZone: "Europe/Stockholm",
}).format(now);
// Current year (Stockholm tz) for the title/H1 — searchers add it ("bönetider
// <stad> 2026"), and it lifts perceived freshness on the competitive metro queries.
// Build-time value; the daily rebuild rolls it over each January.
const year = new Intl.DateTimeFormat("sv-SE", { year: "numeric", timeZone: "Europe/Stockholm" }).format(now);
// Same source as PrayerTable's caption, so heading and table can never name different months.
const monthLabel = stockholmMonthLabel(now);

// The same six values PrayerField renders below, computed once here so the meta
// description and the "idag"-FAQ can quote them. DEFAULT_SETTINGS is what the no-JS
// baseline shows, so the snippet promises exactly what a reader without stored
// settings sees. ⚠️ Only honest while scripts/deploy-bonetider-daily.sh runs nightly —
// a snippet quoting last week's Fajr is worse than one quoting none.
const todayTimes = computePrayerTimes(location, now, DEFAULT_SETTINGS);
const t = {
	fajr: formatTime(todayTimes.fajr),
	sunrise: formatTime(todayTimes.sunrise),
	dhuhr: formatTime(todayTimes.dhuhr),
	asr: formatTime(todayTimes.asr),
	maghrib: formatTime(todayTimes.maghrib),
	isha: formatTime(todayTimes.isha),
};
// formatTime renders an unresolvable slot as "—". Only quote the times when all six
// resolved; a description reading "Fajr —" is worse than the evergreen one.
const hasTimes = ![t.fajr, t.sunrise, t.dhuhr, t.asr, t.maghrib, t.isha].includes("—");

// Umm al-Qura, spelled as /det-islamiska-aret spells it. Noon UTC of the Swedish
// calendar day, not `now`: the nightly build runs at 01:30 Stockholm, which is still
// yesterday in UTC, and hijriLabel reads its instant there. The reader's own
// hijriOffset is applied client-side; this is the crawled, offset-free value.
const hijriToday = hijriLabel(new Date(`${todayIso}T12:00:00Z`));

// Ramadan for this town. "ramadan 2027" already takes 7 935 impressions at position 4
// with 0,5 % CTR — the date cannot win a click Google prints in the result itself. What
// it does not print is the iftar clock where the reader lives, and across Sweden that
// differs by about an hour with a fast-length spread of three. Both numbers come from
// the same engine and defaults as the table further down this page.
const ramadan = nextRamadan(now);
const ramadanTider = ramadan ? ramadanTimes(place.lat, place.lon, ramadan) : null;
const ramadanSpan = ramadan ? ramadanRange(ramadan) : "";

// One array feeds both the visible trail and the JSON-LD, so they cannot drift apart.
// ⚠️ Trailing slashes are load-bearing here, unlike in a JSON-LD-only crumb list:
// breadcrumbList() normalises through pageUrl(), the visible href does not, and
// Cloudflare 308s the slash-less form.
const crumbs = [
	{ name: "Hem", url: "/" },
	{ name: "Bönetider", url: "/bonetider/" },
	{ name: place.name, url: `/bonetider/${place.slug}/` },
];
const popText = nf0.format(pop);
const depText = nf1.format(facts.summerMidnightDepressionDeg);
const placeFactRows = [
	{ term: "Invånare", value: popText, note: place.scbName ? `(tätorten ${place.scbName})` : undefined },
	place.kommun ? { term: "Kommun", value: place.kommun } : null,
	place.county ? { term: "Län", value: place.county } : null,
	place.landAreaKm2 != null ? { term: "Landareal", value: `${nf1.format(place.landAreaKm2)} km²` } : null,
	place.densityPerKm2 != null ? { term: "Befolkningstäthet", value: `${nf0.format(place.densityPerKm2)} inv./km²` } : null,
	place.scbRank != null ? { term: "Storleksrang", value: `Sveriges ${ordinal(place.scbRank)} största tätort` } : null,
	{ term: "Koordinater", value: `${lat1}° N, ${lon1}° O` },
].filter((row): row is { term: string; value: string; note?: string } => row !== null);

// Daylight as a sentence fragment for the slot "kring midsommar/midvinter <desc>":
// polar cases swap the duration for the phenomenon, so the FAQ answers below stay
// grammatical and genuinely place-specific (real per-latitude facts, not a name swap).
const midsummerDesc = facts.midnightSun
	? "går solen aldrig ner (midnattssol)"
	: `är dagen som längst, omkring ${facts.summerDayText}`;
const midwinterDesc = facts.polarNight
	? "går solen aldrig upp (polarnatt)"
	: `är dagen som kortast, bara ${facts.winterDayText}`;

// Swedish ordinal: 1:a, 2:a, 3:e … 11:e, 12:e … 21:a (suffix ":a" for forms ending
// in -a – första/andra – else ":e", with the 11/12 exception).
function ordinal(n: number): string {
	const d1 = n % 10;
	const d2 = n % 100;
	const suffix = (d1 === 1 || d1 === 2) && d2 !== 11 && d2 !== 12 ? ":a" : ":e";
	return `${n}${suffix}`;
}

// Where the place sits, without repeating the name (Stockholm tätort = Stockholm
// kommun) and without genitive-form guessing on county names.
const whereParts: string[] = [];
if (place.kommun && place.kommun !== place.name) whereParts.push(`${place.kommun} kommun`);
if (place.county && place.county !== place.name && place.county !== place.kommun) whereParts.push(place.county);
const where = whereParts.length ? ` i ${whereParts.join(", ")}` : "";

// Direct-answer lead (AEO): a concise, true summary up top – no stale clock values.
const popClause = hasScb ? ` Orten har ${popText} invånare (${SCB_SOURCE}).` : "";
// When the town has its own mosque page, name it up front (real "moské i {stad}"
// keyword, above the fold) and point to the addresses further down.
const mosqueLead = hasMosquePage
	? ` I ${place.name} finns också ${cityMosquePhrase} med adress och vägbeskrivning längre ned på sidan.`
	: "";
const lead = `Bönetider för ${place.name}${where}.${popClause} Tiderna för Fajr, Shurūq, Ẓuhr, ʿAṣr, Maghrib och ʿIshāʾ beräknas efter solens läge och uppdateras automatiskt varje dag.${mosqueLead}`;

// Per-place daylight prose – what actually makes each page different by latitude.
const daylightPara =
	facts.midnightSun || facts.polarNight
		? `Så här långt norrut råder midnattssol kring midsommar – solen går inte ner alls – och polarnatt kring midvinter. Då går Fajr och ʿIshāʾ inte att beräkna med den vanliga vinkelmetoden, så regeln närmaste lämpliga plats (Aqrab al-Balad) används i stället.`
		: `I ${place.name} är den ljusaste sommardagen omkring ${facts.summerDayText} och den mörkaste vinterdagen ${facts.winterDayText}. Vid sommarsolståndet sjunker solen som mest ${depText}° under horisonten – mindre än de 18° som krävs för astronomisk natt – vilket är varför Fajr och ʿIshāʾ ligger nära varandra i juni och beräknas med regeln för höga latituder.`;

// Meta description: front-load the prayer keywords, then close with either the mosque
// cross-sell (towns with a moské page) or the method CTA (everywhere else). Both stay
// under the snippet cap and the mosque variant captures the "moské i {stad}" reader.
const descTail = hasMosquePage
	? ` Se även moskéer i ${place.name} med adress och vägbeskrivning.`
	: " Välj beräkningsmetod och madhhab.";
// Stockholm, Uppsala, Örebro, Jönköping and Kalmar share their name with their
// county — the raw interpolation rendered "Stockholm (Stockholm)" in the snippet.
const descPlace =
	place.county && place.county !== place.name ? `${place.name} (${place.county})` : place.name;

// ⚠️ A county-qualified slug means another town owns the bare one, so the two pages
// carried the SAME title ("Bönetider i Alvik 2026" twice, 171 of them). Only these get
// the county — every page that ranks today keeps its title byte-for-byte.
const ambiguous = place.slug !== slugify(place.name);
const titlePlace = ambiguous && place.county ? `${place.name} (${place.county})` : place.name;
// Lead with today's actual times. The query is answered in the snippet, which is the
// only place left where a prayer-time page can win a click: Google answers most of
// these on the results page itself, and the site's CTR at position 3 is 1,9 %. The
// evergreen sentence stays as the fallback for places whose times cannot be resolved.
const timesLine = `Fajr ${t.fajr} · Ẓuhr ${t.dhuhr} · ʿAṣr ${t.asr} · Maghrib ${t.maghrib} · ʿIshāʾ ${t.isha}`;
// A shorter mosque hook than descTail's: the times cost ~60 characters of the ~155
// Google shows, so the tail has to earn its place in what is left.
const shortTail = hasMosquePage ? ` Även moskéerna i ${place.name}.` : "";
const description = hasTimes
	? `Bönetider i ${titlePlace} idag: ${timesLine}. Uppdateras varje dygn.${shortTail}`
	: `Bönetider för ${descPlace} ${year}: exakta tider för Fajr, Shurūq, Ẓuhr, ʿAṣr, Maghrib och ʿIshāʾ varje dag, beräknade efter solens läge.${descTail}`;

const ogImage = place.population >= OG_POPULATION ? `/bonetider/${place.slug}/og.png` : "/bonetider/og.png";
// Samma tröskel styr den utskrivbara månadstabellen — 273 orter, se lib/bonetider/pdf.ts.
// Länken får inte visas där filen inte byggs: en död länk på 1 855 sidor är värre än
// ingen länk alls.
const hasPdf = place.population >= OG_POPULATION;

// Machine-readable provenance for the WebPage (isBasedOn) – the same sources as
// the visible footer attribution, so the data origin is legible to crawlers.
// External works the page is based on, expressed as CreativeWork (not Dataset):
// `isBasedOn` accepts the supertype, and typing these as Dataset made Google
// validate each as a standalone Dataset rich result — flooding Search Console
// with "missing description/creator/license" across every city page.
const sources: Record<string, unknown>[] = [
	{ "@type": "CreativeWork", name: "GeoNames", url: "https://www.geonames.org/", license: "https://creativecommons.org/licenses/by/4.0/" },
	{ "@type": "SoftwareSourceCode", name: "adhan", url: "https://github.com/batoulapps/adhan-js" },
];
if (hasScb) {
	sources.unshift({
		"@type": "CreativeWork",
		name: `${SCB_SOURCE} (${SCB_REF})`,
		creator: { "@type": "GovernmentOrganization", name: "Statistiska centralbyrån" },
	});
}

// The WebPage's `about` City node. When the town has mosques we add City→Mosque
// containment by @id — the very same @ids fully defined on /moskeer/[stad] — so the
// two pages describe one entity graph instead of competing nodes, and Google reads a
// first-class "this city contains these mosques" fact rather than inferring it.
const aboutCity = cityPlace({
	slug: place.slug,
	name: place.name,
	county: place.county,
	lat: place.lat,
	lon: place.lon,
	...(place.kommun === undefined ? {} : { kommun: place.kommun }),
	...(hasScb ? { population: pop } : {}),
	populationYear: SCB_POP_YEAR,
});
if (hasMosquePage) {
	aboutCity.containsPlace = cityMosques.map((m) => ({ "@id": mosqueUrl(m) }));
}

const faq = [
	// The question the traffic actually asks — "bönetider <stad> idag" — answered with
	// the day's six values rather than a pointer to the block above it. Dropped where the
	// times could not be resolved, and rebuilt nightly like everything else here.
	...(hasTimes
		? [
				{
					q: `Vilka bönetider gäller i ${place.name} idag?`,
					a: `I dag, ${todayLabel}, är Fajr ${t.fajr}, Shurūq ${t.sunrise}, Ẓuhr ${t.dhuhr}, ʿAṣr ${t.asr}, Maghrib ${t.maghrib} och ʿIshāʾ ${t.isha} i ${place.name}. Tiderna räknas om varje dygn efter solens verkliga läge på ${lat1}° N, ${lon1}° O, och listan högst upp på sidan ändras direkt om du väljer en annan beräkningsmetod eller madhhab.`,
				},
			]
		: []),
	{
		q: `När börjar Fajr i ${place.name}?`,
		a: `Fajr är dagens första bön och inträder vid gryningen, strax före soluppgången (Shurūq). Dygnets längd i ${place.name} svänger kraftigt över året – kring midsommar ${midsummerDesc}, kring midvinter ${midwinterDesc} – så Fajr-tiden varierar mycket mellan sommar och vinter. Den exakta tiden räknas om automatiskt varje dygn och står högst upp under Dagens bönetider.`,
	},
	{
		q: `När är Maghrib i ${place.name}?`,
		a: `Maghrib är bönen direkt efter solnedgången och tiden då fastan bryts under ramadan. Tiden följer solnedgången och skiftar dag för dag – på ${place.name}s breddgrad (${lat1}° N) infaller den sent på kvällen kring midsommar och tidigt på eftermiddagen mitt i vintern. Aktuell Maghrib-tid för ${place.name} visas i listan över dagens bönetider ovan.`,
	},
	{
		q: `Varför ligger Fajr och ʿIshāʾ nära varandra på sommaren i ${place.name}?`,
		a: facts.midnightSun
			? `Kring midsommar går solen i ${place.name} inte ner alls (midnattssol), och då går Fajr och ʿIshāʾ inte att beräkna med den vanliga vinkelmetoden. I stället används regeln närmaste lämpliga plats (Aqrab al-Balad) så att tider ändå kan visas. ${place.name} ligger på ${lat1}° N.`
			: `Vid sommarsolståndet sjunker solen i ${place.name} som mest ${depText}° under horisonten – mindre än de 18° som krävs för astronomisk natt. Natten blir därför aldrig riktigt mörk, så Fajr och ʿIshāʾ ligger nära varandra i juni och beräknas med regeln för höga latituder${highNorth ? " (närmaste lämpliga plats, Aqrab al-Balad)" : ""}.`,
	},
];
if (hasMosquePage) {
	// A real question-shaped query ("moské i {stad}?"), answered in plain text so it
	// also feeds the FAQPage JSON-LD (the visible <dd> escapes HTML, so no link here —
	// the "Moskéer nära" section below carries the actual links).
	faq.push({
		q: `Finns det någon moské i ${place.name}?`,
		a: `Ja. Enligt vår karta över moskéer i Sverige finns ${cityMosquePhrase} i ${place.name}. Adress, öppningsår och vägbeskrivning visas längre ned på sidan.`,
	});
	// Everything else on this page answers when a prayer ENTERS. A reader heading for a
	// mosque needs to know that is not when the congregation forms — and that we do not
	// know the second number. Saying so is better than letting the silence imply we do.
	faq.push({
		q: `Vilka bönetider gäller i ${cityMosqueCount === 1 ? "moskén" : "moskéerna"} i ${place.name}?`,
		a: `Tiderna här är astronomiska: de säger när varje bön går in i ${place.name}. Den gemensamma bönen (jamāʿa) hålls oftast en stund senare – ${cityMosqueCount === 1 ? "moskén" : "varje moské"} sätter sin egen iqāma-tid så att de som kommer hinner fram, och fredagsbönen har ett fast klockslag. Vi publicerar inte enskilda moskéers jamāʿa-tider; fråga moskén inför besöket.`,
	});
}
if (ramadan && ramadanTider) {
	faq.push({
		q: `När är ramadan ${ramadan.year} i ${place.name}?`,
		a: `Ramadan ${ramadan.hijriYear} e.H. infaller ${ramadanSpan} enligt Umm al-Qura-kalendern. Första fastedagen i ${place.name} börjar suhūr-gränsen (Fajr) ${ramadanTider.first.suhur} och fastan bryts (Maghrib) ${ramadanTider.first.iftar}; sista dagen ${ramadanTider.last.suhur} respektive ${ramadanTider.last.iftar}. Den exakta första dagen bekräftas genom månsiktning och kan skilja sig en dag.`,
	});
	faq.push({
		q: `Vilken tid är iftar i ${place.name} under ramadan ${ramadan.year}?`,
		a: `Iftar är samma sak som Maghrib, tiden då solen gått ner. I ${place.name} infaller den ${ramadanTider.first.iftar} på ramadans första dag och ${ramadanTider.last.iftar} på den sista – tiden flyttas fram några minuter varje dygn allteftersom dagarna blir längre. Dagens Maghrib-tid står högst upp på sidan, och månadens alla tider i tabellen.`,
	});
	faq.push({
		q: `Hur lång är fastan i ${place.name} under ramadan ${ramadan.year}?`,
		a: `Från Fajr till Maghrib blir fastan ${ramadanTider.first.length} första dagen och ${ramadanTider.last.length} den sista. Eftersom ramadan ${ramadan.year} infaller på vinterhalvåret är fastan kortare ju längre norrut man kommer – tvärtemot sommarens ljusa dygn, då förhållandet är det omvända.`,
	});
}
if (hasScb) {
	const subject = place.scbName ? `tätorten ${place.scbName}` : place.name;
	const densityClause = place.densityPerKm2
		? `, med en befolkningstäthet på ${nf0.format(place.densityPerKm2)} invånare per kvadratkilometer`
		: "";
	faq.push({
		q: `Hur många invånare har ${place.name}?`,
		a: `Enligt ${SCB_SOURCE} (${SCB_REF}) har ${subject} ${popText} invånare${densityClause}.`,
	});
}
---

<Base
	title={`Bönetider i ${titlePlace} idag · ${year} — islam.se`}
	description={description}
	ogImage={ogImage}
	ogImageAlt={`Bönetider i ${place.name} — dagens tider för Fajr, Shurūq, Ẓuhr, ʿAṣr, Maghrib och ʿIshāʾ`}
	jsonLd={[
		{
			"@context": "https://schema.org",
			"@type": "WebPage",
			name: `Bönetider i ${place.name}`,
			description,
			url: `https://islam.se/bonetider/${place.slug}/`,
			inLanguage: "sv",
			// Freshness signal for a page whose value IS *today's* times: the build date
			// (Stockholm tz), not a hand-bumped dataset constant. The prior constant froze at
			// the last manual deploy (live pages showed a dateModified weeks stale, and an "I
			// dag" date to match), which undercuts freshness on time-sensitive prayer queries.
			// A daily rebuild keeps this honest — the server-rendered times regenerate each build.
			dateModified: todayIso,
			about: aboutCity,
			// Explicit related-resource edge to the town's mosque page (when one exists),
			// so crawlers see the reciprocal bönetider ↔ moské link in structured data too.
			...(hasMosquePage ? { relatedLink: `https://islam.se/moskeer/${place.slug}/` } : {}),
			isBasedOn: sources,
			publisher: { "@id": ORG_ID },
		},
		faqPageJsonLd(faq),
		breadcrumbList(crumbs),
	]}
>
	<main id="main" class="home bonetider-stad">
		<header class="bt-stad-header">
			<Breadcrumb items={crumbs} />
			{/* `titlePlace`, not `place.name`: 150 pages shared an H1 with the town that owns
			    the bare slug (two "Bönetider i Alvik"), while their titles already differed. */}
			<h1>Bönetider i {titlePlace} idag</h1>
			<p class="bt-stad-sub">
				{place.county ? `${place.county} · ` : ""}{lat1}° N, {lon1}° O
			</p>
			<p class="bt-stad-lead">{lead}</p>
		</header>

		{/* PrayerField already renders today's six times beside the map, so the
		    standalone list that used to sit under this heading printed the identical
		    readout twice, ~200 px apart. The heading, date and note now frame that one
		    readout instead of introducing a second copy. */}
		<TitledSection class="bt-stad-section bt-stad-idag" id="bt-stad-idag" title={`Dagens bönetider i ${place.name}`}>
			<p class="meta-line bt-stad-date">
				I dag · <time datetime={todayIso} class="bt-today-date">{todayLabel}</time> · <span class="bt-today-hijri">{hijriToday}</span>
			</p>
			<PrayerField location={location} variant="full" fixed={true} />
			<p class="bt-stad-note">
				Tiderna beräknas direkt i din webbläsare. Sveriges ljusa sommarnätter gör att Fajr och
				ʿIshāʾ ligger nära varandra – kartan visar varför: solen sjunker bara en bit under
				horisonten.
			</p>
		</TitledSection>

		<AppPromo variant="section" />

		{hasScb && (
			<TitledSection class="bt-stad-section" id="bt-stad-fakta" title={`Fakta om ${place.name}`}>
				<dl class="bt-facts">
					{placeFactRows.map((row) => (
						<div class="bt-fact">
							<dt>{row.term}</dt>
							<dd>
								{row.value}
								{row.note && <span class="bt-fact-note"> {row.note}</span>}
							</dd>
						</div>
					))}
				</dl>
				<p class="bt-facts-src">Källa: {SCB_SOURCE} ({SCB_REF}).</p>
			</TitledSection>
		)}

		<TitledSection class="bt-stad-section bt-prose" id="bt-stad-about" title={`Om bönetiderna i ${place.name}`}>
			<p>
				{place.name} ligger {place.county ? `i ${place.county}, ` : ""}på {lat1}° nordlig bredd.
				Bönetiderna beräknas utifrån solens verkliga läge för just denna position – inte från en
				tabell – så att de stämmer med dygnet på orten.
			</p>
			<p>{daylightPara}</p>
			<p>
				Tiderna gäller tidszonen Europe/Stockholm och växlar automatiskt mellan vinter- och
				sommartid. Vill du finjustera mot din moské kan du byta metod och madhhab nedan, eller läsa
				mer om <a href="/bonetider/metod/">hur tiderna beräknas</a>.
			</p>
		</TitledSection>

		<TitledSection class="bt-stad-section" id="bt-stad-settings" title="Inställningar">
			<PrayerSettings />
		</TitledSection>

		<TitledSection class="bt-stad-section" id="bt-stad-month" title={`Bönetider i ${place.name} – ${monthLabel}`}>
			<PrayerTable location={location} labelledBy="bt-stad-month" />
			{/* En prenumeration är det enda på den här sidan som kräver ett klick och
			    finns kvar efteråt — allt annat kan Google svara på i resultatlistan.
			    webcal:// får kalenderappen att ta över i stället för webbläsaren; .ics
			    står kvar som länk för den som hellre sparar filen. */}
			<p class="bt-stad-note bt-stad-kalender">
				Ta med tiderna:
				<a href={`webcal://islam.se/bonetider/${place.slug}/kalender.ics`}>Lägg till i kalendern</a>
				<span aria-hidden="true"> · </span>
				<a href={`/bonetider/${place.slug}/kalender.ics`} type="text/calendar">Hämta .ics-filen</a>
				{hasPdf && (
					<>
						<span aria-hidden="true"> · </span>
						<a href={`/bonetider/${place.slug}/kalender.pdf`} type="application/pdf">
							Månadens tider som PDF
						</a>
					</>
				)}
				<br />
				Kalendern rymmer månadens fem böner och fylls på varje natt; PDF:en är ett A4-ark
				att skriva ut. Båda följer standardmetoden (Muslim World League) – egna
				inställningar gäller på sidan, inte i filerna.
			</p>
		</TitledSection>

		{ramadan && ramadanTider && (
			<TitledSection
				class="bt-stad-section bt-stad-ramadan"
				id="bt-stad-ramadan"
				title={`Ramadan ${ramadan.year} i ${place.name}`}
			>
				<p class="meta-line">{ramadanSpan} · {ramadan.hijriYear} e.H.</p>
				<table class="bt-ramadan-table">
					<caption class="sr-only">
						Suhūr, iftar och fastans längd i {place.name} under ramadan {ramadan.year}
					</caption>
					<thead>
						<tr>
							<th scope="col">Dag</th>
							<th scope="col">Suhūr slutar</th>
							<th scope="col">Iftar</th>
							<th scope="col">Fastans längd</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<th scope="row">Första dagen</th>
							<td>{ramadanTider.first.suhur}</td>
							<td>{ramadanTider.first.iftar}</td>
							<td>{ramadanTider.first.length}</td>
						</tr>
						<tr>
							<th scope="row">Sista dagen</th>
							<td>{ramadanTider.last.suhur}</td>
							<td>{ramadanTider.last.iftar}</td>
							<td>{ramadanTider.last.length}</td>
						</tr>
					</tbody>
				</table>
				<p class="bt-stad-note">
					Suhūr slutar när Fajr går in och fastan bryts vid Maghrib – samma tider som
					sidans egen tabell, dag för dag. Datumen följer Umm al-Qura; den första dagen
					bekräftas genom månsiktning och kan skilja sig en dag.
					<SectionLink href="/bonetider/ramadan/">Ramadan {ramadan.year} i hela Sverige</SectionLink>
				</p>
			</TitledSection>
		)}

		<TitledSection class="bt-stad-section" id="bt-stad-faq" title="Vanliga frågor">
			<DefinitionList items={faq} />
			<p class="bt-faq-more">
				<SectionLink href="/bonetider/metod/">Mer om hur bönetiderna beräknas</SectionLink>
			</p>
		</TitledSection>

		{featuredMosques.length > 0 && (
			<TitledSection class="bt-stad-section" id="bt-stad-moske" title={featuredMosquesTitle}>
				<p class="bt-stad-note">
					{hasMosquePage
						? `Moskéer i ${place.name} enligt vår `
						: `Närmaste ${featuredMosques.length === 1 ? "registrerade moské" : "registrerade moskéer"} enligt vår `}
					<a href="/moskeer/">karta över moskéer i Sverige</a>. Välj en för plats och vägbeskrivning.
				</p>
				<ul class="bt-mosques">
					{featuredMosques.map((m) => {
						const dir = directionsLinks(m);
						return (
							<li class="bt-mosque">
								<a href={`/moskeer/${m.citySlug}/#${m.id}`} class="bt-mosque-name">{m.name}</a>
								<span class="bt-mosque-loc">{locationLabel(m)}{m.opened ? ` · öppnad ${m.opened}` : ""}</span>
								<span class="bt-mosque-dir">
									<a href={dir.apple}>Apple Maps</a>
									<a href={dir.google}>Google Maps</a>
								</span>
							</li>
						);
					})}
				</ul>
				<p class="bt-faq-more">
					<SectionLink href={hasMosquePage ? `/moskeer/${place.slug}/` : "/moskeer/"}>
						{hasMosquePage ? `Moskéer i ${place.name}` : "Alla moskéer i Sverige"}
					</SectionLink>
				</p>
			</TitledSection>
		)}

		{nearby.length > 0 && (
			<TitledSection class="bt-stad-section" id="bt-stad-nearby" title="Bönetider i närliggande orter">
				<NearbyLinkList class="bt-nearby" items={nearbyLinks} />
			</TitledSection>
		)}

		<OmBonen />

		<p class="bt-attrib">
			Befolkningsstatistik: {SCB_SOURCE} ({SCB_REF}). Ortsdata från GeoNames (CC BY 4.0). Beräkningar
			med <span lang="en">adhan</span> i tidszonen Europe/Stockholm. <a href="/bonetider/metod/">Om beräkningen</a> ·
			<a class="arrow-link" href="/bonetider/">Alla orter</a>
		</p>
	</main>
</Base>

<style>
	.bonetider-stad {
		margin-block: var(--space-phi);
		/* Guard against any child overflowing the viewport on mobile (e.g. the
		   today readout's tabular times); clip keeps sticky/position working. */
		overflow-x: clip;
	}

	.bt-stad-header h1 {
		margin: var(--space-half) 0 0;
	}

	.bt-stad-sub {
		font-family: var(--font-body);
		color: var(--color-muted);
		font-variant-numeric: lining-nums tabular-nums;
		margin: var(--space-half) 0 0;
	}

	.bt-stad-lead {
		font-family: var(--font-body);
		font-size: var(--step--1);
		line-height: 1.6;
		color: var(--text-body);
		max-width: var(--content-width);
		margin: var(--space-unit) 0 0;
		text-wrap: pretty;
	}

	/* The lead paragraph used to butt straight into the map — measured 0 px where
	   every neighbouring gap was 15–49 px, so proximity grouped the map with the
	   header text instead of letting it open its own movement. The date line is the
	   map's label and stays close to it; the map keeps a full step of air above. */
	.bt-stad-idag :global(.bonetider-field) {
		margin-top: var(--space-unit);
	}

	.bt-stad-date time {
		color: var(--color-text);
		text-transform: capitalize;
	}

	.bt-stad-note {
		font-family: var(--font-body);
		color: var(--color-muted);
		max-width: 40rem;
		margin: var(--space-half) 0 var(--space-unit);
		text-wrap: pretty;
	}

	/* Official-stats block. Reserved, static layout → no CLS. */
	.bt-facts {
		margin: var(--space-half) 0 0;
		padding: 0;
		display: grid;
		gap: var(--space-half) clamp(1rem, 4vw, 2.5rem);
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
		max-width: 46rem;
	}

	.bt-fact {
		margin: 0;
		padding: 0.4rem 0;
		border-bottom: 1px solid var(--color-divider);
	}

	.bt-fact dt {
		font-family: var(--font-heading);
		font-size: var(--step--3);
		color: var(--color-muted);
		margin: 0 0 0.15rem;
	}

	.bt-fact dd {
		margin: 0;
		font-family: var(--font-body);
		font-variant-numeric: lining-nums tabular-nums;
		color: var(--color-text);
	}

	.bt-fact-note {
		font-size: var(--step--3);
		color: var(--color-muted);
		font-variant-numeric: normal;
	}

	.bt-facts-src {
		font-family: var(--font-body);
		font-size: var(--step--3);
		color: var(--color-muted);
		margin: var(--space-unit) 0 0;
	}

	.bt-prose p {
		font-family: var(--font-body);
		font-size: var(--step--1);
		line-height: 1.6;
		color: var(--text-body);
		max-width: var(--content-width);
		margin: 0 0 var(--space-half);
		text-wrap: pretty;
	}

	.bt-prose a {
		color: var(--color-accent);
	}

	/* Placement only — the link inside is a `.section-link .arrow-link`. */
	.bt-faq-more {
		margin: var(--space-unit) 0 0;
	}

	.bt-mosques {
		margin: var(--space-half) 0 0;
		padding: 0;
		max-width: var(--content-width);
	}

	.bt-mosque {
		display: grid;
		gap: 0.1rem 0.75rem;
		padding: var(--space-half) 0;
		border-bottom: 1px solid var(--color-divider);
	}

	.bt-mosque-name {
		font-family: var(--font-heading);
		font-weight: 600;
		color: var(--color-accent);
		text-decoration: none;
		width: fit-content;
	}

	.bt-mosque-name:hover {
		text-decoration: underline;
		text-underline-offset: 0.12em;
	}

	.bt-mosque-loc {
		font-family: var(--font-body);
		font-size: var(--step--3);
		color: var(--color-muted);
	}

	.bt-mosque-dir {
		display: flex;
		gap: 0.75rem;
		margin-top: 0.15rem;
	}

	.bt-mosque-dir a {
		font-family: var(--font-heading);
		font-size: var(--step--4);
		font-weight: 600;
		color: var(--color-accent);
		text-decoration: none;
	}

	.bt-mosque-dir a:hover {
		text-decoration: underline;
		text-underline-offset: 0.12em;
	}

</style>

<script>
	import { MS_PER_DAY } from "../../lib/daily";
	import { hijriLabel } from "../../lib/markesdagar";
import { nextRamadan, ramadanRange, ramadanTimes } from "../../lib/bonetider/ramadan";
	import { loadSettings } from "../../lib/bonetider/storage";

	// The page is statically built, so the server-rendered date is the build date.
	// Refresh it to the reader's real today on load (and across view-transition
	// navigations) so "Dagens bönetider" always names the correct day. Times zone =
	// Europe/Stockholm, matching the prayer-time calculation.
	document.addEventListener("astro:page-load", () => {
		const el = document.querySelector<HTMLTimeElement>(".bt-today-date");
		if (!el) return;
		const now = new Date();
		const tz = { timeZone: "Europe/Stockholm" } as const;
		const isoToday = now.toLocaleDateString("sv-SE", tz);
		el.setAttribute("datetime", isoToday);
		el.textContent = now.toLocaleDateString("sv-SE", {
			weekday: "long",
			day: "numeric",
			month: "long",
			year: "numeric",
			...tz,
		});

		// The Hijri date beside it is the one thing on this page the reader's own
		// settings may legitimately move: `hijriOffset` exists so a household can match
		// its local moon sighting. It shifts the label only — the prayer times are
		// astronomical and never move with it. Noon UTC of the Swedish calendar day,
		// because hijriLabel reads its instant in UTC.
		const hijriEl = document.querySelector<HTMLElement>(".bt-today-hijri");
		if (!hijriEl) return;
		const offset = loadSettings().hijriOffset;
		hijriEl.textContent = hijriLabel(new Date(Date.parse(`${isoToday}T12:00:00Z`) + offset * MS_PER_DAY));
	});
</script>
