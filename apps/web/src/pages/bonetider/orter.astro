---
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import SectionLink from "../../components/SectionLink.astro";
import TitledSection from "../../components/TitledSection.astro";
import { placesByCounty } from "../../lib/bonetider/places-index";
import { breadcrumbList } from "../../lib/jsonld";
const counties = placesByCounty();
const crumbs = [
	{ name: "Hem", url: "/" },
	{ name: "Bönetider", url: "/bonetider/" },
	{ name: "Alla orter", url: "/bonetider/orter/" },
];
---

<Base title="Bönetider för alla orter i Sverige" description="Hitta din ort och dagens bönetider, län för län i Sverige." jsonLd={breadcrumbList(crumbs)}>
	<main id="main" class="home directory">
		<Breadcrumb items={crumbs} />
		<h1>Alla orter</h1>
		{/* The way back to the search, set like the hub's »Alla orter« link that leads here. */}
		<SectionLink class="directory-search" href="/bonetider/#place-query">Sök efter ort</SectionLink>
		<TitledSection class="page-section tool-section page-section--first bh2-section" id="bh2-find" title="Välj län">
			<div class="bt-counties">
				{counties.map((g) => (
					<details class="bt-county disclosure">
						<summary>
							<span>{g.county}</span>
							<span class="bt-county-count">{g.places.length}</span>
						</summary>
						<ul class="bt-county-list">
							{g.places.map((p) => (
								<li>
									<a href={`/bonetider/${p.slug}/`} data-name={p.name} data-county={g.county}>{p.name}</a>
								</li>
							))}
						</ul>
					</details>
				))}
			</div>
		</TitledSection>
	</main>
</Base>

<style>
	/* A link standing alone on its line takes the full touch target, not the 24px a
	   section link takes beside its kicker. */
	.directory-search {
		padding-block: 0.65rem;
		margin-block: 0;
	}

	.bt-county summary {
		align-items: center;
		gap: var(--space-control);
		min-height: var(--tap-target);
	}

	/* The count's face and tone come from the shared county-list rule in layout.css. */
	.bt-county-count {
		margin-left: auto;
		flex: none;
	}

	.bt-county-list {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 10rem), 1fr));
		gap: 0 1rem;
	}

	.bt-county-list a {
		display: flex;
		align-items: center;
		min-height: var(--tap-target);
		font-size: var(--step--2);
	}
</style>
