---
import AppPromo from "../../components/AppPromo.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import DefinitionList from "../../components/DefinitionList.astro";
import AsrShadow from "../../components/bonetider/AsrShadow.astro";
import OmBonen from "../../components/bonetider/OmBonen.astro";
import SunDayCurve from "../../components/bonetider/SunDayCurve.astro";
import Ritning from "../../components/Ritning.astro";
import SectionLink from "../../components/SectionLink.astro";
import TitledSection from "../../components/TitledSection.astro";
import Base from "../../layouts/Base.astro";
import { ORG_ID, breadcrumbList, faqPageJsonLd } from "../../lib/jsonld";
import { BONETIDER_DATA_DATE, SCB_REF, SCB_SOURCE } from "../../lib/bonetider/meta";
import { placeBySlug } from "../../lib/bonetider/places-index";
import { RITNINGAR } from "../../lib/ritningar";
import { dateForStockholmDay } from "../../lib/bonetider/prayer-times";

// The figures are drawn for fixed reference days, never "today" — same reason
// place-facts.ts fixes its year: a statically built page must not go stale, and each
// panel only makes its point on its own day.
const MIDWINTER = dateForStockholmDay(2025, 11, 21);
const EQUINOX = dateForStockholmDay(2025, 2, 20);
const MIDSUMMER = dateForStockholmDay(2025, 5, 21);

// ⚠️ Malmö, NOT the site's default Stockholm — and not for looks. Under the default
// settings, Stockholm's published Fajr is never on the 18° angle on any day of the
// year: the seventh-of-the-night floor is later every time (deepest: −17,4°, late
// January). Malmö is the one large city where the angle genuinely sets Fajr and
// ʿIshāʾ, from about November to February, so it is the only honest place to draw
// the definition working. The §m-latitud prose says so, and sun-day-curve.test.ts
// pins both facts.
const malmo = placeBySlug("malmo");
if (!malmo) throw new Error("metod.astro: placeBySlug('malmo') missing — the figures need it");
const FIGURE_PLACE = { name: malmo.name, latitude: malmo.lat, longitude: malmo.lon };

// One array feeds both the visible trail and the JSON-LD, so they cannot drift apart.
// ⚠️ Trailing slashes are load-bearing here: the visible href is used raw, and
// Cloudflare 308s the slash-less form.
const crumbs = [
	{ name: "Hem", url: "/" },
	{ name: "Bönetider", url: "/bonetider/" },
	{ name: "Så beräknas bönetiderna", url: "/bonetider/metod/" },
];

const description =
	"Så beräknas bönetiderna på islam.se: solens verkliga läge, beräkningsmetoder (Muslim World League m.fl.), madhhab, regler för höga latituder, tidszon – och våra källor (SCB, GeoNames, adhan).";

// Machine-readable sources for the TechArticle citation[]. External works are
// typed CreativeWork (not Dataset): citation accepts the supertype, and bare
// Dataset nodes get validated as standalone Dataset rich results by Google.
const sources: Record<string, unknown>[] = [
	{ "@type": "SoftwareSourceCode", name: "adhan", url: "https://github.com/batoulapps/adhan-js" },
	{ "@type": "CreativeWork", name: "GeoNames", url: "https://www.geonames.org/", license: "https://creativecommons.org/licenses/by/4.0/" },
	{ "@type": "CreativeWork", name: `${SCB_SOURCE} (${SCB_REF})`, creator: { "@type": "GovernmentOrganization", name: "Statistiska centralbyrån" } },
];

// Visible Q&A (also emitted as FAQPage) – the question-shaped queries AI engines
// get for prayer-time calculation. Answers condense the sections below.
const faq = [
	{
		q: "Hur beräknas bönetiderna på islam.se?",
		a: "Tiderna räknas fram ur solens verkliga läge för varje orts latitud och longitud med en etablerad astronomisk modell (NOAA:s solpositionsalgoritm) – inte ur en färdig tabell. Beräkningen sker i din webbläsare och uppdateras varje dygn.",
	},
	{
		q: "Vilken beräkningsmetod används som standard?",
		a: "Muslim World League (Fajr 18°, ʿIshāʾ 17°), som passar svenska latituder väl. I inställningarna kan du byta till bland andra Diyanet, Umm al-Qurā, ISNA, Egyptiska myndigheten och Moonsighting Committee.",
	},
	{
		q: "Hur hanteras Sveriges ljusa sommarnätter?",
		a: "När solen inte sjunker de 18° under horisonten som krävs för Fajr och ʿIshāʾ används en regel för höga latituder – som standard sjundedelen av natten, där Fajr sätts en sjundedel av natten före soluppgången och ʿIshāʾ lika långt efter solnedgången. Norr om polcirkeln, där solen delar av året inte går ner eller inte går upp alls, hämtas tiderna i stället från närmaste plats där de går att beräkna (Aqrab al-Balad).",
	},
	{
		q: "Vilka källor bygger bönetiderna på?",
		a: `Beräkning med det öppna biblioteket adhan, orter och koordinater från GeoNames (CC BY 4.0) och befolkningsstatistik från ${SCB_SOURCE} (${SCB_REF}). islam.se driver inget eget system för månsiktning – ramadans början och högtiderna fastställs genom officiell månsiktning.`,
	},
	{
		q: "Vad heter bönen och bönetiderna på arabiska?",
		a: "Bönen heter på arabiska ṣalāh (صلاة) och själva tidtabellen awqāt aṣ-ṣalāh; på turkiska och bosniska används ordet namaz. De fem dagliga bönerna är Fajr, Ẓuhr, ʿAṣr, Maghrib och ʿIshāʾ, plus Shurūq (soluppgången) som avslutar Fajr-tiden.",
	},
];
const prayerDefinitions = [
	{ term: "Fajr", description: "gryningen, när solen står en bestämd vinkel under horisonten före soluppgången." },
	{ term: "Shurūq", description: "soluppgången, då Fajr-tiden tar slut." },
	{ term: "Ẓuhr", description: "strax efter att solen passerat sin högsta punkt (solens meridianpassage)." },
	{ term: "ʿAṣr", description: "på eftermiddagen, när ett föremåls skugga nått en viss längd (beror på madhhab)." },
	{ term: "Maghrib", description: "solnedgången." },
	{ term: "ʿIshāʾ", description: "kvällen, när solen åter står en bestämd vinkel under horisonten." },
];
---

<Base
	title="Så beräknas bönetiderna – islam.se"
	description={description}
	ogImage="/bonetider/og.png"
	ogImageAlt="Så beräknas islamiska bönetider för svenska latituder – islam.se"
	jsonLd={[
		{
			"@context": "https://schema.org",
			"@type": "TechArticle",
			headline: "Så beräknas bönetiderna",
			description,
			url: "https://islam.se/bonetider/metod/",
			inLanguage: "sv",
			datePublished: BONETIDER_DATA_DATE,
			dateModified: BONETIDER_DATA_DATE,
			author: { "@id": ORG_ID },
			publisher: { "@id": ORG_ID },
			about: { "@type": "Thing", name: "Islamiska bönetider" },
			citation: sources,
		},
		faqPageJsonLd(faq),
		breadcrumbList(crumbs),
	]}
>
	<main id="main" class="home home--text bonetider-metod bt-prose">
		{/* Bönetider's drawing opens the section's prose page, as a section's drawing
		    opens its hub (PageHead): /bonetider/ itself opens on its tool. */}
		<header class="bt-metod-header">
			<Breadcrumb items={crumbs} />
			<h1>Så beräknas bönetiderna</h1>
			<p class="bt-metod-lead">
				Bönetiderna på islam.se beräknas från solens verkliga läge vid varje ort och hämtas inte
				ur en färdig tabell. Här förklarar vi modellen, vilka beräkningsmetoder du kan
				välja, hur ljusa sommarnätter hanteras, och vilka källor vi använder.
			</p>
			<div class="bt-metod-ritning">
				<Ritning {...RITNINGAR.bonetider} fyll hojd={[4.5, 11]} bredd={[7.5, 16]} sizes="(min-width: 79rem) 31rem, (min-width: 48rem) calc(100vw - 49rem), 7rem" />
			</div>
		</header>

		<TitledSection id="m-boner" title="De sex tiderna">
			<p>
				Varje bön är knuten till en bestämd solhöjd. Vi visar sex tidpunkter per dygn:
			</p>
			<DefinitionList items={prayerDefinitions} />
			<SunDayCurve location={FIGURE_PLACE} date={MIDWINTER} dateLabel="midvinter">
				Shurūq och Maghrib ligger på horisonten och Ẓuhr vid kurvans topp. Fajr och ʿIshāʾ hamnar
				nere i skymningen, där solen står 18° respektive 17° under horisonten – de vinklar
				standardmetoden Muslim World League räknar med. ʿAṣr bestäms inte av en vinkel utan av en
				skugga; se <a href="#m-metoder">Beräkningsmetoder och madhhab</a>.
			</SunDayCurve>
		</TitledSection>

		<TitledSection id="m-solen" title="Solens läge, inte en tabell">
			<p>
				Tiderna räknas fram ur solens position med en etablerad astronomisk modell (NOAA:s
				solpositionsalgoritm). För varje ort används latitud och longitud, så att Ẓuhr infaller exakt
				när solen står som högst just där, och Fajr/ʿIshāʾ när solen når de valda vinklarna under
				horisonten. Allt sker direkt i din webbläsare och uppdateras varje dygn.
			</p>
		</TitledSection>

		<TitledSection id="m-metoder" title="Beräkningsmetoder och madhhab">
			<p>
				Olika institutioner använder något olika vinklar för Fajr och ʿIshāʾ. Standard på islam.se är{" "}
				<strong>Muslim World League</strong> (Fajr 18°, ʿIshāʾ 17°), som passar svenska latituder väl.
				I inställningarna kan du byta till bland andra Diyanet (Turkiet), Umm al-Qurā (Mecka), ISNA
				(Nordamerika), Egyptiska myndigheten och Moonsighting Committee – kartan och tiderna uppdateras direkt.
			</p>
			<p>
				För <strong>ʿAṣr</strong> kan du välja madhhab: standard (Shāfiʿī, Mālikī, Ḥanbalī) där skuggan
				är lika lång som föremålet, eller Ḥanafī där den är dubbelt så lång. Vill du att tiderna ska
				stämma exakt med din moské, välj samma metod och madhhab som den – och justera vid behov
				enskilda böner med några minuter under Avancerat. Inställningarna sparas lokalt i din
				webbläsare.
			</p>
			<AsrShadow location={FIGURE_PLACE} date={EQUINOX} dateLabel="vårdagjämningen">
				islam.se visar som standard den tidigare tiden; den senare väljs i inställningarna.
			</AsrShadow>
		</TitledSection>

		<TitledSection id="m-latitud" title="Höga latituder och ljusa nätter">
			<p>
				På svenska breddgrader blir sommarnatten ofta så ljus att solen aldrig sjunker de 18° under
				horisonten som krävs för den vanliga vinkelberäkningen av Fajr och ʿIshāʾ. Då används en regel
				för höga latituder – som standard <em>sjundedelen av natten</em>, där Fajr sätts en sjundedel av
				natten före soluppgången och ʿIshāʾ lika långt efter solnedgången. Norr om polcirkeln, där
				midnattssol och polarnatt råder delar av året, finns ingen natt att dela; där hämtas tiderna
				i stället från närmaste plats där de går att beräkna (Aqrab al-Balad). Inställningen väljs
				automatiskt utifrån orten, men kan ändras manuellt.
			</p>
			<p>
				Sjundedelen gäller dessutom som en gräns, inte bara när vinkeln saknas: skulle vinkeln ge
				en Fajr tidigare än en sjundedel av natten före soluppgången, är det sjundedelen som
				gäller. Ju längre norrut, desto oftare avgör den. I Malmö följer Fajr vinkeln ungefär från
				november till februari; i Stockholm sätter sjundedelen Fajr året runt.
			</p>
			<SunDayCurve location={FIGURE_PLACE} date={MIDSUMMER} dateLabel="midsommar">
				Jämför med midvinter ovan: här ger vinkeln varken Fajr eller ʿIshāʾ, så prickarna ligger i
				stället en sjundedel av natten före soluppgången och efter solnedgången – ovanför den
				streckade linjen, inte på den.
			</SunDayCurve>
		</TitledSection>

		<TitledSection id="m-tid" title="Tidszon och sommartid">
			<p>
				Alla tider visas i tidszonen Europe/Stockholm och växlar automatiskt mellan normaltid och
				sommartid. Tiderna gäller den valda ortens position, inte din webbläsares tidszon.
			</p>
		</TitledSection>

		<TitledSection id="m-kallor" title="Källor och öppenhet">
			<p>Varifrån uppgifterna kommer och hur de används:</p>
			<ul class="bt-sources">
				<li>
					<strong>Beräkning:</strong> det öppna biblioteket <span lang="en">adhan</span>, ett etablerat
					programbibliotek för beräkning av bönetider.
				</li>
				<li>
					<strong>Orter och koordinater:</strong> GeoNames (CC BY 4.0).
				</li>
				<li>
					<strong>Befolkningsstatistik:</strong> {SCB_SOURCE} ({SCB_REF}) – officiell statistik per
					tätort. SCB:s statistik är fri att återanvända.
				</li>
				<li>
					<strong>Sveriges kontur på kartan:</strong> öppna kartdata (allmän egendom).
				</li>
				<li>
					<strong>Kartan på moskéskärmen:</strong> Natural Earth (allmän egendom), nationalparker och
					naturreservat från © OpenStreetMap-bidragsgivare (ODbL, via OpenFreeMap) och terräng från
					AWS Terrain Tiles (Mapzen), bland annat Copernicus EU-DEM och Kartverket.
				</li>
			</ul>
			<p>
				islam.se driver inget eget system för månsiktning. Bönetiderna beräknas astronomiskt enligt
				ovan, medan ramadans början och de två högtiderna fastställs genom officiell månsiktning och kan därför skilja sig något från ren uträkning.
			</p>
		</TitledSection>

		<TitledSection id="m-faq" title="Vanliga frågor">
			<DefinitionList items={faq} />
		</TitledSection>

		<OmBonen />

		<AppPromo variant="compact" />

		<p class="bt-back">
			<SectionLink direction="back" href="/bonetider/">Alla bönetider i Sverige</SectionLink>
		</p>
	</main>
</Base>

<style>
	.bonetider-metod {
		margin-block: var(--space-phi);
		overflow-x: clip;
	}

	.bt-metod-header h1 {
		margin: var(--space-half) 0 0;
	}

	/* PageHead's composition: the drawing as tall as the opening, the title's line to
	   the ingress's last, on the frame's right edge; on a phone beside the title, the
	   ingress under both. The breadcrumb stays above it all. */
	.bt-metod-header {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		grid-template-areas:
			"stig stig"
			"titel ritning"
			"ingress ingress";
		column-gap: var(--space-unit);
		align-items: end;
	}

	/* The breadcrumb carries the gap to the title, so the title's row starts on its top
	   line and the drawing's cell with it. */
	.bt-metod-header > :first-child {
		grid-area: stig;
		margin-bottom: var(--space-half);
	}

	.bt-metod-header h1 {
		grid-area: titel;
		margin-top: 0;
	}

	/* The lead's bottom margin (a global rule gives it 0.95rem) moves to the header's
	   padding: in the row it lengthened the drawing's cell past the last line; as
	   padding it keeps the gap to the first section as it was. */
	.bt-metod-header {
		padding-bottom: var(--space-half);
	}

	.bt-metod-header .bt-metod-lead {
		grid-area: ingress;
		margin-bottom: 0;
	}

	.bt-metod-ritning {
		grid-area: ritning;
	}

	@media (width >= 48rem) {
		.bt-metod-header {
			grid-template-columns: minmax(0, var(--content-width)) minmax(8rem, 1fr);
			grid-template-areas:
				"stig stig"
				"titel ritning"
				"ingress ritning";
			grid-template-rows: auto auto 1fr;
			column-gap: var(--grid-gutter);
			align-items: start;
		}

		.bt-metod-ritning {
			position: relative;
			align-self: stretch;
			min-block-size: 7rem;
		}
	}

	.bt-metod-lead {
		font-family: var(--font-body);
		font-size: var(--step--1);
		line-height: 1.6;
		color: var(--text-body);
		max-width: var(--content-width);
		margin: var(--space-unit) 0 0;
		text-wrap: pretty;
	}

	.bonetider-metod section {
		margin-top: var(--space-phi);
	}

	.bonetider-metod h2 {
		font-size: var(--step-1-sans);
	}

	.bt-prose p {
		font-family: var(--font-body);
		font-size: var(--step--1);
		line-height: 1.6;
		color: var(--text-body);
		max-width: var(--content-width);
		margin: var(--space-half) 0;
		text-wrap: pretty;
	}

	.bt-prose a {
		color: var(--color-accent);
	}

	.bt-sources {
		max-width: var(--content-width);
		margin: var(--space-half) 0;
		padding-left: 1.2rem;
	}

	.bt-sources li {
		font-family: var(--font-body);
		line-height: 1.55;
		color: var(--text-body);
		margin: 0.35rem 0;
	}

	/* Placement only — the link inside is a `.section-link .back-link`. */
	.bt-back {
		margin: var(--space-phi) 0 0;
	}
</style>
