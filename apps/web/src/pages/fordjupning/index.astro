---
import CollectionIndexPage from "../../components/CollectionIndexPage.astro";
import FordjupningCards from "../../components/FordjupningCards.astro";
import { FORDJUPNING_INGRESS, getSortedFordjupning, resolveHero } from "../../lib/fordjupning";
import { breadcrumbList, collectionPageJsonLd } from "../../lib/jsonld";
import { RITNINGAR } from "../../lib/ritningar";

// FORDJUPNING — the encyclopedic pillar pages. Each covers one broad topic in full
// (sources, scholarship, history, the Swedish context); the short answers at /svar/
// handle the single questions underneath them.
const sorted = await getSortedFordjupning();
// Resolved once here rather than per row, so the index stays one pass over the art map
// even at thirty topics.
const entries = await Promise.all(
	sorted.map(async (entry) => ({ entry, hero: await resolveHero(entry) })),
);

// ⚠️ READING ORDER, NOT ALPHABETICAL. `getSortedFordjupning()` sorts by term, which
// opened this page with Abort, Det islamiska nyåret, Döden and Griskött — an order that
// says nothing about the collection and starts it on its three heaviest subjects. The
// list below runs a reader from what islam is and where it came from, through what it
// asks of a life, to the questions that are contested. It is also why the page is a card
// grid rather than the text rows it used to be: every one of these topics carries art
// now, and a directory of hairline rows was throwing that away.
//
// Anything not named here still renders — it falls to the end in the collection's own
// term order — so adding a fördjupning can never make it disappear from its own index.
const READING_ORDER = [
	// What it is, and how it got here
	"islam-i-sverige",
	"koranen",
	"muhammed",
	"sharia",
	"moske",
	// What it asks of a life
	"hijab",
	"halal",
	"ramadan",
	"tvagning",
	"kaba",
	// The turns a life takes
	"konvertering",
	"aktenskap",
	"skilsmassa",
	"doden",
	"muslimsk-begravning",
	// The contested ground
	"abort",
	"griskott",
	"jihad",
	"kalifatet",
	"sunni-och-shia",
	// The rest of the vocabulary
	"islamiskt-nyar",
	"uttryck",
];

const rank = new Map(READING_ORDER.map((id, i) => [id, i]));
const ordered = [...entries].sort(
	(a, b) =>
		(rank.get(a.entry.id) ?? Number.MAX_SAFE_INTEGER) -
		(rank.get(b.entry.id) ?? Number.MAX_SAFE_INTEGER),
);

const description =
	"Fördjupningsartiklar om omdiskuterade ämnen i islam – källorna, historien och det svenska rättsläget, ämne för ämne.";
---

<CollectionIndexPage
	title="Fördjupning om islam"
	description={description}
	ritning={RITNINGAR.fordjupning}
	ogImageAlt="Fördjupning om islam – islam.se"
	mainClass="fordjupning-index home"
	jsonLd={[
		collectionPageJsonLd({
			name: "Fördjupning om islam",
			description,
			// `slug` is prefixed because the helper resolves it against the site root.
			url: "/fordjupning/",
			essays: ordered.map(({ entry: e }) => ({
				title: e.data.title,
				slug: `fordjupning/${e.id}`,
			})),
		}),
		breadcrumbList([
			{ name: "Hem", url: "/" },
			{ name: "Fördjupning", url: "/fordjupning/" },
		]),
	]}
>
	<span slot="lead">
		{FORDJUPNING_INGRESS} Vill du ha ett kort svar i stället finns{" "}
		<a href="/svar/">frågor och svar</a>, och grunderna står samlade under{" "}
		<a href="/vad-ar-islam/">Tro och lära</a>.
	</span>

	{ordered.length > 0 ? (
		<FordjupningCards entries={ordered} />
	) : (
		<p class="fordjupning-empty">Inga fördjupningar är publicerade än.</p>
	)}
</CollectionIndexPage>

<style>
	.fordjupning-empty {
		margin-top: var(--space-phi);
		color: var(--color-muted);
	}
</style>
