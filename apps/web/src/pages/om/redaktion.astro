---
import ArticlePage from "../../components/ArticlePage.astro";
import RuledFacts from "../../components/RuledFacts.astro";
import figures from "../../data/library-figures.json";
import { formatDate } from "../../lib/articles";
import { nf0 } from "../../lib/format";
import { ORG_ID, breadcrumbList } from "../../lib/jsonld";

// By hand when the principles change — never the build date.
const POLICY_UPDATED = "2026-07-29";

// Recounted from data/*.db by scripts/build-library-figures.ts at the head of every
// build. Non-breaking spaces so a figure never wraps across a line.
const n = (value: number) => nf0.format(value).replace(/\s/g, " ");

const description =
	"Redaktionella principer för islam.se: vad vi publicerar, vilka källor texterna vilar på, hur de granskas och hur du anmäler ett fel.";

const mastheadFacts = [
	{ term: "Grundad", html: '2003, av <a href="https://bilal.se" rel="author">Bilal</a>' },
	{
		term: "Redaktion",
		html: '<a href="https://bilal.se" rel="author">Bilal</a> och <a href="https://andreassonphoto.com" rel="author">Yunus</a>',
	},
	{ term: "Utgivningsort", html: "Sverige" },
	{ term: "Kontakt", html: '<a href="mailto:support@islam.se">support@islam.se</a>' },
	{
		term: "Sidan uppdaterad",
		html: `<time datetime="${POLICY_UPDATED}">${formatDate(POLICY_UPDATED)}</time>`,
	},
];

const libraryFacts = [
	{
		term: "Arabiska klassiker",
		html: `${n(figures.arabicQuotes)} citat ur ${n(figures.arabicWorks)} verk`,
	},
	{
		term: "Svensk litteratur",
		html: `${n(figures.swedishQuotes)} citat ur ${n(figures.swedishWorks)} verk`,
	},
	{ term: "Fornnordiskt och engelskt", html: `${n(figures.norseEnglishQuotes)} citat` },
	{ term: "Koranen", html: `${n(figures.quranVerses)} verser` },
	{ term: "Böcker i fulltext", html: `${n(figures.fulltextBooks)} titlar` },
];

type PipelineStep = {
	name: string;
	description: string;
	exit?: string;
	kind?: "gate" | "end";
};

const pipelineSteps: readonly PipelineStep[] = [
	{
		name: "Uppslag",
		description: "Ämnet måste gå att belägga ur källorna.",
	},
	{
		name: "Efterforskning",
		description: "Underlaget hämtar vi ur biblioteket ovan.",
	},
	{
		name: "Källkritik",
		description:
			"Uppgifter utifrån vägs efter källans tillförlitlighet. Vissa källor använder vi inte, och vi håller reda på vilka som visat sig hålla.",
	},
	{
		name: "Faktagranskning",
		description:
			"Varje citat kontrolleras mot sin källa, varje siffra mot ett oberoende belägg, varje hadith mot sin samling och varje versnummer mot versen.",
		exit: "Håller underlaget inte, blir det ingen text.",
		kind: "gate",
	},
	{
		name: "Skrivande",
		description: "Först då skrivs texten.",
	},
	{
		name: "Omläsning",
		description:
			"Texten läses igenom flera gånger, varje gång med ett avgränsat uppdrag: bär resonemanget, är de abstrakta begreppen konkretiserade, är svenskan idiomatisk, ligger trosläran inom traditionen.",
		exit: "Håller texten inte, går den tillbaka till skrivbordet.",
		kind: "gate",
	},
	{
		name: "Publicering",
		description: "Texten går ut med källförteckning och datum.",
		kind: "end",
	},
];
---

<ArticlePage
	title="Redaktionella principer — islam.se"
	description={description}
	jsonLd={[
		{
			"@context": "https://schema.org",
			"@type": "AboutPage",
			name: "Redaktionella principer",
			url: "https://islam.se/om/redaktion/",
			inLanguage: "sv",
			description,
			// The page that islam.se's Organization node points to as its
			// publishingPrinciples (wired in lib/jsonld.ts) — references the same
			// canonical entity rather than declaring a copy.
			mainEntity: { "@id": ORG_ID },
		},
		breadcrumbList([
			{ name: "Hem", url: "/" },
			{ name: "Om", url: "/om" },
			{ name: "Redaktionella principer", url: "/om/redaktion" },
		]),
	]}
>
	<Fragment slot="header">
		<p class="redaktion-lead">
			islam.se publicerar essäer och källbelagda svar om islam på svenska. Här står vad vi
			publicerar, vilka källor texterna vilar på, hur de granskas innan de går ut, och hur du
			anmäler ett fel.
		</p>
	</Fragment>

		{/* Utgivningsruta. Facts only — nothing asserted the site can't show. */}
		<RuledFacts items={mastheadFacts} />

		<div class="article-body prose redaktion-prose">
			<h2>Vad vi publicerar</h2>
			<p>
				Sajten har två slags texter. Essäerna läser islamisk lärdomstradition tillsammans med
				svensk och nordisk litteratur. Svaren ger ett kort och källbelagt besked på en rak fråga.
			</p>

			<h2>Källor</h2>
			<p>
				Texterna vilar på primärkällor. Den islamiska sidan hämtas ur Koranen, sunna och de
				klassiska verken på arabiska; den svenska ur den litterära kanon den läser tillsammans med
				dem. Koranverser återges i tolkning, och de verser en text bygger på anges med hänvisning
				till den arabiska texten. Vi citerar hellre källan själv än andrahandsreferat, och en
				uppgift vi inte kunnat föra tillbaka till en källa står inte kvar.
			</p>
			<p>
				Biblioteket vi söker i är vårt eget. Det rymmer {n(figures.totalQuotes)} citat av{" "}
				{n(figures.totalAuthors)} författare, hämtade ur {n(figures.totalWorks)} verk.
			</p>

			<RuledFacts class="redaktion-figures" items={libraryFacts} />
			<p class="redaktion-figures-note">
				Siffrorna gäller den <time datetime={figures.countedAt}>{formatDate(figures.countedAt)}</time>.
			</p>

			<h2>Så blir en text till</h2>
			<p>Varje text går samma väg innan vi publicerar den.</p>

			<ol class="pipeline">
				{pipelineSteps.map((step) => (
					<li class:list={["pipeline-step", step.kind && `is-${step.kind}`]}>
						<span class="pipeline-name">{step.name}</span>
						<p>{step.description}</p>
						{step.exit && <p class="pipeline-exit">{step.exit}</p>}
					</li>
				))}
			</ol>

			<p>
				Vi använder AI som verktyg i varje led. Ansvaret är ändå vårt: ingen text publiceras utan
				att en människa läst igenom den.
			</p>

			<h2>Teologisk hållning</h2>
			<p>
				Texterna håller sig inom den klassiska islamiska traditionens ramar och prövas mot Koranen
				och sunna så som den första generationen muslimer förstod dem. Där en text rör vid
				trosläran är det den förståelsen som är måttstocken; litterära jämförelser med svenska
				författare är till för att belysa, aldrig för att jämställa eller lägga till något i läran.
			</p>

			<h2 id="rattelser">Rättelser</h2>
			<p>
				Vi rättar sakfel så snart vi får veta om dem. Hittar du ett – i en översättning, en
				hänvisning eller en uppgift – finns ett{" "}
				<a href="/ratta/">formulär för rättelser</a>, och längst ned i varje text ligger en länk
				dit med sidan redan ifylld. Ta med meningen det gäller och gärna ett belägg; det är det
				som avgör hur fort rättelsen går igenom. Ändras en text i sak efter publicering får den
				ett synligt datum för när den senast ändrades; små språkliga justeringar stämplas inte om.
			</p>

			<p>
				Mer om tanken bakom sajten finns på <a href="/om/">Om-sidan</a>. Vill du läsa eller söka i
				texterna med en AI-assistent beskriver <a href="/ai/">AI-sidan</a> hur du kopplar in dem.
			</p>
		</div>
</ArticlePage>

<style>
	.redaktion-lead {
		font-family: var(--font-body);
		font-size: var(--step--1);
		line-height: 1.6;
		color: var(--text-body);
		max-width: var(--content-width);
		margin: var(--space-unit) 0 0;
		text-wrap: pretty;
	}

	/* Same ruled-facts table as the masthead, reused for the library figures — the
	   format is what keeps a column of numbers reading as data rather than a boast. */
	.redaktion-figures {
		--ruled-facts-margin: var(--space-unit) 0 0;
	}

	.redaktion-figures-note {
		font-family: var(--font-body);
		font-size: var(--step--3);
		color: var(--color-muted);
		margin: var(--space-half) 0 0;
	}

	/* Route from idea to publication: one flow that carries its own descriptions, so
	   the step names are never listed twice. Each node draws the rail down to the
	   next one, which means the last node ends it — no length arithmetic to keep
	   in sync with the content. */
	.pipeline {
		--rail: 1.9rem;
		list-style: none;
		margin: var(--space-unit) 0 var(--space-phi);
		padding: 0 0 0 var(--rail);
		max-width: var(--content-width);
	}

	.pipeline-step {
		position: relative;
		padding-bottom: var(--space-unit);
	}

	.pipeline-step:last-child {
		padding-bottom: 0;
	}

	/* Node. */
	.pipeline-step::before {
		content: "";
		position: absolute;
		left: calc(var(--rail) * -1);
		top: 0.72em;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--color-bg);
		border: 1px solid var(--color-muted);
		transform: translateY(-50%);
		z-index: 1;
	}

	/* Rail from this node to the next. The last step has none, so it terminates. */
	.pipeline-step::after {
		content: "";
		position: absolute;
		left: calc(var(--rail) * -1 + 4px);
		top: 0.72em;
		bottom: -0.72em;
		width: 1px;
		background: var(--color-rule);
	}

	.pipeline-step:last-child::after {
		content: none;
	}

	/* A stop is a filled node, not just another colour — the shape carries it where
	   two close tones would not, and the branch below says it in words anyway. */
	.pipeline-step.is-gate::before,
	.pipeline-step.is-end::before {
		background: var(--color-text);
		border-color: var(--color-text);
	}

	.pipeline-name {
		display: block;
		font-family: var(--font-heading);
		font-weight: 600;
		color: var(--color-text);
		margin-bottom: 0.25rem;
	}

	.pipeline-step > :global(p) {
		margin: 0;
		font-family: var(--font-body);
		line-height: 1.6;
		color: var(--text-body);
		text-indent: 0;
	}

	.pipeline-step > :global(p.pipeline-exit) {
		position: relative;
		margin-top: 0.35rem;
		padding-left: 1.3rem;
		font-size: var(--step--2);
		color: var(--color-muted);
	}

	/* The arrow comes from CSS, never from the markup. */
	.pipeline-step > :global(p.pipeline-exit)::before {
		content: "→";
		position: absolute;
		left: 0;
	}

	/* Editorial prose, not book prose — no first-line indents, even paragraph rhythm. */
	.redaktion-prose > :global(p) {
		text-indent: 0;
		margin-bottom: var(--space-unit);
	}

	.redaktion-prose > :global(h2) {
		font-size: var(--step-1);
		margin-top: var(--space-phi);
	}

</style>
