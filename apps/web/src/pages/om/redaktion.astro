---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { formatDate, getArticles } from "../../lib/articles";
import { INDEXED_PLACES } from "../../lib/bonetider/places-index";
import { ORG_ID, breadcrumbList } from "../../lib/jsonld";

const articles = await getArticles();
const articleCount = articles.length;
const svarCount = (await getCollection("svar")).length;
const placeCount = INDEXED_PLACES.length;

// Swedish digit grouping (thin space), so "2118" reads as a figure in prose.
const sv = (n: number) => n.toLocaleString("sv-SE");

// By hand when the principles change — never the build date.
const POLICY_UPDATED = "2026-07-27";

const description =
	"Redaktionella principer för islam.se: vad vi publicerar, vilka källor texterna vilar på, hur de granskas och hur du anmäler ett fel.";
---

<Base
	title="Redaktionella principer — islam.se"
	description={description}
	jsonLd={[
		{
			"@context": "https://schema.org",
			"@type": "AboutPage",
			name: "Redaktionella principer",
			url: "https://islam.se/om/redaktion/",
			inLanguage: "sv",
			description,
			// The page that islam.se's Organization node points to as its
			// publishingPrinciples (wired in lib/jsonld.ts) — references the same
			// canonical entity rather than declaring a copy.
			mainEntity: { "@id": ORG_ID },
		},
		breadcrumbList([
			{ name: "Hem", url: "/" },
			{ name: "Om", url: "/om" },
			{ name: "Redaktionella principer", url: "/om/redaktion" },
		]),
	]}
>
	<main id="main" class="content-column">
		<header class="article-header">
			<h1>Redaktionella principer</h1>
			<p class="redaktion-lead">
				islam.se publicerar essäer och källbelagda svar om islam på svenska. Här står vad vi
				publicerar, vilka källor texterna vilar på, hur de granskas innan de går ut, och hur du
				anmäler ett fel.
			</p>
		</header>

		{/* Utgivningsruta. Facts only — nothing asserted the site can't show. */}
		<dl class="redaktion-masthead">
			<div>
				<dt>Grundad</dt>
				<dd>2003, av <a href="https://bilal.se" rel="author">Bilal</a></dd>
			</div>
			<div>
				<dt>Redaktion</dt>
				<dd>
					<a href="https://bilal.se" rel="author">Bilal</a> och{" "}
					<a href="https://andreassonphoto.com" rel="author">Yunus</a>
				</dd>
			</div>
			<div>
				<dt>Utgivningsort</dt>
				<dd>Sverige</dd>
			</div>
			<div>
				<dt>Sidan uppdaterad</dt>
				<dd><time datetime={POLICY_UPDATED}>{formatDate(POLICY_UPDATED)}</time></dd>
			</div>
		</dl>

		<div class="article-body prose redaktion-prose">
			<h2>Vad vi publicerar</h2>
			<p>
				Tre slags sidor: {articleCount} essäer där islamisk lärdomstradition möter svenskt och
				nordiskt kulturarv, {svarCount} källbelagda svar på vanliga frågor om islam, och bönetider
				för {sv(placeCount)} orter i Sverige. Essäerna är skrivna för att läsas långsamt, och
				vänder sig till den som vill förstå islams tankevärld i samtal med Strindberg, Lagerlöf,
				Boye och Hammarskjöld lika gärna som med al-Ghazālī och Ibn al-Qayyim. Svaren har den
				motsatta uppgiften: att ge ett kort och belagt besked på en rak fråga.
			</p>

			<h2>Källor</h2>
			<p>
				Texterna vilar på primärkällor. Den islamiska sidan hämtas ur Koranen, sunna och de
				klassiska verken på arabiska; den svenska ur den litterära kanon den läser tillsammans med
				dem. Koranverser återges i tolkning, och de verser en text bygger på anges med hänvisning
				till den arabiska texten. Vi citerar hellre källan själv än andrahandsreferat, och en
				uppgift vi inte kunnat föra tillbaka till en källa står inte kvar.
			</p>

			<h2>Så blir en text till</h2>
			<p>
				Varje text går igenom samma steg innan den publiceras: efterforskning i källorna,
				källkontroll, författande och en avslutande granskning av sak, språk och teologi. Vi
				använder AI som ett verktyg i det arbetet. Ansvaret ligger ändå hos oss: en text prövas mot
				sina primärkällor och läses igenom av en människa innan den går ut, och det som inte håller
				– i sak, i källäge eller i språk – publiceras inte.
			</p>

			<h2>Teologisk hållning</h2>
			<p>
				Texterna håller sig inom den klassiska islamiska traditionens ramar och prövas mot Koranen
				och sunna så som de lästs av lärda som Ibn Taymiyya och Ibn al-Qayyim. Där en text rör vid
				trosläran är det den traditionen som är måttstocken; litterära jämförelser med svenska
				författare är till för att belysa, aldrig för att jämställa eller lägga till något i läran.
			</p>

			<h2>Rättelser</h2>
			<p>
				Vi rättar sakfel så snart vi får veta om dem. Hittar du ett – i en översättning, en
				hänvisning eller en uppgift – hör av dig via{" "}
				<a href="https://bilal.se" rel="author">Bilal</a> eller{" "}
				<a href="https://andreassonphoto.com" rel="author">Yunus</a>. Ändras en text i sak efter
				publicering får den ett synligt datum för när den senast ändrades; små språkliga justeringar
				stämplas inte om.
			</p>

			<p>
				Mer om tanken bakom sajten finns på <a href="/om/">Om-sidan</a>. Vill du läsa eller söka i
				texterna med en AI-assistent beskriver <a href="/ai/">AI-sidan</a> hur du kopplar in dem.
			</p>
		</div>

		<p class="redaktion-seealso label">
			<a class="back-link" href="/om/">Om islam.se</a>
			<span class="nav-dot" aria-hidden="true">·</span>
			<a href="/essaer/">Alla essäer</a>
		</p>
	</main>
</Base>

<style>
	.redaktion-lead {
		font-family: var(--font-body);
		font-size: var(--step--1);
		line-height: 1.6;
		color: var(--text-body);
		max-width: var(--content-width);
		margin: var(--space-unit) 0 0;
		text-wrap: pretty;
	}

	/* A quiet ruled table, not a boxed card: label left, fact right. */
	.redaktion-masthead {
		max-width: var(--content-width);
		margin: var(--space-phi) 0 0;
		padding: 0;
		border-top: 1px solid var(--color-rule);
		font-size: var(--step--2);
	}

	.redaktion-masthead > div {
		display: grid;
		grid-template-columns: 11rem 1fr;
		gap: 0.5rem 1.5rem;
		padding: 0.65rem 0;
		border-bottom: 1px solid var(--color-divider);
	}

	.redaktion-masthead dt {
		font-family: var(--font-heading);
		font-size: var(--step--3);
		font-weight: 500;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		font-feature-settings: "case";
		color: var(--color-muted);
		/* Optical: small caps sit high against the text beside them. */
		padding-top: 0.15em;
	}

	.redaktion-masthead dd {
		margin: 0;
		font-family: var(--font-body);
		color: var(--text-body);
	}

	.redaktion-masthead a {
		color: var(--color-accent);
		text-decoration: none;
	}

	.redaktion-masthead a:hover {
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	/* Too narrow for two columns — stack. */
	@media (width <= 30rem) {
		.redaktion-masthead > div {
			grid-template-columns: 1fr;
			gap: 0.2rem;
		}
	}

	/* Editorial prose, not book prose — no first-line indents, even paragraph rhythm. */
	.redaktion-prose > :global(p) {
		text-indent: 0;
		margin-bottom: var(--space-unit);
	}

	.redaktion-prose > :global(h2) {
		font-size: var(--step-1);
		margin-top: var(--space-phi);
	}

	.redaktion-seealso {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		align-items: baseline;
		margin: var(--space-phi) 0 0;
		padding-top: var(--space-half);
		border-top: 1px solid var(--color-rule);
		color: var(--color-muted);
	}

	.redaktion-seealso a {
		color: var(--color-accent);
		text-decoration: none;
	}

	.redaktion-seealso a:hover {
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}
</style>
