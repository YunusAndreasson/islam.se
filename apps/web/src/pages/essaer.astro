---
import { X } from "@lucide/astro";
import { getCollection } from "astro:content";
import CollectionIndexPage from "../components/CollectionIndexPage.astro";
import EssayList from "../components/EssayList.astro";
import FilterOverlayList from "../components/FilterOverlayList.astro";
import TankareGroups from "../components/TankareGroups.astro";
import TitledSection from "../components/TitledSection.astro";
import TradarHome from "../components/TradarHome.astro";
import { AMNEN, amnenWithEssays } from "../lib/amnen";
import { getArticles } from "../lib/articles";
import { breadcrumbList } from "../lib/jsonld";

const articles = await getArticles();
const amneGroups = amnenWithEssays(articles);

// Chronological view — essays by year, newest first.
const byYear = Map.groupBy(articles, (a) => new Date(a.publishedAt).getUTCFullYear());
const yearGroups = [...byYear.entries()].sort((a, b) => b[0] - a[0]);

const threads = await getCollection("tradar");
const thinkers = await getCollection("tankare");
const sunni = thinkers.filter((t) => t.data.tradition === "sunni");
const western = thinkers.filter((t) => t.data.tradition === "western");
const amneFilterItems = AMNEN.map((a) => ({
	label: a.name,
	buttonClass: "overlay-jump" as const,
	target: `amne-${a.slug}`,
}));
const threadFilterItems = threads.map((t) => ({
	label: t.data.title,
	href: `/tradar/${t.id}/`,
}));
const sunniFilterItems = sunni.map((t) => ({
	label: t.data.name,
	href: `/tankare/${t.data.slug}/`,
}));
const westernFilterItems = western.map((t) => ({
	label: t.data.name,
	href: `/tankare/${t.data.slug}/`,
}));
const lengthFilterItems = [
	{ label: "Alla längder", buttonClass: "overlay-length" as const, min: 0, max: 999 },
	{ label: "Kort · under 5 min", buttonClass: "overlay-length" as const, min: 0, max: 4 },
	{ label: "Medel · 5–9 min", buttonClass: "overlay-length" as const, min: 5, max: 9 },
	{ label: "Lång · 10 min och mer", buttonClass: "overlay-length" as const, min: 10, max: 999 },
];
---

<CollectionIndexPage
	title="Essäer"
	description="Samtliga essäer om islamisk intellektuell tradition och svenskt kulturarv, ordnade efter ämne. Al-Ghazālī, Ibn Khaldūn, Strindberg, Lagerlöf och fler."
	lead="Den islamiska lärdomstraditionen läst tillsammans med svensk litteratur: om skapelsen och själen, om rättvisa och sökande."
	mainClass="home essaer-page"
	jsonLd={[
		{
			"@context": "https://schema.org",
			"@type": "CollectionPage",
			name: "Essäer",
			url: "https://islam.se/essaer/",
			inLanguage: "sv",
		},
		breadcrumbList([
			{ name: "Hem", url: "/" },
			{ name: "Essäer", url: "/essaer" },
		]),
	]}
>
	<nav class="filter-row" aria-label="Filtrera och sortera">
		<button class="filter-chip label" type="button" data-overlay="amnen" aria-haspopup="dialog" aria-expanded="false">Ämnen</button>
		<button class="filter-chip label" type="button" data-overlay="tradar" aria-haspopup="dialog" aria-expanded="false">Trådar</button>
		<button class="filter-chip label" type="button" data-overlay="tankare" aria-haspopup="dialog" aria-expanded="false">Tänkare</button>
		<button class="filter-chip label" type="button" data-overlay="langd" aria-haspopup="dialog" aria-expanded="false">Längd</button>
		<button class="filter-chip label" type="button" data-sort-toggle aria-pressed="false">Kronologiskt</button>
	</nav>

	{/* Curated reading paths first — an inviting way in before the topical
	    archive below; the /tradar index holds the rest. */}
	<TradarHome limit={3} />

	{/* ---- Default view: grouped by ämne, da'wah order. Each ämne opens with up to
	    three image cards (like the start page), then the rest as the 2-col index.
	    Every essay stays an .archive-item[data-slug][data-minutes] so the read /
	    length-filter / sort JS below keeps working unchanged. ---- */}
	<div id="by-amne">
		{amneGroups.map(({ amne, essays }) => {
			// Up to the three most recent essays with art open the ämne as image cards
			// (the start-page welcome); the rest follow as the 2-col text index.
			const cards = essays.filter((e) => e.heroImage).slice(0, 3);
			const cardSlugs = new Set(cards.map((e) => e.slug));
			const rest = essays.filter((e) => !cardSlugs.has(e.slug));
			return (
				<section class="archive-section essay-section" id={`amne-${amne.slug}`}>
					<header class="essay-section-head">
						<h2 class="essay-section-title archive-section-heading">
							<a href={`/amnen/${amne.slug}`}>{amne.name}</a>
						</h2>
						<p class="lead essay-section-framing">{amne.framing}</p>
					</header>

					{cards.length > 0 && (
						<EssayList
							articles={cards}
							class="essay-cards"
							itemVariant="card"
							showReadFlag
							showMinutesAttr
						/>
					)}

					{rest.length > 0 && (
						<EssayList articles={rest} class="essay-rest" showReadFlag showMinutesAttr />
					)}
				</section>
			);
		})}
	</div>

	{/* ---- Chronological view: grouped by year (hidden until toggled) ---- */}
	<div id="by-year" hidden>
		{yearGroups.map(([year, essays]) => (
			<TitledSection
				class="archive-section"
				id={`essay-year-${year}`}
				title={year}
				titleClass="label archive-section-heading"
			>
				<EssayList articles={essays} showReadFlag showMinutesAttr />
			</TitledSection>
		))}
	</div>

	{/* The voices the essays return to — a quiet directory after the archive. */}
	<TankareGroups limit={6} />

	{/* ---- Quiet filter overlay (one element, panels swapped by JS) ---- */}
	<div slot="after-main" class="overlay" id="filter-overlay" hidden role="dialog" aria-modal="true" aria-label="Filter">
		<button class="overlay-close" type="button" aria-label="Stäng">
			<X size={18} stroke-width={1.75} />
		</button>
		<div class="overlay-inner">
			<div class="overlay-panel" data-panel="amnen" hidden>
				<p class="label overlay-heading">Ämnen</p>
				<FilterOverlayList items={amneFilterItems} />
			</div>
			<div class="overlay-panel" data-panel="tradar" hidden>
				<p class="label overlay-heading">Trådar</p>
				<FilterOverlayList items={threadFilterItems} />
			</div>
			<div class="overlay-panel" data-panel="tankare" hidden>
				<p class="label overlay-heading">Tänkare</p>
				<div class="overlay-cols">
					<FilterOverlayList items={sunniFilterItems} />
					<FilterOverlayList items={westernFilterItems} />
				</div>
			</div>
			<div class="overlay-panel" data-panel="langd" hidden>
				<p class="label overlay-heading">Längd</p>
				<FilterOverlayList items={lengthFilterItems} />
			</div>
		</div>
	</div>
</CollectionIndexPage>

<style>
	/* The two-column archive grid + cell fixups live globally on
	   `.home .archive-list` (layout.css). The rest of an ämne keeps that 2-col
	   index; the styles below add the image-led chrome (section frame, framing
	   line, and the lead feature) so Essäer reads like the start page. */

	/* Each ämne is a bounded block separated by a full-width hairline. */
	.essay-section {
		margin-top: var(--space-phi2);
		padding-top: var(--space-phi);
		border-top: 1px solid var(--color-rule);
	}
	.essay-section:first-of-type {
		margin-top: var(--space-unit);
		padding-top: 0;
		border-top: none;
	}

	.essay-section-head {
		margin-bottom: var(--space-unit);
	}
	/* The ämne group head on the essay archive — a department name, so the
	   editorial face, inherited from the base h2 rule. */
	.essay-section-title {
		font-size: var(--step-1);
		font-weight: 600;
		letter-spacing: 0;
		line-height: 1.2;
		margin: 0;
	}
	.essay-section-framing {
		--lead-color: var(--color-muted);
		--lead-measure: 40rem;
		--lead-margin: 0.4rem 0 0;
	}

	/* Up to three of the most recent essays with art open each ämne as image cards —
	   the same warm welcome as the start page — then the rest follows as the 2-col
	   text index. Cards stay .archive-item for the read/length/sort JS; the reset of
	   the global .archive-item border/padding lives in EssayArchiveItem.astro. */
	/* Three narrower thread cards across the intro, the same three-up shape the
	   fördjupning band uses on /svar/.
	   ⚠️ Fully :global(). `.essaer-page` is rendered by CollectionIndexPage and carries
	   THAT component's scope id, so a selector scoped to this page never matches it. */
	:global(.essaer-page .tradar-home .thread-list) {
		--thread-list-min: 17rem;
	}

	/* .essay-cards and the card itself are global — see styles/layout.css. */

	.filter-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: var(--space-unit);
	}

	/* The filter pills are the shared global `.filter-chip` (+ `.label`), identical to
	   the Frågor & svar category nav. */

	/* Read/unread value-shift within the ämne group (§9) — not two sections. */
	.read-flag {
		display: none;
		color: var(--color-warm);
	}

	.archive-item[data-read] .archive-title {
		color: var(--color-muted);
	}

	.archive-item[data-read] .read-flag {
		display: inline;
	}

	.archive-item[data-filtered] {
		display: none;
	}

	/* Hide a section whose rows are all filtered out. */
	.archive-section[data-empty] {
		display: none;
	}

	.archive-section-heading a {
		color: inherit;
		text-decoration: none;

		&:hover {
			text-decoration: underline;
			text-underline-offset: 0.15em;
		}
	}

	/* ---- Quiet filter overlay ---- */
	.overlay {
		position: fixed;
		inset: 0;
		z-index: 60;
		background: color-mix(in srgb, var(--color-bg) 96%, transparent);
		/* No hand-written -webkit- twin: Lightning CSS treats the pair as duplicates
	   and keeps only the later one, so the standard property is dropped from the
	   build — and current Chrome no longer honours -webkit-backdrop-filter. It
	   adds the prefix itself where a target still needs it. */
		backdrop-filter: blur(8px);
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		transition: opacity 0.2s ease;
	}

	.overlay[hidden] {
		display: none;
	}

	.overlay[data-visible] {
		opacity: 1;
	}

	.overlay-close {
		position: absolute;
		top: var(--safe-top);
		right: var(--safe-right);
		z-index: 1;
		display: flex;
		padding: 0.75rem;
		border: none;
		/* A tall panel scrolls underneath, so the glyph needs its own ground. */
		background: var(--color-bg);
		border-radius: var(--radius-pill);
		color: var(--color-muted);
		cursor: pointer;

		&:hover {
			color: var(--color-accent);
		}

	}

	.overlay-inner {
		max-width: var(--content-width);
		width: 100%;
		/* The Tänkare panel is ~915px tall; on a 667px phone it would overflow a
	   fixed overlay at both ends with nothing to scroll. */
		max-height: 100%;
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: var(--space-unit) var(--padding-inline);
	}

	.overlay-heading {
		margin-bottom: var(--space-unit);
		color: var(--color-muted);
	}

	.overlay-list {
		margin: 0;
		padding: 0;
	}

	.overlay-cols {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(1.5rem, 5vw, 4rem);
	}

	.overlay-list li {
		margin-bottom: 0.25rem;
	}

	.overlay-list a,
	.overlay-jump,
	.overlay-length {
		display: inline-block;
		font-family: var(--font-heading);
		font-size: var(--step-0);
		font-weight: 500;
		color: var(--color-accent);
		text-decoration: none;
		background: transparent;
		border: none;
		padding: 0.4rem 0;
		cursor: pointer;
		text-align: start;

		&:hover {
			text-decoration: underline;
			text-underline-offset: 0.15em;
		}

	}

	@media (width <= 768px) {
		.overlay-cols {
			grid-template-columns: 1fr;
			gap: var(--space-unit);
		}
	}
</style>

<script>
	function initArchive() {
		// Bail on non-archive pages (this listener fires on every navigation).
		const root = document.getElementById("by-amne");
		if (!root) return;
		// Re-bind to non-null-typed locals so the closures below keep the type
		// (TS drops flow-narrowing across function boundaries).
		const byAmne: HTMLElement = root;
		const byYear = document.getElementById("by-year")!;
		const overlay = document.getElementById("filter-overlay")!;

		const ctrl = new AbortController();
		const { signal } = ctrl;

		// An explicit JS `behavior: "smooth"` is not reached by the CSS kill-switch.
		const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		// ---- Read-progress: value-shift each row in place (muted title + "läst"). ----
		function applyReadState() {
			for (const item of document.querySelectorAll<HTMLElement>(".archive-item[data-slug]")) {
				const slug = item.dataset.slug;
				if (!slug) continue;
				const pct = +(localStorage.getItem(`rp:${slug}`) || 0);
				item.toggleAttribute("data-read", pct > 0.85);
			}
		}

		// ---- Length filter (applied to both views) ----
		let lengthMin = 0;
		let lengthMax = 999;
		function applyLength() {
			for (const item of document.querySelectorAll<HTMLElement>(".archive-item[data-minutes]")) {
				const m = +(item.dataset.minutes || 0);
				item.toggleAttribute("data-filtered", m < lengthMin || m > lengthMax);
			}
			// Hide sections left empty.
			for (const section of document.querySelectorAll<HTMLElement>(".archive-section")) {
				const visible = section.querySelectorAll(".archive-item:not([data-filtered])").length;
				section.toggleAttribute("data-empty", visible === 0);
			}
		}

		// ---- Chronological toggle ----
		const sortBtn = document.querySelector<HTMLButtonElement>("[data-sort-toggle]");
		let chronological = false;
		function setView(chrono: boolean) {
			chronological = chrono;
			byYear.hidden = !chrono;
			byAmne.hidden = chrono;
			sortBtn?.setAttribute("aria-pressed", String(chrono));
			if (sortBtn) sortBtn.textContent = chrono ? "Efter ämne" : "Kronologiskt";
		}
		sortBtn?.addEventListener("click", () => setView(!chronological), { signal });

		// ---- Overlay ----
		let opener: HTMLButtonElement | null = null;
		function openOverlay(panel: string, btn: HTMLButtonElement | null) {
			for (const p of overlay.querySelectorAll<HTMLElement>(".overlay-panel"))
				p.hidden = p.dataset.panel !== panel;
			overlay.hidden = false;
			requestAnimationFrame(() => overlay.setAttribute("data-visible", ""));
			overlay.querySelector<HTMLElement>(".overlay-inner")?.scrollTo(0, 0);
			overlay.querySelector<HTMLElement>(".overlay-close")?.focus();
			opener = btn;
			btn?.setAttribute("aria-expanded", "true");
		}
		function closeOverlay() {
			overlay.removeAttribute("data-visible");
			const done = () => { overlay.hidden = true; };
			overlay.addEventListener("transitionend", done, { once: true });
			setTimeout(done, 250);
			opener?.setAttribute("aria-expanded", "false");
			// preventScroll: a jump handler closes the overlay and then scrolls to the
			// target — returning focus must not fight that.
			opener?.focus({ preventScroll: true });
			opener = null;
		}

		for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-overlay]"))
			btn.addEventListener("click", () => openOverlay(btn.dataset.overlay || "", btn), { signal });

		overlay.querySelector(".overlay-close")?.addEventListener("click", closeOverlay, { signal });
		overlay.addEventListener("click", (e) => { if (e.target === overlay) closeOverlay(); }, { signal });
		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && !overlay.hidden) closeOverlay();
		}, { signal });

		// Ämnen jump → scroll to the section (switching back to ämne view first).
		for (const btn of overlay.querySelectorAll<HTMLButtonElement>(".overlay-jump"))
			btn.addEventListener("click", () => {
				if (chronological) setView(false);
				closeOverlay();
				document.getElementById(btn.dataset.target || "")?.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "start" });
			}, { signal });

		// Längd buckets.
		for (const btn of overlay.querySelectorAll<HTMLButtonElement>(".overlay-length"))
			btn.addEventListener("click", () => {
				lengthMin = +(btn.dataset.min || 0);
				lengthMax = +(btn.dataset.max || 999);
				applyLength();
				closeOverlay();
			}, { signal });

		applyReadState();

		document.addEventListener("astro:before-swap", () => ctrl.abort(), { once: true });
	}

	document.addEventListener("astro:page-load", initArchive);
	window.addEventListener("pageshow", (e) => {
		if ((e as PageTransitionEvent).persisted) initArchive();
	});
</script>
