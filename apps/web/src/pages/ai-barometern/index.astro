---
import AgreementMatrix from "../../components/ai-barometern/AgreementMatrix.astro";
import AnswerChip from "../../components/ai-barometern/AnswerChip.astro";
import ReportFinding from "../../components/ai-barometern/ReportFinding.astro";
import DisclosureLinks from "../../components/ai-barometern/DisclosureLinks.astro";
import ModelLogo from "../../components/ai-barometern/ModelLogo.astro";
import ModelShifts from "../../components/ai-barometern/ModelShifts.astro";
import MoreSection from "../../components/ai-barometern/MoreSection.astro";
import PartyGrid from "../../components/ai-barometern/PartyGrid.astro";
import ScaleLegend from "../../components/ai-barometern/ScaleLegend.astro";
import StanceShare from "../../components/ai-barometern/StanceShare.astro";
import TwinOverview from "../../components/ai-barometern/TwinOverview.astro";
import CollectionIndexPage from "../../components/CollectionIndexPage.astro";
import SectionLink from "../../components/SectionLink.astro";
import TitledSection from "../../components/TitledSection.astro";
import { FAMILIES } from "../../lib/ai-barometern/families";
import { latestFindings, stanceSpread } from "../../lib/ai-barometern/findings";
import { activeQuestions } from "../../lib/ai-barometern/questions";
import {
	familyLabel,
	familyReleases,
	familyShifts,
	HUB_SECTIONS,
	hasComparison,
	latestIndexOf,
	latestRun,
	METHOD_PATH,
	modelPath,
	matrixAreas,
	modelShortName,
	partyRows,
	questionPath,
	roster,
	scaleRow,
	shownData,
	stanceShares,
	svDate,
	svDateList,
	svDateRange,
	topChanges,
	twinRow,
} from "../../lib/ai-barometern/site";
import { describeRow, svJoin } from "../../lib/ai-barometern/summary";
import { TWIN_SETS } from "../../lib/ai-barometern/twins";
import { talord } from "../../lib/format";
import { collectionPageJsonLd, dataset } from "../../lib/jsonld";
import { RITNINGAR } from "../../lib/ritningar";
import "../../styles/ai-barometern-chips.css";
import "../../styles/ai-barometern.css";
import "../../styles/ai-barometern-report.css";

// A guided report, followed by the complete question bank and supporting analyses.
const run = latestRun();
const shown = shownData();
const shownDates = svDateList(shown.runs.map((r) => r.date));
const severalRuns = shown.runs.length > 1;
const count = new Intl.NumberFormat("sv-SE");

const description =
	"Vad svarar ChatGPT, Claude, Gemini, Grok och DeepSeek om klimatet, AI:s risker, kriget i Gaza, politiken och tron? AI-barometern ställer samma frågor till modellerna varje månad och visar hur svaren förändras.";
const lead =
	"Hur svarar AI-modellerna på frågor om klimat, krig, politik och tro? Vi ställer samma frågor till fem modellfamiljer och jämför svaren, mätning för mätning.";

const source = run
	? `Källa: AI-barometern, ${severalRuns ? "mätningarna" : "mätningen"} ${shownDates}. Varje modell fick varje fråga ${talord(run.samples)} gånger.`
	: "";

// The month's news: which families answered with a new model, and what moved. A family that
// switched model compares two models, so the lead names them before any number does.
const changes = topChanges(8);
const shifts = familyShifts();
const switchedLabels = shifts.rows.filter((r) => r.switched).map((r) => r.family.label);
const keptLabels = shifts.rows.filter((r) => !r.switched).map((r) => r.family.label);
const sinceText = shifts.since.length
	? `${shifts.since.length > 1 ? "mätningarna" : "mätningen"} ${svDateList(shifts.since)}`
	: "förra mätningen";
const shiftsLead =
	switchedLabels.length === 0
		? `Alla fem modellerna är desamma som vid ${sinceText}.`
		: `Sedan ${sinceText} har ${svJoin(switchedLabels)} fått ${switchedLabels.length > 1 ? "nya modeller" : "en ny modell"}, så där jämförs två modeller med varandra.${keptLabels.length ? ` ${svJoin(keptLabels)} svarar med samma ${keptLabels.length > 1 ? "modeller" : "modell"} som då.` : ""}`;
const movedTotal = shifts.rows.reduce((n, r) => n + r.moved, 0);

const areas = matrixAreas();
const shares = stanceShares(areas);
const spread = stanceSpread(shares);

const twinRows = TWIN_SETS.map(twinRow);
const hubFindings = latestFindings();
// The company sets are the ringed diagonal in the matrix; the overview keeps to countries,
// peoples, religions and principles.
const overviewRows = twinRows.filter((row) => !row.members.every((m) => m.question.aboutFamily));
// The closed comparisons section says in its summary how often each model answered differently.
const measuredOverview = overviewRows.filter((row) => row.members.every((m) => m.measured));
const twinsHint = `${measuredOverview.length} jämförelser där ett land, en grupp eller ett fall byts ut.`;

// What the models themselves answer about their reliability on religion, for the section on
// why the site asks them at all.
const reliability = activeQuestions().find((q) => q.id === "ai-religiosa-svar");
const reliabilityAnswer =
	reliability && latestIndexOf(reliability) >= 0 ? describeRow(scaleRow(reliability)) : "";
const reliabilityClause = reliabilityAnswer.startsWith("Alla ")
	? `a${reliabilityAnswer.slice(1)}`
	: reliabilityAnswer;
---

<CollectionIndexPage
	title="AI-barometern"
	ritning={RITNINGAR.barometernBred}
	pageTitle="AI-barometern: så svarar AI-modellerna – islam.se"
	description={description}
	lead={lead}
	ogImageAlt="AI-barometern – islam.se"
	mainClass="abm abm-hub home"
	jsonLd={[
		collectionPageJsonLd({ name: "AI-barometern", description, url: "/ai-barometern/", essays: [] }),
		dataset({
			name: "AI-barometern",
			description:
				"Svar från ChatGPT, Claude, Gemini, Grok och DeepSeek på samma frågor om klimat, teknik, ekonomi, krig och folkrätt, politik och religion, insamlade vid återkommande mätningar.",
			url: "/ai-barometern/",
			creator: ["islam.se"],
			spatialCoverage: "Sverige",
		}),
	]}
>
	{/* The measurement's line belongs to the opening, so the section's drawing is as
	    tall as title, ingress and this line together (PageHead). */}
	{
		run ? (
			<p class="meta-line" slot="efter">
				{severalRuns ? "Mätningarna" : "Senaste mätningen"} {shownDates}&nbsp;· {FAMILIES.length}
				&nbsp;modeller&nbsp;· {count.format(shown.questions)}&nbsp;frågor&nbsp;· <a href={METHOD_PATH}>Så går mätningen till</a>
			</p>
		) : (
			<p class="meta-line" slot="efter">
				Den första mätningen har ännu inte publicerats. Frågorna och{" "}
				<a href={METHOD_PATH}>metoden</a> finns redan på sidan.
			</p>
		)
	}

	{run && <p class="abm-report-context">Varje fråga upprepas flera gånger i nya konversationer. Svaren kan variera. Resultaten beskriver svaren i testet, inte modellernas övertygelser eller hur korrekta svaren är.</p>}
	<nav class="abm-report-nav" aria-label="På denna sida">
		<a href={`#${HUB_SECTIONS.findings}`}>Resultat i korthet</a>
		<a href={`#${HUB_SECTIONS.matrix}`}>Fråga för fråga</a>
		{hasComparison() && <a href={`#${HUB_SECTIONS.changes}`}>Sedan förra mätningen</a>}
		<a href={METHOD_PATH}>Metod och data</a>
	</nav>
	{hubFindings.length > 0 && (
		<TitledSection id={HUB_SECTIONS.findings} title="Resultat i korthet">
			<div class="abm-report-findings">
				{hubFindings.slice(0, 3).map((finding) => <ReportFinding finding={finding} />)}
			</div>
			{hubFindings.length > 3 && <details class="abm-extra-findings"><summary>Fler resultat</summary>{hubFindings.slice(3).map((finding) => <ReportFinding finding={finding} />)}</details>}
			<p class="abm-findings-note">Resultaten väljs automatiskt ur mätningen och uppdateras när svaren ändras. {source} <a href={METHOD_PATH}>Läs om urval och begränsningar</a>.</p>
		</TitledSection>
	)}

	{
		run && (
			<TitledSection id={HUB_SECTIONS.matrix} title="Fråga för fråga">
				<p>
					Välj ett ämne för att jämföra svaren. Varje påstående har en egen sida med alla svar och modellernas motiveringar.
				</p>
				<AgreementMatrix
					areas={areas}
					caption="Sammanfattade svar. Öppna en svarsruta för fördelningen mellan de upprepade svaren. Sista raden räknar de påståenden där modellen tog ställning."
					source={source}
				/>
			</TitledSection>
		)
	}

	{
		hasComparison() && (
			<TitledSection id={HUB_SECTIONS.changes} title="Sedan förra mätningen">
				<p>{shiftsLead}</p>
				<ModelShifts
					rows={shifts.rows}
					caption="Påståenden där modellen gick från en ställning till en annan, och hur många påståenden den tog ställning till förra gången och nu. Avstår räknas inte som en ställning."
					source={`Källa: AI-barometern, ${sinceText} och ${svDate(run?.date ?? "")}.`}
				/>
				{changes.length > 0 ? (
					<>
						<h3 class="abm-subhead">Största förändringarna</h3>
						<ScaleLegend cells={changes.flatMap((c) => [c.fromCell, c.toCell])} compact />
						<ul class="abm-changes abm-changes--chips">
							{changes.map((c) => (
								<li>
									<span class="abm-rowmodel">
										<ModelLogo family={c.family} />
										{familyLabel(c.family)}
									</span>
									<span class="abm-change-chips">
										<AnswerChip cell={c.fromCell} small />
										<span aria-hidden="true">→</span>
										<span class="sr-only">blev</span>
										<AnswerChip cell={c.toCell} small />
									</span>
									<a href={questionPath(c.question)}>{c.question.short}</a>
									<span class="abm-change-flags">
										{c.modelChanged && <span class="label">ny modell</span>}
										{!c.significant && <span class="label">osäker</span>}
									</span>
								</li>
							))}
						</ul>
						{movedTotal > changes.length && (
							<p class="abm-findings-note">
								{changes.length} av {movedTotal} ändrade ställningar. Osäker betyder att de upprepade svaren
								överlappar mellan mätningarna. Alla förändringar syns i diagrammet på varje påståendes sida.
							</p>
						)}
					</>
				) : (
					<p>Ingen modell har ändrat ställning sedan förra mätningen.</p>
				)}
			</TitledSection>
		)
	}

	{
		run && (
			<MoreSection id={HUB_SECTIONS.party} title="Partivalet" hint="Vilka partier modellerna rekommenderade, och när de avstod.">
				<p>
					Modellerna fick välja ett riksdagsparti att rekommendera, eller avstå. Partierna listades
					i slumpvis ordning varje gång.
				</p>
				<PartyGrid
					rows={partyRows()}
					caption="Det parti modellen rekommenderade. Den fyllda bokstaven valdes i flest av de tre svaren."
					source={source}
				/>
			</MoreSection>
		)
	}

	{/* Secondary: opened when the findings and the answers raise a question. Each keeps its heading
	    and one line on what it holds, so the three closed sections still say what is inside. */}
	<div class="abm-more-group">
		{
			run && overviewRows.length > 0 && (
				<MoreSection id={HUB_SECTIONS.twins} title="Samma påstående, olika svar" hint={twinsHint}>
					<p>
						Många påståenden ställs i par eller grupper där bara landet, folket eller religionen byts ut,
						eller där en allmän princip prövas mot ett fall av den. Rutan visar om modellen svarade
						likadant, och raden leder till jämförelsen med modellernas svar.
					</p>
					<TwinOverview
						rows={overviewRows}
						caption="Om modellen gav samma svar på jämförelsens påståenden. Sista raden räknar de jämförelser där modellen svarade olika."
						source={source}
					/>
				</MoreSection>
			)
		}
		{
			run && (
				<MoreSection
					id={HUB_SECTIONS.stance}
					title="Vem tar ställning?"
					hint={spread ?? "Hur ofta varje modell tar ställning, område för område."}
				>
					<p>
						Varje påstående kan besvaras med »Avstår«, och modellerna använder det mycket olika. Siffran
						är antalet påståenden där modellen tog ställning, och stapeln visar hur stor del av
						områdets påståenden det är.
					</p>
					<StanceShare
						shares={shares}
						caption="Antal påståenden där modellen tog ställning, per område."
						source={source}
					/>
				</MoreSection>
			)
		}
		<MoreSection
			id={HUB_SECTIONS.why}
			title="Varför islam.se frågar AI-modellerna"
			hint="AI som källa till kunskap, och vad Koranen säger om att pröva det man hör."
		>
			<p>
				Var tionde svensk har under det senaste året skrivit med en AI-tjänst om politik och
				samhällsfrågor, enligt{" "}
				<a href="https://svenskarnaochinternet.se/rapporter/svenskarna-och-internet-valspecial-2026/ai-i-politiken/"
					>Internetstiftelsen</a
				>. Samma tjänster får frågor om tro, om Koranen och om vad som är rätt och fel.
			</p>
			<p>
				Koranen befaller den som inte vet att fråga dem som har kunskap (16:43) och de troende att
				utreda en nyhet innan de handlar efter den (49:6). AI-barometern prövar modellerna på det
				sättet: samma frågor, ställda likadant varje gång, med varje svar sparat. Där en fråga rör en
				religiös bestämmelse står den klassiska hållningen, som de lärda har formulerat den utifrån
				Koranen och sunna, sist på frågans sida.
			</p>
			{
				reliability && reliabilityClause && (
					<p>
						Modellerna har också fått påståendet{" "}
						<a href={questionPath(reliability)}>»{reliability.text.replace(/\.$/, "")}«</a>:{" "}
						{reliabilityClause}
					</p>
				)
			}
		</MoreSection>
	</div>

	<TitledSection id={HUB_SECTIONS.models} title="Modellerna">
		<p>
			Varje modellfamilj representeras av sin aktuella huvudmodell, inte av de dyraste
			specialversionerna. Före varje mätning kontrolleras vilka modeller som har släppts, och ett
			modellbyte markeras i diagrammen.
		</p>
		<dl class="abm-roster">
			{
				roster().map(({ family, current }) => (
					<div>
						<dt>
							<span class="abm-rowmodel">
								<ModelLogo family={family.key} />
								{family.label}
							</span>
						</dt>
						<dd>
							{current ? (
								<>
									{modelShortName(current.name)}
									<span class="abm-model">
										{current.id}, används sedan {svDate(current.adoptedAt)}
									</span>
									{familyReleases(family.key).previous.map((p) => (
										<span class="abm-model">
											Ersatte {modelShortName(p.name)}, som användes {svDateRange(p.adoptedAt, p.retiredAt ?? current.adoptedAt)}
										</span>
									))}
									{familyReleases(family.key).passed.length > 0 && (
										<span class="abm-model">
											Släppt men inte använd: {svJoin(familyReleases(family.key).passed.map((r) => modelShortName(r.name)))}
										</span>
									)}
									<a class="abm-model-link" href={modelPath(family.key)}>
										Alla svar från {family.label}
									</a>
								</>
							) : (
								"Ingen modell vald"
							)}
						</dd>
					</div>
				))
			}
		</dl>
	</TitledSection>

	<p class="abm-note">
		Svaren är modellernas egna och återges som de lämnades. Där en fråga rör en religiös
		bestämmelse redovisar islam.se den klassiska hållningen på frågans egen sida.
	</p>
	<p class="abm-note">Totalt {count.format(shown.answers)} insamlade svar i de visade mätningarna. <a href={METHOD_PATH}>Mätningar och nedladdningsbara data</a>.</p>
	<DisclosureLinks />
	<p class="collection-back"><SectionLink href={METHOD_PATH}>Så går mätningen till</SectionLink></p>
</CollectionIndexPage>
