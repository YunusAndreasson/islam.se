---
import Base from "../layouts/Base.astro";
import EssayImage from "../components/EssayImage.astro";
import PodcastSubscribeLinks from "../components/PodcastSubscribeLinks.astro";
import { formatDate, getArticles } from "../lib/articles";
import { SITE_URL } from "../lib/config";
import { breadcrumbList, ORG_ID } from "../lib/jsonld";
import {
	APPLE_PODCAST_URL,
	PODCAST_COVER,
	PODCAST_DESCRIPTION,
	PODCAST_FEED,
	SPOTIFY_SHOW_URL,
} from "../lib/podcast";
import { CHIP_WIDTHS } from "../lib/hero";

const SITE = SITE_URL;

// Episodes are the essays that have been read aloud — the audio lives on the
// essay page (where the word-by-word player is), so each episode links there.
const articles = await getArticles();
const episodes = articles.filter(
	(a): a is typeof a & { audioFile: string } => typeof a.audioFile === "string",
);

// itunes:duration is raw seconds; readers only need a rough length.
function formatDuration(seconds?: number): string | null {
	if (!seconds) return null;
	const min = Math.round(seconds / 60);
	return `${min} min`;
}

const description =
	"islam.se: andliga essäer — podden där varje essä läses som ett samtal. Lyssna i Apple Podcasts, Spotify eller via RSS.";
---

<Base
	title="Podd — andliga essäer från islam.se"
	description={description}
	jsonLd={[
		{
			"@context": "https://schema.org",
			"@type": "PodcastSeries",
			"@id": `${SITE}/podcast#series`,
			name: "islam.se: andliga essäer",
			description: PODCAST_DESCRIPTION,
			url: `${SITE}/podcast`,
			inLanguage: "sv",
			image: `${SITE}${PODCAST_COVER}`,
			webFeed: `${SITE}${PODCAST_FEED}`,
			publisher: { "@id": ORG_ID },
			sameAs: [APPLE_PODCAST_URL, SPOTIFY_SHOW_URL],
		},
		breadcrumbList([
			{ name: "Hem", url: "/" },
			{ name: "Podd", url: "/podcast" },
		]),
	]}
>
	<main id="main" class="home podcast-page">
		<header class="podcast-hero">
			<div class="podcast-hero-text">
				<h1>Andliga essäer</h1>
				<p class="lead podcast-lead">{PODCAST_DESCRIPTION}</p>
				<PodcastSubscribeLinks class="podcast-subscribe" actionClass="podcast-action" iconSize={15} includeFeed />
			</div>
		</header>

		<section class="podcast-episodes" aria-labelledby="episodes-heading">
			<h2 id="episodes-heading" class="podcast-episodes-heading label">
				<span class="podcast-episodes-count">{episodes.length}</span> avsnitt
			</h2>
			<ol class="podcast-list">
				{episodes.map((ep, i) => {
					const duration = formatDuration(ep.audioDuration);
					return (
						<li class="podcast-item">
							<a class="podcast-item-link" href={`/${ep.slug}/`}>
								<span class="podcast-item-art media-frame media-frame--sm">
									{ep.heroImage ? (
										<EssayImage article={ep} alt="" widths={CHIP_WIDTHS} sizes="6rem" />
									) : (
										<span class="podcast-item-num" aria-hidden="true">{episodes.length - i}</span>
									)}
								</span>
								<span class="podcast-item-body">
									<span class="podcast-item-title">{ep.title}</span>
									<span class="podcast-item-desc">{ep.description}</span>
									<span class="podcast-item-meta label">
										<span>Avsnitt {episodes.length - i}</span>
										<span class="nav-dot" aria-hidden="true">&middot;</span>
										<time datetime={ep.publishedAt}>{formatDate(ep.publishedAt)}</time>
										{duration && <span class="nav-dot" aria-hidden="true">&middot;</span>}
										{duration && <span>{duration}</span>}
									</span>
								</span>
							</a>
						</li>
					);
				})}
			</ol>
		</section>

		<p class="podcast-note">
			Avsnitten är essäerna inlästa – läs dem i stället på <a href="/essaer/">essäsidan</a>, eller
			klistra in <a href={PODCAST_FEED}>RSS-flödet</a> i valfri poddspelare.
		</p>
	</main>
</Base>

<style>
	.podcast-page {
		margin-block: var(--space-phi);
	}

	/* ---- Hero: show identity. The cover tile that used to sit here was the site's own
	   wordmark glyph on a white square — it repeated the mast mark 40 px above it, on the
	   one white surface of a warm-cream page, and it was the only such tile on any
	   top-menu page. The art the page was missing belongs to the episodes; it is in the
	   list below now. PODCAST_COVER is still shipped to the feed and the JSON-LD, which
	   is where Apple and Spotify actually require it. ---- */
	.podcast-hero-text h1 {
		margin: var(--space-half) 0 0;
	}

	.podcast-lead {
		--lead-measure: 40rem;
		--lead-margin: var(--space-unit) 0 0;
	}

	.podcast-subscribe {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: var(--space-unit);
	}

	/* RSS is the quieter, technical option — muted until hovered. */
	.podcast-action--feed {
		color: var(--color-muted);
	}

	/* ---- Episode list ---- */
	.podcast-episodes {
		margin-top: var(--space-phi);
	}

	.podcast-episodes-heading {
		display: flex;
		align-items: baseline;
		gap: 0.5ch;
		margin: 0 0 var(--space-unit);
		padding-bottom: var(--space-half);
		border-bottom: 1px solid var(--color-rule);
	}

	.podcast-episodes-count {
		color: var(--color-muted);
	}

	/* Widened to the shared 64rem canvas (so the top-menu page width never jumps);
	   the episode list flows as a two-column index on the wide canvas, one column
	   on a phone — each row carries a bottom hairline (matches the Essäer archive),
	   so the columns read as one even grid rather than offset border-top pairs. */
	.podcast-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 26rem), 1fr));
		column-gap: clamp(1.75rem, 4vw, 3.5rem);
	}

	.podcast-item {
		border-bottom: 1px solid var(--color-divider);
	}

	.podcast-item-link {
		display: grid;
		grid-template-columns: 6rem 1fr;
		gap: 1.25rem;
		padding: var(--space-unit) 0.4rem;
		margin-inline: -0.4rem;
		border-radius: 8px;
		text-decoration: none;
		color: inherit;
		transition: background-color 0.15s;

		&:hover {
			background: color-mix(in srgb, var(--color-warm) 9%, transparent);
			text-decoration: none;
		}

	}

	/* The episode's own art, square like a podcast app's row. Essays without a hero
	   fall back to the ordinal in the same box, so the column never collapses and the
	   two-column grid stays even. */
	.podcast-item-art {
		display: grid;
		place-items: center;
		aspect-ratio: 1 / 1;
		overflow: hidden;
	}

	/* EssayImage renders a <picture>; without stretching that too the img fills only
	   its intrinsic box and the frame's warm backdrop shows as a band above the photo. */
	.podcast-item-art :global(picture) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.podcast-item-art :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.podcast-item-num {
		font-family: var(--font-heading);
		font-size: var(--step-1-sans);
		/* 300 was the site's only Light weight outside the book-cover artwork — one
		   number in one list, carrying a weight nothing else uses. Muted colour
		   already makes it recede. */
		font-weight: 400;
		color: var(--color-muted);
		font-variant-numeric: tabular-nums;
	}

	.podcast-item-title {
		display: block;
		font-family: var(--font-heading);
		font-size: var(--step-0);
		font-weight: 600;
		line-height: 1.25;
		color: var(--color-accent);
	}

	.podcast-item-desc {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		font-family: var(--font-body);
		font-size: var(--step--2);
		line-height: 1.5;
		color: var(--text-quiet);
		margin-top: 0.3rem;
	}

	.podcast-item-meta {
		display: flex;
		align-items: center;
		gap: 0.5ch;
		margin-top: 0.5rem;
		color: var(--color-muted);
	}

	/* No border-top: every episode row already ends in a hairline and the footer opens
	   with its own, so a rule here put three lines in one band — and this one stopped at
	   the 42 rem measure while the others ran the full canvas, which is what made it read
	   as a stray. `text-wrap: pretty` keeps the last line off a single orphaned word. */
	.podcast-note {
		font-family: var(--font-body);
		font-size: var(--step--2);
		color: var(--color-muted);
		max-width: var(--content-width);
		margin: var(--space-phi) 0 0;
		text-wrap: pretty;
	}

	.podcast-note a {
		color: var(--color-accent);
	}

	@media (width <= 640px) {
		.podcast-hero {
			grid-template-columns: 1fr;
			justify-items: start;
			gap: var(--space-unit);
		}

		.podcast-item-link {
			grid-template-columns: 4.5rem 1fr;
			gap: 0.75rem;
		}
	}
</style>
