---
import CollectionIndexPage from "../components/CollectionIndexPage.astro";
import PodcastSubscribeLinks from "../components/PodcastSubscribeLinks.astro";
import TextRowList from "../components/TextRowList.astro";
import { formatDate, getArticles } from "../lib/articles";
import { SITE_URL } from "../lib/config";
import { CHIP_WIDTHS } from "../lib/hero";
import { breadcrumbList, ORG_ID } from "../lib/jsonld";
import {
	APPLE_PODCAST_URL,
	PODCAST_COVER,
	PODCAST_DESCRIPTION,
	PODCAST_FEED,
	SPOTIFY_SHOW_URL,
} from "../lib/podcast";

const SITE = SITE_URL;

// Episodes are the essays that have been read aloud — the audio lives on the
// essay page (where the word-by-word player is), so each episode links there.
const articles = await getArticles();
const episodes = articles.filter(
	(a): a is typeof a & { audioFile: string } => typeof a.audioFile === "string",
);

// itunes:duration is raw seconds; readers only need a rough length.
function formatDuration(seconds?: number): string | null {
	if (!seconds) return null;
	const min = Math.round(seconds / 60);
	return `${min} min`;
}

// One row per episode, in the shape /fordjupning/ already renders: picture, title,
// deck, quiet meta line. `episodes` is newest-first, so the ordinal counts down.
//
// The meta line is one string rather than the three spans it used to be. That costs
// a <time datetime> the page never used — the machine-readable episode data is in
// podcast.xml.ts, which is what Apple and Spotify actually read — and it buys the
// row list, which is the point.
const episodeRows = episodes.map((ep, i) => ({
	href: `/${ep.slug}/`,
	title: ep.title,
	description: ep.description,
	// No duration here any more — it is the play button's label, which is where a
	// listener actually weighs it: attached to the control that spends it.
	meta: `Avsnitt ${episodes.length - i} · ${formatDate(ep.publishedAt)}`,
	image: ep.heroImage ? { article: ep, widths: CHIP_WIDTHS, sizes: "192px" } : null,
	// The row plays where it stands. Same src/title/artwork contract the essay page's
	// "Lyssna" pill uses, so the floating player treats a row exactly as it treats that
	// button — including the saved position, which means starting an episode here
	// resumes where the reader left it on the essay page, and vice versa.
	audio: {
		src: `/audio/${ep.audioFile}`,
		title: ep.title,
		...(ep.heroImage ? { artwork: ep.heroImage.src } : {}),
		// The duration IS the button. An essay with no measured audio falls back to
		// AudioPlayer's own "Lyssna".
		...(formatDuration(ep.audioDuration) ? { label: formatDuration(ep.audioDuration)! } : {}),
	},
}));

const description =
	"islam.se: andliga essäer – podden där varje essä läses som ett samtal. Lyssna i Apple Podcasts, Spotify eller via RSS.";
---

{/* The page is composed entirely from the shared index primitives now — PageHead via
    CollectionIndexPage for the top, TextRowList for the episodes — so it opens and
    reads like /fordjupning/ and /svar/ rather than approximating them.

    What it used to be, and why none of it survived: a hand-rolled <Base> with its own
    `.podcast-hero`, its own h1 margin and a `.podcast-lead` that was a full scale step
    SMALLER and 6rem WIDER than every other index ingress on the site. layout.css names
    `.podcast-lead` in its list of the fourteen lead classes that had drifted apart; this
    was the last one still standing outside the family. The hero also carried a media
    query setting `grid-template-columns` on an element that had not been a grid since
    the cover tile was removed. */}
<CollectionIndexPage
	title="Andliga essäer"
	pageTitle="Podd — andliga essäer från islam.se"
	description={description}
	lead={PODCAST_DESCRIPTION}
	jsonLd={[
		{
			"@context": "https://schema.org",
			"@type": "PodcastSeries",
			"@id": `${SITE}/podcast#series`,
			name: "islam.se: andliga essäer",
			description: PODCAST_DESCRIPTION,
			url: `${SITE}/podcast`,
			inLanguage: "sv",
			image: `${SITE}${PODCAST_COVER}`,
			webFeed: `${SITE}${PODCAST_FEED}`,
			publisher: { "@id": ORG_ID },
			sameAs: [APPLE_PODCAST_URL, SPOTIFY_SHOW_URL],
		},
		breadcrumbList([
			{ name: "Hem", url: "/" },
			{ name: "Podd", url: "/podcast" },
		]),
	]}
>
	{/* The action row, at the rung Essäer's filter pills occupy — first thing under the
	    ingress. No wrapper class: the row layout is the component's own now (it has to
	    be — see PodcastSubscribeLinks), and the space beneath it is carried by the count
	    below, which this page does author. */}
	<PodcastSubscribeLinks actionClass="podcast-action" iconSize={15} includeFeed />

	{/* The count as the shared `.collection-count`, the same quiet label the essay
	    collections carry. It used to be an <h2> with a rule under it, which put a third
	    hairline into a band where the list already draws one between every row — and
	    made the episode titles h2s under an h2, a flat outline for no gain. The titles
	    are the headings now, exactly as on /fordjupning/. */}
	<p class="label collection-count podcast-count">{episodes.length} avsnitt</p>

	{/* One column, not two, and every row plays. The old grid cut each row to a 26rem track, which is what
	    made the page feel tight: a 96px square, a title a step below the site's list
	    rank, and a deck clamped to two lines a step below that. At the full canvas the
	    row gets the family's own ranks — --step-1-sans title, --step--1 deck, unclamped —
	    and the deck arrives whole. Ten episodes is a short page either way.

	    The art is 3:2 at 12rem — the site's one crop, at the presence a row this tall
	    can hold. It was 120px and square for a while; see TextRowList for why neither
	    survived. */}
	<TextRowList
		class="podcast-list"
		aria-label="Avsnitt"
		items={episodeRows}
		style="--text-row-list-margin: var(--space-half) 0 0; --text-row-media-separator: 1px solid var(--color-rule); --text-row-media-separator-padding: var(--space-unit); --text-row-thumb-width: 12rem; --text-row-meta-margin: var(--space-half)"
	/>

	<p class="podcast-note">
		Avsnitten är essäerna inlästa – läs dem i stället på <a href="/essaer/">essäsidan</a>, eller
		klistra in <a href={PODCAST_FEED}>RSS-flödet</a> i valfri poddspelare.
	</p>
</CollectionIndexPage>

<style>
	/* The count carries the space between the action row and the list, rather than the
	   action row carrying it beneath itself. Not a preference — a scoped rule on the
	   pills' wrapper cannot reach it (PodcastSubscribeLinks owns that element), and the
	   page's old `.podcast-subscribe { margin-top: var(--space-phi) }` had in fact never
	   applied for exactly that reason. This <p> is the page's own, so this works.

	   φ above, half below: the label belongs to the list it counts, not to the pills. */
	.podcast-count {
		margin-top: var(--space-phi);
	}

	/* No border-top: every episode row already ends in a hairline and the footer opens
	   with its own, so a rule here put three lines in one band — and this one stopped at
	   the 42 rem measure while the others ran the full canvas, which is what made it read
	   as a stray. `text-wrap: pretty` keeps the last line off a single orphaned word. */
	.podcast-note {
		font-family: var(--font-body);
		font-size: var(--step--2);
		color: var(--color-muted);
		max-width: var(--content-width);
		margin: var(--space-phi) 0 0;
		text-wrap: pretty;
	}

	.podcast-note a {
		color: var(--color-accent);
	}
</style>
