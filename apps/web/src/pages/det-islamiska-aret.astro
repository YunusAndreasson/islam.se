---
// Det islamiska året — the dedicated, indexable home for the calendar that
// otherwise lives only as a homepage section (§7.9). The full upcoming year(s),
// not the homepage's top five, each carrying Event JSON-LD so the dates are
// machine-readable for search and calendar tools.
//
// Caveat on the structured data: these are global observances with no venue,
// performer, or tickets, so even with a VirtualLocation (see eventLd below) they
// won't earn full Event rich-result cards — Google reserves those for ticketed,
// located events. The primary win is this indexable, well-headed page ranking for
// date queries ("ramadan 2026 datum", "eid 2026"); the Event markup is supporting
// structure (and now passes validation — the location field was the critical gap).
import CollectionIndexPage from "../components/CollectionIndexPage.astro";
import DefinitionList from "../components/DefinitionList.astro";
import MarkesdagList from "../components/MarkesdagList.astro";
import TitledSection from "../components/TitledSection.astro";
import { fastRows } from "../lib/fastelangd";
import { breadcrumbList, faqPageJsonLd } from "../lib/jsonld";
import { RITNINGAR } from "../lib/ritningar";
import {
	type Markesdag,
	getUpcomingMarkesdagar,
	gregorian,
	gregorianShort,
} from "../lib/markesdagar";

const events = getUpcomingMarkesdagar();

// Group by Hijri year so the long list reads as "the year", with a Gregorian
// span beside each heading for readers who think in the civil calendar.
interface YearGroup {
	hijriYear: number;
	gregSpan: string;
	rows: (Markesdag & { gregorian: string })[];
}
const rows = events.map((e) => ({ ...e, gregorian: gregorian(e.startISO, e.endISO) }));
const groups: YearGroup[] = [...Map.groupBy(rows, (r) => r.hijriYear).entries()].map(
	([hijriYear, rows]) => {
		const years = rows.flatMap((r) => [r.startISO, r.endISO ?? r.startISO]).map((d) => d.slice(0, 4));
		const lo = years.reduce((a, b) => (a < b ? a : b));
		const hi = years.reduce((a, b) => (a > b ? a : b));
		return { hijriYear, gregSpan: lo === hi ? lo : `${lo}–${hi}`, rows };
	},
);

// These are worldwide religious observances with no physical venue. Google's
// Event type requires `location`, so we declare an OnlineEventAttendanceMode +
// VirtualLocation pointing at this canonical calendar page — honest (no invented
// address) and it clears the critical "Missing location" error. performer/offers/
// organizer are deliberately omitted: a date observance has no performer, no
// tickets, and no single organizer — faking them would be dishonest, and those
// are non-critical warnings that don't affect validity.
const CALENDAR_URL = "https://islam.se/det-islamiska-aret/";
const eventLd = events.map((e) => ({
	"@context": "https://schema.org",
	"@type": "Event",
	name: e.name,
	startDate: e.startISO,
	...(e.endISO ? { endDate: e.endISO } : {}),
	eventStatus: "https://schema.org/EventScheduled",
	eventAttendanceMode: "https://schema.org/OnlineEventAttendanceMode",
	location: { "@type": "VirtualLocation", url: CALENDAR_URL },
	image: "https://islam.se/og-default.png",
	...(e.note ? { description: e.note } : {}),
	url: CALENDAR_URL,
	inLanguage: "sv",
}));

// Answer-first dates for the queries AI engines get most ("när är ramadan <år>").
// `events` is already filtered to upcoming, so find() returns the next occurrence.
const nextOf = (n: string) => events.find((e) => e.name === n);
const ramadan = nextOf("Ramadan");
const eidFitr = nextOf("Eid al-fitr");
const eidAdha = nextOf("Eid al-adha");

const dateFaq: { q: string; a: string }[] = [];
if (ramadan)
	dateFaq.push({
		q: `När är ramadan ${ramadan.startISO.slice(0, 4)}?`,
		a: `Ramadan ${ramadan.hijriYear} e.H. infaller ${gregorian(ramadan.startISO, ramadan.endISO)} enligt Umm al-Qura-kalendern. Den exakta första dagen bekräftas genom månsiktning och kan skilja sig en dag.`,
	});
if (eidFitr)
	dateFaq.push({
		q: `När är Eid al-fitr ${eidFitr.startISO.slice(0, 4)}?`,
		a: `Eid al-fitr infaller omkring ${gregorian(eidFitr.startISO)} (1 Shawwāl) enligt Umm al-Qura-kalendern; den fastställs slutligen genom månsiktning.`,
	});
if (eidAdha)
	dateFaq.push({
		q: `När är Eid al-adha ${eidAdha.startISO.slice(0, 4)}?`,
		a: `Eid al-adha infaller omkring ${gregorian(eidAdha.startISO)} (10 Dhū al-ḥijja) enligt Umm al-Qura-kalendern.`,
	});

// Dates only. It sits straight under the lead, which already says the dates follow
// Umm al-Qura and can move a day with the moon; closing on that again read the same
// sentence twice in two paragraphs. The FAQ answers above keep it for the JSON-LD.
const leadSummary =
	ramadan && eidFitr && eidAdha
		? `Nästa ramadan börjar omkring ${gregorian(ramadan.startISO)}, Eid al-fitr infaller omkring ${gregorian(eidFitr.startISO)} och Eid al-adha omkring ${gregorian(eidAdha.startISO)}.`
		: "";

const faqLd = dateFaq.length > 0 ? [faqPageJsonLd(dateFaq)] : [];

// The whole SEO argument for this page. "ramadan <år>" is a known-answer query:
// Google prints the date in the result list. From 2026-08-15 to 2026-09-24 the
// title carried the full answer (start, end, Eid) on the theory that it bought
// exact-match relevance at no cost. Measured, it cost the click: »när är ramadan
// 2027« converted 3 of 1 080 impressions at position 3, 27 Aug–23 Sep. So the
// title keeps only the start date, enough for relevance, and promises the one
// thing no date snippet can compute: how long the fast is where the reader lives.
// The section below has to deliver that immediately, or the click bounces back.
const ramadanYear = ramadan?.startISO.slice(0, 4);
const fast = ramadan ? fastRows(ramadan.startISO, ramadan.endISO ?? ramadan.startISO) : [];
const fastSouth = fast[0];
const fastNorth = fast.at(-1);

const pageTitle = ramadan
	? `Ramadan ${ramadanYear} börjar ${gregorianShort(ramadan.startISO)} – fastans längd i din stad – islam.se`
	: "Det islamiska året – islam.se";

const description =
	ramadan && fastSouth && fastNorth
		? `Den första fastedagen i ramadan ${ramadanYear} varar ${fastSouth.first} i ${fastSouth.name} men ${
				fastNorth.first
			} i ${fastNorth.name}. Se fastans längd ort för ort, när ramadan slutar och när Eid al-fitr infaller.`
		: "Ramadan, Eid al-fitr, Eid al-adha, Arafa, Ashura och hajj – datum i både gregoriansk och islamisk kalender (Umm al-Qura).";
---

<CollectionIndexPage
	title="Det islamiska året"
	ritning={RITNINGAR.aret}
	pageTitle={pageTitle}
	description={description}
	lead="De återkommande högtiderna och fastedagarna, räknade från utvandringen (hijra) till Medina år 622. Datumen följer Umm al-Qura-kalendern och visas här mot den gregorianska; eftersom varje månad inleds när nymånen har iakttagits kan ett datum hamna en dag tidigare eller senare. Endast det som har stöd i hadith tas upp."
	mainClass="home md-page"
	jsonLd={[
		breadcrumbList([
			{ name: "Hem", url: "/" },
			{ name: "Det islamiska året", url: "/det-islamiska-aret" },
		]),
		...faqLd,
		...eventLd,
	]}
>
		{leadSummary && <p class="lead md-answer">{leadSummary}</p>}

		<p class="md-subscribe label">
			<a href="webcal://islam.se/det-islamiska-aret.ics">Prenumerera på kalendern</a>
			<span class="nav-dot" aria-hidden="true">&middot;</span>
			<a href="/det-islamiska-aret.ics">Ladda ner (.ics)</a>
		</p>

		{fastSouth && fastNorth && (
			<section class="md-fast">
				<h2 class="md-fast-head">Hur lång är fastan i Sverige under ramadan {ramadanYear}?</h2>
				<p class="md-fast-answer">
					Den första dagen är fastan <strong>{fastSouth.first}</strong> i {fastSouth.name} och{" "}
					<strong>{fastNorth.first}</strong> i {fastNorth.name}. När ramadan infaller på vintern är
					fastedagen kortare ju längre norrut man kommer, alltså tvärtom mot sommaren, då norra Sverige
					fastar längst. Mot slutet av månaden har skillnaden nästan jämnats ut.
				</p>
				<table class="md-fast-table">
					<thead>
						<tr>
							<th scope="col">Ort</th>
							<th scope="col">Första dagen</th>
							<th scope="col">Sista dagen</th>
						</tr>
					</thead>
					<tbody>
						{fast.map((r) => (
							<tr>
								<th scope="row">
									<a href={`/bonetider/${r.slug}/`}>{r.name}</a>
									<span class="md-fast-lat">{r.latText}</span>
								</th>
								<td>{r.first}</td>
								<td>{r.last}</td>
							</tr>
						))}
					</tbody>
				</table>
				<p class="md-fast-note">
					Räknat från fajr till maghrib efter Muslim World League, samma inställningar som
					{" "}<a href="/bonetider/">bönetiderna</a> använder. Norr om polcirkeln är tiderna omstridda, och
					i praktiken följer man en regel för höga latituder eller en sydligare tidtabell.
					{" "}<a href="/fordjupning/ramadan/">Fördjupningen om ramadan</a> går igenom hur den ordningen
					kom till, och <a href="/bonetider/ramadan/">iftar och suhūr ort för ort</a> ger klockslagen
					för fler orter än de fem här.
				</p>
			</section>
		)}

		{groups.map((g) => (
			<section class="md-year" data-year>
				<h2 class="md-year-head">
					{/* »e.H.« rides with the hijri year, outside the uppercased span: in it
					    the abbreviation printed »E.H.«, and Swedish writes e.H. */}
					{g.hijriYear} e.H.<span class="md-year-greg">{g.gregSpan}</span>
				</h2>
				<MarkesdagList rows={g.rows} />
			</section>
		))}

		<p class="md-standing">
			Därtill <em>de vita dagarna</em> (Ayyām al-bīḍ) – fasta den 13:e, 14:e och 15:e i varje månmånad.
		</p>
		<p class="md-also">
			Och i <em>Shaʿbān</em>, månaden före ramadan, fastade Profeten <span class="honorific honorific--saw">ﷺ</span> fler dagar än under någon annan månad utom ramadan.
		</p>

		{dateFaq.length > 0 && (
			<TitledSection class="md-faq" id="md-faq-head" title="Vanliga frågor">
				<DefinitionList items={dateFaq} />
			</TitledSection>
		)}
</CollectionIndexPage>

<style>
	/* The same quiet two-column rhythm as the homepage section (Markesdagar.astro),
	   here extended to the full year and grouped under Hijri-year headings.

	   The page sits on the mast's canvas like every other index (tokens.css, »Two
	   frames«). Prose is held to the reading measure separately — the wide canvas
	   is for the date list and the fast table, not for paragraphs. */
	.md-page :is(.md-standing, .md-also) {
		max-width: var(--content-width);
	}

	/* Was a negative top margin, which pulled these two links up into the last
	   line of the summary paragraph above — a real 15px text collision, not just
	   tight spacing. Normal flow, and the links get enough padding to clear the
	   24px target floor (they were 15px tall). */
	.md-subscribe {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.15rem 0.6rem;
		margin: var(--space-half) 0 var(--space-unit);
		color: var(--color-muted);

		/* Once the row wraps, the separator dangles at the end of the first line.
		   Narrow screens get the two actions stacked instead; their own
		   padding-block keeps them apart, so the dot has no work to do. */
		@media (width <= 30rem) {
			flex-direction: column;
			align-items: flex-start;
			gap: 0;

			.nav-dot {
				display: none;
			}
		}

		/* A faint underline at rest, as on the correction link: set in the label's
		   muted caps with no underline, the page's two calendar actions read as a
		   caption — and a touch screen has no hover to reveal otherwise. */
		a {
			color: var(--color-muted);
			text-decoration: underline;
			text-decoration-color: color-mix(in oklab, var(--color-muted) 40%, transparent);
			text-underline-offset: var(--underline-offset);
			padding-block: 0.4rem;

			&:hover {
				color: var(--color-accent);
				text-decoration-color: currentColor;
			}

			&:focus-visible {
				border-radius: var(--radius-xs);
			}
		}
	}

	/* The same quiet reference table as the bönetider pages' daylight gradient
	   (components/bonetider/DaylightLatitude.astro) — three columns, tabular
	   figures, city as the row header. Prose stays on the reading measure; only
	   the table is allowed to be its own width. */
	.md-fast {
		margin: var(--space-unit) 0 var(--space-phi2);
		max-width: var(--content-width);
	}

	/* From 72rem the table stands beside the question and its answer, not under them:
	   held to the measure, the whole block left the right half of the 76rem canvas empty
	   at the top of the page (2026-09-26). */
	@media (width >= 72rem) {
		.md-fast {
			display: grid;
			grid-template-columns: minmax(0, var(--content-width)) minmax(0, 1fr);
			grid-template-rows: auto auto 1fr;
			column-gap: 4rem;
			max-width: none;
		}

		.md-fast > :not(.md-fast-table) {
			grid-column: 1;
		}

		.md-fast-table {
			grid-column: 2;
			grid-row: 1 / -1;
			align-self: start;
		}
	}

	.md-fast-head {
		font-family: var(--font-heading);
		font-size: var(--step-1-sans);
		font-weight: 620;
		margin: 0 0 var(--space-half);
	}

	.md-fast-answer {
		margin: 0 0 var(--space-unit);
	}

	.md-fast-table {
		width: 100%;
		max-width: 32rem;
		border-collapse: collapse;
		font-family: var(--font-body);
		font-size: var(--step--2);
	}

	.md-fast-table :is(th, td) {
		padding: 0.45rem 0.5rem;
		text-align: end;
		white-space: nowrap;
	}

	.md-fast-table thead th {
		color: var(--color-muted);
		font-weight: 600;
		font-size: var(--step--3);
		border-bottom: 1px solid var(--color-divider);
	}

	.md-fast-table tbody th[scope="row"] {
		text-align: start;
		display: flex;
		flex-direction: column;
		gap: 0.05rem;
	}

	.md-fast-table tbody td {
		color: var(--color-text);
		font-variant-numeric: lining-nums tabular-nums;
	}

	.md-fast-table tbody tr:not(:last-child) :is(th, td) {
		border-bottom: 1px solid color-mix(in srgb, var(--color-divider), transparent 40%);
	}

	/* At the narrowest supported viewport the three no-wrap columns were 39px wider
	   than the page. Let dates wrap within fixed columns instead of making the entire
	   document pan sideways. */
	@media (width <= 22rem) {
		.md-fast-table {
			table-layout: fixed;
		}

		.md-fast-table :is(th, td) {
			padding-inline: 0.3rem;
			white-space: normal;
		}
	}

	.md-fast-lat {
		/* The row header is a <th>, so this would inherit the UA's bold and be set
		   heavier than the city name it annotates. It is the quietest thing in the
		   row; it should be the lightest. */
		font-size: var(--step--4);
		font-weight: 400;
		color: var(--color-muted);
		font-variant-numeric: lining-nums tabular-nums;
	}

	.md-fast-note {
		font-size: var(--step--3);
		line-height: 1.5;
		color: var(--color-muted);
		margin: var(--space-half) 0 0;
	}

	.md-year {
		margin-top: var(--space-unit);
	}

	.md-year[hidden] {
		display: none;
	}

	.md-year-head {
		font-family: var(--font-heading);
		font-size: var(--step-1-sans);
		font-weight: 620;
		color: var(--color-text);
		margin: 0 0 var(--space-half);
		padding-bottom: var(--space-half);
		border-bottom: 1px solid var(--color-divider);
	}

	.md-year-greg {
		font-weight: 400;
		font-size: var(--step--3);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-muted);
		margin-inline-start: 0.5rem;
	}

	/* The shared .md-* calendar-list rules live in styles/layout.css — the
	   homepage section renders the same rows and used to carry an identical
	   copy of every rule below, media query included. Only the two spacings
	   that differ on this page stay here. */
	.md-list {
		margin: 0;
	}

	.md-also {
		margin: var(--space-half) 0 var(--space-phi2);
	}

	.md-answer {
		--lead-margin: var(--space-unit) 0 0;
	}

	.md-faq {
		max-width: var(--content-width);
		margin-top: var(--space-unit);
		padding-top: var(--space-half);
		border-top: 1px solid var(--color-rule);
	}

	.md-faq h2 {
		font-family: var(--font-heading);
		font-size: var(--step-1-sans);
		margin: 0 0 var(--space-half);
	}

</style>

<script>
	// Build-time already filtered to upcoming, but deploys are manual (§7.9): trim
	// any observance that has passed since the last build, and hide a year heading
	// once all its rows are gone, so the page never shows a stale "upcoming" date.
	document.addEventListener("astro:page-load", () => {
		const today = new Date().toISOString().slice(0, 10);
		for (const section of document.querySelectorAll<HTMLElement>("[data-year]")) {
			let any = false;
			for (const row of section.querySelectorAll<HTMLElement>("[data-end]")) {
				const keep = (row.dataset.end ?? "") >= today;
				row.hidden = !keep;
				if (keep) any = true;
			}
			section.hidden = !any;
		}
	});
</script>
