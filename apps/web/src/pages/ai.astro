---
import { Copy } from "@lucide/astro";
import ArticlePage from "../components/ArticlePage.astro";
import CopyCodeBlock from "../components/CopyCodeBlock.astro";
import SectionOrnament from "../components/SectionOrnament.astro";
import { getArticles } from "../lib/articles";

const articles = await getArticles();
const articleCount = articles.length;
const mcpTools = [
	{ name: "search_articles", description: "Fritextsökning bland alla essäer" },
	{ name: "get_article", description: "Hämtar en hel essä med metadata" },
	{ name: "list_articles", description: "Listar alla publicerade essäer" },
];
const claudeDesktopConfig = `{
  "mcpServers": {
    "islam-se": {
      "url": "https://mcp.islam.se/mcp"
    }
  }
}`;
const claudeCodeCommand = "claude mcp add -s user --transport http islam-se https://mcp.islam.se/mcp";
---

<ArticlePage title="islam.se för AI-assistenter" description="Anslut din AI-assistent till islam.se och sök bland alla essäer direkt i samtalet.">
		<div class="article-body prose ai-prose">
			<p>Samtliga {articleCount} essäer finns tillgängliga via en öppen <a href="https://modelcontextprotocol.io" target="_blank" rel="noopener">MCP-server</a>. MCP är ett protokoll som låter AI-assistenter använda externa verktyg. Claude, ChatGPT och andra assistenter kan söka i, läsa och citera essäerna direkt i samtalet.</p>

			<div class="tool-list">
				<dl>
					{mcpTools.map((tool) => (
						<div class="tool-item">
							<dt><code>{tool.name}</code></dt>
							<dd>{tool.description}</dd>
						</div>
					))}
				</dl>
			</div>

			<div class="server-url" data-url="https://mcp.islam.se/mcp">
				<span class="server-url-label">Serveradress</span>
				<code class="server-url-value">https://mcp.islam.se/mcp</code>
				<button class="copy-btn" type="button" aria-label="Kopiera serveradress">
					<Copy size={14} stroke-width={1.75} />
					<span class="copy-label">Kopiera</span>
				</button>
				<p class="copy-status" role="status"></p>
			</div>

			<SectionOrnament />

			<h2>Claude Desktop</h2>
			<ol>
				<li>Öppna <strong>Settings</strong> (<kbd>Cmd</kbd><kbd>,</kbd> eller <kbd>Ctrl</kbd><kbd>,</kbd>).</li>
				<li>Gå till <strong>Developer</strong> &rarr; <strong>Edit Config</strong>.</li>
				<li>Lägg till:</li>
			</ol>
			<CopyCodeBlock code={claudeDesktopConfig} copyLabel="Kopiera kod" />
			<ol start="4">
				<li>Spara och starta om Claude.</li>
			</ol>

			<h2>Claude.ai</h2>
			<ol>
				<li>Logga in på <a href="https://claude.ai" target="_blank" rel="noopener">claude.ai</a>.</li>
				<li>Gå till <strong>Settings</strong> &rarr; <strong>Integrations</strong> &rarr; <strong>Add&nbsp;integration</strong>.</li>
				<li>Klistra in serveradressen.</li>
			</ol>

			<h2>ChatGPT</h2>
			<ol>
				<li>Gå till <strong>Settings</strong> &rarr; <strong>Tools</strong> &rarr; <strong>Add MCP server</strong>.</li>
				<li>Klistra in serveradressen.</li>
			</ol>

			<h2>Claude Code</h2>
			<CopyCodeBlock code={claudeCodeCommand} copyLabel="Kopiera kommando" />

			<SectionOrnament />

			<h2>Prova</h2>
			<p>När servern är kopplad, skriv till exempel:</p>
			<blockquote>
				<p>Sök bland essäerna på islam.se efter texter om Strindberg och islam.</p>
			</blockquote>
			<p>Assistenten söker, hittar relevanta essäer och kan citera dem med länk tillbaka till islam.se.</p>
		</div>
</ArticlePage>

<style>
	/* Disable book-style paragraph indentation — this is technical prose */
	.ai-prose > :global(p + p:not([class])) {
		text-indent: 0;
	}

	.ai-prose > :global(p:has(+ p)) {
		margin-bottom: var(--space-unit);
	}

	/* Tool list — definition list */
	.tool-list {
		margin-block: var(--space-unit);
	}

	.tool-list dl {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.tool-item {
		display: flex;
		align-items: baseline;
		gap: 1rem;
	}

	.tool-item dt {
		flex-shrink: 0;
	}

	.tool-item dd {
		color: var(--color-muted);
		font-size: 0.9375em;
	}

	@media (width <= 30rem) {
		.tool-item {
			flex-direction: column;
			gap: 0.125rem;
		}
	}

	/* Code — monospace for tool names and config blocks */
	.ai-prose :global(code) {
		font-family: ui-monospace, "SF Mono", "Cascadia Code", "Segoe UI Mono", Menlo, Consolas, monospace;
		font-size: 0.85em;
		font-variant-numeric: lining-nums tabular-nums;
		letter-spacing: 0;
	}

	.ai-prose :global(pre) {
		background: var(--surface-1);
		border: 1px solid var(--color-divider);
		border-radius: 0.375rem;
		padding: 0.875rem 1.25rem;
		font-size: var(--step--3);
		line-height: 1.7;
		overflow-x: auto;
	}

	@media (width <= 30rem) {
		.ai-prose :global(pre) {
			padding: 0.75rem 0.875rem;
			font-size: var(--step--4);
			border-radius: 0.25rem;
		}
	}

	/* Server URL card */
	.server-url {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.375rem;
		margin-block: var(--space-unit);
		padding: 1rem 1.25rem;
		border: 1px solid var(--color-divider);
		border-radius: 0.375rem;
		background: var(--surface-1);
	}

	.server-url-label {
		width: 100%;
		font-family: var(--font-heading);
		font-size: var(--step--4);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.server-url-value {
		flex: 1;
		font-size: var(--step--2);
		letter-spacing: 0.01em;
		color: var(--color-accent);
		word-break: break-all;
	}

	@media (width <= 30rem) {
		.server-url {
			padding: 0.875rem 1rem;
		}

		.server-url-value {
			font-size: var(--step--3);
			width: 100%;
			flex: none;
		}
	}

	.copy-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
		padding: 0.3rem 0.7rem;
		font-family: var(--font-heading);
		font-size: var(--step--4);
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-muted);
		background: none;
		border: 1px solid var(--color-divider);
		border-radius: 1rem;
		cursor: pointer;
		transition: border-color var(--dur-fast) ease, color var(--dur-fast) ease;

		&:hover {
			border-color: var(--color-warm);
			color: var(--color-accent);
		}
	}

	/* Keyboard shortcut keys */
	.ai-prose :global(kbd) {
		display: inline-block;
		min-width: 1.4em;
		padding: 0.1em 0.35em;
		font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
		font-size: 0.8em;
		line-height: 1.3;
		text-align: center;
		border: 1px solid var(--color-divider);
		border-radius: 0.25rem;
		background: var(--surface-1);
		box-shadow: 0 1px 0 color-mix(in srgb, var(--color-muted), transparent 75%);
	}

	.ai-prose :global(kbd + kbd) {
		margin-left: 0.15em;
	}

	/* Ordered list refinements */
	.ai-prose :global(ol) {
		padding-left: 1.25em;
	}

	.ai-prose :global(li) {
		margin-bottom: 0.35em;
	}

	/* Remove external arrow from code-only links */
	.ai-prose :global(a:has(> code)::after) {
		content: none;
	}
	.ai-prose :global(.copy-status) {
		grid-column: 1 / -1;
		margin: 0;
		font-size: var(--step--3);
		color: var(--text-quiet);
	}
	.ai-prose :global(.copy-status:empty) { position: absolute; }
</style>

<script>
	document.addEventListener("astro:page-load", () => {
		for (const btn of document.querySelectorAll<HTMLButtonElement>(".copy-btn, .copy-code")) {
			const container = btn.closest(".server-url, .code-block");
			const code = container?.querySelector("code");
			const status = container?.querySelector<HTMLElement>(".copy-status");
			if (!(code && status)) continue;
			const label = btn.querySelector<HTMLElement>(".copy-label");
			const copyIcon = btn.querySelector<SVGElement>(".copy-icon");
			const checkIcon = btn.querySelector<SVGElement>(".check-icon");
			let resetTimer: ReturnType<typeof setTimeout> | undefined;
			btn.addEventListener("click", async () => {
				if (resetTimer) clearTimeout(resetTimer);
				btn.disabled = true;
				status.textContent = "";
				if (label) label.textContent = "Kopiera";
				if (copyIcon) copyIcon.style.display = "";
				if (checkIcon) checkIcon.style.display = "none";
				try {
					await navigator.clipboard.writeText(code.textContent || "");
					if (!btn.isConnected) return;
					status.textContent = "Kopierad.";
					if (label) label.textContent = "Kopierad";
					if (copyIcon) copyIcon.style.display = "none";
					if (checkIcon) checkIcon.style.display = "";
					resetTimer = setTimeout(() => {
						status.textContent = "";
						if (label) label.textContent = "Kopiera";
						if (copyIcon) copyIcon.style.display = "";
						if (checkIcon) checkIcon.style.display = "none";
					}, 2000);
				} catch {
					if (!btn.isConnected) return;
					const range = document.createRange();
					range.selectNodeContents(code);
					const selection = window.getSelection();
					selection?.removeAllRanges();
					selection?.addRange(range);
					status.textContent = "Kunde inte kopiera automatiskt. Texten är markerad så att du kan kopiera den själv.";
				} finally {
					btn.disabled = false;
				}
			});
			document.addEventListener("astro:before-swap", () => {
				if (resetTimer) clearTimeout(resetTimer);
			}, { once: true });
		}
	});
</script>
