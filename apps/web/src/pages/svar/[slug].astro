---
import { getImage } from "astro:assets";
import { type CollectionEntry, getCollection, render } from "astro:content";
import ArticleBody from "../../components/ArticleBody.astro";
import ArticleMeta from "../../components/ArticleMeta.astro";
import ArticleSection from "../../components/ArticleSection.astro";
import DefinitionList from "../../components/DefinitionList.astro";
import LinkList from "../../components/LinkList.astro";
import EssayImage from "../../components/EssayImage.astro";
import Kicker from "../../components/Kicker.astro";
import Rattelse from "../../components/Rattelse.astro";
import SectionLink from "../../components/SectionLink.astro";
import Base from "../../layouts/Base.astro";
import { getArticles } from "../../lib/articles";
import { requireBySlug } from "../../lib/content-refs";
import { FAKTA_ART, FAKTA_CLUSTERS, FAKTA_IMAGE_BY_SVAR, FAKTA_SLUGS } from "../../lib/fakta";
import { readingMinutes } from "../../lib/format";
import { SVAR_CATEGORIES, svarSeoMetadata } from "../../lib/svar";
import { pillarBySvar } from "../../lib/svar-fordjupning";
import { figureJsonLd } from "../../lib/inline-images";
import { articleJsonLd, breadcrumbList, faqPageJsonLd, imageObject } from "../../lib/jsonld";
import { PAGE_HERO_SIZES, PAGE_HERO_WIDTHS } from "../../lib/hero";
import { pageHeroPreload } from "../../lib/hero-preload";
import { SITE_URL } from "../../lib/config";

export async function getStaticPaths() {
	const entries = await getCollection("svar");
	const bySlug = new Map(entries.map((e) => [e.id, e]));
	const essayBySlug = new Map((await getArticles()).map((a) => [a.slug, a]));
	// Reverse index of the pillar pages: whichever /fordjupning/ page ranks this answer
	// highest in its `related` is this answer's fördjupning. Derived rather than declared
	// on both sides, so the pair can never drift apart.
	const pillars = pillarBySvar(
		(await getCollection("fordjupning")).map((u) => ({
			id: u.id,
			term: u.data.term,
			related: u.data.related,
		})),
	);
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: {
			entry,
			pillar: pillars.get(entry.id) ?? null,
			// A stale `related` slug used to be dropped silently. That is the one place
			// this page under-guarded compared to its `essays` field and to fördjupning's
			// own `related` — a reader-facing link should fail the build, not vanish.
			related: requireBySlug(bySlug, entry.data.related ?? [], {
				sourceFile: `svar/${entry.id}.md`,
				field: "related",
				dataDir: "data/svar/",
			}),
			// Curated cross-silo links into the essay corpus. A stale slug fails the
			// build (we never want a dead "Läs vidare" link), the same guarantee the
			// tänkare/tråd derivations give.
			essays: requireBySlug(essayBySlug, entry.data.essays ?? [], {
				sourceFile: `svar/${entry.id}.md`,
				field: "essays",
				dataDir: "data/articles/",
			}).map((essay) => ({ slug: essay.slug, title: essay.title })),
		},
	}));
}

type SvarEntry = CollectionEntry<"svar">;
interface Props {
	entry: SvarEntry;
	related: SvarEntry[];
	essays: { slug: string; title: string }[];
	pillar: { slug: string; term: string } | null;
}

const { entry, related, essays, pillar } = Astro.props;
const { data } = entry;
const seo = svarSeoMetadata(entry.id, { title: data.title, description: data.description });
const { Content, headings } = await render(entry);
const url = `${SITE_URL}/svar/${entry.id}/`;
const sourceItems = (data.sources ?? []).map((s) => ({
	label: s.name,
	...(s.url === undefined ? {} : { href: s.url }),
}));
const relatedItems = related.map((r) => ({ label: r.data.title, href: `/svar/${r.id}/` }));
const essayItems = essays.map((e) => ({ label: e.title, href: `/${e.slug}/` }));

// Cornerstone answers (the Five Pillars + six Articles of Faith) belong to the
// FAKTA hub: they get a hero image so the page reads as an article, and they
// breadcrumb / link back to /vad-ar-islam/. Ordinary questions belong to the
// /svar/ index.
//
// The hero is the same two-tier art as the hub card, so a pillar looks like
// itself in both places: bespoke FAKTA photography when this answer has it,
// otherwise the essay hero it borrows. Resolving the essay is skipped entirely
// when bespoke art exists — getArticles() is the expensive half.
const isFakta = FAKTA_SLUGS.has(entry.id);
const heroArt = FAKTA_ART.get(entry.id);
const heroEssaySlug = heroArt ? undefined : FAKTA_IMAGE_BY_SVAR.get(entry.id);
const heroArticle = heroEssaySlug
	? (await getArticles()).find((a) => a.slug === heroEssaySlug)
	: undefined;

// The hero is the Article's representative image, as on the essays and fördjupning
// pages. Without it Google has no image to show for these answers in Discover or as a
// thumbnail; the OG title card below is the fallback for the ~55 answers with no hero.
const heroSource = heroArt ?? heroArticle?.heroImage;
// Bespoke art has no phone crop; a borrowed essay hero may (EssayImage decides the same way).
const heroPreload = await pageHeroPreload(heroSource, heroArt ? undefined : heroArticle?.mobileHeroImage);
const heroAlt = heroArticle?.imageAlt ?? data.title;
let heroImageObject: Record<string, unknown> | undefined;
if (heroSource) {
	const rendition = await getImage({ src: heroSource, width: 1200, format: "webp" });
	heroImageObject = imageObject({
		contentUrl: new URL(rendition.src, Astro.site).href,
		url,
		name: heroAlt,
		width: 1200,
		height: Math.round((1200 * heroSource.height) / heroSource.width),
	});
}
const ogImage = `/svar/${entry.id}/og.png`;

// The section this answer sits in, for the header kicker. Cornerstone answers are
// clustered in the FAKTA hub; every other question belongs to a /svar/ category.
// Both taxonomies are editorial and live in lib/, so this is a lookup, not a
// frontmatter field.
const faktaCluster = FAKTA_CLUSTERS.find((c) => c.items.some((i) => i.svarSlug === entry.id));
const svarCategory = SVAR_CATEGORIES.find((c) => c.ids.includes(entry.id));
const kicker = faktaCluster
	? { name: faktaCluster.name, href: `/vad-ar-islam/#${faktaCluster.slug}` }
	: svarCategory
		? { name: svarCategory.name, href: `/svar/#${svarCategory.slug}` }
		: null;

// Article + FAQPage + breadcrumb. The page answers one primary question, so the
// Article carries it as mainEntityOfPage and the FAQ block (when present) earns the
// FAQ rich-result eligibility for the long-tail variants.
const jsonLd: Record<string, unknown>[] = [
	articleJsonLd({
		headline: data.title,
		description: data.description,
		url,
		publishedAt: data.publishedAt,
		...(data.updatedAt === undefined ? {} : { updatedAt: data.updatedAt }),
		image: heroImageObject ?? new URL(ogImage, Astro.site).href,
		citations: data.sources ?? [],
	}),
	breadcrumbList([
		{ name: "Hem", url: "/" },
		isFakta
			? { name: "Tro och lära", url: "/vad-ar-islam/" }
			: { name: "Frågor och svar", url: "/svar/" },
		{ name: data.title, url },
	]),
];
if (data.faq && data.faq.length > 0) jsonLd.push(faqPageJsonLd(data.faq));
// The photographs set inside the answer, each with its licence and credit.
jsonLd.push(...(await figureJsonLd(entry.body, url, Astro.site)));
---

<Base
	title={`${seo.title}`}
	description={seo.description}
	ogImage={ogImage}
	ogImageAlt={data.title}
	ogArticle={{
		publishedAt: data.publishedAt,
		...(data.updatedAt === undefined ? {} : { updatedAt: data.updatedAt }),
		...(kicker ? { section: kicker.name } : {}),
	}}
	jsonLd={jsonLd}
	{...heroPreload}
	preloadFonts={["body", "sans", { face: "display", media: "(min-width: 48.0625rem)" }]}
>
	<main id="main" class="svar-page reading">
		<article>
			<header class="svar-header">
				{/* The section this answer belongs to, in the same register the essay
				    pages use for their ämne. It gives the header a line above the
				    title instead of dropping the h1 straight onto a full-width photo,
				    and it is a real way back into the hub the reader came from.
				    (The frontmatter description was the obvious filler here, but it
				    is near-verbatim the body's opening sentence — it would have read
				    as an immediate repeat.) */}
				{kicker && (
					<Kicker form="quiet" href={kicker.href} class="svar-kicker">{kicker.name}</Kicker>
				)}
				<h1>{data.title}</h1>
				{/* Answer pages showed no date at all: the line below only rendered when
				    `updatedAt` differed from `publishedAt`, and no answer file set
				    `updatedAt`, so the condition never fired. A reference page with no
				    date reads as abandoned — to a reader deciding whether to trust it,
				    and to a crawler weighing freshness. Published always; revised only
				    when a page genuinely was. Long Swedish form via the same helper the
				    essays use, not the raw ISO slice this printed before. */}
				<ArticleMeta
					class="meta-line"
					publishedAt={data.publishedAt}
					readingTime={readingMinutes(entry.body ?? "")}
					{...(data.updatedAt === undefined ? {} : { updatedAt: data.updatedAt })}
				/>
			</header>

			{(heroArt ?? heroArticle?.heroImage) && (
				<div class="svar-hero media-frame">
					<EssayImage
						{...(heroArt === undefined ? {} : { src: heroArt })}
						{...(heroArticle === undefined ? {} : { article: heroArticle })}
						alt={heroArticle?.imageAlt ?? ""}
						widths={PAGE_HERO_WIDTHS}
						sizes={PAGE_HERO_SIZES}
						loading="eager"
						fetchpriority="high"
					/>
				</div>
			)}

			<ArticleBody headings={headings}>
				<Content />
			</ArticleBody>

			{/* Up to the pillar page that covers this topic in full. Placed straight after
			    the answer: the reader has just had the short version and is at the exact
			    point where more depth is the obvious next step. */}
			{pillar && (
				<p class="svar-fordjupning">
					<SectionLink href={`/fordjupning/${pillar.slug}/`}>
						Fördjupning: {pillar.term}
					</SectionLink>
				</p>
			)}

			{data.faq && data.faq.length > 0 && (
				<ArticleSection class="svar-faq" id="svar-faq-rubrik" title="Vanliga frågor">
					<DefinitionList items={data.faq} />
				</ArticleSection>
			)}

			{data.sources && data.sources.length > 0 && (
				<ArticleSection class="svar-sources" id="svar-kallor" title="Källor och fördjupning">
					<LinkList variant="diamond" items={sourceItems} />
				</ArticleSection>
			)}

			{related.length > 0 && (
				<ArticleSection class="svar-related" id="svar-relaterat" title="Relaterade frågor">
					<LinkList variant="diamond" items={relatedItems} nav />
				</ArticleSection>
			)}

			{essays.length > 0 && (
				<ArticleSection class="svar-essays" id="svar-essaer" title="Läs vidare">
					<LinkList variant="diamond" items={essayItems} nav />
				</ArticleSection>
			)}

			<p class="svar-back">
				{isFakta ? (
					<SectionLink direction="back" href="/vad-ar-islam/">Tro och lära</SectionLink>
				) : (
					<SectionLink direction="back" href="/svar/">Alla frågor och svar</SectionLink>
				)}
			</p>

			<Rattelse />
		</article>
	</main>
</Base>

<style>
	.svar-page {
		margin-block: var(--space-phi);
	}

	/* The header owns the gap down to whatever follows, so an answer with a hero
	   and one without open with the same rhythm. Without this the h1 on a
	   hero-less answer sat directly on the body's drop cap. */
	.svar-header {
		margin-bottom: var(--space-phi);
	}

	.svar-header h1 {
		margin: var(--space-half) 0 0;
		text-wrap: balance;
	}

	/* The kicker is Kicker.astro's, the same one the essay's ämne wears, so an answer
	   and an essay open the same way; its margin is in layout.css (`.svar-kicker`). */

	/* Cornerstone (FAKTA) answers carry a borrowed hero so the page reads as an
	   article. It spans the reading frame, above the body. */
	/* The hero breaks out past the 42rem text column to the full 64rem frame, so
	   it needs a real gap above it — at --space-unit it sat almost flush under the
	   h1 and read as though the title were a caption for the photo. φ above, φ
	   below, the same rhythm the essay hero uses. */
	.svar-hero {
		/* Top gap comes from .svar-header; this is the gap down to the prose. */
		margin-block: 0 var(--space-phi);
	}
	/* No aspect-ratio pin — this was the worst of the three reading pages: a 16/9 band
	   cut 25 % off the 4:3 FAKTA artworks and 15.7 % off a borrowed 3:2 essay hero. */
	.svar-hero :global(img) {
		width: 100%;
	}

	/* Placement only — the link inside is a `.section-link .back-link`. */
	.svar-back {
		margin-top: var(--space-phi);
	}

	/* Sits between the answer and the FAQ, so it needs the section rhythm above it but
	   no rule — it is a single line of navigation, not a section. */
	.svar-fordjupning {
		margin-top: var(--space-unit);
	}
</style>
