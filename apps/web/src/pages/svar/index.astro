---
import { Search } from "@lucide/astro";
import { getCollection } from "astro:content";
import CollectionIndexPage from "../../components/CollectionIndexPage.astro";
import SectionLink from "../../components/SectionLink.astro";
import TextRowList from "../../components/TextRowList.astro";
import TitledSection from "../../components/TitledSection.astro";
import { resolveHero } from "../../lib/fordjupning";
import { breadcrumbList, collectionPageJsonLd } from "../../lib/jsonld";
import { groupSvar, svarSearchTerms } from "../../lib/svar";
import { CHIP_WIDTHS } from "../../lib/hero";

// FRÅGOR & SVAR — the full, browsable question list. `groupSvar` arranges the
// corpus into themed sections and drops the cornerstone Five Pillars + six Articles
// of Faith (they live in the FAKTA hub at /vad-ar-islam/), so this index and the
// hub never duplicate each other. A category jump-nav lets a reader go straight
// to a theme, and an observer marks which one they are currently in.
const entries = await getCollection("svar");
// The long reference articles. They live at /fordjupning/ but are surfaced here,
// above the questions: a reader who comes looking for a topic rather than a single
// question should meet the full treatment first. No mast entry of their own until the
// set is large enough to carry an index page.
const allaFordjupningar = (await getCollection("fordjupning")).sort((a, b) =>
	a.data.term.localeCompare(b.data.term, "sv"),
);
// ⚠️ Capped. This type is heading for ~30 topics, and listing them all here would push
// the 50+ questions this page exists for below the fold. The band is a taster with a way
// through to the full index, not a second index.
const FORDJUPNING_BAND_MAX = 6;
const fordjupning = await Promise.all(
	allaFordjupningar.slice(0, FORDJUPNING_BAND_MAX).map(async (entry) => ({
		entry,
		hero: await resolveHero(entry),
	})),
);
const fordjupningRows = fordjupning.map(({ entry: f, hero }) => ({
	href: `/fordjupning/${f.id}/`,
	title: f.data.term,
	description: f.data.blurb ?? f.data.seoDescription ?? f.data.description,
	image: hero && {
		src: hero.src,
		article: hero.article,
		widths: CHIP_WIDTHS,
		sizes: "120px",
	},
}));
const groups = groupSvar(entries);
const listed = groups.flatMap((g) => g.entries);

const description =
	"Tydliga, källbelagda svar på vanliga frågor om islam – tro, dyrkan, mat, familj, samhälle och historia. Grundade i Koranen och klassisk sunnitisk lärdom.";
---

<CollectionIndexPage
	title="Frågor & svar om islam"
	pageTitle="Frågor och svar om islam — islam.se"
	description={description}
	ogImageAlt="Frågor och svar om islam — islam.se"
	mainClass="svar-index home"
	jsonLd={[
		collectionPageJsonLd({
			name: "Frågor och svar om islam",
			description,
			url: "/svar/",
			essays: listed.map((e) => ({ title: e.data.title, slug: `svar/${e.id}` })),
		}),
		breadcrumbList([
			{ name: "Hem", url: "/" },
			{ name: "Frågor och svar", url: "/svar/" },
		]),
	]}
>
	<span slot="lead">
		Källbelagda svar på vanliga frågor om islam, från tro och dyrkan till mat, familj, samhälle
		och historia. Vill du i stället ha grunderna förklarade, finns{" "}
		<a href="/vad-ar-islam/">de fem pelarna och trosartiklarna</a>. För fördjupade rättsliga
		frågor finns <a href="https://al-ibadah.com" rel="noopener">al-ibadah.com</a>.
	</span>


		{groups.length > 0 ? (
			<>
				{/* Narrows this page only; ⌘K still searches the whole site. */}
				<search><form class="svar-search field" data-total={listed.length}>
					<Search class="svar-search-icon" size={18} stroke-width={1.75} />
					<input
						class="svar-search-input"
						id="svar-q"
						type="search"
						name="q"
						placeholder={`Sök bland ${listed.length} frågor …`}
						aria-label="Sök bland frågorna på denna sida"
						aria-controls="svar-results"
						autocomplete="off"
						autocapitalize="off"
						spellcheck="false"
						enterkeyhint="search"
					/>
					<button class="svar-search-clear label" type="button" hidden>Rensa</button>
				</form></search>
				<p class="svar-search-status label" role="status"></p>

				<nav class="svar-nav" aria-label="Kategorier">
					<ul>
						{groups.map((g) => (
							<li data-cat-item={g.category.slug}>
								<a href={`#${g.category.slug}`} data-cat={g.category.slug} class="filter-chip label">{g.category.short ?? g.category.name}</a>
							</li>
						))}
					</ul>
				</nav>

		{fordjupning.length > 0 && (
			<TitledSection
				class="svar-fordjupningar"
				id="svar-fordjupningar-rubrik"
				title="Fördjupningar"
				titleClass="label"
			>
				<TextRowList
					class="svar-fordjupningar-list"
					style="--text-row-title-size: var(--step-0); --text-row-desc-margin: 0.2rem"
					items={fordjupningRows}
					titleElement="span"
				/>
				{allaFordjupningar.length > FORDJUPNING_BAND_MAX && (
					<p class="svar-fordjupningar-alla">
						<SectionLink href="/fordjupning/">
							Alla {allaFordjupningar.length} fördjupningar
						</SectionLink>
					</p>
				)}
			</TitledSection>
		)}


				<div id="svar-results">
					{groups.map((g) => (
						<TitledSection
							class="svar-section"
							id={`sc-${g.category.slug}`}
							sectionId={g.category.slug}
							title={g.category.name}
						>
							{g.category.intro && <p class="lead svar-section-intro">{g.category.intro}</p>}
							<TextRowList
								class="svar-list"
								variant="question"
								items={g.entries.map((e) => ({
									href: `/svar/${e.id}/`,
									title: e.data.title,
									description: e.data.description,
									attrs: {
										"data-svar-item": "",
										"data-terms": svarSearchTerms(e) || undefined,
									},
								}))}
							/>
						</TitledSection>
					))}

					{/* The status line states the count; this is only the way out. */}
					<p class="svar-empty" hidden>
						Frågan kan ändå finnas bland essäerna eller på en annan sida.
						<button class="svar-empty-all" type="button">Sök i hela sajten</button>
					</p>
				</div>
			</>
		) : (
			<p>Inga frågor publicerade ännu.</p>
		)}
</CollectionIndexPage>

<script>
	import { closeEnough, fold } from "../../lib/search-text";

	// On-page filter. The haystack is read out of the DOM once (no index to fetch);
	// `data-terms` adds only the synonyms the page doesn't print. AND over tokens,
	// both sides folded. No debounce — one pass over 51 rows is microseconds.
	// A query with no exact hit is retried loosely (`closeEnough`).
	function bindSvarSearch() {
		const form = document.querySelector<HTMLFormElement>(".svar-search");
		const input = document.querySelector<HTMLInputElement>("#svar-q");
		const status = document.querySelector<HTMLElement>(".svar-search-status");
		const clear = document.querySelector<HTMLButtonElement>(".svar-search-clear");
		const empty = document.querySelector<HTMLElement>(".svar-empty");
		if (!form || !input || !status || !clear || !empty) return;

		const emptyAll = empty.querySelector<HTMLButtonElement>(".svar-empty-all");
		const items = Array.from(document.querySelectorAll<HTMLLIElement>("[data-svar-item]")).map(
			(el) => ({
				el,
				section: el.closest<HTMLElement>(".svar-section"),
				link: el.querySelector<HTMLAnchorElement>("a"),
				hay: `${fold(el.textContent ?? "")} ${el.dataset.terms ?? ""}`,
				// Built lazily on the first loose pass only.
				words: null as string[] | null,
			}),
		);
		const sections = Array.from(document.querySelectorAll<HTMLElement>(".svar-section"));
		// Paired up front so the per-keystroke loop needs no lookups.
		const chips = Array.from(document.querySelectorAll<HTMLElement>("[data-cat-item]")).map(
			(el) => ({ el, section: document.getElementById(el.dataset.catItem ?? "") }),
		);
		const total = items.length;
		if (!total) return;

		let visible = items.map((i) => i.link);

		type Item = (typeof items)[number];

		/** Loose pass: a token counts if any word in the row is close enough. */
		function nearly(item: Item, token: string): boolean {
			if (item.hay.includes(token)) return true;
			item.words ??= item.hay.split(/[^\p{L}\p{N}]+/u).filter((w) => w.length > 1);
			return item.words.some((w) => closeEnough(token, w));
		}

		/* Arrow const, not a `function` declaration — a hoisted one is created before
		   the null-guard above and loses the narrowing of status/clear/empty. */
		const apply = (raw: string): void => {
			const query = raw.trim();
			const tokens = fold(query).split(/\s+/).filter(Boolean);
			const live = new Set<HTMLElement>();
			let hits = 0;
			visible = [];

			// Exact first; loose only when that found nothing, so near-misses can
			// never dilute a working query.
			let on = items.map((item) => tokens.every((t) => item.hay.includes(t)));
			const loose = tokens.length > 0 && !on.some(Boolean);
			if (loose) on = items.map((item) => tokens.every((t) => nearly(item, t)));

			for (const [i, item] of items.entries()) {
				item.el.hidden = !on[i];
				if (!on[i]) continue;
				hits++;
				visible.push(item.link);
				if (item.section) live.add(item.section);
			}

			// Empty sections and their chips go too.
			const filtering = tokens.length > 0;
			for (const section of sections) section.hidden = filtering && !live.has(section);
			for (const chip of chips) {
				chip.el.hidden = filtering && !(chip.section && live.has(chip.section));
			}

			clear.hidden = !query;
			empty.hidden = !query || hits > 0;
			// Name which pass answered.
			status.textContent = !query
				? ""
				: hits === 0
					? `Inga träffar bland sidans ${total} frågor`
					: loose
						? `Ingen exakt träff – visar ${hits} ${hits === 1 ? "snarlik fråga" : "snarlika frågor"}`
						: `${hits} av ${total} frågor`;

			// replaceState, not push: one entry per keystroke would wreck Back.
			const url = query ? `?q=${encodeURIComponent(query)}` : location.pathname;
			history.replaceState(history.state, "", url);
		};

		input.addEventListener("input", () => apply(input.value));

		// The magnifier is an aria-hidden <svg> and the row's padding belongs to the
		// form, so a tap that lands beside the input would otherwise hit nothing.
		form.addEventListener("mousedown", (e) => {
			if (e.target === input || (e.target as HTMLElement).closest?.("button")) return;
			e.preventDefault();
			input.focus();
		});

		// Enter on a single hit opens it.
		form.addEventListener("submit", (e) => {
			e.preventDefault();
			if (visible.length === 1) visible[0]?.click();
		});

		input.addEventListener("keydown", (e) => {
			if (e.key !== "Escape" || !input.value) return;
			// Don't let the palette's global Escape also fire.
			e.preventDefault();
			e.stopPropagation();
			input.value = "";
			apply("");
		});

		clear.addEventListener("click", () => {
			input.value = "";
			apply("");
			input.focus();
		});

		// Hand the query to the site-wide palette.
		emptyAll?.addEventListener("click", () => {
			const query = input.value.trim();
			document.querySelector<HTMLButtonElement>(".search-trigger")?.click();
			const field = document.querySelector<HTMLInputElement>(".palette-input");
			if (!field) return;
			field.value = query;
			field.dispatchEvent(new Event("input", { bubbles: true }));
		});

		// Arriving on /svar/?q=… (a shared link, or the back button) lands filtered.
		const initial = new URLSearchParams(location.search).get("q");
		if (initial) {
			input.value = initial;
			apply(initial);
		}
	}

	// Progressive enhancement: highlight the category chip whose section is in view.
	// Plain anchors already work without this (jump + scroll-margin handle landing).
	function bindSvarNav() {
		const sections = Array.from(document.querySelectorAll<HTMLElement>(".svar-section"));
		const chips = new Map(
			Array.from(document.querySelectorAll<HTMLAnchorElement>(".svar-nav a")).map((a) => [
				a.dataset.cat ?? "",
				a,
			]),
		);
		if (!sections.length || !chips.size) return;

		const obs = new IntersectionObserver(
			(items) => {
				for (const it of items) {
					if (!it.isIntersecting) continue;
					const id = (it.target as HTMLElement).id;
					// Remove rather than set "false": aria-current="false" means
					// "not current" but still counts as the attribute being present,
					// and it left ~12 links carrying it on every scroll.
					for (const [cat, chip] of chips) {
						if (cat === id) chip.setAttribute("aria-current", "true");
						else chip.removeAttribute("aria-current");
					}
				}
			},
			// Trip when a heading reaches the upper third of the viewport.
			{ rootMargin: "-30% 0px -65% 0px" },
		);
		for (const s of sections) obs.observe(s);
	}

	document.addEventListener("astro:page-load", () => {
		bindSvarSearch();
		bindSvarNav();
	});
</script>

<style>
	.svar-index {
		margin-block: var(--space-phi);
	}

	/* A hairline under a line of type, like the palette's own field. Held to the
	   reading measure, not the full canvas. */
	.svar-search {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		max-width: var(--content-width);
		margin: 0 0 0.4rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--color-divider);
		transition: border-color 0.15s;
	}

	.svar-search:focus-within {
		border-bottom-color: var(--color-warm);
	}

	.svar-search-icon {
		flex-shrink: 0;
		color: var(--color-muted);
	}

	.svar-search-input {
		flex: 1;
		min-width: 0;
		font-family: var(--font-heading);
		font-size: var(--step-0);
		color: var(--color-text);
		background: transparent;
		border: none;
		/* The input itself is the tap target — the icon beside it is decorative and
	   the hairline is the form's, not the field's. Keep it thumb-sized. */
		min-height: 2.75rem;
		padding: 0;
		outline: none;
	}

	.svar-search-input::placeholder {
		color: var(--color-muted);
	}

	/* The UA's grey ✕ ignores the page's colour; "Rensa" replaces it. */
	.svar-search-input::-webkit-search-cancel-button {
		-webkit-appearance: none;
	}

	.svar-search-clear {
		flex-shrink: 0;
		border: none;
		background: transparent;
		color: var(--color-muted);
		cursor: pointer;
		/* Padded past the 24px WCAG 2.5.8 target from a ~14px label. */
		padding: 0.35rem 0.5rem;
		margin-right: -0.5rem;

		&:hover { color: var(--color-accent); }
		&:focus-visible { border-radius: var(--radius-xs); }
	}

	/* Reserves its line so nothing below shifts as the reader types. */
	.svar-search-status {
		min-height: 1.2em;
		margin: 0 0 var(--space-half);
	}

	.svar-empty {
		font-family: var(--font-body);
		font-size: var(--step--1);
		color: var(--color-muted);
		margin: var(--space-unit) 0 0;
	}

	.svar-empty-all {
		font: inherit;
		color: var(--color-accent);
		background: transparent;
		border: none;
		padding: 0.35rem 0;
		margin-left: 0.4rem;
		cursor: pointer;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.15em;

		&:focus-visible { border-radius: var(--radius-xs); }
	}

	/* Category jump-nav: a wrapping pill row (no horizontal scroll), borrowed from
	   Essäer's filter row so the two index pages divide their content the same way. */
	.svar-nav {
		/* Top gap is owned by .page-head's margin-bottom (shared by every section
		   page); the nav only sets its space down to the first category. */
		margin: 0 0 var(--space-unit);
	}
	.svar-nav ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	/* The pill itself is the shared global `.filter-chip` (+ `.label`), identical to
	   Essäer's filter row. */

	.svar-section {
		margin-top: var(--space-phi);
		/* Clears the sticky mast, so an anchor jump doesn't drop the heading
		   underneath it. (The category nav itself is not sticky — a sticky
		   section nav was considered and turned down as too much chrome.) */
		scroll-margin-top: 5rem;
	}
	.svar-section h2 {
		font-size: var(--step-1);
		margin: 0;
	}
	.svar-section-intro {
		--lead-color: var(--color-muted);
		--lead-margin: 0.4rem 0 0;
	}

	.svar-list {
		--text-row-list-margin: var(--space-unit) 0 0;
	}

	/* The fördjupning band: the long reference articles, set above the question list.
	   Deliberately a different shape from the question rows below — a bordered band with
	   a term and a line of framing — so the reader sees two kinds of thing, not a
	   longer list of the same thing. */
	.svar-fordjupningar {
		margin-top: var(--space-unit);
		padding-block: var(--space-unit);
		border-block: 1px solid var(--color-rule);
	}

	.svar-fordjupningar h2 {
		margin: 0 0 var(--space-half);
	}

	.svar-fordjupningar-alla {
		margin: var(--space-unit) 0 0;
	}
</style>
