---
import { getCollection } from "astro:content";
import CollectionIndexPage from "../../components/CollectionIndexPage.astro";
import FordjupningCards from "../../components/FordjupningCards.astro";
import SectionLink from "../../components/SectionLink.astro";
import TextRowList from "../../components/TextRowList.astro";
import TitledSection from "../../components/TitledSection.astro";
import { getSortedFordjupning, resolveHero } from "../../lib/fordjupning";
import { breadcrumbList, collectionPageJsonLd } from "../../lib/jsonld";
import { groupSvar } from "../../lib/svar";

// FRÅGOR & SVAR — the full, browsable question list. `groupSvar` arranges the
// corpus into themed sections and drops the cornerstone Five Pillars + six Articles
// of Faith (they live in the FAKTA hub at /vad-ar-islam/), so this index and the
// hub never duplicate each other. A category jump-nav lets a reader go straight
// to a theme, and an observer marks which one they are currently in.
const entries = await getCollection("svar");

// The long reference articles. /svar/ is their only door — /fordjupning/ has no mast
// entry of its own — so all of them are reachable from here, in the shape Essäer
// already uses for a set of things with pictures: cards in the auto-fill grid, then
// the single link to the full index.
//
// Six curated topics. On phones these become thumbnail rows, so the preview
// stays shorter than the question directory it introduces. Category links precede
// the preview so a reader can go straight to their question.
const fordjupningar = await Promise.all(
	(await getSortedFordjupning()).map(async (entry) => ({ entry, hero: await resolveHero(entry) })),
);
// Named, not sliced off the alphabetical list: the first three by letter are Abort,
// Döden and Griskött — a macabre trio by accident, and the first thing a reader meets.
// The order answers a Swedish reader's arrival questions in turn — how did it get here,
// then dress and food, then the book, the law and the man. Ramadan is deliberately not
// here: fasting is a pillar, so it already has a card with art on Pelare & tro, and the
// page's own intro sends readers there. Each of the six was also
// checked at thumbnail size; a page whose art goes muddy small does not belong here
// however common its question (Moskén and Sunni och shia both fail that test today).
// ⚠️ Dropping a slug from this list removes its only direct link on /svar/. pelarRest
// below is a COUNT GUARD, not a row list — everything not named here is reachable only
// through the single "Alla N fördjupningar" link to /fordjupning/.
const PELAR_KORT = [
	"islam-i-sverige",
	"hijab",
	"halal",
	"koranen",
	"sharia",
	"muhammed",
];
const pelarKort = PELAR_KORT.map((id) => {
	const found = fordjupningar.find((f) => f.entry.id === id);
	if (!found) {
		throw new Error(
			`svar/index.astro: PELAR_KORT names "${id}", which is not a page in data/fordjupning/. ` +
				"Use a filename without .md, or drop it from the list.",
		);
	}
	return found;
});
const pelarRest = fordjupningar.filter((f) => !PELAR_KORT.includes(f.entry.id));

const groups = groupSvar(entries);
const listed = groups.flatMap((g) => g.entries);

const svarRows = (items: typeof listed) =>
	items.map((e) => ({
		href: `/svar/${e.id}/`,
		// Title only. It already carries the question AND its short answer ("Vad är
		// tawhid? Guds enhet, namn och egenskaper"); `description` is the meta tag
		// Google prints, 163 chars of it, and 51 of those made the list a river.
		title: e.data.title,
	}));

const description =
	"Tydliga, källbelagda svar på vanliga frågor om islam – tro, dyrkan, mat, familj, samhälle och historia. Grundade i Koranen och klassisk islamisk lärdom.";
---

<CollectionIndexPage
	title="Frågor och svar"
	pageTitle="Frågor och svar om islam – islam.se"
	description={description}
	lead="Frågor om tron, vardagen och livet som muslim. Här hittar du svar med stöd i Koranen, sunna och klassisk islamisk lärdom."
	ogImageAlt="Frågor och svar om islam – islam.se"
	mainClass="svar-index home"
	jsonLd={[
		collectionPageJsonLd({
			name: "Frågor och svar om islam",
			description,
			url: "/svar/",
			essays: listed.map((e) => ({ title: e.data.title, slug: `svar/${e.id}` })),
		}),
		breadcrumbList([
			{ name: "Hem", url: "/" },
			{ name: "Frågor och svar", url: "/svar/" },
		]),
	]}
>



		{groups.length > 0 ? (
			<>


				<nav class="svar-nav" aria-label="Kategorier">
					<ul>
						{groups.map((g) => (
							<li data-cat-item={g.category.slug}>
								<a href={`#${g.category.slug}`} data-cat={g.category.slug} class="filter-chip label">{g.category.short ?? g.category.name}</a>
							</li>
						))}
					</ul>
				</nav>

				{fordjupningar.length > 0 && (
					<section class="svar-pelare" aria-labelledby="svar-pelare-rubrik">
						<h2 class="label svar-pelare-label" id="svar-pelare-rubrik">Fördjupning</h2>
						<FordjupningCards
							entries={pelarKort}
							headingLevel={3}
							sizes="(max-width: 42rem) 6rem, (min-width: 79rem) 24rem, (min-width: 63rem) 30vw, (min-width: 42rem) 45vw, 100vw"
						/>
						{pelarRest.length > 0 && (
							<p class="svar-pelare-alla">
								<SectionLink href="/fordjupning/">
									Alla fördjupningar
								</SectionLink>
							</p>
						)}
					</section>
				)}



				<div id="svar-results">
					{groups.map((g) => (
						<TitledSection
							class="svar-section"
							id={`sc-${g.category.slug}`}
							sectionId={g.category.slug}
							title={g.category.name}
						>
							{g.category.intro && <p class="lead svar-section-intro">{g.category.intro}</p>}
							<TextRowList
								class="svar-list"
								variant="question"
								items={svarRows(g.entries)}
							/>
						</TitledSection>
					))}


				</div>


			</>
		) : (
			<p>Inga frågor publicerade ännu.</p>
		)}
</CollectionIndexPage>

<script>
	// Progressive enhancement: highlight the category chip whose section is in view.
	// Plain anchors already work without this (jump + scroll-margin handle landing).
	function bindSvarNav() {
		const sections = Array.from(document.querySelectorAll<HTMLElement>(".svar-section"));
		const chips = new Map(
			Array.from(document.querySelectorAll<HTMLAnchorElement>(".svar-nav a")).map((a) => [
				a.dataset.cat ?? "",
				a,
			]),
		);
		if (!sections.length || !chips.size) return;

		const obs = new IntersectionObserver(
			(items) => {
				for (const it of items) {
					if (!it.isIntersecting) continue;
					const id = (it.target as HTMLElement).id;
					// Remove rather than set "false": aria-current="false" means
					// "not current" but still counts as the attribute being present,
					// and it left ~12 links carrying it on every scroll.
					for (const [cat, chip] of chips) {
						if (cat === id) chip.setAttribute("aria-current", "true");
						else chip.removeAttribute("aria-current");
					}
				}
			},
			// Trip when a heading reaches the upper third of the viewport.
			{ rootMargin: "-30% 0px -65% 0px" },
		);
		for (const s of sections) obs.observe(s);
	}

	document.addEventListener("astro:page-load", () => {
		bindSvarNav();
	});
</script>

<style>

	.svar-index :global(.lead--page:empty) { display: none; }

	/* The long-form topics. No rules around the band — the photographs already mark it
	   off as a different kind of thing. */
	.svar-pelare {
		margin: 0 0 var(--space-unit);
	}

	.svar-pelare-label {
		color: var(--color-muted);
		margin: 0 0 var(--space-half);
		font-size: var(--step--1);
	}

	.svar-pelare-alla {
		margin: var(--space-unit) 0 0;
	}

	/* Category jump-nav: a wrapping pill row borrowed from Essäer's filter row so the
	   two index pages divide their content the same way — but sticky here, because
	   this page is nine sections deep and the row is its table of contents.
	   (A sticky section nav was turned down once as too much chrome, against a list
	   half this many sections that had no way back to the top.) */
	.svar-nav {
		/* Published by Header.astro; the fallback is one line of mast plus padding. */
		--top: var(--mast-height, 5.5rem);
		position: sticky;
		top: var(--top);
		/* Under the mast (z-index 10), over the rows. */
		z-index: 9;
		background: var(--color-bg);
		/* Top gap is owned by .page-head's margin-bottom (shared by every section
		   page); the nav only sets its space down to the first category. */
		margin: 0 0 var(--space-unit);
		padding-block: 0.55rem;

		/* No rule at rest — a hairline here sat a few pixels under the one closing
		   the fördjupning row and read as a double line. This is the mast's own
		   under-shade instead: it says "content is passing underneath" only while
		   that is actually true. */
		&::after {
			content: "";
			position: absolute;
			inset: 100% 0 auto;
			height: 1.25rem;
			background: linear-gradient(to bottom, var(--color-bg), transparent);
			pointer-events: none;
			opacity: 0;
			transition: opacity var(--dur-fast) ease;
		}
	}

	:global(html.page-scrolled) .svar-nav::after {
		opacity: 1;
	}

	/* The mast slides away on scroll-down, so the row would otherwise pin below a
	   strip of nothing. */
	:global(html.mast-hidden) .svar-nav {
		--top: 0px;
	}

	.svar-nav ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
	}

	@media (width <= 42rem) {
		/* Related reading is a short preview before the questions, not six full-width
		   photographs. Keep the 3:2 art beside each title and complete description. */
		.svar-pelare :global(.card-list a:has(.card-list-thumb)) {
			display: grid;
			grid-template-columns: 6rem minmax(0, 1fr);
			column-gap: var(--space-half);
			align-items: start;
		}
		.svar-pelare :global(.card-list-thumb) {
			grid-row: 1 / span 2;
			margin: 0;
		}
		.svar-pelare :global(.card-list) {
			margin-bottom: 0;
		}

	}

	/* Phones: eight chips wrap to three rows, and three sticky rows eat a quarter of
	   the viewport. One scrolling row instead — the no-horizontal-scroll rule this
	   reverses was written for a row that stood still. */
	@media (width <= 34rem) {

		.svar-nav ul {
			flex-wrap: nowrap;
			overflow-x: auto;
			scrollbar-width: none;
			scroll-snap-type: x proximity;
		}
		.svar-nav li {
			flex: 0 0 auto;
			scroll-snap-align: start;
		}
	}

	/* The pill itself is the shared global `.filter-chip` (+ `.label`), identical to
	   Essäer's filter row. */

	.svar-section {
		margin-top: var(--space-phi);
		/* Clears the mast AND the sticky category row, so an anchor jump doesn't drop
		   the heading underneath either. */
		scroll-margin-top: calc(var(--mast-height, 5.5rem) + 4rem);
	}
	.svar-section :global(h2) {
		font-size: var(--step-1-sans);
		margin: 0;
	}
	.svar-section-intro {
		--lead-color: var(--color-muted);
		--lead-margin: 0.4rem 0 0;
	}

	.svar-list {
		--text-row-list-margin: var(--space-unit) 0 0;
		/* A hairline under all 63 rows read as a ledger; the rows are one line each
		   and hold together on spacing alone. */
		--text-row-question-separator: 0;
		--text-row-question-padding: 0.4rem;
	}

	/* Two columns once there is room — the same grid the essay archive uses
	   (layout.css `.home .archive-list`), so the two indexes read as one system.
	   The rows are a single line each now, so a section is scannable at a glance.
	   ⚠️ Bare class, not `.svar-index .svar-list`: `.svar-index` arrives through
	   CollectionIndexPage's `mainClass` and carries THAT component's scope id, so a
	   descendant selector written from here silently matches nothing. */
	.svar-list {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
		column-gap: var(--grid-gutter);
	}

	/* Without a hairline between rows the padding is the whole tap target; a
	   one-line row lands at 40px, under the site's 44px thumb target. */
	@media (hover: none), (pointer: coarse) {
		.svar-list {
			--text-row-question-padding: 0.7rem;
		}
	}
</style>
