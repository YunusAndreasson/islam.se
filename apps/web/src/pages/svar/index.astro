---
import { Search } from "@lucide/astro";
import { getCollection } from "astro:content";
import CollectionIndexPage from "../../components/CollectionIndexPage.astro";
import EssayImage from "../../components/EssayImage.astro";
import SectionLink from "../../components/SectionLink.astro";
import TextRowList from "../../components/TextRowList.astro";
import TitledSection from "../../components/TitledSection.astro";
import { FAKTA_SVAR_ORDER } from "../../lib/fakta";
import { getSortedFordjupning, resolveHero } from "../../lib/fordjupning";
import { CARD_WIDTHS } from "../../lib/hero";
import { breadcrumbList, collectionPageJsonLd } from "../../lib/jsonld";
import { groupSvar, svarSearchTerms } from "../../lib/svar";

// FRÅGOR & SVAR — the full, browsable question list. `groupSvar` arranges the
// corpus into themed sections and drops the cornerstone Five Pillars + six Articles
// of Faith (they live in the FAKTA hub at /vad-ar-islam/), so this index and the
// hub never duplicate each other. A category jump-nav lets a reader go straight
// to a theme, and an observer marks which one they are currently in.
const entries = await getCollection("svar");
const bySlug = new Map(entries.map((e) => [e.id, e]));

// The long reference articles. /svar/ is their only door — /fordjupning/ has no mast
// entry of its own — so all nine are reachable from here, but in the shape Essäer
// already uses for a set of things with pictures: up to three cards in the same
// auto-fill grid, then the rest as text (`essaer.astro` does exactly this per ämne).
//
// ⚠️ Three cards, not nine. The art is dark and atmospheric and turns to mud at
// thumbnail size, so the cards have to stay wide — and nine of them is most of a
// screen standing between the reader and the questions this page exists for.
const fordjupningar = await Promise.all(
	(await getSortedFordjupning()).map(async (entry) => ({ entry, hero: await resolveHero(entry) })),
);
// Named, not sliced off the alphabetical list: the first three by letter are Abort,
// Döden and Griskött — a macabre trio by accident, and the first thing a reader meets.
// These are the everyday ones with the broadest reach: fasting, dress, food.
const PELAR_KORT = ["ramadan", "hijab", "halal"];
const pelarKort = PELAR_KORT.map((id) => {
	const found = fordjupningar.find((f) => f.entry.id === id);
	if (!found) {
		throw new Error(
			`svar/index.astro: PELAR_KORT names "${id}", which is not a page in data/fordjupning/. ` +
				"Use a filename without .md, or drop it from the list.",
		);
	}
	return found;
});
const pelarRest = fordjupningar.filter((f) => !PELAR_KORT.includes(f.entry.id));

// The cornerstone answers, kept OUT of the browsable list (the hub owns their art and
// their sequence) but rendered as rows the on-page filter can reach. "vad är ramadan"
// is the most ordinary thing a reader can type into a page called Frågor & svar, and
// before this it matched nothing: `ödet` returned 0 rows, `vallfärd` and `zakat` 1 each.
const grunderna = FAKTA_SVAR_ORDER.map((slug) => bySlug.get(slug)).filter((e) => e !== undefined);

const groups = groupSvar(entries);
const listed = groups.flatMap((g) => g.entries);
const searchable = listed.length + grunderna.length;

const svarRows = (items: typeof listed) =>
	items.map((e) => ({
		href: `/svar/${e.id}/`,
		// Title only. It already carries the question AND its short answer ("Vad är
		// tawhid? Guds enhet, namn och egenskaper"); `description` is the meta tag
		// Google prints, 163 chars of it, and 51 of those made the list a river.
		// ⚠️ It moves into `data-terms` — see svarSearchTerms.
		title: e.data.title,
		attrs: {
			"data-svar-item": "",
			"data-terms": svarSearchTerms(e) || undefined,
		},
	}));

const description =
	"Tydliga, källbelagda svar på vanliga frågor om islam – tro, dyrkan, mat, familj, samhälle och historia. Grundade i Koranen och klassisk sunnitisk lärdom.";
---

<CollectionIndexPage
	title="Frågor & svar om islam"
	pageTitle="Frågor och svar om islam — islam.se"
	description={description}
	ogImageAlt="Frågor och svar om islam — islam.se"
	mainClass="svar-index home"
	jsonLd={[
		collectionPageJsonLd({
			name: "Frågor och svar om islam",
			description,
			url: "/svar/",
			essays: listed.map((e) => ({ title: e.data.title, slug: `svar/${e.id}` })),
		}),
		breadcrumbList([
			{ name: "Hem", url: "/" },
			{ name: "Frågor och svar", url: "/svar/" },
		]),
	]}
>
	<span slot="lead">
		Källbelagda svar på vanliga frågor om islam, från tro och dyrkan till mat, familj, samhälle
		och historia. Grunderna – de fem pelarna och de sex trosartiklarna – står med bild och
		sammanhang på <a href="/vad-ar-islam/">Pelare &amp; tro</a>, och svarar även här på en sökning.
	</span>


		{groups.length > 0 ? (
			<>
				{/* Narrows this page only; ⌘K still searches the whole site. */}
				<search><form class="svar-search field">
					<Search class="svar-search-icon" size={18} stroke-width={1.75} />
					<input
						class="svar-search-input"
						id="svar-q"
						type="search"
						name="q"
						placeholder={`Sök bland ${searchable} frågor …`}
						aria-label="Sök bland frågorna på denna sida"
						aria-controls="svar-results"
						autocomplete="off"
						autocapitalize="off"
						spellcheck="false"
						enterkeyhint="search"
					/>
					<button class="svar-search-clear label" type="button" hidden>Rensa</button>
				</form></search>
				<p class="svar-search-status label" role="status"></p>

				{fordjupningar.length > 0 && (
					<section class="svar-pelare" aria-labelledby="svar-pelare-rubrik">
						<h2 class="label svar-pelare-label" id="svar-pelare-rubrik">Hela ämnet</h2>
						{/* The same card as Essäer's, class for class — see styles/layout.css. */}
						<ul class="essay-cards svar-pelare-cards">
							{pelarKort.map(({ entry: f, hero }) => (
								<li class="archive-item essay-card">
									<a href={`/fordjupning/${f.id}/`}>
									{hero && (
										<div class="essay-card-media media-frame">
											<EssayImage
												{...(hero.src === undefined ? {} : { src: hero.src })}
												{...(hero.article === undefined ? {} : { article: hero.article })}
													alt=""
													widths={CARD_WIDTHS}
													sizes="(max-width: 600px) 100vw, 20rem"
												/>
											</div>
										)}
										<span class="archive-title essay-card-title">{f.data.term}</span>
										<p class="archive-description essay-card-desc">
											{f.data.blurb ?? f.data.seoDescription}
										</p>
									</a>
								</li>
							))}
						</ul>
						{pelarRest.length > 0 && (
							<p class="svar-pelare-alla">
								<SectionLink href="/fordjupning/">
									Alla {fordjupningar.length} fördjupningar
								</SectionLink>
							</p>
						)}
					</section>
				)}

				<nav class="svar-nav" aria-label="Kategorier">
					<ul>
						{groups.map((g) => (
							<li data-cat-item={g.category.slug}>
								<a href={`#${g.category.slug}`} data-cat={g.category.slug} class="filter-chip label">{g.category.short ?? g.category.name}</a>
							</li>
						))}
					</ul>
				</nav>

				<div id="svar-results">
					{/* Search-only: no chip points here, and the script re-hides it the
					    moment the query is cleared. */}
					{grunderna.length > 0 && (
						<TitledSection
							class="svar-section"
							id="sc-grunderna"
							sectionId="grunderna"
							title="Grunderna"
							data-search-only
							hidden
						>
							<p class="lead svar-section-intro">
								De fem pelarna och de sex trosartiklarna, med bild och sammanhang på{" "}
								<a href="/vad-ar-islam/">Pelare &amp; tro</a>.
							</p>
							<TextRowList
								class="svar-list"
								variant="question"
								items={svarRows(grunderna)}
							/>
						</TitledSection>
					)}

					{groups.map((g) => (
						<TitledSection
							class="svar-section"
							id={`sc-${g.category.slug}`}
							sectionId={g.category.slug}
							title={g.category.name}
						>
							{g.category.intro && <p class="lead svar-section-intro">{g.category.intro}</p>}
							<TextRowList
								class="svar-list"
								variant="question"
								items={svarRows(g.entries)}
							/>
						</TitledSection>
					))}

					{/* The status line states the count; this is only the way out. */}
					<p class="svar-empty" hidden>
						Frågan kan ändå finnas bland essäerna eller på en annan sida.
						<button class="svar-empty-all" type="button">Sök i hela sajten</button>
					</p>
				</div>
			</>
		) : (
			<p>Inga frågor publicerade ännu.</p>
		)}
</CollectionIndexPage>

<script>
	import { closeEnough, fold } from "../../lib/search-text";

	// On-page filter. The haystack is read out of the DOM once (no index to fetch);
	// `data-terms` carries everything the row doesn't print, description included.
	// AND over tokens, both sides folded. No debounce — one pass over 63 rows is
	// microseconds. A query with no exact hit is retried loosely (`closeEnough`).
	function bindSvarSearch() {
		const form = document.querySelector<HTMLFormElement>(".svar-search");
		const input = document.querySelector<HTMLInputElement>("#svar-q");
		const status = document.querySelector<HTMLElement>(".svar-search-status");
		const clear = document.querySelector<HTMLButtonElement>(".svar-search-clear");
		const empty = document.querySelector<HTMLElement>(".svar-empty");
		if (!form || !input || !status || !clear || !empty) return;

		const emptyAll = empty.querySelector<HTMLButtonElement>(".svar-empty-all");
		const items = Array.from(document.querySelectorAll<HTMLLIElement>("[data-svar-item]")).map(
			(el) => ({
				el,
				section: el.closest<HTMLElement>(".svar-section"),
				link: el.querySelector<HTMLAnchorElement>("a"),
				hay: `${fold(el.textContent ?? "")} ${el.dataset.terms ?? ""}`,
				// Built lazily on the first loose pass only.
				words: null as string[] | null,
			}),
		);
		const sections = Array.from(document.querySelectorAll<HTMLElement>(".svar-section"));
		// The fördjupning band sits between the field and the results. At 390px its
		// three cards stack to most of a screen, so a reader who types sees nothing
		// change without scrolling. It is a browsing affordance, not a result.
		const pelare = document.querySelector<HTMLElement>(".svar-pelare");
		// Same reasoning for the category framing sentences: they tell a browser what
		// a section holds, and only push the hits further down for a searcher.
		const intros = Array.from(document.querySelectorAll<HTMLElement>(".svar-section-intro"));
		// Paired up front so the per-keystroke loop needs no lookups.
		const chips = Array.from(document.querySelectorAll<HTMLElement>("[data-cat-item]")).map(
			(el) => ({ el, section: document.getElementById(el.dataset.catItem ?? "") }),
		);
		const total = items.length;
		if (!total) return;

		let visible = items.map((i) => i.link);

		type Item = (typeof items)[number];

		/** Loose pass: a token counts if any word in the row is close enough. */
		function nearly(item: Item, token: string): boolean {
			if (item.hay.includes(token)) return true;
			item.words ??= item.hay.split(/[^\p{L}\p{N}]+/u).filter((w) => w.length > 1);
			return item.words.some((w) => closeEnough(token, w));
		}

		/* Arrow const, not a `function` declaration — a hoisted one is created before
		   the null-guard above and loses the narrowing of status/clear/empty. */
		const apply = (raw: string): void => {
			const query = raw.trim();
			const tokens = fold(query).split(/\s+/).filter(Boolean);
			const live = new Set<HTMLElement>();
			let hits = 0;
			visible = [];

			// Exact first; loose only when that found nothing, so near-misses can
			// never dilute a working query.
			let on = items.map((item) => tokens.every((t) => item.hay.includes(t)));
			const loose = tokens.length > 0 && !on.some(Boolean);
			if (loose) on = items.map((item) => tokens.every((t) => nearly(item, t)));

			for (const [i, item] of items.entries()) {
				item.el.hidden = !on[i];
				if (!on[i]) continue;
				hits++;
				visible.push(item.link);
				if (item.section) live.add(item.section);
			}

			// Empty sections and their chips go too.
			const filtering = tokens.length > 0;
			for (const section of sections) {
				// ⚠️ The search-only section (Grunderna) needs the inverted test, not the
				// same one. With no query `tokens.every(...)` is vacuously true for every
				// row, so `live` holds EVERY section — `!live.has(section)` alone would
				// leave the cornerstone rows on screen at rest, which is the one state
				// they must never be in.
				section.hidden =
					section.dataset.searchOnly !== undefined
						? !filtering || !live.has(section)
						: filtering && !live.has(section);
			}
			for (const chip of chips) {
				chip.el.hidden = filtering && !(chip.section && live.has(chip.section));
			}
			if (pelare) pelare.hidden = filtering;
			for (const intro of intros) intro.hidden = filtering;

			clear.hidden = !query;
			empty.hidden = !query || hits > 0;
			// Name which pass answered.
			status.textContent = !query
				? ""
				: hits === 0
					? `Inga träffar bland sidans ${total} frågor`
					: loose
						? `Ingen exakt träff – visar ${hits} ${hits === 1 ? "snarlik fråga" : "snarlika frågor"}`
						: `${hits} av ${total} frågor`;

			// replaceState, not push: one entry per keystroke would wreck Back.
			const url = query ? `?q=${encodeURIComponent(query)}` : location.pathname;
			history.replaceState(history.state, "", url);
		};

		input.addEventListener("input", () => apply(input.value));

		// The magnifier is an aria-hidden <svg> and the row's padding belongs to the
		// form, so a tap that lands beside the input would otherwise hit nothing.
		form.addEventListener("mousedown", (e) => {
			if (e.target === input || (e.target as HTMLElement).closest?.("button")) return;
			e.preventDefault();
			input.focus();
		});

		// Enter on a single hit opens it.
		form.addEventListener("submit", (e) => {
			e.preventDefault();
			if (visible.length === 1) visible[0]?.click();
		});

		input.addEventListener("keydown", (e) => {
			if (e.key !== "Escape" || !input.value) return;
			// Don't let the palette's global Escape also fire.
			e.preventDefault();
			e.stopPropagation();
			input.value = "";
			apply("");
		});

		clear.addEventListener("click", () => {
			input.value = "";
			apply("");
			input.focus();
		});

		// Hand the query to the site-wide palette.
		emptyAll?.addEventListener("click", () => {
			const query = input.value.trim();
			document.querySelector<HTMLButtonElement>(".search-trigger")?.click();
			const field = document.querySelector<HTMLInputElement>(".palette-input");
			if (!field) return;
			field.value = query;
			field.dispatchEvent(new Event("input", { bubbles: true }));
		});

		// Arriving on /svar/?q=… (a shared link, or the back button) lands filtered.
		const initial = new URLSearchParams(location.search).get("q");
		if (initial) {
			input.value = initial;
			apply(initial);
		}
	}

	// Progressive enhancement: highlight the category chip whose section is in view.
	// Plain anchors already work without this (jump + scroll-margin handle landing).
	function bindSvarNav() {
		const sections = Array.from(document.querySelectorAll<HTMLElement>(".svar-section"));
		const chips = new Map(
			Array.from(document.querySelectorAll<HTMLAnchorElement>(".svar-nav a")).map((a) => [
				a.dataset.cat ?? "",
				a,
			]),
		);
		if (!sections.length || !chips.size) return;

		const obs = new IntersectionObserver(
			(items) => {
				for (const it of items) {
					if (!it.isIntersecting) continue;
					const id = (it.target as HTMLElement).id;
					// Remove rather than set "false": aria-current="false" means
					// "not current" but still counts as the attribute being present,
					// and it left ~12 links carrying it on every scroll.
					for (const [cat, chip] of chips) {
						if (cat === id) chip.setAttribute("aria-current", "true");
						else chip.removeAttribute("aria-current");
					}
				}
			},
			// Trip when a heading reaches the upper third of the viewport.
			{ rootMargin: "-30% 0px -65% 0px" },
		);
		for (const s of sections) obs.observe(s);
	}

	document.addEventListener("astro:page-load", () => {
		bindSvarSearch();
		bindSvarNav();
	});
</script>

<style>
	.svar-index {
		margin-block: var(--space-phi);
	}

	/* A hairline under a line of type, like the palette's own field. Held to the
	   reading measure, not the full canvas. */
	.svar-search {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		max-width: var(--content-width);
		margin: 0 0 0.4rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--color-divider);
		transition: border-color 0.15s;
	}

	.svar-search:focus-within {
		border-bottom-color: var(--color-warm);
	}

	.svar-search-icon {
		flex-shrink: 0;
		color: var(--color-muted);
	}

	.svar-search-input {
		flex: 1;
		min-width: 0;
		font-family: var(--font-heading);
		font-size: var(--step-0);
		color: var(--color-text);
		background: transparent;
		border: none;
		/* The input itself is the tap target — the icon beside it is decorative and
	   the hairline is the form's, not the field's. Keep it thumb-sized. */
		min-height: 2.75rem;
		padding: 0;
		outline: none;
	}

	.svar-search-input::placeholder {
		color: var(--color-muted);
	}

	/* The UA's grey ✕ ignores the page's colour; "Rensa" replaces it. */
	.svar-search-input::-webkit-search-cancel-button {
		-webkit-appearance: none;
	}

	.svar-search-clear {
		flex-shrink: 0;
		border: none;
		background: transparent;
		color: var(--color-muted);
		cursor: pointer;
		/* Padded past the 24px WCAG 2.5.8 target from a ~14px label. */
		padding: 0.35rem 0.5rem;
		margin-right: -0.5rem;

		&:hover { color: var(--color-accent); }
		&:focus-visible { border-radius: var(--radius-xs); }
	}

	/* Reserves its line so nothing below shifts as the reader types. */
	.svar-search-status {
		min-height: 1.2em;
		margin: 0 0 var(--space-half);
	}

	.svar-empty {
		font-family: var(--font-body);
		font-size: var(--step--1);
		color: var(--color-muted);
		margin: var(--space-unit) 0 0;
	}

	.svar-empty-all {
		font: inherit;
		color: var(--color-accent);
		background: transparent;
		border: none;
		padding: 0.35rem 0;
		margin-left: 0.4rem;
		cursor: pointer;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.15em;

		&:focus-visible { border-radius: var(--radius-xs); }
	}

	/* The nine long-form topics as one line of terms. Deliberately NOT one of the
	   global list primitives: both HairlineLinkList and DiamondList stack vertically,
	   so nine of either would be ~22rem of rows — more chrome than the three image
	   cards this replaced, not less. */
	/* The long-form topics. No rules around the band — the photographs already mark it
	   off as a different kind of thing. */
	.svar-pelare {
		margin: 0 0 var(--space-unit);
	}

	.svar-pelare-label {
		color: var(--color-muted);
		margin: 0 0 var(--space-half);
		font-size: var(--step--1);
	}

	/* Only the band's own rhythm is local — the cards themselves are the global
	   `.essay-cards` / `.essay-card*` from styles/layout.css. */
	.svar-pelare-cards {
		margin-bottom: 0;
	}

	.svar-pelare-alla {
		margin: var(--space-unit) 0 0;
	}

	/* Category jump-nav: a wrapping pill row borrowed from Essäer's filter row so the
	   two index pages divide their content the same way — but sticky here, because
	   this page is nine sections deep and the row is its table of contents.
	   (A sticky section nav was turned down once as too much chrome, against a list
	   half this many sections that had no way back to the top.) */
	.svar-nav {
		/* Published by Header.astro; the fallback is one line of mast plus padding. */
		--top: var(--mast-height, 5.5rem);
		position: sticky;
		top: var(--top);
		/* Under the mast (z-index 10), over the rows. */
		z-index: 9;
		background: var(--color-bg);
		/* Top gap is owned by .page-head's margin-bottom (shared by every section
		   page); the nav only sets its space down to the first category. */
		margin: 0 0 var(--space-unit);
		padding-block: 0.55rem;

		/* No rule at rest — a hairline here sat a few pixels under the one closing
		   the fördjupning row and read as a double line. This is the mast's own
		   under-shade instead: it says "content is passing underneath" only while
		   that is actually true. */
		&::after {
			content: "";
			position: absolute;
			inset: 100% 0 auto;
			height: 1.25rem;
			background: linear-gradient(to bottom, var(--color-bg), transparent);
			pointer-events: none;
			opacity: 0;
			transition: opacity 0.2s ease;
		}
	}

	:global(html.page-scrolled) .svar-nav::after {
		opacity: 1;
	}

	/* The mast slides away on scroll-down, so the row would otherwise pin below a
	   strip of nothing. */
	:global(html.mast-hidden) .svar-nav {
		--top: 0px;
	}

	.svar-nav ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
	}

	/* Phones: eight chips wrap to three rows, and three sticky rows eat a quarter of
	   the viewport. One scrolling row instead — the no-horizontal-scroll rule this
	   reverses was written for a row that stood still. */
	@media (width <= 34rem) {
		.svar-nav ul {
			flex-wrap: nowrap;
			overflow-x: auto;
			scrollbar-width: none;
			scroll-snap-type: x proximity;
		}
		.svar-nav li {
			flex: 0 0 auto;
			scroll-snap-align: start;
		}
	}

	/* The pill itself is the shared global `.filter-chip` (+ `.label`), identical to
	   Essäer's filter row. */

	.svar-section {
		margin-top: var(--space-phi);
		/* Clears the mast AND the sticky category row, so an anchor jump doesn't drop
		   the heading underneath either. */
		scroll-margin-top: calc(var(--mast-height, 5.5rem) + 4rem);
	}
	.svar-section h2 {
		font-size: var(--step-1-sans);
