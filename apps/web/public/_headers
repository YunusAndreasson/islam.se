# Cloudflare Pages headers. https://developers.cloudflare.com/pages/configuration/headers/

# Content-hashed, immutable build assets (JS, CSS, images, fonts all live here).
# The filename changes whenever the bytes do, so browsers can keep them forever and
# skip revalidation entirely on repeat visits.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Audio is the heaviest thing on the site (191 MB; 92 MB of it Quran recitation across 240
# files) and had no explicit Cache-Control at all, so phones revalidated it on every visit.
# 30 days, NOT immutable: these filenames are not content-hashed, so a re-recorded narration
# has to be able to propagate. Do not add a second /audio/... rule — Pages MERGES the headers
# of every matching rule and joins duplicates with a comma instead of picking a winner.
/audio/*
  Cache-Control: public, max-age=2592000

# OG cards are crawler-facing, and regenerate under the same URL when a title changes.
/og/*
  Cache-Control: public, max-age=86400

# The moskéskärm hangs on a wall in a foyer and reloads itself in the small hours to pick
# up a deploy. There is no service worker, so without this a reload during an outage — or
# on a mosque's flaky wifi — lands on the browser's error page and the wall goes blank in
# front of a congregation. stale-if-error serves the last good copy for a week instead, and
# stale-while-revalidate keeps the reload instant. max-age stays short so a deploy is still
# picked up the same night. One rule only: Pages MERGES the headers of every matching rule
# and joins duplicates with a comma rather than picking a winner — and /* below
# deliberately sets no Cache-Control, so there is nothing here to collide with.
/bonetider/skarm/visa/
  Cache-Control: public, max-age=600, stale-while-revalidate=604800, stale-if-error=604800

# Baseline security headers for every response. (Cache-Control is intentionally left
# to Cloudflare's default for HTML so content edits go live without a stale window.)
#
# Link header advertises the LLM map at the HTTP layer (not just the HTML <link>),
# so header-only AI crawlers that never parse the body still discover /llms.txt.
#
# HSTS: one year, this host only. No includeSubDomains and no preload on purpose: both
# reach every subdomain of islam.se, a preload entry takes months to withdraw, and
# neither should be switched on before every subdomain is known to answer on HTTPS.
# COOP same-origin: nothing here opens a window it then talks to (sharing goes through
# navigator.share or the clipboard, every target=_blank link is noopener), and Turnstile
# on /ratta/ is a frame, which this header does not govern.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
  Link: </llms.txt>; rel="alternate"; type="text/plain"; title="llms.txt"

# Machine-readable files with no search value of their own: calendar feeds, the client
# search index and the AI-barometern raw data. Keep them out of the index so they never
# compete with the pages that present them. (The markdown twins get an HTTP canonical
# from functions/_middleware.js instead, so AI agents can still read them.)
/bonetider/:stad/kalender.ics
  X-Robots-Tag: noindex

/det-islamiska-aret.ics
  X-Robots-Tag: noindex

/search-index.json
  X-Robots-Tag: noindex

/ai-barometern/data/*
  X-Robots-Tag: noindex
