{
	"name": "@islam-se/tui",
	"version": "0.1.0",
	"type": "module",
	"description": "Terminal UI for managing ideas and article production",
	"main": "dist/index.js",
	"bin": {
		"islam-tui": "./dist/index.js"
	},
	"scripts": {
		"build": "rm -rf dist && tsc",
		"dev": "tsc && node --no-warnings dist/index.js",
		"start": "node --no-warnings dist/index.js"
	},
	"dependencies": {
		"@inkjs/ui": "^2.0.0",
		"@islam-se/orchestrator": "workspace:*",
		"ink": "^8.0.0",
		"marked": "^18.1.3",
		"marked-terminal": "^8.0.0",
		"react": "^19.3.1"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"typescript": "^7.0.2"
	}
}
