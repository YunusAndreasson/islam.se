{
  "expo": {
    "name": "islam.se",
    "slug": "islam-se-mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "islamse",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": false,
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon.png",
        "tinted": "./assets/images/ios-tinted.png"
      },
      "bundleIdentifier": "se.islam.mobile",
      "buildNumber": "25",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "sv"
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "package": "se.islam.mobile",
      "userInterfaceStyle": "automatic",
      "versionCode": 14,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#2a557f"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "@maplibre/maplibre-react-native",
        {
          "android": {
            "nativeVariant": "vulkan"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Platsåtkomst används för att beräkna bönetider där du befinner dig.",
          "locationFullAccuracyPermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2a557f",
          "icon": "./assets/images/notification-icon.png",
          "enableRemoteNotifications": false
        }
      ],
      "expo-web-browser",
      "expo-mail-composer",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f6f3ed",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#161a26"
          }
        }
      ],
      "./plugins/withPrayerWidgetAndroid",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.se.islam.mobile",
          "widgets": [
            {
              "name": "PrayerTimesWidget",
              "displayName": "Bönetider",
              "description": "Nästa bön och dagens bönetider",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryInline",
                  "accessoryRectangular",
                  "accessoryCircular"
                ]
              },
              "android": {
                "minWidth": 250,
                "minHeight": 110,
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "resizeMode": "both",
                "initialLayout": "./src/widgets/PrayerTimesWidgetAndroid.tsx"
              }
            }
          ],
          "enableAndroid": true
        }
      ],
      "expo-status-bar",
      "expo-font",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      "expo-background-task",
      "expo-localization",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false,
          "microphonePermission": false
        }
      ],
      "expo-asset",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "openarabic",
          "project": "islam-se"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "updates": {
      "url": "https://u.expo.dev/ae3f5ac8-8773-4205-b590-ecb11f9a097e",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "sentryDsn": "https://a3ad279e35fb34a58bfdf05b12bd7ca3@o1414696.ingest.us.sentry.io/4512069756977152",
      "router": {},
      "eas": {
        "projectId": "ae3f5ac8-8773-4205-b590-ecb11f9a097e"
      }
    },
    "owner": "edenmind"
  }
}
