{
  "expo": {
    "name": "islam.se",
    "slug": "islam-se-mobile",
    "version": "1.3.15",
    "orientation": "portrait",
    "scheme": "islamse",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": false,
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon.png",
        "tinted": "./assets/images/ios-tinted.png"
      },
      "bundleIdentifier": "se.islam.mobile",
      "buildNumber": "29",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "sv",
        "NSLocationDefaultAccuracyReduced": true
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "package": "se.islam.mobile",
      "userInterfaceStyle": "automatic",
      "versionCode": 18,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#2a557f"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "@maplibre/maplibre-react-native",
        {
          "android": {
            "nativeVersion": "13.7.1",
            "nativeVariant": "vulkan"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Din ungefärliga plats används för lokala bönetider och för kompassen när du väljer den.",
          "locationFullAccuracyPermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2a557f",
          "icon": "./assets/images/notification-icon.png",
          "enableRemoteNotifications": false
        }
      ],
      "expo-web-browser",
      "expo-mail-composer",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ece6d8",
          "dark": {
            "backgroundColor": "#1d2233"
          },
          "android": {
            "image": "./assets/images/launch-transparent.png"
          }
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.se.islam.mobile",
          "widgets": [
            {
              "name": "PrayerTimesWidget",
              "displayName": "Bönetider",
              "description": "Nästa bön och dagens bönetider",
              "ios": {
                "initialLayout": "./src/widgets/PrayerTimesWidget.tsx",
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryInline",
                  "accessoryRectangular",
                  "accessoryCircular"
                ]
              },
              "android": null
            }
          ],
          "enableAndroid": true
        }
      ],
      "expo-status-bar",
      "expo-font",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      "expo-background-task",
      "expo-localization",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false,
          "microphonePermission": false
        }
      ],
      "expo-asset",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "openarabic",
          "project": "islam-se",
          "experimental_android": {
            "enableAndroidGradlePlugin": true
          }
        }
      ],
      "./plugins/withSentryAndroidBreadcrumbs",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/withSkiaVulkanAndroid",
      "./plugins/withAndroidLinkIntent"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "updates": {
      "url": "https://u.expo.dev/ae3f5ac8-8773-4205-b590-ecb11f9a097e",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "sentryDsn": "https://a3ad279e35fb34a58bfdf05b12bd7ca3@o1414696.ingest.us.sentry.io/4512069756977152",
      "mixpanelToken": "23d2115fb5dabcc70bd8941991c7f222",
      "router": {},
      "eas": {
        "projectId": "ae3f5ac8-8773-4205-b590-ecb11f9a097e"
      }
    },
    "owner": "edenmind",
    "locales": {
      "sv": {
        "ios": {
          "NSLocationWhenInUseUsageDescription": "Din ungefärliga plats används för lokala bönetider och för kompassen när du väljer den."
        }
      },
      "en": {
        "ios": {
          "NSLocationWhenInUseUsageDescription": "Your approximate location is used for local prayer times and for the compass when you choose to use it."
        }
      }
    }
  }
}
