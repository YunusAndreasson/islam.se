<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/islam_widget_paper"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/islam_widget_name"
        android:textColor="@color/islam_widget_ink"
        android:textSize="20sp" />
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginVertical="6dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/islam_widget_preview_horizon" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/islam_widget_preview"
        android:textColor="@color/islam_widget_muted"
        android:textSize="12sp" />
</LinearLayout>
