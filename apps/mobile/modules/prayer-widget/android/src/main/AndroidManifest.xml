<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <receiver android:name="se.islam.widget.PinResultReceiver" android:exported="false" />
    <receiver
        android:name="se.islam.mobile.PrayerTimesWidgetProvider"
        android:exported="false"
        android:label="@string/islam_widget_name">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
        <action android:name="android.intent.action.TIME_SET" />
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/islam_prayer_widget" />
    </receiver>
  </application>
</manifest>
