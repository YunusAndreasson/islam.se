{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "pnpm": "12.14.0"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "SENTRY_ORG": "openarabic",
        "SENTRY_PROJECT": "islam-se",
        "SENTRY_ALLOW_FAILURE": "true"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "channel": "preview",
      "pnpm": "12.14.0"
    },
    "production": {
      "channel": "production",
      "env": {
        "SENTRY_ORG": "openarabic",
        "SENTRY_PROJECT": "islam-se",
        "SENTRY_ALLOW_FAILURE": "true"
      },
      "autoIncrement": true,
      "pnpm": "12.14.0"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6774383118",
        "metadataPath": "./store.config.js"
      },
      "android": {
        "serviceAccountKeyPath": "./secrets/play-service-account.json",
        "track": "production",
        "releaseStatus": "inProgress",
        "rollout": 0.2
      }
    }
  }
}
