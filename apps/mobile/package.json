{
  "name": "mobile",
  "main": "index.ts",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "bash ./scripts/dev-android.sh",
    "android:plain": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "deps:check": "bash ./scripts/update-deps.sh",
    "deps:update": "bash ./scripts/update-deps.sh --apply",
    "deps:update:latest": "bash ./scripts/update-deps.sh --apply --latest",
    "test": "jest",
    "test:cov": "jest --coverage",
    "api:check": "node ./scripts/check-deprecated-apis.mjs",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run api:check && pnpm run test:cov",
    "mutation": "stryker run",
    "sync:data": "node scripts/sync-web-data.mjs",
    "sync:data:check": "node scripts/sync-web-data.mjs --check",
    "version:bump": "node scripts/release.js",
    "release": "./scripts/eas-release.sh all",
    "release:check": "./scripts/eas-release.sh --check all",
    "release:ios": "./scripts/eas-release.sh ios",
    "release:android": "./scripts/eas-release.sh android",
    "release:all": "./scripts/eas-release.sh all",
    "sentry:sourcemaps": "sentry-expo-upload-sourcemaps dist"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "@expo/ui": "~58.0.20",
    "@expo/vector-icons": "^15.1.1",
    "@maplibre/maplibre-react-native": "^11.5.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~8.28.0",
    "adhan": "^4.4.6",
    "astronomy-engine": "^2.1.19",
    "expo": "~58.0.14",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.16",
    "expo-audio": "~58.0.9",
    "expo-background-task": "~58.0.11",
    "expo-blur": "~58.0.4",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.8",
    "expo-glass-effect": "~58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-intent-launcher": "~58.0.3",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.4",
    "expo-location": "~58.0.17",
    "expo-mail-composer": "~58.0.3",
    "expo-navigation-bar": "~58.0.4",
    "expo-network": "~58.0.3",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.23",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-store-review": "~58.0.2",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-task-manager": "~58.0.12",
    "expo-updates": "~58.0.17",
    "expo-web-browser": "~58.0.6",
    "expo-widgets": "~58.0.20",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-skia": "3.6.2",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@expo/agent-cli": "^1.0.19",
    "@jest/globals": "^30.5.2",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "@swmansion/argent": "0.29.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/node": "^24.13.4",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "fast-check": "^4.10.0",
    "globals": "^14.0.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.11",
    "sf-symbols-typescript": "^2.2.0",
    "test-renderer": "1.3.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "jest"
      ]
    }
  },
  "packageManager": "pnpm@12.14.0"
}
