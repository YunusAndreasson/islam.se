diff --git a/ios/LiveActivityFactory.swift b/ios/LiveActivityFactory.swift
index 4b8a632965ddb507aeeb54a4d8944f455e5dffd7..92d5778cb3d8fe71a90bbb36319c5cbaa113902a 100644
--- a/ios/LiveActivityFactory.swift
+++ b/ios/LiveActivityFactory.swift
@@ -43,9 +43,15 @@ final class LiveActivityFactory: SharedObject {
     let activities = Activity<LiveActivityAttributes>.activities
       // Filter LiveActivity instances for activities that don't match the factory's name.
       .filter { $0.content.state.name == name }
-      // A stale activity is still visible and updatable; only ended/dismissed ones are gone.
-      .filter { $0.activityState == .active || $0.activityState == .stale }
-      
+      // An ENDED activity is still on screen (and still enumerable here) until the system
+      // actually removes it at its dismissal date — only a fully dismissed one is gone from
+      // this array. Excluding `.ended` here made every already-ended-with-a-future-
+      // dismissal-date activity invisible to callers that dedupe/replace off this list (e.g.
+      // a caller that always ends what it starts, to keep a countdown ticking after the
+      // banner's content can no longer be updated): they'd see zero instances, never clean
+      // the old one up, and stack a fresh duplicate on every call.
+      .filter { $0.activityState == .active || $0.activityState == .stale || $0.activityState == .ended }
+
     let activeIDs = Set(activities.map(\.id))
     instances = instances.filter { activeIDs.contains($0.key) }
 
