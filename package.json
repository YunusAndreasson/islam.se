{
	"name": "islam-se",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm -r build",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"lint:articles": "markdownlint-cli2 'data/articles/*.md'",
		"knip": "knip",
		"verify": "pnpm check && pnpm test && pnpm test:checkers && pnpm build",
		"test": "vitest run",
		"test:watch": "vitest",
		"cli": "pnpm --filter @islam-se/cli run cli",
		"produce": "pnpm --filter @islam-se/content-producer run produce",
		"tui": "ISLAM_OUTPUT_DIR=$(pwd)/apps/content-producer/output pnpm --filter @islam-se/tui run dev",
		"pdf": "pnpm --filter @islam-se/web run pdf",
		"rattelser": "pnpm --filter @islam-se/web run rattelser",
		"ship": "pnpm build && pnpm pdf && cd apps/web && node scripts/assert-full-build.mjs && wrangler pages deploy dist --project-name islam-se --branch master --commit-dirty=true",
		"ship:mailer": "cd apps/web/workers/rattelse-mailer && wrangler deploy",
		"deploy": "pnpm ship",
		"test:checkers": "python3 scripts/check-quran-quotes.py --self-test && python3 scripts/check-book-passages.py --self-test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@types/node": "^25.9.5",
		"knip": "^6.29.0",
		"markdownlint-cli2": "^0.23.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10",
		"wrangler": "^4.113.0"
	},
	"packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d"
}
