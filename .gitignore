# Claude Code local settings (the tracked root .claude/ is intentional; these
# per-app dirs are local agent state and should not be committed)
apps/.claude/
apps/mobile/.claude/
.claude/projects/

# Local editor / AI-tool configs (per-dev, not committed)
.codex/
.opencode/
.zed/
.mcp.json
opencode.json

# Argent's local install state — same category as the per-app agent dirs above.
# `.agents/skills/` is a cache of skill files downloaded from
# software-mansion/argent, and `.argent/install.json` records this machine's
# install. skills-lock.json IS tracked: it pins the versions the cache is
# restored from, so the lockfile is committed and the cache is not, as with
# node_modules.
.agents/
.argent/

# Dependencies
node_modules/

# Build output
dist/
.astro/

# Environment
.env
.env.local

# Cloudflare — local Function secrets and the local D1/KV state
.dev.vars
.wrangler/

# Data files (keep structure, ignore content)
data/sources/*
data/extracted/*
data/*.db
data/*.db-*
# Backups taken before a bulk import or cleanup (books.db.bak-2026-09-19 is 1.1 GB)
data/*.db.bak*
!data/.gitkeep

# Generated output
output/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Local bin symlinks
bin/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Python bytecode from scripts/
__pycache__/
*.pyc

# local verification build output
dist-*/

# IndexNow: last ping + URLs already announced (apps/web/scripts/indexnow.ts)
.indexnow-state.json

# One-off pipeline scratch from the 2026 rewrites and book imports: notes,
# install scripts and their output. Kept locally; nothing in the pipeline reads it.
data/IMPORT-RESUME.md
data/install-*.cjs
data/rewrite-*
data/deepen-test/
data/article-rankings.json

# Unpublished essay drafts, and the raw mosque scrape with its speculative columns:
# both stay on the owner's machine.
data/articles-pending/
apps/web/src/data/moskeer-sverige.full.csv
